// Возвращает совместимый снимок раздела или Неопределено.
//
// Параметры:
//  Источник - Строка - EDS, УПП или УКТ;
//  Раздел - Строка - Vessels, Wagons, Placements или Cells;
//  BuildId - Строка - идентификатор текущей сборки сцены.
//
// Возвращаемое значение:
//  Структура, Неопределено - дата, данные и предупреждения совместимого снимка.
Функция ПрочитатьСовместимыйСнимок(Источник, Раздел, BuildId) Экспорт

	Запись = ПрочитатьЗаписьСнимка(Источник, Раздел);
	Если Запись = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Строка(Запись.BuildId) <> Строка(BuildId) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Обработка = Обработки.d3_v4.Создать();
	Результат = Новый Структура;
	Результат.Вставить("ДатаПолучения", Запись.ДатаПолучения);
	Результат.Вставить("Данные", Обработка.ПрочитатьОбъектыСцены(Запись.ДанныеJSON));
	Результат.Вставить("Предупреждения", Обработка.ПрочитатьОбъектыСцены(Запись.ПредупрежденияJSON));
	Возврат Результат;

КонецФункции

// Читает снимки EDS/УПП/УКТ и период Скаут для polling формы.
//
// Параметры:
//  Версии - Структура - известные клиенту даты слоёв.
//
// Возвращаемое значение:
//  Структура:
//   * РежимРеальныхДанных - Булево - текущее значение константы;
//   * Техника - Структура - секция Скаут;
//   * EDS - Структура - секция судов;
//   * УПП - Структура - секция вагонов;
//   * УКТ - Структура - секция размещений.
Функция ПолучитьОбновленияСнимков(Версии) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("РежимРеальныхДанных", РежимРеальныхДанныхВключен());
	Результат.Вставить("Техника", СобратьСекциюТехники(Версии.ПериодТехники));

	BuildId = "";
	Попытка
		BuildId = Обработки.d3_v4.Создать().ПолучитьИдентификаторСборкиСцены();
	Исключение
		BuildId = "";
	КонецПопытки;

	Результат.Вставить("EDS", СобратьСекциюСнимка(ИсточникEDS(), РазделСуда(), Версии.ДатаEDS, BuildId));
	Результат.Вставить("УПП", СобратьСекциюСнимка(ИсточникУПП(), РазделВагоны(), Версии.ДатаУПП, BuildId));
	Результат.Вставить("УКТ", СобратьСекциюСнимка(ИсточникУКТ(), РазделРазмещения(), Версии.ДатаУКТ, BuildId));
	Возврат Результат;

КонецФункции

