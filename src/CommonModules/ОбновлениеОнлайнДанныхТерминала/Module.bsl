// Точка входа регламентного задания ПолучитьСудаEDS.
Процедура ОбновитьСудаEDS() Экспорт

	Если Не РежимРеальныхДанныхВключен() Тогда
		Возврат;
	КонецЕсли;

	Если ЗаданиеМетодаУжеВыполняется(ИмяМетодаСудов()) Тогда
		Возврат;
	КонецЕсли;

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Обработка = Обработки.d3_v4.Создать();
		Снимок = Обработка.СобратьСнимокСудовEDS();
		ЗаписатьСнимокРаздела(
			ИсточникEDS(),
			РазделСуда(),
			Снимок.Объекты,
			Снимок.Предупреждения,
			Обработка.ПолучитьИдентификаторСборкиСцены(),
			ДлительностьСекунд(Начало),
			Обработка);
	Исключение
		ЗаписатьОшибку("EDS.ОбновлениеСудов", ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

