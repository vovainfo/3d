#Область ПрограммныйИнтерфейс

// Точка входа регламентного задания ПолучитьТехникуСкаут.
// Читает GPS Скаут, пишет снимок в регистр и удаляет записи старше окна хранения.
Процедура ОбновитьПоложениеТехники() Экспорт

	Если Не Константы.ПолучениеРеальныхДанных.Получить() Тогда
		Возврат;
	КонецЕсли;

	Если ЗаданиеОбновленияУжеВыполняется() Тогда
		Возврат;
	КонецЕсли;

	ОбработкаСкаут = Обработки.Скаут.Создать();

	Попытка
		ТаблицаКоординат = ОбработкаСкаут.ПолучитьКоординатыТехники();
		ОбработкаСкаут.ЗаписатьПоложениеТехники(ТаблицаКоординат);
	Исключение
		ЗаписатьОшибку(ИнформацияОбОшибке());
	КонецПопытки;

	Попытка
		ОбработкаСкаут.УдалитьУстаревшиеПоложения(ЧасовХранитьПоложения());
	Исключение
		ЗаписатьОшибку(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КлючЗаданияОбновления()

	Возврат "ПолучитьТехникуСкаут";

КонецФункции

Функция ЧасовХранитьПоложения()

	Возврат 1;

КонецФункции

Функция ЗаданиеОбновленияУжеВыполняется()

	Отбор = Новый Структура;
	Отбор.Вставить("Ключ", КлючЗаданияОбновления());
	Отбор.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
	Найденные = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);

	ТекущееЗадание = Неопределено;
	Попытка
		ТекущееЗадание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	Исключение
		ТекущееЗадание = Неопределено;
	КонецПопытки;

	Для Каждого Задание Из Найденные Цикл
		Если ТекущееЗадание <> Неопределено
				И Задание.УникальныйИдентификатор = ТекущееЗадание.УникальныйИдентификатор Тогда
			Продолжить;
		КонецЕсли;
		Возврат Истина;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Процедура ЗаписатьОшибку(Информация)

	ЗаписьЖурналаРегистрации(
		"Скаут.ОбновлениеПоложенияТехники",
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация));

КонецПроцедуры

#КонецОбласти
