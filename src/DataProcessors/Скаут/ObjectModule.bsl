		Возврат "Автовоз";
	ИначеЕсли КодТипа = 7 Тогда
		Возврат "Лесовоз";
	ИначеЕсли КодТипа = 8 Тогда
		Возврат "Пассажирский";
	ИначеЕсли КодТипа = 9 Тогда
		Возврат "Бульдозер";
	ИначеЕсли КодТипа = 10 Тогда
