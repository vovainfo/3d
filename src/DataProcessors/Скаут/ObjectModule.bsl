КонецФункции

Функция КоординатыСценыКарты(Широта, Долгота)

	Если Широта = 0 И Долгота = 0 Тогда
		Возврат Новый Структура("x,y", 0, 0);
	КонецЕсли;

	УТМ = КоординатыUTM32652(Широта, Долгота);
	ЛокальнаяX = УТМ.Easting - 734400;
	ЛокальнаяY = УТМ.Northing - 4774800;
	Радианы = -50 * 3.141592653589793 / 180;
	КоординатаX = ЛокальнаяX * Cos(Радианы) - ЛокальнаяY * Sin(Радианы);
	КоординатаY = ЛокальнаяX * Sin(Радианы) + ЛокальнаяY * Cos(Радианы);
	Возврат Новый Структура("x,y", КоординатаX, КоординатаY);

КонецФункции

Функция КоординатыUTM32652(ШиротаГрадусы, ДолготаГрадусы)

	ЧислоПи = 3.141592653589793;
	БольшаяПолуось = 6378137;
	Сжатие = 1 / 298.257223563;
	Эксцентриситет2 = Сжатие * (2 - Сжатие);
	ВторойЭксцентриситет2 = Эксцентриситет2 / (1 - Эксцентриситет2);
	Масштаб = 0.9996;
	ЦентральныйМеридиан = 129 * ЧислоПи / 180;
	Широта = ШиротаГрадусы * ЧислоПи / 180;
	Долгота = ДолготаГрадусы * ЧислоПи / 180;
	SinШирота = Sin(Широта);
	CosШирота = Cos(Широта);
	TanШирота = Tan(Широта);
	РадиусКривизны = БольшаяПолуось / Sqrt(1 - Эксцентриситет2 * SinШирота * SinШирота);
	КвадратТангенса = TanШирота * TanШирота;
	ПараметрC = ВторойЭксцентриситет2 * CosШирота * CosШирота;
	ДельтаДолготы = CosШирота * (Долгота - ЦентральныйМеридиан);
	Эксцентриситет4 = Эксцентриситет2 * Эксцентриситет2;
	Эксцентриситет6 = Эксцентриситет4 * Эксцентриситет2;
	ДугаМеридиана = БольшаяПолуось * (
		(1 - Эксцентриситет2 / 4 - 3 * Эксцентриситет4 / 64 - 5 * Эксцентриситет6 / 256) * Широта
		- (3 * Эксцентриситет2 / 8 + 3 * Эксцентриситет4 / 32 + 45 * Эксцентриситет6 / 1024) * Sin(2 * Широта)
		+ (15 * Эксцентриситет4 / 256 + 45 * Эксцентриситет6 / 1024) * Sin(4 * Широта)
		- (35 * Эксцентриситет6 / 3072) * Sin(6 * Широта));
	Дельта2 = ДельтаДолготы * ДельтаДолготы;
	Дельта3 = Дельта2 * ДельтаДолготы;
	Дельта4 = Дельта2 * Дельта2;
	Дельта5 = Дельта4 * ДельтаДолготы;
	Дельта6 = Дельта4 * Дельта2;
	Easting = Масштаб * РадиусКривизны * (ДельтаДолготы + (1 - КвадратТангенса + ПараметрC) * Дельта3 / 6
		+ (5 - 18 * КвадратТангенса + КвадратТангенса * КвадратТангенса + 72 * ПараметрC - 58 * ВторойЭксцентриситет2)
		* Дельта5 / 120) + 500000;
	Northing = Масштаб * (ДугаМеридиана + РадиусКривизны * TanШирота * (
		Дельта2 / 2 + (5 - КвадратТангенса + 9 * ПараметрC + 4 * ПараметрC * ПараметрC) * Дельта4 / 24
		+ (61 - 58 * КвадратТангенса + КвадратТангенса * КвадратТангенса + 600 * ПараметрC - 330 * ВторойЭксцентриситет2)
		* Дельта6 / 720));
	Возврат Новый Структура("Easting,Northing", Easting, Northing);

КонецФункции

#КонецОбласти

#КонецЕсли
