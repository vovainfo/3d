Функция ДатаИлиНеопределено(Значение)

	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат ДатаПоВладивостоку(Значение);
	КонецЕсли;

	Текст = СокрЛП(Строка(Значение));
	Если ПустаяСтрока(Текст) Или СтрДлина(Текст) < 19 Или Сред(Текст, 11, 1) <> "T" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат ДатаПоВладивостоку(XMLЗначение(Тип("Дата"), Лев(Текст, 19)));
	Исключение
		Возврат Неопределено;
	КонецПопытки;

