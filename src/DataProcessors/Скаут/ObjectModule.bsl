#Область ПрограммныйИнтерфейс

// Получает координаты доступной техники из Скаут-онлайн API.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Идентификатор, Наименование, ГосНомер, КодТипаТС, ТипТС, ТипТехники, Отображать, СКонтейнером, Информация, Широта, Долгота, Азимут, Скорость, Водитель.
Функция ПолучитьКоординатыТехники() Экспорт

	Токен = СокрЛП(Строка(Константы.ТокенСкаут.Получить()));
	ИзКэша = Не ПустаяСтрока(Токен);
	ТаймаутСекунд = ТаймаутЗапросаРегламента();
	Если Не ИзКэша Тогда
		Токен = ОбновитьТокенАвторизации(ТаймаутСекунд);
	КонецЕсли;

	РезультатНавигации = ЗапроситьНавигационныеДанные(Токен, ТаймаутСекунд);
	Если ИзКэша И РезультатНавигации.КодСостояния = 401 Тогда
		Токен = ОбновитьТокенАвторизации(ТаймаутСекунд);
		РезультатНавигации = ЗапроситьНавигационныеДанные(Токен, ТаймаутСекунд);
	КонецЕсли;

	Если РезультатНавигации.КодСостояния <> 204 Тогда
		ПроверитьКодОтветаНавигации(РезультатНавигации);
	КонецЕсли;

	Возврат РезультатНавигации.Таблица;

КонецФункции

// Получает актуальное состояние одной техники из Скаут-онлайн API.
//
// Параметры:
//  ИдентификаторСкаут - Число - идентификатор техники в Скаут.
//
// Возвращаемое значение:
//  Структура:
//   * Скорость - Число, Неопределено - скорость, км/ч.
//   * ДвигательРаботает - Булево, Неопределено - признак работы двигателя.
//   * ОстатокТоплива - Число, Неопределено - уровень топлива, л.
//   * ДатаДанных - Дата, Неопределено - дата и время последних онлайн-данных по Владивостоку.
Функция ПолучитьСостояниеТехники(ИдентификаторСкаут) Экспорт

	Если Не ЗначениеЗаполнено(ИдентификаторСкаут) Тогда
		Возврат НовоеСостояниеТехники();
	КонецЕсли;

	ТаймаутСекунд = ТаймаутЗапросаКарточки();
	Токен = СокрЛП(Строка(Константы.ТокенСкаут.Получить()));
	ИзКэша = Не ПустаяСтрока(Токен);
	Если Не ИзКэша Тогда
		Токен = ОбновитьТокенАвторизации(ТаймаутСекунд);
	КонецЕсли;

	РезультатЗапроса = ЗапроситьОнлайнДанныеТехники(Токен, ИдентификаторСкаут, ТаймаутСекунд);
	Если ИзКэша И РезультатЗапроса.КодСостояния = 401 Тогда
		Токен = ОбновитьТокенАвторизации(ТаймаутСекунд);
		РезультатЗапроса = ЗапроситьОнлайнДанныеТехники(Токен, ИдентификаторСкаут, ТаймаутСекунд);
	КонецЕсли;

	Если РезультатЗапроса.КодСостояния = 204 Тогда
		Возврат НовоеСостояниеТехники();
	КонецЕсли;

	Если РезультатЗапроса.КодСостояния < 200 Или РезультатЗапроса.КодСостояния >= 300 Тогда
		ВызватьИсключение СтрШаблон(
			"Ошибка состояния техники Скаут: HTTP %1. %2",
			РезультатЗапроса.КодСостояния,
			РезультатЗапроса.ТелоОтвета);
	КонецЕсли;

	Возврат РазобратьОнлайнДанныеТехники(РезультатЗапроса.Данные);

КонецФункции

// Записывает снимок положения техники в периодический регистр сведений.
//
// Параметры:
//  ТаблицаКоординат - ТаблицаЗначений - строки, полученные ПолучитьКоординатыТехники.
Процедура ЗаписатьПоложениеТехники(ТаблицаКоординат) Экспорт

	ДатаПолучения = ТекущаяДатаСеанса();
	АктуальнаяТехника = ПолучитьАктуальнуюПогрузочнуюТехникуУПП(ДатаПолучения);
	ТехникаУКТ = ПолучитьАктуальнуюТехникуУКТ();
	КонтейнерыНаТехнике = ПолучитьКонтейнерыНаТехникеУКТ();
	НаборЗаписей = РегистрыСведений.ПоложениеТехникиСкаут.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Период.Установить(ДатаПолучения);

	Для Каждого СтрокаТаблицы Из ТаблицаКоординат Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Идентификатор) Тогда
			Продолжить;
		КонецЕсли;

		КоординатыСцены = КоординатыСценыКарты(СтрокаТаблицы.Широта, СтрокаТаблицы.Долгота);
		Запись = НаборЗаписей.Добавить();
		Запись.Период = ДатаПолучения;
		Запись.Идентификатор = СтрокаТаблицы.Идентификатор;
		Запись.Наименование = СтрокаТаблицы.Наименование;
		Запись.ГосНомер = СтрокаТаблицы.ГосНомер;
		Запись.КодТипаТС = СтрокаТаблицы.КодТипаТС;
		Запись.ТипТС = СтрокаТаблицы.ТипТС;
		Запись.Широта = СтрокаТаблицы.Широта;
		Запись.Долгота = СтрокаТаблицы.Долгота;
		Запись.Азимут = СтрокаТаблицы.Азимут;
		Запись.Скорость = СтрокаТаблицы.Скорость;
		Запись.КоординатаX = КоординатыСцены.x;
		Запись.КоординатаY = КоординатыСцены.y;
		Запись.ДатаПолучения = ДатаПолучения;

		ДанныеУПП = АктуальнаяТехника.Получить(ЧислоИдентификатораСкаут(СтрокаТаблицы.Идентификатор));
		Если ДанныеУПП = Неопределено Тогда
			Запись.Отображать = Ложь;
			Запись.ТипТехники = "";
			Запись.Водитель = "";
			СтрокаТаблицы.Отображать = Ложь;
			СтрокаТаблицы.ТипТехники = "";
			СтрокаТаблицы.Водитель = "";
		Иначе
			Если ЗначениеЗаполнено(ДанныеУПП.Наименование) Тогда
				Запись.Наименование = ДанныеУПП.Наименование;
				СтрокаТаблицы.Наименование = ДанныеУПП.Наименование;
			КонецЕсли;
			Запись.ТипТехники = ДанныеУПП.ТипТехники;
			Запись.Водитель = ДанныеУПП.Водитель;
			Запись.Отображать = Истина;
			СтрокаТаблицы.ТипТехники = ДанныеУПП.ТипТехники;
			СтрокаТаблицы.Водитель = ДанныеУПП.Водитель;
			СтрокаТаблицы.Отображать = Истина;
		КонецЕсли;

		ИмяУКТ = ТехникаУКТ.Получить(ЧислоИдентификатораСкаут(СтрокаТаблицы.Идентификатор));
		Если ЗначениеЗаполнено(ИмяУКТ) Тогда
			Запись.Наименование = ИмяУКТ;
			СтрокаТаблицы.Наименование = ИмяУКТ;
		КонецЕсли;

		Запись.СКонтейнером = Ложь;
		Запись.Информация = "";
		СтрокаТаблицы.СКонтейнером = Ложь;
		СтрокаТаблицы.Информация = "";
		Если Запись.ТипТехники <> "Буксиры" И Запись.ТипТехники <> "Экскаваторы" И Запись.ТипТехники <> "Бульдозеры" Тогда
			ИнформацияКонтейнера = КонтейнерыНаТехнике.Получить(ЧислоИдентификатораСкаут(СтрокаТаблицы.Идентификатор));
			Если ИнформацияКонтейнера <> Неопределено Тогда
				Запись.СКонтейнером = Истина;
				Запись.Информация = ИнформацияКонтейнера;
				СтрокаТаблицы.СКонтейнером = Истина;
				СтрокаТаблицы.Информация = ИнформацияКонтейнера;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	НаборЗаписей.Записать();

КонецПроцедуры

// Удаляет снимки старше окна хранения. За один запуск снимается не более 500 периодов.
//
// Параметры:
//  ЧасовХранить - Число - сколько часов хранить историю положений.
Процедура УдалитьУстаревшиеПоложения(ЧасовХранить = 1) Экспорт

	Граница = ТекущаяДатаСеанса() - ЧасовХранить * 3600;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 500
	|	Положение.Период КАК Период
	|ИЗ
	|	РегистрСведений.ПоложениеТехникиСкаут КАК Положение
	|ГДЕ
	|	Положение.Период < &Граница
	|УПОРЯДОЧИТЬ ПО
	|	Период";
	Запрос.УстановитьПараметр("Граница", Граница);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НаборЗаписей = РегистрыСведений.ПоложениеТехникиСкаут.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Период.Установить(Выборка.Период);
		НаборЗаписей.Записать();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьАктуальнуюПогрузочнуюТехникуУПП(ДатаПолучения)

	ТекстЗапроса =
		"ВЫБРАТЬ
		|	ПРЕДСТАВЛЕНИЕ(АП_СП.ПогрузочнаяТехника) КАК Погрузчик,
		|	ПРЕДСТАВЛЕНИЕ(АП_СП.ПогрузочнаяТехника.ВидПогрузочнойТехники) КАК ВидПогрузочнойТехники,
		|	АП_СП.ПогрузочнаяТехника.ИдентификаторСКАУТ КАК ИдентификаторСКАУТ,
		|	ПРЕДСТАВЛЕНИЕ(АП_СП.Водитель) КАК Водитель
		|ИЗ
		|	РегистрСведений.ПогрузочнаяТехникаДополнительныеСведения.СрезПоследних(&Дата, Дата >= &ДатаОтсечки) КАК АП_СП
		|ГДЕ
		|	НЕ АП_СП.Возврат
		|	И АП_СП.ПогрузочнаяТехника.Родитель.Наименование = ""Автопогрузчики""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПогрузочнаяТехника.Наименование,
		|	""Буксиры"",
		|	ПогрузочнаяТехника.ИдентификаторСКАУТ,
		|	""""
		|ИЗ
		|	Справочник.ПогрузочнаяТехника КАК ПогрузочнаяТехника
		|ГДЕ
		|	ПогрузочнаяТехника.ВидПогрузочнойТехники.Наименование = ""Буксиры""
		|	И ПогрузочнаяТехника.ПометкаУдаления = ЛОЖЬ
		|	И ПогрузочнаяТехника.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПогрузочнойТехники.ВРаботе)";

	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("Дата", ДатаПолучения);
	ПараметрыЗапроса.Вставить("ДатаОтсечки", ДатаПолучения - 24 * 60 * 60);

	ПараметрыСервиса = Обработки.d3_v4.ПолучитьWebСервисУПП();
	ОбработкаРС = ПараметрыСервиса.Сервис.ВнешнийЗапрос(
		ТекстЗапроса,
		ЗначениеВСтрокуВнутр(ПараметрыЗапроса),
		ПараметрыСервиса.КодПроверки);
	ТаблицаУПП = ЗначениеИзСтрокиВнутр(ОбработкаРС);
	Если ТипЗнч(ТаблицаУПП) <> Тип("ТаблицаЗначений") Тогда
		ВызватьИсключение "УПП вернул данные, которые не удалось преобразовать в таблицу погрузочной техники.";
	КонецЕсли;

	Индекс = Новый Соответствие;
	Для Каждого СтрокаУПП Из ТаблицаУПП Цикл
		Идентификатор = ЧислоИдентификатораСкаут(СтрокаУПП.ИдентификаторСКАУТ);
		Если Идентификатор = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Индекс.Получить(Идентификатор) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Описание = Новый Структура;
		Описание.Вставить("Наименование", СокрЛП(Строка(СтрокаУПП.Погрузчик)));
		Описание.Вставить("ТипТехники", Лев(СокрЛП(Строка(СтрокаУПП.ВидПогрузочнойТехники)), 30));
		Описание.Вставить("Водитель", Лев(СокрЛП(Строка(СтрокаУПП.Водитель)), 100));
		Индекс.Вставить(Идентификатор, Описание);
	КонецЦикла;

	Возврат Индекс;

КонецФункции

Функция ПолучитьАктуальнуюТехникуУКТ()

	Индекс = Новый Соответствие;
	ТаблицаУКТ = Неопределено;
	Попытка
		ТекстЗапроса =
			"ВЫБРАТЬ
			|	ПогрузочнаяТехника.Наименование КАК Наименование,
			|	ПогрузочнаяТехника.СКАУТ_ИД КАК СКАУТ_ИД
			|ИЗ
			|	Справочник.ПогрузочнаяТехника КАК ПогрузочнаяТехника
			|ГДЕ
			|	ПогрузочнаяТехника.СКАУТ_ИД <> 0
			|	И НЕ ПогрузочнаяТехника.ПометкаУдаления";

		ПараметрыСервиса = Обработки.d3_v4.ПолучитьWebСервисУКТ();
		ОбработкаРС = ПараметрыСервиса.Сервис.ВнешнийЗапрос(
			ТекстЗапроса,
			ЗначениеВСтрокуВнутр(Новый Структура),
			ПараметрыСервиса.КодПроверки);
		ТаблицаУКТ = ЗначениеИзСтрокиВнутр(ОбработкаРС);
	Исключение
		Возврат Индекс;
	КонецПопытки;

	Если ТипЗнч(ТаблицаУКТ) <> Тип("ТаблицаЗначений") Тогда
		Возврат Индекс;
	КонецЕсли;

	Для Каждого СтрокаУКТ Из ТаблицаУКТ Цикл
		Идентификатор = ЧислоИдентификатораСкаут(СтрокаУКТ.СКАУТ_ИД);
		Если Идентификатор = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Индекс.Получить(Идентификатор) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ИмяТехники = СокрЛП(Строка(СтрокаУКТ.Наименование));
		Если ЗначениеЗаполнено(ИмяТехники) Тогда
			Индекс.Вставить(Идентификатор, ИмяТехники);
		КонецЕсли;
	КонецЦикла;

	Возврат Индекс;

КонецФункции

Функция ПолучитьКонтейнерыНаТехникеУКТ()

	Индекс = Новый Соответствие;
	ТаблицаУКТ = Неопределено;
	Попытка
		ТекстЗапроса =
			"ВЫБРАТЬ
			|	КонтейнерыНаТехникеВРаботе.Контейнер.Наименование КАК Контейнер,
			|	КонтейнерыНаТехникеВРаботе.Откуда.Наименование КАК Откуда,
			|	КонтейнерыНаТехникеВРаботе.Куда.Наименование КАК Куда,
			|	КонтейнерыНаТехникеВРаботе.Дата КАК Дата,
			|	КонтейнерыНаТехникеВРаботе.ПогрузочнаяТехника.СКАУТ_ИД КАК СКАУТ_ИД
			|ИЗ
			|	РегистрСведений.КонтейнерыНаТехникеВРаботе КАК КонтейнерыНаТехникеВРаботе
			|ГДЕ
			|	КонтейнерыНаТехникеВРаботе.ПогрузочнаяТехника.СКАУТ_ИД <> 0";

		ПараметрыСервиса = Обработки.d3_v4.ПолучитьWebСервисУКТ();
		ОбработкаРС = ПараметрыСервиса.Сервис.ВнешнийЗапрос(
			ТекстЗапроса,
			ЗначениеВСтрокуВнутр(Новый Структура),
			ПараметрыСервиса.КодПроверки);
		ТаблицаУКТ = ЗначениеИзСтрокиВнутр(ОбработкаРС);
	Исключение
		Возврат Индекс;
	КонецПопытки;

	Если ТипЗнч(ТаблицаУКТ) <> Тип("ТаблицаЗначений") Тогда
		Возврат Индекс;
	КонецЕсли;

	Для Каждого СтрокаУКТ Из ТаблицаУКТ Цикл
		Идентификатор = ЧислоИдентификатораСкаут(СтрокаУКТ.СКАУТ_ИД);
		Если Идентификатор = 0 Тогда
			Продолжить;
		КонецЕсли;

		Текст = СтрШаблон("%1: %2->%3 %4",
			СтрокаУКТ.Контейнер,
			СтрокаУКТ.Откуда,
			СтрокаУКТ.Куда,
			Формат(СтрокаУКТ.Дата, "ДФ=HH:mm:ss"));
		Существующий = Индекс.Получить(Идентификатор);
		Если Существующий = Неопределено Тогда
			Индекс.Вставить(Идентификатор, Лев(Текст, 100));
		Иначе
			Индекс.Вставить(Идентификатор, Лев(Существующий + "; " + Текст, 100));
		КонецЕсли;
	КонецЦикла;

	Возврат Индекс;

КонецФункции

Функция ЧислоИдентификатораСкаут(Значение)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Попытка
		Возврат Число(СокрЛП(Строка(Значение)));
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

Функция ОбновитьТокенАвторизации(ТаймаутСекунд)

	ЛогинСкаут = СокрЛП(Строка(Константы.ЛогинСкаут.Получить()));
	ПарольСкаут = Строка(Константы.ПарольСкаут.Получить());
	Если ПустаяСтрока(ЛогинСкаут) Тогда
		ВызватьИсключение "Не заполнена константа ""Логин Скаут"".";
	КонецЕсли;
	Если ПустаяСтрока(ПарольСкаут) Тогда
		ВызватьИсключение "Не заполнена константа ""Пароль Скаут"".";
	КонецЕсли;

	ТелоЗапроса = СтрШаблон(
		"grant_type=password&username=%1&password=%2",
		КодироватьСтроку(ЛогинСкаут, СпособКодированияСтроки.КодировкаURL),
		КодироватьСтроку(ПарольСкаут, СпособКодированияСтроки.КодировкаURL));

	Запрос = Новый HTTPЗапрос("/api/auth/token");
	Запрос.Заголовки.Вставить("Authorization", "Basic OGIxZmQ3MDQtMDk2ZS00MmQ2LTliYTUtNmQ5ODk4MGU3Y2QxOg==");
	Запрос.Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8);

	Ответ = СоединениеАпи(ТаймаутСекунд).ВызватьHTTPМетод("POST", Запрос);
	ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
	ПроверитьКодОтвета(Ответ, ТелоОтвета, "авторизации");

	Данные = ПрочитатьJSONИзСтроки(ТелоОтвета);
	Токен = ЗначениеПоля(Данные, "access_token");
	Если Не ЗначениеЗаполнено(Токен) Тогда
		ВызватьИсключение "Сервис Скаут не вернул токен авторизации.";
	КонецЕсли;

	Константы.ТокенСкаут.Установить(Токен);
	Возврат Токен;

КонецФункции

// Возвращаемое значение:
//  Структура:
//   * КодСостояния - Число - HTTP-код ответа Скаут.
//   * ТелоОтвета - Строка - тело ответа как есть.
//   * Таблица - ТаблицаЗначений - координаты техники.
Функция ЗапроситьНавигационныеДанные(Токен, ТаймаутСекунд)

	Адрес = "/api/v3/online-data/units-navigation";

	Запрос = Новый HTTPЗапрос(Адрес);
	Запрос.Заголовки.Вставить("Authorization", "Bearer " + Токен);

	Ответ = СоединениеАпи(ТаймаутСекунд).ВызватьHTTPМетод("GET", Запрос);
	ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();

	Результат = Новый Структура;
	Результат.Вставить("КодСостояния", Ответ.КодСостояния);
	Результат.Вставить("ТелоОтвета", Строка(ТелоОтвета));
	Результат.Вставить("Таблица", НоваяТаблицаКоординат());

	Если Ответ.КодСостояния = 401 Тогда
		Возврат Результат;
	КонецЕсли;
	Если Ответ.КодСостояния = 204 Или ПустаяСтрока(ТелоОтвета) Тогда
		Возврат Результат;
	КонецЕсли;
	Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
		Возврат Результат;
	КонецЕсли;

	Данные = ПрочитатьJSONИзСтроки(ТелоОтвета);
	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		ВызватьИсключение "Сервис Скаут вернул неожиданный формат координат.";
	КонецЕсли;

	Для Каждого Элемент Из Данные Цикл
		СтрокаТаблицы = Результат.Таблица.Добавить();
		СтрокаТаблицы.Идентификатор = ЧислоИзПоля(Элемент, "id");
		СтрокаТаблицы.Наименование = СтрокаИзПоля(Элемент, "unitName");
		СтрокаТаблицы.ГосНомер = СтрокаИзПоля(Элемент, "stateNumber");
		КодТипаТС = ЧислоИзПоля(Элемент, "unitType");
		СтрокаТаблицы.КодТипаТС = КодТипаТС;
		СтрокаТаблицы.ТипТС = ПредставлениеТипаТС(КодТипаТС);
		СтрокаТаблицы.Широта = ЧислоИзПоля(Элемент, "lat");
		СтрокаТаблицы.Долгота = ЧислоИзПоля(Элемент, "lon");
		СтрокаТаблицы.Азимут = ЧислоИзПоля(Элемент, "angle");
		СтрокаТаблицы.Скорость = ЧислоИзПоля(Элемент, "speed");
	КонецЦикла;

	Возврат Результат;

КонецФункции

