	Результат.ОстатокТоплива = ЧислоИлиНеопределено(ЗначениеПоля(Онлайн, "fuelLevel"));
	Результат.ДатаДанных = ДатаИлиНеопределено(ЗначениеПоля(Онлайн, "date"));
