
#Область ОписаниеПеременных

&НаКлиенте
Перем ИндексОбъектов;

&НаКлиенте
Перем ИндексЯчеек;

&НаКлиенте
Перем ДемоАктивно;

&НаКлиенте
Перем ИдентификаторДемоТягача;

&НаКлиенте
Перем КандидатыДемоЯчеек;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Сборка = ОбъектОбработки.СобратьHTMLСцены();

	HTML = Сборка.HTML;
	ДанныеСценыJSON = Сборка.ДанныеСценыJSON;
	SnapshotId = Сборка.SnapshotId;
	ВерсияДанных = 0;
	СостояниеОбмена = Сборка.СостояниеОбмена;
	КарточкаОбъекта = "Кликните ячейку или технику на плане";
	ПоискОбъекта = "";

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ДемоАктивно = Истина;
	ПостроитьИндексы();
	ПодготовитьДемоКэш();
	ПодключитьОбработчикОжидания("ШагДемонстрации", 1);
	СостояниеОбмена = "демо · тягач и изменение ячеек";

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	ОтключитьОбработчикОжидания("ШагДемонстрации");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура HTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Href = "";
	Попытка
		Если ДанныеСобытия.Href <> Неопределено Тогда
			Href = Строка(ДанныеСобытия.Href);
		КонецЕсли;
	Исключение
	КонецПопытки;

	Если СтрНайти(Href, "#pick:") = 0 Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;

	Узел = Неопределено;
	Попытка
		Узел = ДанныеСобытия.Anchor;
	Исключение
		Попытка
			Узел = ДанныеСобытия.Element;
		Исключение
			Узел = Неопределено;
		КонецПопытки;
	КонецПопытки;

	Если Узел = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Идентификатор = ПолучитьАтрибутHTML(Узел, "data-id");
	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	ВидОбъекта = ПолучитьАтрибутHTML(Узел, "data-kind");
	X = ЧислоИзАтрибута(Узел, "data-x");
	Y = ЧислоИзАтрибута(Узел, "data-y");

	Если ДемоАктивно И ВидОбъекта = "cell" Тогда
		Ячейка = НайтиЯчейкуВИндексе(Идентификатор);
		Если Ячейка <> Неопределено И Ячейка.count > 0 Тогда
			Попытка
				ОтправитьКомандуСцене(Новый Структура(
					"op,cell",
					"upsertCell",
					Новый Структура("id,count", Идентификатор, Ячейка.count - 1)));
				Ячейка.count = Ячейка.count - 1;
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	ОбработатьВыборОбъекта(Идентификатор, ВидОбъекта, X, Y, 0);

КонецПроцедуры

&НаКлиенте
Процедура ПоискОбъектаПриИзменении(Элемент)
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НайтиОбъект(Команда)

	Идентификатор = СокрЛП(ПоискОбъекта);
	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	Цель = НайтиЯчейкуВИндексе(Идентификатор);
	Если Цель = Неопределено Тогда
		Цель = НайтиОбъектВИндексе(Идентификатор);
	КонецЕсли;
	Если Цель = Неопределено Тогда
		КарточкаОбъекта = СтрШаблон("Объект %1 не найден", Идентификатор);
		Возврат;
	КонецЕсли;

	ОтправитьКомандуСцене(Новый Структура("op,id", "focus", Идентификатор));
	ОбработатьВыборОбъекта(Цель.id, ?(Цель.Свойство("kind"), Цель.kind, "cell"), Цель.x, Цель.y, 0);

КонецПроцедуры

&НаКлиенте
Процедура ПереключитьДемо(Команда)

	ДемоАктивно = Не ДемоАктивно;
	Если ДемоАктивно Тогда
		ПодготовитьДемоКэш();
		ПодключитьОбработчикОжидания("ШагДемонстрации", 1);
		СостояниеОбмена = "демо · тягач и изменение ячеек";
	Иначе
		ОтключитьОбработчикОжидания("ШагДемонстрации");
		СостояниеОбмена = "демо выключено · read-only";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура SpikeDelta100(Команда)

	ОбновленияЯчеек = Новый Массив;
	Счётчик = 0;
	Для Каждого КлючИЗначение Из ИндексЯчеек Цикл
		Ячейка = КлючИЗначение.Значение;
		НовыйCount = Ячейка.count + ?(Ячейка.count >= Ячейка.maxTier, -2, 1);
		Если НовыйCount < 0 Тогда
			НовыйCount = 0;
		КонецЕсли;
		ОбновленияЯчеек.Добавить(Новый Структура("id,count", Ячейка.id, НовыйCount));
		Счётчик = Счётчик + 1;
		Если Счётчик >= 100 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Delta = Новый Структура;
	Delta.Вставить("baseSnapshotId", SnapshotId);
	Delta.Вставить("version", ВерсияДанных + 1);
	Delta.Вставить("moves", Новый Массив);
	Delta.Вставить("cellUpserts", ОбновленияЯчеек);
	Delta.Вставить("upserts", Новый Массив);
	Delta.Вставить("removed", Новый Массив);
	Delta.Вставить("quality", Новый Массив);

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		ОтправитьКомандуСцене(Новый Структура("op,delta", "applyDelta", Delta));
		ВерсияДанных = ВерсияДанных + 1;
		Для Каждого Обновление Из ОбновленияЯчеек Цикл
			Ячейка = НайтиЯчейкуВИндексе(Обновление.id);
			Если Ячейка <> Неопределено Тогда
				Ячейка.count = Обновление.count;
			КонецЕсли;
		КонецЦикла;
		Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
		СостояниеОбмена = СтрШаблон(
			"spike cellUpserts %1 · %2 мс · v%3",
			ОбновленияЯчеек.Количество(), Длительность, ВерсияДанных);
	Исключение
		СостояниеОбмена = "spike ошибка: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПостроитьИндексы()

	ИндексОбъектов = Новый Соответствие;
	ИндексЯчеек = Новый Соответствие;
	//@skip-check bsl-legacy-check-type-environments
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ДанныеСценыJSON);
	//@skip-check undefined-function
	Сцена = ПрочитатьJSON(Чтение);
	Если Сцена = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Сцена.Свойство("objects") Тогда
		Для Каждого ОбъектСцены Из Сцена.objects Цикл
			ИндексОбъектов.Вставить(ОбъектСцены.id, ОбъектСцены);
		КонецЦикла;
	КонецЕсли;
	Если Сцена.Свойство("cells") Тогда
		Для Каждого Ячейка Из Сцена.cells Цикл
			ИндексЯчеек.Вставить(Ячейка.id, Ячейка);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПодготовитьДемоКэш()

	ИдентификаторДемоТягача = "TR-1";
	КандидатыДемоЯчеек = Новый Массив;
	Если ИндексЯчеек = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого КлючИЗначение Из ИндексЯчеек Цикл
		Ячейка = КлючИЗначение.Значение;
		Если Ячейка.count > 0 Тогда
			КандидатыДемоЯчеек.Добавить(Ячейка.id);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ШагДемонстрации()

	Если Не ДемоАктивно Тогда
		Возврат;
	КонецЕсли;

	Перемещения = Новый Массив;
	ОбновленияЯчеек = Новый Массив;

	Если Не ПустаяСтрока(ИдентификаторДемоТягача) Тогда
		Тягач = НайтиОбъектВИндексе(ИдентификаторДемоТягача);
		Если Тягач <> Неопределено Тогда
			УголВРадианах = Тягач.rotation * 3.141592653589793 / 180;
			// rotation = направление носа (локальная +X у иконки тягача).
			Перемещения.Добавить(Новый Структура(
				"id,x,y,z",
				Тягач.id,
				Тягач.x + Cos(УголВРадианах),
				Тягач.y + Sin(УголВРадианах),
				0));
		КонецЕсли;
	КонецЕсли;

	Если КандидатыДемоЯчеек <> Неопределено И КандидатыДемоЯчеек.Количество() > 0 Тогда
		ГСЧ = Новый ГенераторСлучайныхЧисел;
		Индекс = ГСЧ.СлучайноеЧисло(0, КандидатыДемоЯчеек.ВГраница());
		ИдЯчейки = КандидатыДемоЯчеек[Индекс];
		Ячейка = НайтиЯчейкуВИндексе(ИдЯчейки);
		Если Ячейка <> Неопределено И Ячейка.count > 0 Тогда
			ОбновленияЯчеек.Добавить(Новый Структура("id,count", Ячейка.id, Ячейка.count - 1));
		КонецЕсли;
		КандидатыДемоЯчеек.Удалить(Индекс);
	КонецЕсли;

	Если Перемещения.Количество() = 0 И ОбновленияЯчеек.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Delta = Новый Структура;
	Delta.Вставить("baseSnapshotId", SnapshotId);
	Delta.Вставить("version", ВерсияДанных + 1);
	Delta.Вставить("moves", Перемещения);
	Delta.Вставить("cellUpserts", ОбновленияЯчеек);
	Delta.Вставить("upserts", Новый Массив);
	Delta.Вставить("removed", Новый Массив);
	Delta.Вставить("quality", Новый Массив);

	Попытка
		ОтправитьКомандуСцене(Новый Структура("op,delta", "applyDelta", Delta));
		ВерсияДанных = ВерсияДанных + 1;
		Для Каждого Перемещение Из Перемещения Цикл
			ОбновитьПозициюВИндексе(Перемещение.id, Перемещение.x, Перемещение.y, Перемещение.z);
		КонецЦикла;
		Для Каждого Обновление Из ОбновленияЯчеек Цикл
			Ячейка = НайтиЯчейкуВИндексе(Обновление.id);
			Если Ячейка <> Неопределено Тогда
				Ячейка.count = Обновление.count;
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПозициюВИндексе(Идентификатор, X, Y, Z)

	ОбъектСцены = НайтиОбъектВИндексе(Идентификатор);
	Если ОбъектСцены = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОбъектСцены.x = X;
	ОбъектСцены.y = Y;
	Если ОбъектСцены.Свойство("z") Тогда
		ОбъектСцены.z = Z;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция НайтиОбъектВИндексе(Идентификатор)

	Если ИндексОбъектов = Неопределено Тогда
		ПостроитьИндексы();
	КонецЕсли;
	Возврат ИндексОбъектов.Получить(Идентификатор);

КонецФункции

&НаКлиенте
Функция НайтиЯчейкуВИндексе(Идентификатор)

	Если ИндексЯчеек = Неопределено Тогда
		ПостроитьИндексы();
	КонецЕсли;
	Возврат ИндексЯчеек.Получить(Идентификатор);

КонецФункции

&НаКлиенте
Функция ЧислоИзАтрибута(Узел, ИмяАтрибута)

	Текст = ПолучитьАтрибутHTML(Узел, ИмяАтрибута);
	Если ПустаяСтрока(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Текст);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

&НаКлиенте
Процедура ОтправитьКомандуСцене(Команда)

	Попытка
		ДокументHTML = Элементы.HTML.Документ;
		УзелКоманд = ДокументHTML.getElementById("scene-command-bridge");
	Исключение
		ВызватьИсключение "Не удалось получить доступ к документу плана.";
	КонецПопытки;

	Если УзелКоманд = Неопределено Тогда
		ВызватьИсключение "План ещё не готов принимать команды.";
	КонецЕсли;
	Если ПолучитьАтрибутHTML(УзелКоманд, "data-ready") <> "true" Тогда
		ВызватьИсключение "План ещё не завершил инициализацию.";
	КонецЕсли;

	НомерКоманды = 0;
	ПредыдущийНомерКоманды = ПолучитьАтрибутHTML(УзелКоманд, "data-seq");
	Если Не ПустаяСтрока(ПредыдущийНомерКоманды) Тогда
		Попытка
			НомерКоманды = Число(ПредыдущийНомерКоманды);
		Исключение
			НомерКоманды = 0;
		КонецПопытки;
	КонецЕсли;
	НомерКоманды = НомерКоманды + 1;
	СтрокаНомераКоманды = Строка(НомерКоманды);

	УзелКоманд.setAttribute("data-error", "");
	УзелКоманд.setAttribute("data-ack", "");
	УзелКоманд.setAttribute("data-payload", СериализоватьJSON(Команда));
	УзелКоманд.setAttribute("data-seq", СтрокаНомераКоманды);
	Попытка
		УзелКоманд.click();
	Исключение
		Попытка
			УзелКоманд.fireEvent("onclick");
		Исключение
			ВызватьИсключение "HTML-движок не поддерживает отправку команд на план.";
		КонецПопытки;
	КонецПопытки;

	Если ПолучитьАтрибутHTML(УзелКоманд, "data-ack") <> СтрокаНомераКоманды Тогда
		ВызватьИсключение "План не подтвердил применение команды.";
	КонецЕсли;
	ТекстОшибки = ПолучитьАтрибутHTML(УзелКоманд, "data-error");
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ВызватьИсключение "Ошибка изменения плана: " + ТекстОшибки;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция СериализоватьJSON(Значение)

	//@skip-check bsl-legacy-check-type-environments
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	//@skip-check undefined-function-or-procedure
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

&НаКлиенте
Функция ПолучитьАтрибутHTML(Узел, ИмяАтрибута)

	Попытка
		Значение = Узел.getAttribute(ИмяАтрибута);
		Если Значение = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Возврат Строка(Значение);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

&НаКлиенте
Процедура ОбработатьВыборОбъекта(Идентификатор, ВидОбъекта, X, Y, Z) Экспорт

	Если ВидОбъекта = "cell" Тогда
		Ячейка = НайтиЯчейкуВИндексе(Идентификатор);
		Если Ячейка = Неопределено Тогда
			КарточкаОбъекта = СтрШаблон("Ячейка %1", Идентификатор);
			Возврат;
		КонецЕсли;
		КарточкаОбъекта = СтрШаблон(
			"Ячейка %1%2Блок %3 · row %4 · bay %5%2Контейнеров: %6 / max %7%2Координаты: %8, %9 м",
			Ячейка.id, Символы.ПС,
			Ячейка.blockId, Ячейка.row, Ячейка.bay,
			Ячейка.count, Ячейка.maxTier,
			Формат(Ячейка.x, "ЧДЦ=2"), Формат(Ячейка.y, "ЧДЦ=2"));
		Возврат;
	КонецЕсли;

	ОбъектСцены = НайтиОбъектВИндексе(Идентификатор);
	Если ОбъектСцены = Неопределено Тогда
		КарточкаОбъекта = СтрШаблон("%1 (%2) · X=%3 Y=%4", Идентификатор, ВидОбъекта, X, Y);
		Возврат;
	КонецЕсли;

	Если ОбъектСцены.kind = "vessel" Тогда
		ДлинаСудна = 0;
		Если ОбъектСцены.Свойство("length") Тогда
			ДлинаСудна = ОбъектСцены.length;
		ИначеЕсли ОбъектСцены.Свойство("size") И ОбъектСцены.size.Свойство("length") Тогда
			ДлинаСудна = ОбъектСцены.size.length;
		КонецЕсли;
		КарточкаОбъекта = СтрШаблон(
			"%1 · судно%2%3Длина: %4 м%2Координаты: %5, %6 м",
			ОбъектСцены.name, Символы.ПС, ОбъектСцены.id + Символы.ПС,
			Формат(ДлинаСудна, "ЧДЦ=0"),
			Формат(ОбъектСцены.x, "ЧДЦ=2"), Формат(ОбъектСцены.y, "ЧДЦ=2"));
		Возврат;
	КонецЕсли;

	Если ОбъектСцены.kind = "craneSts" Тогда
		Привязка = "";
		Если ОбъектСцены.Свойство("vesselId") И Не ПустаяСтрока(ОбъектСцены.vesselId) Тогда
			Привязка = СтрШаблон("%1Судно: %2", Символы.ПС, ОбъектСцены.vesselId);
		КонецЕсли;
		КарточкаОбъекта = СтрШаблон(
			"%1 · STS (причальный)%2%3Координаты: %4, %5 м%6",
			ОбъектСцены.name, Символы.ПС, ОбъектСцены.id + Символы.ПС,
			Формат(ОбъектСцены.x, "ЧДЦ=2"), Формат(ОбъектСцены.y, "ЧДЦ=2"),
			Привязка);
		Возврат;
	КонецЕсли;

	КарточкаОбъекта = СтрШаблон(
		"%1 · %2%3Координаты: %4, %5 м",
		ОбъектСцены.id, ОбъектСцены.kind, Символы.ПС,
		Формат(ОбъектСцены.x, "ЧДЦ=2"), Формат(ОбъектСцены.y, "ЧДЦ=2"));

КонецПроцедуры

