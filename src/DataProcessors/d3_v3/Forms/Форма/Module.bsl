
#Область ОписаниеПеременных

&НаКлиенте
Перем ИндексОбъектов;

&НаКлиенте
Перем ИндексЯчеек;

&НаКлиенте
Перем ИндексРазмещений;

&НаКлиенте
Перем ТопологияБлоков;

&НаКлиенте
Перем ДемоАктивно;

&НаКлиенте
Перем ИдентификаторДемоТягача;

&НаКлиенте
Перем КандидатыДемоРазмещений;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Сборка = ОбъектОбработки.СобратьHTMLСцены();

	HTML = Сборка.HTML;
	ДанныеСценыJSON = Сборка.ДанныеСценыJSON;
	SnapshotId = Сборка.SnapshotId;
	ВерсияДанных = 0;
	СостояниеОбмена = Сборка.СостояниеОбмена;
	КарточкаОбъекта = "Кликните ячейку или технику на плане";
	ПоискОбъекта = "";

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ДемоАктивно = Истина;
	ПостроитьИндексы();
	ПодготовитьДемоКэш();
	ПодключитьОбработчикОжидания("ШагДемонстрации", 1);
	СостояниеОбмена = "демо · тягач и размещения 20/40 ft";

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	ОтключитьОбработчикОжидания("ШагДемонстрации");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура HTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Href = "";
	Попытка
		Если ДанныеСобытия.Href <> Неопределено Тогда
			Href = Строка(ДанныеСобытия.Href);
		КонецЕсли;
	Исключение
	КонецПопытки;

	Если СтрНайти(Href, "#pick:") = 0 Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;

	Узел = Неопределено;
	Попытка
		Узел = ДанныеСобытия.Anchor;
	Исключение
		Попытка
			Узел = ДанныеСобытия.Element;
		Исключение
			Узел = Неопределено;
		КонецПопытки;
	КонецПопытки;

	Если Узел = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Идентификатор = ПолучитьАтрибутHTML(Узел, "data-id");
	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	ВидОбъекта = ПолучитьАтрибутHTML(Узел, "data-kind");
	X = ЧислоИзАтрибута(Узел, "data-x");
	Y = ЧислоИзАтрибута(Узел, "data-y");

	Если ДемоАктивно И (ВидОбъекта = "placement" Или ВидОбъекта = "cell") Тогда
		Размещение = Неопределено;
		Если ВидОбъекта = "placement" Тогда
			Размещение = НайтиРазмещениеВИндексе(Идентификатор);
		Иначе
			Размещение = ВерхнееРазмещениеЯчейки(Идентификатор);
		КонецЕсли;
		Если Размещение <> Неопределено Тогда
			Попытка
				УдалитьРазмещениеАтомарно(Размещение.id);
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	ОбработатьВыборОбъекта(Идентификатор, ВидОбъекта, X, Y, 0);

КонецПроцедуры

&НаКлиенте
Процедура ПоискОбъектаПриИзменении(Элемент)
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НайтиОбъект(Команда)

	Идентификатор = СокрЛП(ПоискОбъекта);
	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	Цель = НайтиРазмещениеВИндексе(Идентификатор);
	Вид = "placement";
	Если Цель = Неопределено Тогда
		Цель = НайтиЯчейкуВИндексе(Идентификатор);
		Вид = "cell";
	КонецЕсли;
	Если Цель = Неопределено Тогда
		Цель = НайтиОбъектВИндексе(Идентификатор);
		Вид = ?(Цель = Неопределено, "", Цель.kind);
	КонецЕсли;
	Если Цель = Неопределено Тогда
		КарточкаОбъекта = СтрШаблон("Объект %1 не найден", Идентификатор);
		Возврат;
	КонецЕсли;

	ОтправитьКомандуСцене(Новый Структура("op,id", "focus", Идентификатор));
	X = 0;
	Y = 0;
	Если Цель.Свойство("x") Тогда
		X = Цель.x;
	КонецЕсли;
	Если Цель.Свойство("y") Тогда
		Y = Цель.y;
	КонецЕсли;
	ОбработатьВыборОбъекта(Цель.id, Вид, X, Y, 0);

КонецПроцедуры

&НаКлиенте
Процедура ПереключитьДемо(Команда)

	ДемоАктивно = Не ДемоАктивно;
	Если ДемоАктивно Тогда
		ПодготовитьДемоКэш();
		ПодключитьОбработчикОжидания("ШагДемонстрации", 1);
		СостояниеОбмена = "демо · тягач и размещения 20/40 ft";
	Иначе
		ОтключитьОбработчикОжидания("ШагДемонстрации");
		СостояниеОбмена = "демо выключено · read-only";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура SpikeDelta100(Команда)

	Удаления = Новый Массив;
	Счётчик = 0;
	Если КандидатыДемоРазмещений = Неопределено Или КандидатыДемоРазмещений.Количество() = 0 Тогда
		ПодготовитьДемоКэш();
	КонецЕсли;
	Пока Счётчик < 100 И КандидатыДемоРазмещений <> Неопределено
		И КандидатыДемоРазмещений.Количество() > 0 Цикл
		Удаления.Добавить(КандидатыДемоРазмещений[0]);
		КандидатыДемоРазмещений.Удалить(0);
		Счётчик = Счётчик + 1;
	КонецЦикла;

	Delta = Новый Структура;
	Delta.Вставить("baseSnapshotId", SnapshotId);
	Delta.Вставить("version", ВерсияДанных + 1);
	Delta.Вставить("moves", Новый Массив);
	Delta.Вставить("placementUpserts", Новый Массив);
	Delta.Вставить("placementRemoved", Удаления);
	Delta.Вставить("cellUpserts", Новый Массив);
	Delta.Вставить("upserts", Новый Массив);
	Delta.Вставить("removed", Новый Массив);
	Delta.Вставить("quality", Новый Массив);

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		ОтправитьКомандуСцене(Новый Структура("op,delta", "applyDelta", Delta));
		ВерсияДанных = ВерсияДанных + 1;
		Для Каждого ИдРазмещения Из Удаления Цикл
			УбратьРазмещениеИзИндекса(ИдРазмещения, Ложь);
		КонецЦикла;
		Для Каждого КлючЯчейка Из ИндексЯчеек Цикл
			КлючЯчейка.Значение.count = 0;
		КонецЦикла;
		Для Каждого КлючРазмещение Из ИндексРазмещений Цикл
			ОбновитьВысотуЯчеекРазмещения(КлючРазмещение.Значение, Истина);
		КонецЦикла;
		ПодготовитьДемоКэш();
		Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
		СостояниеОбмена = СтрШаблон(
			"spike placementRemoved %1 · %2 мс · v%3",
			Удаления.Количество(), Длительность, ВерсияДанных);
	Исключение
		СостояниеОбмена = "spike ошибка: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПостроитьИндексы()

	ИндексОбъектов = Новый Соответствие;
	ИндексЯчеек = Новый Соответствие;
	ИндексРазмещений = Новый Соответствие;
	ТопологияБлоков = Новый Соответствие;
	//@skip-check bsl-legacy-check-type-environments
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ДанныеСценыJSON);
	//@skip-check undefined-function
	Сцена = ПрочитатьJSON(Чтение);
	Если Сцена = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Сцена.Свойство("topology") И Сцена.topology.Свойство("blocks") Тогда
		Для Каждого Блок Из Сцена.topology.blocks Цикл
			ТопологияБлоков.Вставить(Блок.id, Блок);
		КонецЦикла;
	КонецЕсли;

	Если Сцена.Свойство("objects") Тогда
		Для Каждого ОбъектСцены Из Сцена.objects Цикл
			ИндексОбъектов.Вставить(ОбъектСцены.id, ОбъектСцены);
		КонецЦикла;
	КонецЕсли;

	Если Сцена.Свойство("placements") Тогда
		Для Каждого Размещение Из Сцена.placements Цикл
			ИндексРазмещений.Вставить(Размещение.id, Размещение);
			ОбновитьВысотуЯчеекРазмещения(Размещение, Истина);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ОбеспечитьЯчейку(Блок, Row, Bay)

	Ид = СтрШаблон("%1:%2:%3", Блок.id, Row, Bay);
	Существующая = ИндексЯчеек.Получить(Ид);
	Если Существующая <> Неопределено Тогда
		Возврат Существующая;
	КонецЕсли;
	Слот = КоординатыСлотаКлиент(Блок, Row, Bay);
	Ячейка = Новый Структура(
		"id,kind,blockId,row,bay,count,maxTier,x,y,rotation",
		Ид, "cell", Блок.id, Row, Bay, 0, Блок.maxTier,
		Слот.x, Слот.y, Слот.rotation);
	ИндексЯчеек.Вставить(Ид, Ячейка);
	Возврат Ячейка;

КонецФункции

&НаКлиенте
Функция КоординатыСлотаКлиент(Блок, Row, Bay)

	Угол = 0;
	Если Блок.Свойство("rotationDeg") Тогда
		Угол = Блок.rotationDeg;
	КонецЕсли;
	Радианы = Угол * 3.141592653589793 / 180;
	CosУ = Cos(Радианы);
	SinУ = Sin(Радианы);
	ЛокX = (Bay - 1) * Блок.bayPitch;
	ЛокY = (Row - 1) * Блок.rowPitch;
	Возврат Новый Структура("x,y,rotation",
		Блок.originX + ЛокX * CosУ - ЛокY * SinУ,
		Блок.originY + ЛокX * SinУ + ЛокY * CosУ,
		Угол);

КонецФункции

&НаКлиенте
Процедура ОбновитьВысотуЯчеекРазмещения(Размещение, ПриДобавлении)

	Если Не Размещение.Свойство("cellIds") Тогда
		Возврат;
	КонецЕсли;
	Блок = ТопологияБлоков.Получить(Размещение.blockId);
	Смещение = 0;
	Для Каждого ИдЯчейки Из Размещение.cellIds Цикл
		Ячейка = ИндексЯчеек.Получить(ИдЯчейки);
		Если Ячейка = Неопределено И Блок <> Неопределено Тогда
			Ячейка = ОбеспечитьЯчейку(Блок, Размещение.row, Размещение.bay + Смещение);
		КонецЕсли;
		Смещение = Смещение + 1;
		Если Ячейка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ПриДобавлении Тогда
			Если Размещение.tier > Ячейка.count Тогда
				Ячейка.count = Размещение.tier;
			КонецЕсли;
		Иначе
			Ячейка.count = ВысотаЯчейкиПоРазмещениям(ИдЯчейки);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ВысотаЯчейкиПоРазмещениям(ИдЯчейки)

	МаксЯрус = 0;
	Для Каждого КлючИЗначение Из ИндексРазмещений Цикл
		Размещение = КлючИЗначение.Значение;
		Если Не Размещение.Свойство("cellIds") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Ид Из Размещение.cellIds Цикл
			Если Ид = ИдЯчейки И Размещение.tier > МаксЯрус Тогда
				МаксЯрус = Размещение.tier;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат МаксЯрус;

КонецФункции

&НаКлиенте
Процедура ПодготовитьДемоКэш()

	ИдентификаторДемоТягача = "TR-1";
	КандидатыДемоРазмещений = Новый Массив;
	Если ИндексРазмещений = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// O(placements): верхнее = tier совпадает с count якорной ячейки.
	УжеДобавлены = Новый Соответствие;
	Для Каждого КлючИЗначение Из ИндексРазмещений Цикл
		Размещение = КлючИЗначение.Значение;
		Если Не Размещение.Свойство("cellIds") Или Размещение.cellIds.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Ячейка = ИндексЯчеек.Получить(Размещение.cellIds[0]);
		Если Ячейка = Неопределено Или Ячейка.count <> Размещение.tier Тогда
			Продолжить;
		КонецЕсли;
		Если УжеДобавлены.Получить(Размещение.id) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УжеДобавлены.Вставить(Размещение.id, Истина);
		КандидатыДемоРазмещений.Добавить(Размещение.id);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ШагДемонстрации()

	Если Не ДемоАктивно Тогда
		Возврат;
	КонецЕсли;

	Перемещения = Новый Массив;
	Удаления = Новый Массив;

	Если Не ПустаяСтрока(ИдентификаторДемоТягача) Тогда
		Тягач = НайтиОбъектВИндексе(ИдентификаторДемоТягача);
		Если Тягач <> Неопределено Тогда
			УголВРадианах = Тягач.rotation * 3.141592653589793 / 180;
			Перемещения.Добавить(Новый Структура(
				"id,x,y,z",
				Тягач.id,
				Тягач.x + Cos(УголВРадианах),
				Тягач.y + Sin(УголВРадианах),
				0));
		КонецЕсли;
	КонецЕсли;

	Если КандидатыДемоРазмещений <> Неопределено И КандидатыДемоРазмещений.Количество() > 0 Тогда
		ГСЧ = Новый ГенераторСлучайныхЧисел;
		Индекс = ГСЧ.СлучайноеЧисло(0, КандидатыДемоРазмещений.ВГраница());
		ИдРазмещения = КандидатыДемоРазмещений[Индекс];
		Если НайтиРазмещениеВИндексе(ИдРазмещения) <> Неопределено Тогда
			Удаления.Добавить(ИдРазмещения);
		КонецЕсли;
		КандидатыДемоРазмещений.Удалить(Индекс);
	КонецЕсли;

	Если Перемещения.Количество() = 0 И Удаления.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Delta = Новый Структура;
	Delta.Вставить("baseSnapshotId", SnapshotId);
	Delta.Вставить("version", ВерсияДанных + 1);
	Delta.Вставить("moves", Перемещения);
	Delta.Вставить("placementUpserts", Новый Массив);
	Delta.Вставить("placementRemoved", Удаления);
	Delta.Вставить("cellUpserts", Новый Массив);
	Delta.Вставить("upserts", Новый Массив);
	Delta.Вставить("removed", Новый Массив);
	Delta.Вставить("quality", Новый Массив);

	Попытка
		ОтправитьКомандуСцене(Новый Структура("op,delta", "applyDelta", Delta));
		ВерсияДанных = ВерсияДанных + 1;
		Для Каждого Перемещение Из Перемещения Цикл
			ОбновитьПозициюВИндексе(Перемещение.id, Перемещение.x, Перемещение.y, Перемещение.z);
		КонецЦикла;
		ЗатронутыеЯчейки = Новый Соответствие;
		Для Каждого ИдРазмещения Из Удаления Цикл
			Размещение = НайтиРазмещениеВИндексе(ИдРазмещения);
			Если Размещение <> Неопределено И Размещение.Свойство("cellIds") Тогда
				Для Каждого ИдЯчейки Из Размещение.cellIds Цикл
					ЗатронутыеЯчейки.Вставить(ИдЯчейки, Истина);
				КонецЦикла;
			КонецЕсли;
			УбратьРазмещениеИзИндекса(ИдРазмещения, Ложь);
		КонецЦикла;
		Для Каждого КлючЯчейка Из ЗатронутыеЯчейки Цикл
			Ячейка = ИндексЯчеек.Получить(КлючЯчейка.Ключ);
			Если Ячейка <> Неопределено Тогда
				Ячейка.count = ВысотаЯчейкиПоРазмещениям(КлючЯчейка.Ключ);
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура УдалитьРазмещениеАтомарно(Идентификатор)

	Delta = Новый Структура;
	Delta.Вставить("baseSnapshotId", SnapshotId);
	Delta.Вставить("version", ВерсияДанных + 1);
	Delta.Вставить("moves", Новый Массив);
	Delta.Вставить("placementUpserts", Новый Массив);
	Удалённые = Новый Массив;
	Удалённые.Добавить(Идентификатор);
	Delta.Вставить("placementRemoved", Удалённые);
	Delta.Вставить("cellUpserts", Новый Массив);
	Delta.Вставить("upserts", Новый Массив);
	Delta.Вставить("removed", Новый Массив);
	Delta.Вставить("quality", Новый Массив);

	ОтправитьКомандуСцене(Новый Структура("op,delta", "applyDelta", Delta));
	ВерсияДанных = ВерсияДанных + 1;
	УбратьРазмещениеИзИндекса(Идентификатор);

КонецПроцедуры

&НаКлиенте
Процедура УбратьРазмещениеИзИндекса(Идентификатор, ПересчитатьВысоту = Истина)

	Размещение = НайтиРазмещениеВИндексе(Идентификатор);
	Если Размещение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИндексРазмещений.Удалить(Идентификатор);
	Если ПересчитатьВысоту Тогда
		ОбновитьВысотуЯчеекРазмещения(Размещение, Ложь);
	ИначеЕсли Размещение.Свойство("cellIds") Тогда
		// высоты пересчитаем пакетом снаружи
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПозициюВИндексе(Идентификатор, X, Y, Z)

	ОбъектСцены = НайтиОбъектВИндексе(Идентификатор);
	Если ОбъектСцены = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОбъектСцены.x = X;
	ОбъектСцены.y = Y;
	Если ОбъектСцены.Свойство("z") Тогда
		ОбъектСцены.z = Z;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция НайтиОбъектВИндексе(Идентификатор)

	Если ИндексОбъектов = Неопределено Тогда
		ПостроитьИндексы();
	КонецЕсли;
	Возврат ИндексОбъектов.Получить(Идентификатор);

КонецФункции

&НаКлиенте
Функция НайтиЯчейкуВИндексе(Идентификатор)

	Если ИндексЯчеек = Неопределено Тогда
		ПостроитьИндексы();
	КонецЕсли;
	Возврат ИндексЯчеек.Получить(Идентификатор);

КонецФункции

&НаКлиенте
Функция НайтиРазмещениеВИндексе(Идентификатор)

	Если ИндексРазмещений = Неопределено Тогда
		ПостроитьИндексы();
	КонецЕсли;
	Возврат ИндексРазмещений.Получить(Идентификатор);

КонецФункции

&НаКлиенте
Функция ВерхнееРазмещениеЯчейки(ИдЯчейки)

	Ячейка = НайтиЯчейкуВИндексе(ИдЯчейки);
	Если Ячейка = Неопределено Или Ячейка.count <= 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Лучшее = Неопределено;
	Для Каждого КлючИЗначение Из ИндексРазмещений Цикл
		Размещение = КлючИЗначение.Значение;
		Если Не Размещение.Свойство("cellIds") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Ид Из Размещение.cellIds Цикл
			Если Ид = ИдЯчейки Тогда
				Если Лучшее = Неопределено Или Размещение.tier > Лучшее.tier Тогда
					Лучшее = Размещение;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Лучшее;

КонецФункции

&НаКлиенте
Функция ЧислоИзАтрибута(Узел, ИмяАтрибута)

	Текст = ПолучитьАтрибутHTML(Узел, ИмяАтрибута);
	Если ПустаяСтрока(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Текст);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

&НаКлиенте
Процедура ОтправитьКомандуСцене(Команда)

	Попытка
		ДокументHTML = Элементы.HTML.Документ;
		УзелКоманд = ДокументHTML.getElementById("scene-command-bridge");
	Исключение
		ВызватьИсключение "Не удалось получить доступ к документу плана.";
	КонецПопытки;

	Если УзелКоманд = Неопределено Тогда
		ВызватьИсключение "План ещё не готов принимать команды.";
	КонецЕсли;
	Если ПолучитьАтрибутHTML(УзелКоманд, "data-ready") <> "true" Тогда
		ВызватьИсключение "План ещё не завершил инициализацию.";
	КонецЕсли;

	НомерКоманды = 0;
	ПредыдущийНомерКоманды = ПолучитьАтрибутHTML(УзелКоманд, "data-seq");
	Если Не ПустаяСтрока(ПредыдущийНомерКоманды) Тогда
		Попытка
			НомерКоманды = Число(ПредыдущийНомерКоманды);
		Исключение
			НомерКоманды = 0;
		КонецПопытки;
	КонецЕсли;
	НомерКоманды = НомерКоманды + 1;
	СтрокаНомераКоманды = Строка(НомерКоманды);

	УзелКоманд.setAttribute("data-error", "");
	УзелКоманд.setAttribute("data-ack", "");
	УзелКоманд.setAttribute("data-payload", СериализоватьJSON(Команда));
	УзелКоманд.setAttribute("data-seq", СтрокаНомераКоманды);
	Попытка
		УзелКоманд.click();
	Исключение
		Попытка
			УзелКоманд.fireEvent("onclick");
		Исключение
			ВызватьИсключение "HTML-движок не поддерживает отправку команд на план.";
		КонецПопытки;
	КонецПопытки;

	Если ПолучитьАтрибутHTML(УзелКоманд, "data-ack") <> СтрокаНомераКоманды Тогда
		ВызватьИсключение "План не подтвердил применение команды.";
	КонецЕсли;
	ТекстОшибки = ПолучитьАтрибутHTML(УзелКоманд, "data-error");
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ВызватьИсключение "Ошибка изменения плана: " + ТекстОшибки;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция СериализоватьJSON(Значение)

	//@skip-check bsl-legacy-check-type-environments
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	//@skip-check undefined-function-or-procedure
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

&НаКлиенте
Функция ПолучитьАтрибутHTML(Узел, ИмяАтрибута)

	Попытка
		Значение = Узел.getAttribute(ИмяАтрибута);
		Если Значение = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Возврат Строка(Значение);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

&НаКлиенте
Процедура ОбработатьВыборОбъекта(Идентификатор, ВидОбъекта, X, Y, Z) Экспорт

	Если ВидОбъекта = "placement" Тогда
		Размещение = НайтиРазмещениеВИндексе(Идентификатор);
		Если Размещение = Неопределено Тогда
			КарточкаОбъекта = СтрШаблон("Размещение %1", Идентификатор);
			Возврат;
		КонецЕсли;
		ЯчейкиТекст = "";
		Если Размещение.Свойство("cellIds") Тогда
			ЯчейкиТекст = СтрСоединить(Размещение.cellIds, ", ");
		КонецЕсли;
		КарточкаОбъекта = СтрШаблон(
			"Контейнер %1%2%3 ft · ярус %4%2Блок %5 · row %6 · bay %7%2Ячейки: %8",
			Размещение.id, Символы.ПС,
			Размещение.lengthFt, Размещение.tier,
			Размещение.blockId, Размещение.row, Размещение.bay,
			ЯчейкиТекст);
		Возврат;
	КонецЕсли;

	Если ВидОбъекта = "cell" Тогда
		Ячейка = НайтиЯчейкуВИндексе(Идентификатор);
		Если Ячейка = Неопределено Тогда
			КарточкаОбъекта = СтрШаблон("Ячейка %1", Идентификатор);
			Возврат;
		КонецЕсли;
		Верх = ВерхнееРазмещениеЯчейки(Идентификатор);
		Доп = "";
		Если Верх <> Неопределено Тогда
			Доп = СтрШаблон("%1Верх: %2 (%3 ft, tier %4)",
				Символы.ПС, Верх.id, Верх.lengthFt, Верх.tier);
		КонецЕсли;
		КарточкаОбъекта = СтрШаблон(
			"Ячейка %1 (20 ft)%2Блок %3 · row %4 · bay %5%2Высота: %6 / max %7%2Координаты: %8, %9 м%10",
			Ячейка.id, Символы.ПС,
			Ячейка.blockId, Ячейка.row, Ячейка.bay,
			Ячейка.count, Ячейка.maxTier,
			Формат(Ячейка.x, "ЧДЦ=2"), Формат(Ячейка.y, "ЧДЦ=2"),
			Доп);
		Возврат;
	КонецЕсли;

	ОбъектСцены = НайтиОбъектВИндексе(Идентификатор);
	Если ОбъектСцены = Неопределено Тогда
		КарточкаОбъекта = СтрШаблон("%1 (%2) · X=%3 Y=%4", Идентификатор, ВидОбъекта, X, Y);
		Возврат;
	КонецЕсли;

	Если ОбъектСцены.kind = "vessel" Тогда
		ДлинаСудна = 0;
		Если ОбъектСцены.Свойство("length") Тогда
			ДлинаСудна = ОбъектСцены.length;
		ИначеЕсли ОбъектСцены.Свойство("size") И ОбъектСцены.size.Свойство("length") Тогда
			ДлинаСудна = ОбъектСцены.size.length;
		КонецЕсли;
		КарточкаОбъекта = СтрШаблон(
			"%1 · судно%2%3Длина: %4 м%2Координаты: %5, %6 м",
			ОбъектСцены.name, Символы.ПС, ОбъектСцены.id + Символы.ПС,
			Формат(ДлинаСудна, "ЧДЦ=0"),
			Формат(ОбъектСцены.x, "ЧДЦ=2"), Формат(ОбъектСцены.y, "ЧДЦ=2"));
		Возврат;
	КонецЕсли;

	Если ОбъектСцены.kind = "craneSts" Тогда
		Привязка = "";
		Если ОбъектСцены.Свойство("vesselId") И Не ПустаяСтрока(ОбъектСцены.vesselId) Тогда
			Привязка = СтрШаблон("%1Судно: %2", Символы.ПС, ОбъектСцены.vesselId);
		КонецЕсли;
		КарточкаОбъекта = СтрШаблон(
			"%1 · STS (причальный)%2%3Координаты: %4, %5 м%6",
			ОбъектСцены.name, Символы.ПС, ОбъектСцены.id + Символы.ПС,
			Формат(ОбъектСцены.x, "ЧДЦ=2"), Формат(ОбъектСцены.y, "ЧДЦ=2"),
			Привязка);
		Возврат;
	КонецЕсли;

	КарточкаОбъекта = СтрШаблон(
		"%1 · %2%3Координаты: %4, %5 м",
		ОбъектСцены.id, ОбъектСцены.kind, Символы.ПС,
		Формат(ОбъектСцены.x, "ЧДЦ=2"), Формат(ОбъектСцены.y, "ЧДЦ=2"));

КонецПроцедуры

#КонецОбласти
