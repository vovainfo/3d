Процедура ДобавитьИнфраструктуруДемо(Объекты, МассивЦветов)

	// Суда у причала (в акватории) и STS на кромке берега.
	ДобавитьСудаИСтс(Объекты);

	// Склады у нижнего края; ж/д чуть выше них; техника между площадками и путём.
	Для НомерСклада = 1 По 4 Цикл
		Если НомерСклада = 1 Тогда
			XСклада = 80; YСклада = 598; УголСклада = 0;
			ДлинаСклада = 110; ШиринаСклада = 32; ЦветСклада = "#64748b";
		ИначеЕсли НомерСклада = 2 Тогда
			XСклада = 220; YСклада = 595; УголСклада = 8;
			ДлинаСклада = 95; ШиринаСклада = 34; ЦветСклада = "#6b7280";
		ИначеЕсли НомерСклада = 3 Тогда
			XСклада = 380; YСклада = 598; УголСклада = -10;
			ДлинаСклада = 120; ШиринаСклада = 30; ЦветСклада = "#526579";
		Иначе
			XСклада = 560; YСклада = 590; УголСклада = 90;
			ДлинаСклада = 70; ШиринаСклада = 48; ЦветСклада = "#737b88";
		КонецЕсли;
		Объекты.Добавить(Новый Структура(
			"id,kind,name,x,y,z,rotation,color,size",
			СтрШаблон("W-%1", НомерСклада), "warehouse",
			СтрШаблон("Склад %1", НомерСклада),
			XСклада, YСклада, 0, УголСклада, ЦветСклада,
			Новый Структура("length,width", ДлинаСклада, ШиринаСклада)));
	КонецЦикла;

	Для НомерКрана = 1 По 2 Цикл
		Объекты.Добавить(Новый Структура(
			"id,kind,name,x,y,z,rotation,color,size",
			СтрШаблон("CR-RTG-%1", НомерКрана), "craneRtg",
			СтрШаблон("Козловой кран RTG %1", НомерКрана),
			?(НомерКрана = 1, 130, 520), ?(НомерКрана = 1, 410, 320), 0,
			?(НомерКрана = 1, 0, 45), "#ffd000",
			Новый Структура("span,length", 32, 22)));
		Объекты.Добавить(Новый Структура(
			"id,kind,name,x,y,z,rotation,color",
			СтрШаблон("CR-RS-%1", НомерКрана), "craneReachStacker",
			СтрШаблон("Ричстакер %1", НомерКрана),
			?(НомерКрана = 1, 250, 580), ?(НомерКрана = 1, 450, 380), 0,
			?(НомерКрана = 1, 200, 300), "#e39b00"));
		Объекты.Добавить(Новый Структура(
			"id,kind,name,x,y,z,rotation,color",
			СтрШаблон("CR-MOB-%1", НомерКрана), "craneMobile",
			СтрШаблон("Мобильный кран %1", НомерКрана),
			?(НомерКрана = 1, 50, 400), ?(НомерКрана = 1, 520, 420), 0,
			?(НомерКрана = 1, 15, 200), "#d9a400"));
	КонецЦикла;

	Для НомерТягача = 1 По 4 Цикл
		Тягач = Новый Структура(
			"id,kind,name,x,y,z,rotation,color,load",
			СтрШаблон("TR-%1", НомерТягача), "containerTruck",
			СтрШаблон("Контейнеровоз %1", НомерТягача),
			90 + (НомерТягача - 1) * 140, 500, 0,
			(НомерТягача - 1) * 45,
			МассивЦветов[НомерТягача - 1],
			?(НомерТягача = 3, "none", ?(НомерТягача = 2, "container20", "container40")));
		Объекты.Добавить(Тягач);
	КонецЦикла;

	YПути = 545;
	Объекты.Добавить(Новый Структура(
		"id,kind,name,x,y,z,rotation,color,size",
		"RW-001", "railway", "Железнодорожный путь",
		360, YПути, 0, 0, "#6b7280",
		Новый Структура("length", 640)));
	Объекты.Добавить(Новый Структура(
		"id,kind,name,x,y,z,rotation,color",
		"LOCO-001", "dieselLocomotive", "Тепловоз",
		250, YПути, 0, 0, "#d46b00"));
	Объекты.Добавить(Новый Структура(
		"id,kind,name,x,y,z,rotation,color,size",
		"WGN-FLAT-001", "wagonFlatcar", "Фитинговая платформа",
		268, YПути, 0, 0, "#4b5563",
		Новый Структура("length", 14.2)));
	Объекты.Добавить(Новый Структура(
		"id,kind,name,x,y,z,rotation,color,size",
		"WGN-GOND-001", "wagonGondola", "Полувагон",
		284, YПути, 0, 0, "#7d4e32",
		Новый Структура("length,width", 13.9, 3.05)));
	Объекты.Добавить(Новый Структура(
		"id,kind,name,x,y,z,rotation,color,size",
		"WGN-COVER-001", "wagonCovered", "Крытый вагон",
		300, YПути, 0, 0, "#4f7a55",
		Новый Структура("length,width", 14.7, 3.15)));
	Объекты.Добавить(Новый Структура(
		"id,kind,name,x,y,z,rotation,color,size",
		"WGN-TANK-001", "wagonTank", "Вагон-цистерна",
		316, YПути, 0, 0, "#929aa3",
		Новый Структура("length", 12)));

КонецПроцедуры

Процедура ДобавитьСудаИСтс(Объекты)

	// Причал: y=105 на участке [0..280], y=72 на участке [400..720].
	// Суда вплотную к стенке: южный борт ≈ y_причала − 1 м.
	Зазор = 1;

	// Судно 1 — западный прямолинейный участок (y = 105)
	Длина1 = 152;
