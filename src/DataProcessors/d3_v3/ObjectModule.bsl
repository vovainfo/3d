Функция КарточкаИзРазмещения(Размещение)

	Карточка = Новый Структура;
	Карточка.Вставить("id", Размещение.id);
	Карточка.Вставить("kind", "placement");
	Карточка.Вставить("blockId", Размещение.blockId);
	Карточка.Вставить("row", Размещение.row);
	Карточка.Вставить("bay", Размещение.bay);
	Карточка.Вставить("tier", Размещение.tier);
	Карточка.Вставить("lengthFt", Размещение.lengthFt);
	Карточка.Вставить("spanCells", Размещение.spanCells);
	Карточка.Вставить("cellIds", Размещение.cellIds);
	Возврат Карточка;

