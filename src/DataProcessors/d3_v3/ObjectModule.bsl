Функция СгенерироватьДемоСцену()

	ДанныеСцены = Новый Структура;
	ДанныеСцены.Вставить("version", 3);
	ДанныеСцены.Вставить("units", "m");
	ДанныеСцены.Вставить("view", "top");
	БереговаяЛиния = Новый Массив;
	// Причальная стенка: 3 прямых участка, ровно 2 изгиба.
	БереговаяЛиния.Добавить(Новый Структура("x,y", 0, 105));
	БереговаяЛиния.Добавить(Новый Структура("x,y", 280, 105));
	БереговаяЛиния.Добавить(Новый Структура("x,y", 400, 72));
	БереговаяЛиния.Добавить(Новый Структура("x,y", 720, 72));

	ДанныеСцены.Вставить("site", Новый Структура(
		"width,length,gridStep,quayWidth,shoreline",
		720, 620, 2, 14, БереговаяЛиния));

	Блоки = Новый Массив;
	// Атомарный слот = 20 ft: bayPitch 6.25 м, bays=50 (физический размер как у прежних 25×12.5).
	Блоки.Добавить(ОписаниеБлока("A", 18, 335, 0, 2.75, 6.25, 2.591, 60, 50, 7));
	Блоки.Добавить(ОписаниеБлока("B", 430, 180, 45, 2.75, 6.25, 2.591, 60, 50, 7));
	ДанныеСцены.Вставить("topology", Новый Структура("blocks", Блоки));

	Размещения = Новый Массив;
	ДанныеСцены.Вставить("placements", Размещения);

	Объекты = Новый Массив;
	ДанныеСцены.Вставить("objects", Объекты);

	ГСЧ = Новый ГенераторСлучайныхЧисел;
	Для Каждого Блок Из Блоки Цикл
		СгенерироватьРазмещенияБлока(Блок, Размещения, ГСЧ);
	КонецЦикла;

	МассивЦветов = Новый Массив;
	МассивЦветов.Добавить("#1769aa");
	МассивЦветов.Добавить("#2e8b57");
	МассивЦветов.Добавить("#b3261e");
	МассивЦветов.Добавить("#d18b00");

	ДобавитьИнфраструктуруДемо(Объекты, МассивЦветов);
	Возврат ДанныеСцены;

КонецФункции

Процедура СгенерироватьРазмещенияБлока(Блок, Размещения, ГСЧ)

	ЧислоРядов = Блок.rows;
	ЧислоБэев = Блок.bays;
	МаксЯрус = Блок.maxTier;

	// Занятость: ключ "row:bay:tier" → id размещения.
	Занято = Новый Соответствие;

	// Разреженная демо-загрузка: иначе JSON/рендер ~10–30k placements убивают WebKit 1С.
	Для НомерРяда = 0 По ЧислоРядов - 1 Цикл
		НомерБэя = 0;
		Пока НомерБэя < ЧислоБэев Цикл
			// ~55% слотов без штабеля вовсе.
			Если ГСЧ.СлучайноеЧисло(1, 100) <= 55 Тогда
				НомерБэя = НомерБэя + 1;
				Продолжить;
			КонецЕсли;

			Высота = ГСЧ.СлучайноеЧисло(1, Мин(4, МаксЯрус));
			Ярус = 1;
			Пока Ярус <= Высота Цикл
				Ключ = КлючСлота(НомерРяда, НомерБэя, Ярус);
				Если Занято.Получить(Ключ) <> Неопределено Тогда
					Прервать;
				КонецЕсли;

				Можно40 = (НомерБэя + 1 < ЧислоБэев)
					И (Занято.Получить(КлючСлота(НомерРяда, НомерБэя + 1, Ярус)) = Неопределено)
					И (Ярус = 1
						Или Занято.Получить(КлючСлота(НомерРяда, НомерБэя + 1, Ярус - 1)) <> Неопределено);

				Бросок = ГСЧ.СлучайноеЧисло(1, 100);
				Если Можно40 И Бросок <= 45 Тогда
					Размещение = СоздатьРазмещение(Блок, НомерРяда, НомерБэя, Ярус, 40);
					Размещения.Добавить(Размещение);
					Занято.Вставить(КлючСлота(НомерРяда, НомерБэя, Ярус), Размещение.id);
					Занято.Вставить(КлючСлота(НомерРяда, НомерБэя + 1, Ярус), Размещение.id);
				Иначе
					Размещение = СоздатьРазмещение(Блок, НомерРяда, НомерБэя, Ярус, 20);
					Размещения.Добавить(Размещение);
					Занято.Вставить(КлючСлота(НомерРяда, НомерБэя, Ярус), Размещение.id);
				КонецЕсли;
				Ярус = Ярус + 1;
			КонецЦикла;

			// Если поставили 40 ft на нижнем ярусе, сдвигаем на 2 bay.
			Если Занято.Получить(КлючСлота(НомерРяда, НомерБэя, 1)) <> Неопределено
				И НомерБэя + 1 < ЧислоБэев
				И Занято.Получить(КлючСлота(НомерРяда, НомерБэя + 1, 1))
					= Занято.Получить(КлючСлота(НомерРяда, НомерБэя, 1)) Тогда
				НомерБэя = НомерБэя + 2;
			Иначе
				НомерБэя = НомерБэя + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция КлючСлота(Row, Bay, Tier)

	Возврат СтрШаблон("%1:%2:%3", Row, Bay, Tier);

КонецФункции

Функция СоздатьРазмещение(Блок, Row, Bay, Tier, LengthFt)

	Span = ?(LengthFt = 40, 2, 1);
	ИдЯчеек = Новый Массив;
	ИдЯчеек.Добавить(СтрШаблон("%1:%2:%3", Блок.id, Row, Bay));
	Если Span = 2 Тогда
		ИдЯчеек.Добавить(СтрШаблон("%1:%2:%3", Блок.id, Row, Bay + 1));
	КонецЕсли;

	Возврат Новый Структура(
		"id,kind,blockId,row,bay,tier,lengthFt,spanCells,cellIds",
		СтрШаблон("P-%1-%2-%3-T%4-%5", Блок.id, Row, Bay, Tier, LengthFt),
		"placement",
		Блок.id,
		Row,
		Bay,
		Tier,
		LengthFt,
		Span,
		ИдЯчеек);

