// Локальные координаты центра слота (tier не влияет на план X/Y).
//
Функция КоординатыСлота(Блок, Row, Bay, Tier = 1) Экспорт

	Угол = 0;
	Если Блок.Свойство("rotationDeg") Тогда
		Угол = Блок.rotationDeg;
	КонецЕсли;
	Радианы = Угол * 3.141592653589793 / 180;
	CosУ = Cos(Радианы);
	SinУ = Sin(Радианы);

	ЛокX = Bay * Блок.bayPitch;
	ЛокY = Row * Блок.rowPitch;
	X = Блок.originX + ЛокX * CosУ - ЛокY * SinУ;
	Y = Блок.originY + ЛокX * SinУ + ЛокY * CosУ;
	Z = (Tier - 1) * Блок.tierPitch;

	Возврат Новый Структура("x,y,z,rotation", X, Y, Z, Угол);

КонецФункции

