
#Область ОписаниеПеременных

#КонецОбласти

#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");

	HTML = ОбъектОбработки.ПолучитьМакет("МакетHTML").ПолучитьТекст();
	Three = ОбъектОбработки.ПолучитьМакет("МакетThree").ПолучитьТекст();
	JS = ОбъектОбработки.ПолучитьМакет("МакетJS").ПолучитьТекст();
	CSS = ОбъектОбработки.ПолучитьМакет("МакетCSS").ПолучитьТекст() ;

	HTML = СтрЗаменить(HTML, "@CSS", CSS);
	HTML = СтрЗаменить(HTML, "@THREE", Three);
	HTML = СтрЗаменить(HTML, "@JS", JS);

	ДанныеСцены = Новый Структура;
	ДанныеСцены.Вставить("version", 1);
	ДанныеСцены.Вставить("units", "m");
	ДанныеСцены.Вставить("site", Новый Структура("width,length,gridStep", 620, 620, 2));

	Объекты = Новый Массив;
	ДанныеСцены.Вставить("objects", Объекты);

	// Демонстрационная площадка. В рабочей конфигурации этот массив
	// заполняется данными учёта без изменения контракта с JavaScript.
	ГСЧ = Новый ГенераторСлучайныхЧисел;
	МассивЦветов = Новый Массив;
	МассивЦветов.Добавить("#1769aa");
	МассивЦветов.Добавить("#2e8b57");
	МассивЦветов.Добавить("#b3261e");
	МассивЦветов.Добавить("#d18b00");

	// 40 * 60 штабелей со средней высотой 5 контейнеров = ровно 12 000.
	Для Ряд = 0 По 39 Цикл
		Для Позиция = 0 По 59 Цикл
			МаксZ = 3 + (Ряд + Позиция) % 5;
			Для Уровень = 1 По МаксZ Цикл
				Если (Ряд + Позиция + Уровень) % 4 = 0 Тогда
					Вид = "container20";
				Иначе
					Вид = "container40";
				КонецЕсли;

				Идентификатор = СтрШаблон("C-%1-%2-%3", Ряд, Позиция, Уровень);
				Если Ряд < 20 Тогда
					// Первая половина площадки: продольные оси контейнеров под 0°.
					X = 8 + Ряд * 12.5;
					Y = 8 + Позиция * 2.75;
					Угол = 0;
				Иначе
					// Вторая половина: отдельная локальная сетка, повёрнутая на 45°.
					ЛокальныйРяд = Ряд - 20;
					Коэффициент45 = 0.70710678;
					X = 370
						+ ЛокальныйРяд * 12.5 * Коэффициент45
						- Позиция * 2.75 * Коэффициент45;
					Y = 8
						+ ЛокальныйРяд * 12.5 * Коэффициент45
						+ Позиция * 2.75 * Коэффициент45;
					Угол = 45;
				КонецЕсли;
				Z = (Уровень - 1) * 2.591;
				Цвет = МассивЦветов[ГСЧ.СлучайноеЧисло(0, МассивЦветов.Количество() - 1)];
				Объекты.Добавить(Новый Структура(
					"id,kind,name,x,y,z,rotation,color",
					Идентификатор, Вид, Идентификатор, X, Y, Z, Угол, Цвет));
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	// Четыре склада в отдельной зоне площадки.
	Для НомерСклада = 1 По 4 Цикл
		Если НомерСклада = 1 Тогда
			XСклада = 75;
			YСклада = 550;
			УголСклада = 0;
			ДлинаСклада = 110;
			ШиринаСклада = 36;
			ВысотаСклада = 14;
			ЦветСклада = "#64748b";
		ИначеЕсли НомерСклада = 2 Тогда
			XСклада = 210;
			YСклада = 545;
			УголСклада = 15;
			ДлинаСклада = 90;
			ШиринаСклада = 45;
			ВысотаСклада = 18;
			ЦветСклада = "#6b7280";
		ИначеЕсли НомерСклада = 3 Тогда
			XСклада = 365;
			YСклада = 550;
			УголСклада = -20;
			ДлинаСклада = 125;
			ШиринаСклада = 30;
			ВысотаСклада = 12;
			ЦветСклада = "#526579";
		Иначе
			XСклада = 540;
			YСклада = 530;
			УголСклада = 90;
			ДлинаСклада = 80;
			ШиринаСклада = 55;
			ВысотаСклада = 20;
			ЦветСклада = "#737b88";
		КонецЕсли;
		Ангар = Новый Структура(
			"id,kind,name,x,y,z,rotation,color,size",
			СтрШаблон("W-%1", НомерСклада), "warehouse",
			СтрШаблон("Склад %1", НомерСклада),
			XСклада, YСклада, 0, УголСклада, ЦветСклада,
			Новый Структура(
				"length,width,height",
				ДлинаСклада, ШиринаСклада, ВысотаСклада));
		Объекты.Добавить(Ангар);
	КонецЦикла;

	// По два крана каждого вида.
	Для НомерКрана = 1 По 2 Цикл
		XКрана = ?(НомерКрана = 1, 120, 400);
		YКрана = ?(НомерКрана = 1, 320, 335);
		УголRTG = ?(НомерКрана = 1, 0, 45);
		Объекты.Добавить(Новый Структура(
			"id,kind,name,x,y,z,rotation,color,size",
			СтрШаблон("CR-RTG-%1", НомерКрана), "craneRtg",
			СтрШаблон("Козловой кран RTG %1", НомерКрана),
			XКрана, YКрана, 0, УголRTG, "#ffd000",
			Новый Структура("span,length,height", 32, 22, 24)));

		Объекты.Добавить(Новый Структура(
			"id,kind,name,x,y,z,rotation,color",
			СтрШаблон("CR-RS-%1", НомерКрана), "craneReachStacker",
			СтрШаблон("Ричстакер %1", НомерКрана),
			?(НомерКрана = 1, 520, 545),
			?(НомерКрана = 1, 310, 340), 0,
			?(НомерКрана = 1, 210, 315), "#e39b00"));

		Объекты.Добавить(Новый Структура(
			"id,kind,name,x,y,z,rotation,color",
			СтрШаблон("CR-MOB-%1", НомерКрана), "craneMobile",
			СтрШаблон("Мобильный кран %1", НомерКрана),
			?(НомерКрана = 1, 40, 285),
			?(НомерКрана = 1, 320, 330), 0,
			?(НомерКрана = 1, 25, 205), "#d9a400"));
	КонецЦикла;

	// Четыре контейнеровоза: пустой, 20ft и два 40ft.
	Для НомерТягача = 1 По 4 Цикл
		Если НомерТягача = 2 Тогда
			Загрузка = "container20";
		ИначеЕсли НомерТягача = 3 Тогда
			Загрузка = "none";
		Иначе
			Загрузка = "container40";
		КонецЕсли;
		Тягач = Новый Структура(
			"id,kind,name,x,y,z,rotation,color,load",
			СтрШаблон("TR-%1", НомерТягача), "containerTruck",
			СтрШаблон("Контейнеровоз %1", НомерТягача),
			80 + (НомерТягача - 1) * 140, 355, 0,
			(НомерТягача - 1) * 45 + ?(НомерТягача = 1, 180, 0),
			МассивЦветов[НомерТягача - 1], Загрузка);
		Тягач.Вставить("loadColor", МассивЦветов[4 - НомерТягача]);
		Объекты.Добавить(Тягач);
	КонецЦикла;

	// Железнодорожная зона и демонстрационный состав.
	Объекты.Добавить(Новый Структура(
		"id,kind,name,x,y,z,rotation,color,size",
		"RW-001", "railway", "Железнодорожный путь",
		310, 390, 0, 0, "#6b7280",
		Новый Структура(
			"length,gauge,sleeperStep,curveOffset",
			580, 1.52, 0.82, -20)));

	Объекты.Добавить(Новый Структура(
		"id,kind,name,x,y,z,rotation,color",
		"LOCO-001", "dieselLocomotive", "Тепловоз",
		230, 371.85, 0, -2.6, "#d46b00"));

	Платформа = Новый Структура(
		"id,kind,name,x,y,z,rotation,color,size,load",
		"WGN-FLAT-001", "wagonFlatcar", "Фитинговая платформа",
		248, 371.12, 0, -2.0, "#4b5563",
		Новый Структура("length", 14.2), "container40");
	Платформа.Вставить("loadColor", "#1769aa");
	Объекты.Добавить(Платформа);

	Объекты.Добавить(Новый Структура(
		"id,kind,name,x,y,z,rotation,color,size",
		"WGN-GOND-001", "wagonGondola", "Полувагон",
		264, 370.62, 0, -1.5, "#7d4e32",
		Новый Структура("length,width,height", 13.9, 3.05, 2.4)));

	Объекты.Добавить(Новый Структура(
		"id,kind,name,x,y,z,rotation,color,size",
		"WGN-COVER-001", "wagonCovered", "Крытый вагон",
		280, 370.25, 0, -1.0, "#4f7a55",
		Новый Структура("length,width,height", 14.7, 3.15, 3.4)));

	Объекты.Добавить(Новый Структура(
		"id,kind,name,x,y,z,rotation,color,size",
		"WGN-TANK-001", "wagonTank", "Вагон-цистерна",
		296, 370.06, 0, -0.5, "#929aa3",
		Новый Структура("length,radius", 12, 1.38)));

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ДанныеСцены);
	JSONСцены = ЗаписьJSON.Закрыть();
	// Не позволяем данным преждевременно закрыть script type=application/json.
	JSONСцены = СтрЗаменить(JSONСцены, "</", "<\/");

	ДанныеСценыJSON = JSONСцены;
	HTML = СтрЗаменить(HTML, "@SceneData", JSONСцены);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПодключитьОбработчикОжидания("ПередвинутьАвтомобильПоОжиданию", 1);

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()

	ОтключитьОбработчикОжидания("ПередвинутьАвтомобильПоОжиданию");

КонецПроцедуры

&НаКлиенте
Процедура ПередвинутьАвтомобильПоОжиданию()

	Сцена = ПолучитьДанныеСцены();
	Автомобиль = Неопределено;
	Для Каждого ОбъектСцены Из Сцена.objects Цикл
		Если ОбъектСцены.kind = "containerTruck" Тогда
			Автомобиль = ОбъектСцены;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Автомобиль <> Неопределено Тогда
		УголВРадианах = Автомобиль.rotation * 3.141592653589793 / 180;
		// Передняя часть модели направлена вдоль отрицательной локальной оси X.
		НовыйX = Автомобиль.x - Cos(УголВРадианах);
		НовыйY = Автомобиль.y - Sin(УголВРадианах);

		Попытка
			ПереместитьОбъектСцены(
				Автомобиль.id,
				НовыйX,
				НовыйY,
				Автомобиль.z);
		Исключение
			// Первый вызов может произойти до завершения инициализации HTML.
		КонецПопытки;
	КонецЕсли;

	ПеренестиСлучайныйКонтейнерЗаЖелезнуюДорогу(Сцена);

КонецПроцедуры

&НаКлиенте
Процедура ПеренестиСлучайныйКонтейнерЗаЖелезнуюДорогу(Сцена)

	Кандидаты = Новый Массив;
	Для Каждого ОбъектСцены Из Сцена.objects Цикл
		Если (ОбъектСцены.kind = "container20"
				Или ОбъектСцены.kind = "container40")
				И ОбъектСцены.y < 400 Тогда
			Кандидаты.Добавить(ОбъектСцены);
		КонецЕсли;
	КонецЦикла;

	Если Кандидаты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ГСЧ = Новый ГенераторСлучайныхЧисел;
	Индекс = ГСЧ.СлучайноеЧисло(0, Кандидаты.ВГраница());
	Контейнер = Кандидаты[Индекс];
	НоваяY = ГСЧ.СлучайноеЧисло(430, 500);

	Попытка
		ПереместитьОбъектСцены(
			Контейнер.id,
			Контейнер.x,
			НоваяY,
			Контейнер.z);
	Исключение
		// Сцена может быть ещё не готова принимать команды.
	КонецПопытки;

КонецПроцедуры
#КонецОбласти


#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура HTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	Href = "";
	Попытка
		Если ДанныеСобытия.Href <> Неопределено Тогда
			Href = Строка(ДанныеСобытия.Href);
		КонецЕсли;
	Исключение
		// События разных HTML-движков имеют различный набор свойств.
	КонецПопытки;
	
	Если СтрНайти(Href, "#pick:") = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Узел = Неопределено;
	Попытка
		Узел = ДанныеСобытия.Anchor;
	Исключение
		Попытка
			Узел = ДанныеСобытия.Element;
		Исключение
			Узел = Неопределено;
		КонецПопытки;
	КонецПопытки;

	Если Узел = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Идентификатор = ПолучитьАтрибутHTML(Узел, "data-id");
	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ОбъектСцены = НайтиОбъектСцены(Идентификатор);
	Исключение
		Возврат;
	КонецПопытки;

	Если ОбъектСцены = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ОбъектСцены.kind = "container20"
			Или ОбъектСцены.kind = "container40" Тогда
		// Железнодорожная зона расположена около Y=390 м.
		ПереместитьОбъектСцены(
			Идентификатор,
			ОбъектСцены.x,
			430,
			ОбъектСцены.z);
		Возврат;
	КонецЕсли;
	
	ОбработатьВыборОбъекта(
		Идентификатор,
		ОбъектСцены.kind,
		ОбъектСцены.x,
		ОбъектСцены.y,
		ОбъектСцены.z);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПереместитьОбъектСцены(Идентификатор, X, Y, Z) Экспорт

	ПроверитьКоординатыОбъекта(X, Y, Z);
	Идентификатор = Строка(Идентификатор);
	Сцена = ПолучитьДанныеСцены();
	ОбъектСцены = НайтиОбъектВМассиве(Сцена.objects, Идентификатор);
	Если ОбъектСцены = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Объект сцены с идентификатором ""%1"" не найден.", Идентификатор);
	КонецЕсли;

	Команда = Новый Структура("op,id,x,y,z", "move", Идентификатор, X, Y, Z);
	ОтправитьКомандуСцене(Команда);

	ОбъектСцены.x = X;
	ОбъектСцены.y = Y;
	ОбъектСцены.z = Z;
	СохранитьДанныеСцены(Сцена);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьОбъектСцены(Идентификатор) Экспорт

	Идентификатор = Строка(Идентификатор);
	Сцена = ПолучитьДанныеСцены();
	ИндексОбъекта = НайтиИндексОбъектаВМассиве(Сцена.objects, Идентификатор);
	Если ИндексОбъекта = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Объект сцены с идентификатором ""%1"" не найден.", Идентификатор);
	КонецЕсли;

	Команда = Новый Структура("op,id", "remove", Идентификатор);
	ОтправитьКомандуСцене(Команда);

	Сцена.objects.Удалить(ИндексОбъекта);
	СохранитьДанныеСцены(Сцена);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьОбъектСцены(ДанныеОбъекта) Экспорт

	Если ТипЗнч(ДанныеОбъекта) <> Тип("Структура") Тогда
		ВызватьИсключение "Данные добавляемого объекта должны иметь тип Структура.";
	КонецЕсли;

	Идентификатор = "";
	ВидОбъекта = "";
	X = Неопределено;
	Y = Неопределено;
	Z = Неопределено;
	Если Не ДанныеОбъекта.Свойство("id", Идентификатор)
			Или Не ДанныеОбъекта.Свойство("kind", ВидОбъекта)
			Или Не ДанныеОбъекта.Свойство("x", X)
			Или Не ДанныеОбъекта.Свойство("y", Y)
			Или Не ДанныеОбъекта.Свойство("z", Z) Тогда
		ВызватьИсключение "Для объекта обязательны поля id, kind, x, y и z.";
	КонецЕсли;

	Идентификатор = Строка(Идентификатор);
	ВидОбъекта = Строка(ВидОбъекта);
	Если ПустаяСтрока(Идентификатор) Тогда
		ВызватьИсключение "Идентификатор объекта сцены не может быть пустым.";
	КонецЕсли;
	Если Не ПоддерживаетсяВидОбъекта(ВидОбъекта) Тогда
		ВызватьИсключение СтрШаблон("Вид объекта ""%1"" не поддерживается.", ВидОбъекта);
	КонецЕсли;
	ПроверитьКоординатыОбъекта(X, Y, Z);
	НормализованныеДанные = Новый Структура(
		"id,kind,x,y,z", Идентификатор, ВидОбъекта, X, Y, Z);
	ПеренестиСвойствоОбъекта(ДанныеОбъекта, НормализованныеДанные, "name");
	ПеренестиСвойствоОбъекта(ДанныеОбъекта, НормализованныеДанные, "rotation");
	ПеренестиСвойствоОбъекта(ДанныеОбъекта, НормализованныеДанные, "color");
	ПеренестиСвойствоОбъекта(ДанныеОбъекта, НормализованныеДанные, "size");
	ПеренестиСвойствоОбъекта(ДанныеОбъекта, НормализованныеДанные, "load");
	ПеренестиСвойствоОбъекта(ДанныеОбъекта, НормализованныеДанные, "loadColor");

	Сцена = ПолучитьДанныеСцены();
	Если НайтиОбъектВМассиве(Сцена.objects, Идентификатор) <> Неопределено Тогда
		ВызватьИсключение СтрШаблон("Объект сцены с идентификатором ""%1"" уже существует.", Идентификатор);
	КонецЕсли;

	Команда = Новый Структура("op,object", "add", НормализованныеДанные);
	ОтправитьКомандуСцене(Команда);

	Сцена.objects.Добавить(НормализованныеДанные);
	СохранитьДанныеСцены(Сцена);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ПолучитьДанныеСцены()

	//@skip-check bsl-legacy-check-type-environments
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ДанныеСценыJSON);
	//@skip-check undefined-function
	Возврат ПрочитатьJSON(Чтение);

КонецФункции

&НаКлиенте
Процедура СохранитьДанныеСцены(Сцена)

	ДанныеСценыJSON = СериализоватьJSON(Сцена);

КонецПроцедуры

&НаКлиенте
Функция СериализоватьJSON(Значение)

	//@skip-check bsl-legacy-check-type-environments
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	//@skip-check undefined-function-or-procedure
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

&НаКлиенте
Процедура ОтправитьКомандуСцене(Команда)

	Попытка
		ДокументHTML = Элементы.HTML.Документ;
		УзелКоманд = ДокументHTML.getElementById("scene-command-bridge");
	Исключение
		ВызватьИсключение "Не удалось получить доступ к документу 3D-сцены.";
	КонецПопытки;

	Если УзелКоманд = Неопределено Тогда
		ВызватьИсключение "3D-сцена ещё не готова принимать команды.";
	КонецЕсли;
	Если ПолучитьАтрибутHTML(УзелКоманд, "data-ready") <> "true" Тогда
		ВызватьИсключение "3D-сцена ещё не завершила инициализацию.";
	КонецЕсли;

	НомерКоманды = 0;
	ПредыдущийНомерКоманды = ПолучитьАтрибутHTML(УзелКоманд, "data-seq");
	Если Не ПустаяСтрока(ПредыдущийНомерКоманды) Тогда
		Попытка
			НомерКоманды = Число(ПредыдущийНомерКоманды);
		Исключение
			НомерКоманды = 0;
		КонецПопытки;
	КонецЕсли;
	НомерКоманды = НомерКоманды + 1;
	СтрокаНомераКоманды = Строка(НомерКоманды);

	УзелКоманд.setAttribute("data-error", "");
	УзелКоманд.setAttribute("data-ack", "");
	УзелКоманд.setAttribute("data-payload", СериализоватьJSON(Команда));
	УзелКоманд.setAttribute("data-seq", СтрокаНомераКоманды);
	Попытка
		УзелКоманд.click();
	Исключение
		Попытка
			УзелКоманд.fireEvent("onclick");
		Исключение
			ВызватьИсключение "HTML-движок не поддерживает отправку команд в 3D-сцену.";
		КонецПопытки;
	КонецПопытки;

	Если ПолучитьАтрибутHTML(УзелКоманд, "data-ack") <> СтрокаНомераКоманды Тогда
		ВызватьИсключение "3D-сцена не подтвердила выполнение команды.";
	КонецЕсли;
	ТекстОшибки = ПолучитьАтрибутHTML(УзелКоманд, "data-error");
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ВызватьИсключение "Ошибка изменения 3D-сцены: " + ТекстОшибки;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПеренестиСвойствоОбъекта(Источник, Приемник, ИмяСвойства)

	ЗначениеСвойства = Неопределено;
	Если Источник.Свойство(ИмяСвойства, ЗначениеСвойства) Тогда
		Приемник.Вставить(ИмяСвойства, ЗначениеСвойства);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьКоординатыОбъекта(X, Y, Z)

	Если ТипЗнч(X) <> Тип("Число")
			Или ТипЗнч(Y) <> Тип("Число")
			Или ТипЗнч(Z) <> Тип("Число") Тогда
		ВызватьИсключение "Координаты X, Y и Z должны быть числами.";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ПоддерживаетсяВидОбъекта(ВидОбъекта)

	ПоддерживаемыеВиды = "|container20|container40|warehouse|craneRtg|craneReachStacker"
		+ "|craneMobile|containerTruck|railway|dieselLocomotive|wagonFlatcar"
		+ "|wagonGondola|wagonCovered|wagonTank|";
	Возврат СтрНайти(ПоддерживаемыеВиды, "|" + ВидОбъекта + "|") > 0;

КонецФункции

&НаКлиенте
Функция НайтиИндексОбъектаВМассиве(ОбъектыСцены, Идентификатор)

	Для Индекс = 0 По ОбъектыСцены.ВГраница() Цикл
		Если ОбъектыСцены[Индекс].id = Идентификатор Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

&НаКлиенте
Функция НайтиОбъектВМассиве(ОбъектыСцены, Идентификатор)

	Индекс = НайтиИндексОбъектаВМассиве(ОбъектыСцены, Идентификатор);
	Если Индекс = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ОбъектыСцены[Индекс];

КонецФункции

&НаКлиенте
Функция ПолучитьАтрибутHTML(Узел, ИмяАтрибута)

	Попытка
		Значение = Узел.getAttribute(ИмяАтрибута);
		Если Значение = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Возврат Строка(Значение);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

&НаКлиенте
Функция НайтиОбъектСцены(Идентификатор)

	Сцена = ПолучитьДанныеСцены();
	Возврат НайтиОбъектВМассиве(Сцена.objects, Идентификатор);

КонецФункции

&НаКлиенте
Процедура ОбработатьВыборОбъекта(Идентификатор, ВидОбъекта, X, Y, Z) Экспорт
	
	Сообщить(СтрШаблон(
		"Выбран объект %1 (%2): X=%3 м, Y=%4 м, Z=%5 м",
		Идентификатор, ВидОбъекта, X, Y, Z));
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборКонтейнера(X, Y, Z)

	ОбработатьВыборОбъекта("", "container", X, Y, Z);

КонецПроцедуры

#КонецОбласти
