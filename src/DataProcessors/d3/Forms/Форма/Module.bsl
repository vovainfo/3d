
#Область ОписаниеПеременных

#КонецОбласти

#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");

	HTML = ОбъектОбработки.ПолучитьМакет("МакетHTML").ПолучитьТекст();
	Three = ОбъектОбработки.ПолучитьМакет("МакетThree").ПолучитьТекст();
	JS = ОбъектОбработки.ПолучитьМакет("МакетJS").ПолучитьТекст();
	CSS = ОбъектОбработки.ПолучитьМакет("МакетCSS").ПолучитьТекст() ;

	HTML = СтрЗаменить(HTML, "@CSS", CSS);
	HTML = СтрЗаменить(HTML, "@THREE", Three);
	HTML = СтрЗаменить(HTML, "@JS", JS);

	ДанныеСцены = Новый Структура;
	ДанныеСцены.Вставить("version", 1);
	ДанныеСцены.Вставить("units", "m");
	ДанныеСцены.Вставить("site", Новый Структура("width,length,gridStep", 620, 620, 2));

	Объекты = Новый Массив;
	ДанныеСцены.Вставить("objects", Объекты);

	// Демонстрационная площадка. В рабочей конфигурации этот массив
	// заполняется данными учёта без изменения контракта с JavaScript.
	ГСЧ = Новый ГенераторСлучайныхЧисел;
	МассивЦветов = Новый Массив;
	МассивЦветов.Добавить("#1769aa");
	МассивЦветов.Добавить("#2e8b57");
	МассивЦветов.Добавить("#b3261e");
	МассивЦветов.Добавить("#d18b00");

	// 40 * 60 штабелей со средней высотой 5 контейнеров = ровно 12 000.
	Для Ряд = 0 По 39 Цикл
		Для Позиция = 0 По 59 Цикл
			МаксZ = 3 + (Ряд + Позиция) % 5;
			Для Уровень = 1 По МаксZ Цикл
				Если (Ряд + Позиция + Уровень) % 4 = 0 Тогда
					Вид = "container20";
				Иначе
					Вид = "container40";
				КонецЕсли;

				Идентификатор = СтрШаблон("C-%1-%2-%3", Ряд, Позиция, Уровень);
				Если Ряд < 20 Тогда
					// Первая половина площадки: продольные оси контейнеров под 0°.
					X = 8 + Ряд * 12.5;
					Y = 8 + Позиция * 2.75;
					Угол = 0;
				Иначе
					// Вторая половина: отдельная локальная сетка, повёрнутая на 45°.
					ЛокальныйРяд = Ряд - 20;
					Коэффициент45 = 0.70710678;
					X = 370
						+ ЛокальныйРяд * 12.5 * Коэффициент45
						- Позиция * 2.75 * Коэффициент45;
					Y = 8
						+ ЛокальныйРяд * 12.5 * Коэффициент45
						+ Позиция * 2.75 * Коэффициент45;
					Угол = 45;
				КонецЕсли;
				Z = (Уровень - 1) * 2.591;
				Цвет = МассивЦветов[ГСЧ.СлучайноеЧисло(0, МассивЦветов.Количество() - 1)];
				Объекты.Добавить(Новый Структура(
					"id,kind,name,x,y,z,rotation,color",
					Идентификатор, Вид, Идентификатор, X, Y, Z, Угол, Цвет));
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	// Четыре склада в отдельной зоне площадки.
	Для НомерСклада = 1 По 4 Цикл
		Если НомерСклада = 1 Тогда
			XСклада = 75;
			YСклада = 550;
			УголСклада = 0;
			ДлинаСклада = 110;
			ШиринаСклада = 36;
			ВысотаСклада = 14;
			ЦветСклада = "#64748b";
		ИначеЕсли НомерСклада = 2 Тогда
			XСклада = 210;
			YСклада = 545;
			УголСклада = 15;
			ДлинаСклада = 90;
			ШиринаСклада = 45;
			ВысотаСклада = 18;
			ЦветСклада = "#6b7280";
		ИначеЕсли НомерСклада = 3 Тогда
			XСклада = 365;
			YСклада = 550;
			УголСклада = -20;
			ДлинаСклада = 125;
			ШиринаСклада = 30;
			ВысотаСклада = 12;
			ЦветСклада = "#526579";
		Иначе
			XСклада = 540;
			YСклада = 530;
			УголСклада = 90;
			ДлинаСклада = 80;
			ШиринаСклада = 55;
			ВысотаСклада = 20;
			ЦветСклада = "#737b88";
		КонецЕсли;
		Ангар = Новый Структура(
			"id,kind,name,x,y,z,rotation,color,size",
			СтрШаблон("W-%1", НомерСклада), "warehouse",
			СтрШаблон("Склад %1", НомерСклада),
			XСклада, YСклада, 0, УголСклада, ЦветСклада,
			Новый Структура(
				"length,width,height",
				ДлинаСклада, ШиринаСклада, ВысотаСклада));
		Объекты.Добавить(Ангар);
	КонецЦикла;

	// По два крана каждого вида.
	Для НомерКрана = 1 По 2 Цикл
		XКрана = ?(НомерКрана = 1, 120, 400);
		YКрана = ?(НомерКрана = 1, 320, 335);
		УголRTG = ?(НомерКрана = 1, 0, 45);
		Объекты.Добавить(Новый Структура(
			"id,kind,name,x,y,z,rotation,color,size",
			СтрШаблон("CR-RTG-%1", НомерКрана), "craneRtg",
			СтрШаблон("Козловой кран RTG %1", НомерКрана),
			XКрана, YКрана, 0, УголRTG, "#ffd000",
			Новый Структура("span,length,height", 32, 22, 24)));

		Объекты.Добавить(Новый Структура(
			"id,kind,name,x,y,z,rotation,color",
			СтрШаблон("CR-RS-%1", НомерКрана), "craneReachStacker",
			СтрШаблон("Ричстакер %1", НомерКрана),
			?(НомерКрана = 1, 520, 545),
			?(НомерКрана = 1, 310, 340), 0,
			?(НомерКрана = 1, 210, 315), "#e39b00"));

		Объекты.Добавить(Новый Структура(
			"id,kind,name,x,y,z,rotation,color",
			СтрШаблон("CR-MOB-%1", НомерКрана), "craneMobile",
			СтрШаблон("Мобильный кран %1", НомерКрана),
			?(НомерКрана = 1, 40, 285),
			?(НомерКрана = 1, 320, 330), 0,
			?(НомерКрана = 1, 25, 205), "#d9a400"));
	КонецЦикла;

	// Четыре контейнеровоза: пустой, 20ft и два 40ft.
	Для НомерТягача = 1 По 4 Цикл
		Если НомерТягача = 2 Тогда
			Загрузка = "container20";
		ИначеЕсли НомерТягача = 3 Тогда
			Загрузка = "none";
		Иначе
			Загрузка = "container40";
		КонецЕсли;
		Тягач = Новый Структура(
			"id,kind,name,x,y,z,rotation,color,load",
			СтрШаблон("TR-%1", НомерТягача), "containerTruck",
			СтрШаблон("Контейнеровоз %1", НомерТягача),
			80 + (НомерТягача - 1) * 140, 355, 0,
			(НомерТягача - 1) * 45,
			МассивЦветов[НомерТягача - 1], Загрузка);
		Тягач.Вставить("loadColor", МассивЦветов[4 - НомерТягача]);
		Объекты.Добавить(Тягач);
	КонецЦикла;

	// Железнодорожная зона и демонстрационный состав.
	Объекты.Добавить(Новый Структура(
		"id,kind,name,x,y,z,rotation,color,size",
		"RW-001", "railway", "Железнодорожный путь",
		310, 390, 0, 0, "#6b7280",
		Новый Структура(
			"length,gauge,sleeperStep,curveOffset",
			580, 1.52, 0.82, -20)));

	Объекты.Добавить(Новый Структура(
		"id,kind,name,x,y,z,rotation,color",
		"LOCO-001", "dieselLocomotive", "Тепловоз",
		230, 371.85, 0, -2.6, "#d46b00"));

	Платформа = Новый Структура(
		"id,kind,name,x,y,z,rotation,color,size,load",
		"WGN-FLAT-001", "wagonFlatcar", "Фитинговая платформа",
		248, 371.12, 0, -2.0, "#4b5563",
		Новый Структура("length", 14.2), "container40");
	Платформа.Вставить("loadColor", "#1769aa");
	Объекты.Добавить(Платформа);

	Объекты.Добавить(Новый Структура(
		"id,kind,name,x,y,z,rotation,color,size",
		"WGN-GOND-001", "wagonGondola", "Полувагон",
		264, 370.62, 0, -1.5, "#7d4e32",
		Новый Структура("length,width,height", 13.9, 3.05, 2.4)));

	Объекты.Добавить(Новый Структура(
		"id,kind,name,x,y,z,rotation,color,size",
		"WGN-COVER-001", "wagonCovered", "Крытый вагон",
		280, 370.25, 0, -1.0, "#4f7a55",
		Новый Структура("length,width,height", 14.7, 3.15, 3.4)));

	Объекты.Добавить(Новый Структура(
		"id,kind,name,x,y,z,rotation,color,size",
		"WGN-TANK-001", "wagonTank", "Вагон-цистерна",
		296, 370.06, 0, -0.5, "#929aa3",
		Новый Структура("length,radius", 12, 1.38)));

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ДанныеСцены);
	JSONСцены = ЗаписьJSON.Закрыть();
	// Не позволяем данным преждевременно закрыть script type=application/json.
	JSONСцены = СтрЗаменить(JSONСцены, "</", "<\/");

	ДанныеСценыJSON = JSONСцены;
	HTML = СтрЗаменить(HTML, "@SceneData", JSONСцены);
КонецПроцедуры
#КонецОбласти


#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура HTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	Href = "";
	Попытка
		Если ДанныеСобытия.Href <> Неопределено Тогда
			Href = Строка(ДанныеСобытия.Href);
		КонецЕсли;
	Исключение
		// События разных HTML-движков имеют различный набор свойств.
	КонецПопытки;
	
	Если СтрНайти(Href, "#pick:") = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Узел = Неопределено;
	Попытка
		Узел = ДанныеСобытия.Anchor;
	Исключение
		Попытка
			Узел = ДанныеСобытия.Element;
		Исключение
			Узел = Неопределено;
		КонецПопытки;
	КонецПопытки;

	Если Узел = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Идентификатор = ПолучитьАтрибутHTML(Узел, "data-id");
	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ОбъектСцены = НайтиОбъектСцены(Идентификатор);
	Исключение
		Возврат;
	КонецПопытки;

	Если ОбъектСцены = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбработатьВыборОбъекта(
		Идентификатор,
		ОбъектСцены.kind,
		ОбъектСцены.x,
		ОбъектСцены.y,
		ОбъектСцены.z);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ПолучитьАтрибутHTML(Узел, ИмяАтрибута)

	Попытка
		Значение = Узел.getAttribute(ИмяАтрибута);
		Если Значение = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Возврат Строка(Значение);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

&НаКлиенте
Функция НайтиОбъектСцены(Идентификатор)

	//@skip-check bsl-legacy-check-type-environments
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ДанныеСценыJSON);
	//@skip-check undefined-function
	Сцена = ПрочитатьJSON(Чтение);
	Для Каждого ОбъектСцены Из Сцена.objects Цикл
		Если ОбъектСцены.id = Идентификатор Тогда
			Возврат ОбъектСцены;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

&НаКлиенте
Процедура ОбработатьВыборОбъекта(Идентификатор, ВидОбъекта, X, Y, Z) Экспорт
	
	Сообщить(СтрШаблон(
		"Выбран объект %1 (%2): X=%3 м, Y=%4 м, Z=%5 м",
		Идентификатор, ВидОбъекта, X, Y, Z));
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборКонтейнера(X, Y, Z)

	ОбработатьВыборОбъекта("", "container", X, Y, Z);

КонецПроцедуры

#КонецОбласти
