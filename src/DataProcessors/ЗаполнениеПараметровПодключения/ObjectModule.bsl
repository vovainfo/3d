#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Готовит таблицу предпросмотра переноса параметров из констант и значений по умолчанию.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Заполнять, База, Реквизит, ТекущееЗначение, НовоеЗначение, Источник.
Функция ПодготовитьЗаполнение() Экспорт

	Таблица = НоваяТаблицаПредпросмотра();
	ТекущиеЗначения = ТекущиеЗначенияСправочника();

	Для Каждого СтрокаИсточника Из ОписаниеЗаполнения() Цикл
		ТекущееЗначение = ТекущиеЗначения.Получить(КлючЗначения(СтрокаИсточника.База, СтрокаИсточника.Реквизит));
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.База = СтрокаИсточника.База;
		СтрокаТаблицы.Реквизит = СтрокаИсточника.Реквизит;
		СтрокаТаблицы.Источник = СтрокаИсточника.Источник;
		СтрокаТаблицы.ТекущееЗначение = ПредставлениеЗначения(СтрокаИсточника.Реквизит, ТекущееЗначение);
		СтрокаТаблицы.НовоеЗначение = ПредставлениеЗначения(СтрокаИсточника.Реквизит, СтрокаИсточника.НовоеЗначение);
		СтрокаТаблицы.Заполнять = Не ЗначенияСовпадают(
			СтрокаИсточника.Реквизит,
			ТекущееЗначение,
			СтрокаИсточника.НовоеЗначение);
	КонецЦикла;

	Возврат Таблица;

КонецФункции

// Записывает отмеченные реквизиты предопределённых элементов справочника.
// Значения паролей читаются заново из констант, а не из формы.
//
// Параметры:
//  ОтмеченныеСтроки - ТаблицаЗначений - колонки База, Реквизит.
Процедура ВыполнитьЗаполнение(ОтмеченныеСтроки) Экспорт

	Если ОтмеченныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ИндексИсточника = Новый Соответствие;
	Для Каждого СтрокаИсточника Из ОписаниеЗаполнения() Цикл
		ИндексИсточника.Вставить(
			КлючЗначения(СтрокаИсточника.База, СтрокаИсточника.Реквизит),
			СтрокаИсточника.НовоеЗначение);
	КонецЦикла;

	ЗначенияПоБазам = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из ОтмеченныеСтроки Цикл
		НовоеЗначение = ИндексИсточника.Получить(КлючЗначения(СтрокаТаблицы.База, СтрокаТаблицы.Реквизит));
		Если НовоеЗначение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		РеквизитыБазы = ЗначенияПоБазам.Получить(СтрокаТаблицы.База);
		Если РеквизитыБазы = Неопределено Тогда
			РеквизитыБазы = Новый Структура;
			ЗначенияПоБазам.Вставить(СтрокаТаблицы.База, РеквизитыБазы);
		КонецЕсли;
		РеквизитыБазы.Вставить(СтрокаТаблицы.Реквизит, НовоеЗначение);
	КонецЦикла;

	НачатьТранзакцию();
	Попытка
		Для Каждого ЭлементБазы Из ЗначенияПоБазам Цикл
			БазаОбъект = ЭлементБазы.Ключ.ПолучитьОбъект();
			ЗаполнитьЗначенияСвойств(БазаОбъект, ЭлементБазы.Значение);
			БазаОбъект.Записать();
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОписаниеЗаполнения()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("База", Новый ОписаниеТипов("СправочникСсылка.ИнформационныеБазыПорта"));
	Таблица.Колонки.Добавить("Реквизит", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("НовоеЗначение");
	Таблица.Колонки.Добавить("Источник", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));

	ДобавитьПараметрыWebСервиса(Таблица, ПараметрыWebСервисаEDS());
	ДобавитьПараметрыWebСервиса(Таблица, ПараметрыWebСервисаУПП());
	ДобавитьПараметрыWebСервиса(Таблица, ПараметрыWebСервисаУКТ());
	ДобавитьПараметрыWebСервиса(Таблица, ПараметрыWebСервисаВМКТ());
	ДобавитьПараметрыСкаут(Таблица);

	Возврат Таблица;

КонецФункции

