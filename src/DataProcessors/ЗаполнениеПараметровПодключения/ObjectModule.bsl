	СтрокаТаблицы.База = База;
	СтрокаТаблицы.Реквизит = Реквизит;
	СтрокаТаблицы.НовоеЗначение = НовоеЗначение;
	СтрокаТаблицы.Источник = Источник;

КонецПроцедуры

Функция URIПространстваИменПоУмолчанию()

	Возврат "http://fishport.ru";

КонецФункции

Функция ТекущиеЗначенияСправочника()

	Результат = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ИнформационныеБазыПорта.Ссылка КАК База,
		|	ИнформационныеБазыПорта.АдресWSDL КАК АдресWSDL,
		|	ИнформационныеБазыПорта.ПользовательСервиса КАК ПользовательСервиса,
		|	ИнформационныеБазыПорта.ПарольСервиса КАК ПарольСервиса,
		|	ИнформационныеБазыПорта.URIПространстваИмен КАК URIПространстваИмен,
		|	ИнформационныеБазыПорта.ИмяСервиса КАК ИмяСервиса,
		|	ИнформационныеБазыПорта.ИмяТочкиПодключения КАК ИмяТочкиПодключения,
		|	ИнформационныеБазыПорта.КодПроверки КАК КодПроверки,
		|	ИнформационныеБазыПорта.Путь КАК Путь,
		|	ИнформационныеБазыПорта.Порт КАК Порт,
		|	ИнформационныеБазыПорта.ТаймаутЗапроса КАК ТаймаутЗапроса,
		|	ИнформационныеБазыПорта.ТаймаутЗапросаКарточки КАК ТаймаутЗапросаКарточки,
		|	ИнформационныеБазыПорта.ИдентификаторКлиента КАК ИдентификаторКлиента
		|ИЗ
		|	Справочник.ИнформационныеБазыПорта КАК ИнформационныеБазыПорта
		|ГДЕ
		|	ИнформационныеБазыПорта.Ссылка В (&Базы)";
	Запрос.УстановитьПараметр("Базы", ПредопределенныеБазы());

	ИменаРеквизитов = СтрРазделить(
		"АдресWSDL,ПользовательСервиса,ПарольСервиса,URIПространстваИмен,ИмяСервиса,ИмяТочкиПодключения,КодПроверки,Путь,Порт,ТаймаутЗапроса,ТаймаутЗапросаКарточки,ИдентификаторКлиента",
		",",
		Ложь);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
			Результат.Вставить(КлючЗначения(Выборка.База, ИмяРеквизита), Выборка[ИмяРеквизита]);
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПредопределенныеБазы()

	Базы = Новый Массив;
	Базы.Добавить(Справочники.ИнформационныеБазыПорта.EDS);
	Базы.Добавить(Справочники.ИнформационныеБазыПорта.УПП);
	Базы.Добавить(Справочники.ИнформационныеБазыПорта.УКТ);
	Базы.Добавить(Справочники.ИнформационныеБазыПорта.ВМКТ);
	Базы.Добавить(Справочники.ИнформационныеБазыПорта.Скаут);

	Возврат Базы;

КонецФункции

Функция НоваяТаблицаПредпросмотра()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Заполнять", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("База", Новый ОписаниеТипов("СправочникСсылка.ИнформационныеБазыПорта"));
	Таблица.Колонки.Добавить("Реквизит", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("ТекущееЗначение", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(300)));
	Таблица.Колонки.Добавить("НовоеЗначение", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(300)));
	Таблица.Колонки.Добавить("Источник", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));

	Возврат Таблица;

КонецФункции

Функция ПредставлениеЗначения(Реквизит, Значение)

	Если Реквизит = "ПарольСервиса" Тогда
		Если ПустаяСтрока(Строка(Значение)) Тогда
			Возврат "пусто";
		КонецЕсли;
		Возврат "заполнено";
	КонецЕсли;

	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(Строка(Значение));

КонецФункции

Функция ЗначенияСовпадают(Реквизит, ТекущееЗначение, НовоеЗначение)

	Если Реквизит = "Порт" Или Реквизит = "ТаймаутЗапроса" Или Реквизит = "ТаймаутЗапросаКарточки" Тогда
		Возврат ЧислоИзЗначения(ТекущееЗначение) = ЧислоИзЗначения(НовоеЗначение);
	КонецЕсли;

	Возврат СокрЛП(Строка(ТекущееЗначение)) = СокрЛП(Строка(НовоеЗначение));

КонецФункции

Функция ЧислоИзЗначения(Значение)

	Если Значение = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Число(Значение);

КонецФункции

Функция КлючЗначения(База, Реквизит)

	Возврат Строка(База.УникальныйИдентификатор()) + "|" + Реквизит;

КонецФункции

#КонецОбласти

