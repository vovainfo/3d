Процедура ДобавитьПараметрыWebСервиса(Таблица, Параметры)

	База = Параметры.База;
	ПрефиксКонстант = Параметры.ПрефиксКонстант;
	ДобавитьСтрокуИсточника(Таблица, База, "АдресWSDL", Параметры.АдресWSDL, "Константа " + ПрефиксКонстант + "Url");
	ДобавитьСтрокуИсточника(Таблица, База, "ПользовательСервиса", Параметры.Логин, "Константа " + ПрефиксКонстант + "Логин");
	ДобавитьСтрокуИсточника(Таблица, База, "ПарольСервиса", Параметры.Пароль, "Константа " + ПрефиксКонстант + "Пароль");
	ДобавитьСтрокуИсточника(Таблица, База, "КодПроверки", Параметры.КодПроверки, "Константа " + ПрефиксКонстант + "КодПроверки");
	ДобавитьСтрокуИсточника(Таблица, База, "URIПространстваИмен", URIПространстваИменПоУмолчанию(), "Значение по умолчанию");
	ДобавитьСтрокуИсточника(Таблица, База, "ИмяСервиса", Параметры.ИмяСервиса, "Значение по умолчанию");
	ДобавитьСтрокуИсточника(Таблица, База, "ИмяТочкиПодключения", Параметры.ИмяТочки, "Значение по умолчанию");
	ДобавитьСтрокуИсточника(Таблица, База, "ТаймаутЗапроса", Параметры.Таймаут, "Значение по умолчанию");

КонецПроцедуры

