
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Заголовок = "Заполнение параметров подключения";
	ЗаполнитьТаблицуПредпросмотра();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьВСправочник(Команда)

	ЗаписатьВСправочникНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьТаблицуПредпросмотра()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТаблицаЗаполнения.Загрузить(ОбработкаОбъект.ПодготовитьЗаполнение());

КонецПроцедуры

&НаСервере
Процедура ЗаписатьВСправочникНаСервере()

	ОтмеченныеСтроки = Новый ТаблицаЗначений;
	ОтмеченныеСтроки.Колонки.Добавить("База", Новый ОписаниеТипов("СправочникСсылка.ИнформационныеБазыПорта"));
	ОтмеченныеСтроки.Колонки.Добавить("Реквизит", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));

	Для Каждого СтрокаТаблицы Из ТаблицаЗаполнения Цикл
		Если Не СтрокаТаблицы.Заполнять Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ОтмеченныеСтроки.Добавить();
		НоваяСтрока.База = СтрокаТаблицы.База;
		НоваяСтрока.Реквизит = СтрокаТаблицы.Реквизит;
	КонецЦикла;

	Если ОтмеченныеСтроки.Количество() = 0 Тогда
		ВывестиСообщениеПользователю("Нет строк для записи.");
		Возврат;
	КонецЕсли;

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ВыполнитьЗаполнение(ОтмеченныеСтроки);
	ЗаполнитьТаблицуПредпросмотра();
	ВывестиСообщениеПользователю("Параметры подключения записаны в справочник.");

КонецПроцедуры

&НаСервере
Процедура ВывестиСообщениеПользователю(ТекстСообщения)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти
