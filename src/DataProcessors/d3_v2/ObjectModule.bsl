// Возвращает HTML-документ сцены с подставленными CSS/Three/JS и JSON данных.
//
Функция СобратьHTMLСцены() Экспорт

	HTML = ПолучитьМакет("МакетHTML").ПолучитьТекст();
	Three = ПолучитьМакет("МакетThree").ПолучитьТекст();
	JS = ПолучитьМакет("МакетJS").ПолучитьТекст();
	CSS = ПолучитьМакет("МакетCSS").ПолучитьТекст();

	HTML = СтрЗаменить(HTML, "@CSS", CSS);
	HTML = СтрЗаменить(HTML, "@THREE", Three);
	HTML = СтрЗаменить(HTML, "@JS", JS);

	Снимок = ПолучитьСнимок();
	JSONСцены = СериализоватьJSON(Снимок.ДанныеСцены);
	JSONСцены = СтрЗаменить(JSONСцены, "</", "<\/");
	HTML = СтрЗаменить(HTML, "@SceneData", JSONСцены);

	Результат = Новый Структура;
	Результат.Вставить("HTML", HTML);
	Результат.Вставить("ДанныеСценыJSON", JSONСцены);
	Результат.Вставить("SnapshotId", Снимок.SnapshotId);
	Результат.Вставить("СостояниеОбмена", Снимок.СостояниеОбмена);
	Возврат Результат;

КонецФункции

// Интерфейс stub-адаптера: полный снимок сцены для первичной загрузки.
//
Функция ПолучитьСнимок() Экспорт

	ДанныеСцены = СгенерироватьДемоСцену();
	SnapshotId = "stub-" + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0");

	Результат = Новый Структура;
	Результат.Вставить("SnapshotId", SnapshotId);
	Результат.Вставить("ДанныеСцены", ДанныеСцены);
	Результат.Вставить("СостояниеОбмена", "stub · snapshot готов · polling выключен");
	Возврат Результат;

КонецФункции

// Интерфейс stub-адаптера: чанк снимка (пока весь снимок одним чанком).
//
Функция ПолучитьЧанкСнимка(SnapshotId, ChunkIndex) Экспорт

	Снимок = ПолучитьСнимок();
	Чанк = Новый Структура;
	Чанк.Вставить("snapshotId", SnapshotId);
	Чанк.Вставить("chunkIndex", ChunkIndex);
	Чанк.Вставить("blockId", "*");
	Чанк.Вставить("objects", Снимок.ДанныеСцены.objects);
	Возврат Чанк;

КонецФункции

// Интерфейс stub-адаптера: изменения после версии (пустой поток).
//
Функция ПолучитьИзменения(ПослеВерсии) Экспорт

	Delta = Новый Структура;
	Delta.Вставить("baseSnapshotId", "");
	Delta.Вставить("version", ПослеВерсии);
	Delta.Вставить("moves", Новый Массив);
	Delta.Вставить("upserts", Новый Массив);
	Delta.Вставить("removed", Новый Массив);
	Delta.Вставить("quality", Новый Массив);
	Возврат Delta;

КонецФункции

// Карточка объекта по идентификатору из данных сцены.
//
Функция ПолучитьКарточкуОбъекта(Идентификатор, ДанныеСцены) Экспорт

	Если ДанныеСцены = Неопределено Или Не ДанныеСцены.Свойство("objects") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого ОбъектСцены Из ДанныеСцены.objects Цикл
		Если ОбъектСцены.id = Идентификатор Тогда
			Возврат КарточкаИзОбъектаСцены(ОбъектСцены);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ПолучитьСостояниеОбмена() Экспорт

	Возврат "stub · источник CSV/JSON не подключён";

КонецФункции

// Вычисляет локальные координаты слота блока.
// Блок: originX, originY, rotationDeg, rowPitch, bayPitch, tierPitch.
//
Функция КоординатыСлота(Блок, Row, Bay, Tier) Экспорт

	Угол = 0;
	Если Блок.Свойство("rotationDeg") Тогда
		Угол = Блок.rotationDeg;
	КонецЕсли;
	Радианы = Угол * 3.141592653589793 / 180;
	CosУ = Cos(Радианы);
	SinУ = Sin(Радианы);

	ЛокX = Bay * Блок.bayPitch;
	ЛокY = Row * Блок.rowPitch;
	X = Блок.originX + ЛокX * CosУ - ЛокY * SinУ;
	Y = Блок.originY + ЛокX * SinУ + ЛокY * CosУ;
	Z = (Tier - 1) * Блок.tierPitch;

	Возврат Новый Структура("x,y,z,rotation", X, Y, Z, Угол);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СериализоватьJSON(Значение)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

Функция КарточкаИзОбъектаСцены(ОбъектСцены)

	Карточка = Новый Структура;
	Карточка.Вставить("id", ОбъектСцены.id);
	Карточка.Вставить("kind", ОбъектСцены.kind);
	Карточка.Вставить("name", ?(ОбъектСцены.Свойство("name"), ОбъектСцены.name, ОбъектСцены.id));
	Карточка.Вставить("x", ОбъектСцены.x);
	Карточка.Вставить("y", ОбъектСцены.y);
	Карточка.Вставить("z", ОбъектСцены.z);

	Блок = "";
	Если ОбъектСцены.Свойство("blockId", Блок) Тогда
		Карточка.Вставить("blockId", Блок);
	КонецЕсли;
	Если ОбъектСцены.Свойство("row") Тогда
		Карточка.Вставить("row", ОбъектСцены.row);
	КонецЕсли;
	Если ОбъектСцены.Свойство("bay") Тогда
		Карточка.Вставить("bay", ОбъектСцены.bay);
	КонецЕсли;
	Если ОбъектСцены.Свойство("tier") Тогда
		Карточка.Вставить("tier", ОбъектСцены.tier);
	КонецЕсли;
	Если ОбъектСцены.Свойство("status") Тогда
		Карточка.Вставить("status", ОбъектСцены.status);
	КонецЕсли;
	Если ОбъектСцены.Свойство("observedAt") Тогда
		Карточка.Вставить("observedAt", ОбъектСцены.observedAt);
	КонецЕсли;

	Возврат Карточка;

КонецФункции

Функция СгенерироватьДемоСцену()

	ДанныеСцены = Новый Структура;
	ДанныеСцены.Вставить("version", 1);
	ДанныеСцены.Вставить("units", "m");
	// Площадка шире: блок B на 45° уходит примерно до X≈662.
	ДанныеСцены.Вставить("site", Новый Структура("width,length,gridStep", 720, 620, 2));

	// rowPitch — шаг поперёк контейнера, bayPitch — вдоль длинной оси.
	// A: 0° влево. B: 45°, origin сдвинут вправо, чтобы диагональ не пересекала A
	// (при origin 370 и ширине A до X=308 площадки накладывались).
	Блоки = Новый Массив;
	Блоки.Добавить(ОписаниеБлока("A", 8, 8, 0, 2.75, 12.5, 2.591, 60, 25, 7));
	Блоки.Добавить(ОписаниеБлока("B", 450, 8, 45, 2.75, 12.5, 2.591, 60, 25, 7));
	ДанныеСцены.Вставить("topology", Новый Структура("blocks", Блоки));

	Объекты = Новый Массив;
	ДанныеСцены.Вставить("objects", Объекты);

	ГСЧ = Новый ГенераторСлучайныхЧисел;
	МассивЦветов = Новый Массив;
	МассивЦветов.Добавить("#1769aa");
	МассивЦветов.Добавить("#2e8b57");
	МассивЦветов.Добавить("#b3261e");
	МассивЦветов.Добавить("#d18b00");

	МоментНаблюдения = Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-ddTHH:mm:ss");

	// 50 * 60 штабелей со средней высотой 5 = 15 000 контейнеров.
	Для Ряд = 0 По 49 Цикл
		Для Позиция = 0 По 59 Цикл
			МаксZ = 3 + (Ряд + Позиция) % 5;
			Для Уровень = 1 По МаксZ Цикл
				Если (Ряд + Позиция + Уровень) % 4 = 0 Тогда
					Вид = "container20";
				Иначе
					Вид = "container40";
				КонецЕсли;

				Если Ряд < 25 Тогда
					Блок = Блоки[0];
					ЛокальныйБэй = Ряд;
				Иначе
					Блок = Блоки[1];
					ЛокальныйБэй = Ряд - 25;
				КонецЕсли;

				// В демо-петле Ряд идёт вдоль bayPitch (12.5), Позиция — вдоль rowPitch (2.75).
				Слот = КоординатыСлота(Блок, Позиция, ЛокальныйБэй, Уровень);
				Идентификатор = СтрШаблон("C-%1-%2-%3", Ряд, Позиция, Уровень);
				Цвет = МассивЦветов[ГСЧ.СлучайноеЧисло(0, МассивЦветов.Количество() - 1)];

				Контейнер = Новый Структура(
					"id,kind,name,x,y,z,rotation,color,blockId,row,bay,tier,status,observedAt",
					Идентификатор, Вид, Идентификатор,
					Слот.x, Слот.y, Слот.z, Слот.rotation, Цвет,
					Блок.id, Позиция, ЛокальныйБэй, Уровень,
					"yard", МоментНаблюдения);
				Объекты.Добавить(Контейнер);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	ДобавитьИнфраструктуруДемо(Объекты, МассивЦветов);
	Возврат ДанныеСцены;

КонецФункции

Функция ОписаниеБлока(Идентификатор, OriginX, OriginY, RotationDeg, RowPitch, BayPitch, TierPitch, Rows, Bays, MaxTier)

	Возврат Новый Структура(
		"id,originX,originY,rotationDeg,rowPitch,bayPitch,tierPitch,rows,bays,maxTier",
		Идентификатор, OriginX, OriginY, RotationDeg, RowPitch, BayPitch, TierPitch, Rows, Bays, MaxTier);

КонецФункции

Процедура ДобавитьИнфраструктуруДемо(Объекты, МассивЦветов)

	Для НомерСклада = 1 По 4 Цикл
		Если НомерСклада = 1 Тогда
			XСклада = 75; YСклада = 550; УголСклада = 0;
			ДлинаСклада = 110; ШиринаСклада = 36; ВысотаСклада = 14; ЦветСклада = "#64748b";
		ИначеЕсли НомерСклада = 2 Тогда
			XСклада = 210; YСклада = 545; УголСклада = 15;
			ДлинаСклада = 90; ШиринаСклада = 45; ВысотаСклада = 18; ЦветСклада = "#6b7280";
		ИначеЕсли НомерСклада = 3 Тогда
			XСклада = 365; YСклада = 550; УголСклада = -20;
			ДлинаСклада = 125; ШиринаСклада = 30; ВысотаСклада = 12; ЦветСклада = "#526579";
		Иначе
			XСклада = 540; YСклада = 530; УголСклада = 90;
			ДлинаСклада = 80; ШиринаСклада = 55; ВысотаСклада = 20; ЦветСклада = "#737b88";
		КонецЕсли;
		Объекты.Добавить(Новый Структура(
			"id,kind,name,x,y,z,rotation,color,size",
			СтрШаблон("W-%1", НомерСклада), "warehouse",
			СтрШаблон("Склад %1", НомерСклада),
			XСклада, YСклада, 0, УголСклада, ЦветСклада,
			Новый Структура("length,width,height", ДлинаСклада, ШиринаСклада, ВысотаСклада)));
	КонецЦикла;

	Для НомерКрана = 1 По 2 Цикл
		Объекты.Добавить(Новый Структура(
			"id,kind,name,x,y,z,rotation,color,size",
			СтрШаблон("CR-RTG-%1", НомерКрана), "craneRtg",
			СтрШаблон("Козловой кран RTG %1", НомерКрана),
			?(НомерКрана = 1, 120, 400), ?(НомерКрана = 1, 320, 335), 0,
			?(НомерКрана = 1, 0, 45), "#ffd000",
			Новый Структура("span,length,height", 32, 22, 24)));
		Объекты.Добавить(Новый Структура(
			"id,kind,name,x,y,z,rotation,color",
			СтрШаблон("CR-RS-%1", НомерКрана), "craneReachStacker",
			СтрШаблон("Ричстакер %1", НомерКрана),
			?(НомерКрана = 1, 520, 545), ?(НомерКрана = 1, 310, 340), 0,
			?(НомерКрана = 1, 210, 315), "#e39b00"));
		Объекты.Добавить(Новый Структура(
			"id,kind,name,x,y,z,rotation,color",
			СтрШаблон("CR-MOB-%1", НомерКрана), "craneMobile",
			СтрШаблон("Мобильный кран %1", НомерКрана),
			?(НомерКрана = 1, 40, 285), ?(НомерКрана = 1, 320, 330), 0,
			?(НомерКрана = 1, 25, 205), "#d9a400"));
	КонецЦикла;

	Для НомерТягача = 1 По 4 Цикл
		Если НомерТягача = 2 Тогда
			Загрузка = "container20";
		ИначеЕсли НомерТягача = 3 Тогда
			Загрузка = "none";
		Иначе
			Загрузка = "container40";
		КонецЕсли;
		Тягач = Новый Структура(
			"id,kind,name,x,y,z,rotation,color,load",
			СтрШаблон("TR-%1", НомерТягача), "containerTruck",
			СтрШаблон("Контейнеровоз %1", НомерТягача),
			80 + (НомерТягача - 1) * 140, 355, 0,
			(НомерТягача - 1) * 45 + ?(НомерТягача = 1, 180, 0),
			МассивЦветов[НомерТягача - 1], Загрузка);
		Тягач.Вставить("loadColor", МассивЦветов[4 - НомерТягача]);
		Объекты.Добавить(Тягач);
	КонецЦикла;

	Объекты.Добавить(Новый Структура(
		"id,kind,name,x,y,z,rotation,color,size",
		"RW-001", "railway", "Железнодорожный путь",
		310, 390, 0, 0, "#6b7280",
		Новый Структура("length,gauge,sleeperStep,curveOffset", 580, 1.52, 0.82, -20)));
	Объекты.Добавить(Новый Структура(
		"id,kind,name,x,y,z,rotation,color",
		"LOCO-001", "dieselLocomotive", "Тепловоз",
		230, 371.85, 0, -2.6, "#d46b00"));

	Платформа = Новый Структура(
		"id,kind,name,x,y,z,rotation,color,size,load",
		"WGN-FLAT-001", "wagonFlatcar", "Фитинговая платформа",
		248, 371.12, 0, -2.0, "#4b5563",
		Новый Структура("length", 14.2), "container40");
	Платформа.Вставить("loadColor", "#1769aa");
	Объекты.Добавить(Платформа);

	Объекты.Добавить(Новый Структура(
		"id,kind,name,x,y,z,rotation,color,size",
		"WGN-GOND-001", "wagonGondola", "Полувагон",
		264, 370.62, 0, -1.5, "#7d4e32",
		Новый Структура("length,width,height", 13.9, 3.05, 2.4)));
	Объекты.Добавить(Новый Структура(
		"id,kind,name,x,y,z,rotation,color,size",
		"WGN-COVER-001", "wagonCovered", "Крытый вагон",
		280, 370.25, 0, -1.0, "#4f7a55",
		Новый Структура("length,width,height", 14.7, 3.15, 3.4)));
	Объекты.Добавить(Новый Структура(
		"id,kind,name,x,y,z,rotation,color,size",
		"WGN-TANK-001", "wagonTank", "Вагон-цистерна",
		296, 370.06, 0, -0.5, "#929aa3",
		Новый Структура("length,radius", 12, 1.38)));

