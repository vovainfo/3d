
#Область ОписаниеПеременных

&НаКлиенте
Перем ИндексОбъектов;

&НаКлиенте
Перем ДемоАктивно;

&НаКлиенте
Перем ИдентификаторДемоТягача;

&НаКлиенте
Перем КандидатыДемоКонтейнеров;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Сборка = ОбъектОбработки.СобратьHTMLСцены();

	HTML = Сборка.HTML;
	ДанныеСценыJSON = Сборка.ДанныеСценыJSON;
	SnapshotId = Сборка.SnapshotId;
	ВерсияДанных = 0;
	СостояниеОбмена = Сборка.СостояниеОбмена;
	КарточкаОбъекта = "Кликните объект на сцене";
	ПоискОбъекта = "";

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ДемоАктивно = Истина;
	ПостроитьИндексОбъектов();
	ПодготовитьДемоКэш();
	ПодключитьОбработчикОжидания("ШагДемонстрации", 1);
	СостояниеОбмена = "демо · тягач и перенос контейнеров";

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	ОтключитьОбработчикОжидания("ШагДемонстрации");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура HTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Href = "";
	Попытка
		Если ДанныеСобытия.Href <> Неопределено Тогда
			Href = Строка(ДанныеСобытия.Href);
		КонецЕсли;
	Исключение
		// События разных HTML-движков имеют различный набор свойств.
	КонецПопытки;

	Если СтрНайти(Href, "#pick:") = 0 Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;

	Узел = Неопределено;
	Попытка
		Узел = ДанныеСобытия.Anchor;
	Исключение
		Попытка
			Узел = ДанныеСобытия.Element;
		Исключение
			Узел = Неопределено;
		КонецПопытки;
	КонецПопытки;

	Если Узел = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Идентификатор = ПолучитьАтрибутHTML(Узел, "data-id");
	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	ВидОбъекта = ПолучитьАтрибутHTML(Узел, "data-kind");
	X = ЧислоИзАтрибута(Узел, "data-x");
	Y = ЧислоИзАтрибута(Узел, "data-y");
	Z = ЧислоИзАтрибута(Узел, "data-z");

	// Демо: клик по контейнеру перекидывает его за железнодорожную зону.
	Если ДемоАктивно
			И (ВидОбъекта = "container20" Или ВидОбъекта = "container40") Тогда
		Попытка
			ПереместитьОбъектСцены(Идентификатор, X, 430, Z);
			ОбработатьВыборОбъекта(Идентификатор, ВидОбъекта, X, 430, Z);
		Исключение
			ОбработатьВыборОбъекта(Идентификатор, ВидОбъекта, X, Y, Z);
		КонецПопытки;
		Возврат;
	КонецЕсли;

	ОбработатьВыборОбъекта(Идентификатор, ВидОбъекта, X, Y, Z);

КонецПроцедуры

&НаКлиенте
Процедура ПоискОбъектаПриИзменении(Элемент)

	// Поиск выполняется командой «Найти».

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НайтиОбъект(Команда)

	Идентификатор = СокрЛП(ПоискОбъекта);
	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	ОбъектСцены = НайтиОбъектВИндексе(Идентификатор);
	Если ОбъектСцены = Неопределено Тогда
		КарточкаОбъекта = СтрШаблон("Объект %1 не найден", Идентификатор);
		Возврат;
	КонецЕсли;

	ОтправитьКомандуСцене(Новый Структура("op,id", "focus", Идентификатор));
	ОбработатьВыборОбъекта(
		ОбъектСцены.id,
		ОбъектСцены.kind,
		ОбъектСцены.x,
		ОбъектСцены.y,
		ОбъектСцены.z);

КонецПроцедуры

&НаКлиенте
Процедура ПереключитьДемо(Команда)

	ДемоАктивно = Не ДемоАктивно;
	Если ДемоАктивно Тогда
		ПодготовитьДемоКэш();
		ПодключитьОбработчикОжидания("ШагДемонстрации", 1);
		СостояниеОбмена = "демо · тягач и перенос контейнеров";
	Иначе
		ОтключитьОбработчикОжидания("ШагДемонстрации");
		СостояниеОбмена = "демо выключено · read-only";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура SpikeDelta100(Команда)

	Перемещения = Новый Массив;
	Счётчик = 0;
	Для Каждого КлючИЗначение Из ИндексОбъектов Цикл
		ОбъектСцены = КлючИЗначение.Значение;
		Если ОбъектСцены.kind <> "container20" И ОбъектСцены.kind <> "container40" Тогда
			Продолжить;
		КонецЕсли;

		// Чётные нажатия уводят за ЖД, нечётные возвращают в штабель.
		Если ОбъектСцены.y < 400 Тогда
			НовыйY = 430 + (Счётчик % 60);
		Иначе
			НовыйY = ОбъектСцены.y - 120;
			Если НовыйY < 8 Тогда
				НовыйY = 8 + (Счётчик % 40) * 2.75;
			КонецЕсли;
		КонецЕсли;

		Перемещения.Добавить(Новый Структура(
			"id,x,y,z",
			ОбъектСцены.id,
			ОбъектСцены.x,
			НовыйY,
			ОбъектСцены.z));
		Счётчик = Счётчик + 1;
		Если Счётчик >= 100 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Delta = Новый Структура;
	Delta.Вставить("baseSnapshotId", SnapshotId);
	Delta.Вставить("version", ВерсияДанных + 1);
	Delta.Вставить("moves", Перемещения);
	Delta.Вставить("upserts", Новый Массив);
	Delta.Вставить("removed", Новый Массив);
	Delta.Вставить("quality", Новый Массив);

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		ОтправитьКомандуСцене(Новый Структура("op,delta", "applyDelta", Delta));
		ВерсияДанных = ВерсияДанных + 1;
		Для Каждого Перемещение Из Перемещения Цикл
			ОбновитьПозициюВИндексе(Перемещение.id, Перемещение.x, Перемещение.y, Перемещение.z);
		КонецЦикла;
		Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
		СостояниеОбмена = СтрШаблон(
			"spike delta %1 moves · %2 мс · snapshot %3 · v%4",
			Перемещения.Количество(), Длительность, SnapshotId, ВерсияДанных);
	Исключение
		СостояниеОбмена = "spike delta ошибка: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПостроитьИндексОбъектов()

	ИндексОбъектов = Новый Соответствие;
	//@skip-check bsl-legacy-check-type-environments
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ДанныеСценыJSON);
	//@skip-check undefined-function
	Сцена = ПрочитатьJSON(Чтение);
	Если Сцена = Неопределено Или Не Сцена.Свойство("objects") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ОбъектСцены Из Сцена.objects Цикл
		ИндексОбъектов.Вставить(ОбъектСцены.id, ОбъектСцены);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПодготовитьДемоКэш()

	ИдентификаторДемоТягача = "TR-1";
	КандидатыДемоКонтейнеров = Новый Массив;
	Если ИндексОбъектов = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого КлючИЗначение Из ИндексОбъектов Цикл
		ОбъектСцены = КлючИЗначение.Значение;
//		Если ПустаяСтрока(ИдентификаторДемоТягача)
//				И ОбъектСцены.kind = "containerTruck" Тогда
//			ИдентификаторДемоТягача = ОбъектСцены.id;
//		КонецЕсли;
		Если (ОбъектСцены.kind = "container20" Или ОбъектСцены.kind = "container40")
				И ОбъектСцены.y < 400 Тогда
			КандидатыДемоКонтейнеров.Добавить(ОбъектСцены.id);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ШагДемонстрации()

	Если Не ДемоАктивно Тогда
		Возврат;
	КонецЕсли;

	Перемещения = Новый Массив;

	Если Не ПустаяСтрока(ИдентификаторДемоТягача) Тогда
		Тягач = НайтиОбъектВИндексе(ИдентификаторДемоТягача);
		Если Тягач <> Неопределено Тогда
			УголВРадианах = Тягач.rotation * 3.141592653589793 / 180;
			// Передняя часть модели направлена вдоль отрицательной локальной оси X.
			Перемещения.Добавить(Новый Структура(
				"id,x,y,z",
				Тягач.id,
				Тягач.x - Cos(УголВРадианах),
				Тягач.y - Sin(УголВРадианах),
				Тягач.z));
		КонецЕсли;
	КонецЕсли;

	Если КандидатыДемоКонтейнеров <> Неопределено
			И КандидатыДемоКонтейнеров.Количество() > 0 Тогда
		ГСЧ = Новый ГенераторСлучайныхЧисел;
		Индекс = ГСЧ.СлучайноеЧисло(0, КандидатыДемоКонтейнеров.ВГраница());
		ИдКонтейнера = КандидатыДемоКонтейнеров[Индекс];
		Контейнер = НайтиОбъектВИндексе(ИдКонтейнера);
		Если Контейнер <> Неопределено И Контейнер.y < 400 Тогда
			Перемещения.Добавить(Новый Структура(
				"id,x,y,z",
				Контейнер.id,
				Контейнер.x,
				ГСЧ.СлучайноеЧисло(430, 500),
				Контейнер.z));
			КандидатыДемоКонтейнеров.Удалить(Индекс);
		ИначеЕсли Контейнер <> Неопределено Тогда
			КандидатыДемоКонтейнеров.Удалить(Индекс);
		КонецЕсли;
	КонецЕсли;

	Если Перемещения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Delta = Новый Структура;
	Delta.Вставить("baseSnapshotId", SnapshotId);
	Delta.Вставить("version", ВерсияДанных + 1);
	Delta.Вставить("moves", Перемещения);
	Delta.Вставить("upserts", Новый Массив);
	Delta.Вставить("removed", Новый Массив);
	Delta.Вставить("quality", Новый Массив);

	Попытка
		ОтправитьКомандуСцене(Новый Структура("op,delta", "applyDelta", Delta));
		ВерсияДанных = ВерсияДанных + 1;
		Для Каждого Перемещение Из Перемещения Цикл
			ОбновитьПозициюВИндексе(Перемещение.id, Перемещение.x, Перемещение.y, Перемещение.z);
		КонецЦикла;
	Исключение
		// Первый вызов может произойти до готовности HTML-документа.
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПереместитьОбъектСцены(Идентификатор, X, Y, Z) Экспорт

	Идентификатор = Строка(Идентификатор);
	ОбъектСцены = НайтиОбъектВИндексе(Идентификатор);
	Если ОбъектСцены = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Объект сцены с идентификатором ""%1"" не найден.", Идентификатор);
	КонецЕсли;

	Команда = Новый Структура("op,id,x,y,z", "move", Идентификатор, X, Y, Z);
	ОтправитьКомандуСцене(Команда);
	ОбновитьПозициюВИндексе(Идентификатор, X, Y, Z);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПозициюВИндексе(Идентификатор, X, Y, Z)

	ОбъектСцены = НайтиОбъектВИндексе(Идентификатор);
	Если ОбъектСцены = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОбъектСцены.x = X;
	ОбъектСцены.y = Y;
	ОбъектСцены.z = Z;

КонецПроцедуры

&НаКлиенте
Функция НайтиОбъектВИндексе(Идентификатор)

	Если ИндексОбъектов = Неопределено Тогда
		ПостроитьИндексОбъектов();
	КонецЕсли;
	Возврат ИндексОбъектов.Получить(Идентификатор);

КонецФункции

&НаКлиенте
Функция ЧислоИзАтрибута(Узел, ИмяАтрибута)

	Текст = ПолучитьАтрибутHTML(Узел, ИмяАтрибута);
	Если ПустаяСтрока(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Текст);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

&НаКлиенте
Процедура ОтправитьКомандуСцене(Команда)

	Попытка
		ДокументHTML = Элементы.HTML.Документ;
		УзелКоманд = ДокументHTML.getElementById("scene-command-bridge");
	Исключение
		ВызватьИсключение "Не удалось получить доступ к документу 3D-сцены.";
	КонецПопытки;

	Если УзелКоманд = Неопределено Тогда
		ВызватьИсключение "3D-сцена ещё не готова принимать команды.";
	КонецЕсли;
	Если ПолучитьАтрибутHTML(УзелКоманд, "data-ready") <> "true" Тогда
		ВызватьИсключение "3D-сцена ещё не завершила инициализацию.";
	КонецЕсли;

	НомерКоманды = 0;
	ПредыдущийНомерКоманды = ПолучитьАтрибутHTML(УзелКоманд, "data-seq");
	Если Не ПустаяСтрока(ПредыдущийНомерКоманды) Тогда
		Попытка
			НомерКоманды = Число(ПредыдущийНомерКоманды);
		Исключение
			НомерКоманды = 0;
		КонецПопытки;
	КонецЕсли;
	НомерКоманды = НомерКоманды + 1;
	СтрокаНомераКоманды = Строка(НомерКоманды);

	УзелКоманд.setAttribute("data-error", "");
	УзелКоманд.setAttribute("data-ack", "");
	УзелКоманд.setAttribute("data-payload", СериализоватьJSON(Команда));
	УзелКоманд.setAttribute("data-seq", СтрокаНомераКоманды);
	Попытка
		УзелКоманд.click();
	Исключение
		Попытка
			УзелКоманд.fireEvent("onclick");
		Исключение
			ВызватьИсключение "HTML-движок не поддерживает отправку команд в 3D-сцену.";
		КонецПопытки;
	КонецПопытки;

	Если ПолучитьАтрибутHTML(УзелКоманд, "data-ack") <> СтрокаНомераКоманды Тогда
		ВызватьИсключение "3D-сцена не подтвердила применение команды.";
	КонецЕсли;
	ТекстОшибки = ПолучитьАтрибутHTML(УзелКоманд, "data-error");
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ВызватьИсключение "Ошибка изменения 3D-сцены: " + ТекстОшибки;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция СериализоватьJSON(Значение)

	//@skip-check bsl-legacy-check-type-environments
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	//@skip-check undefined-function-or-procedure
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

&НаКлиенте
Функция ПолучитьАтрибутHTML(Узел, ИмяАтрибута)

	Попытка
		Значение = Узел.getAttribute(ИмяАтрибута);
		Если Значение = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Возврат Строка(Значение);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

&НаКлиенте
Процедура ОбработатьВыборОбъекта(Идентификатор, ВидОбъекта, X, Y, Z) Экспорт

	ОбъектСцены = НайтиОбъектВИндексе(Идентификатор);
	Если ОбъектСцены = Неопределено Тогда
		КарточкаОбъекта = СтрШаблон(
			"%1 (%2) · X=%3 Y=%4 Z=%5 м",
			Идентификатор, ВидОбъекта, X, Y, Z);
		Возврат;
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("%1 · %2", ОбъектСцены.id, ОбъектСцены.kind));
	Если ОбъектСцены.Свойство("blockId") Тогда
		Строки.Добавить(СтрШаблон(
			"Слот %1 / row %2 / bay %3 / tier %4",
			ОбъектСцены.blockId,
			?(ОбъектСцены.Свойство("row"), ОбъектСцены.row, "—"),
			?(ОбъектСцены.Свойство("bay"), ОбъектСцены.bay, "—"),
			?(ОбъектСцены.Свойство("tier"), ОбъектСцены.tier, "—")));
	КонецЕсли;
	Если ОбъектСцены.Свойство("status") Тогда
		Строки.Добавить("Статус: " + ОбъектСцены.status);
	КонецЕсли;
	Если ОбъектСцены.Свойство("observedAt") Тогда
		Строки.Добавить("Наблюдение: " + ОбъектСцены.observedAt);
	КонецЕсли;
	Строки.Добавить(СтрШаблон(
		"Координаты: %1, %2, %3 м",
		Формат(ОбъектСцены.x, "ЧДЦ=3"),
