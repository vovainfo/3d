Процедура ДобавитьСудаУПлощадок(Объекты)

	// Акватория у площадок O: берег ≈ от (1529,711) до (2002,629), направление ~350°.
	// Суда севернее кромки (в воде), корпус вдоль причала.
	УголПричала = 350;
	Зазор = 2;

	Длина1 = 160;
	Ширина1 = 28;
	Объекты.Добавить(Новый Структура(
		"id,kind,name,x,y,z,rotation,color,length,size",
		"SHIP-001", "vessel", "MV Aurora",
		1585, 702 + Ширина1 / 2 + Зазор, 0, УголПричала, "#d7dee8",
		Длина1,
		Новый Структура("length,beam", Длина1, Ширина1)));

	Длина2 = 180;
	Ширина2 = 32;
	Объекты.Добавить(Новый Структура(
		"id,kind,name,x,y,z,rotation,color,length,size",
		"SHIP-002", "vessel", "MV Pacific Star",
		1820, 660 + Ширина2 / 2 + Зазор, 0, УголПричала, "#cfd6e0",
		Длина2,
		Новый Структура("length,beam", Длина2, Ширина2)));

