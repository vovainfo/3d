
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Получает из EDS таблицу актуальных швартовых операций.
//
// Возвращаемое значение:
//  ТаблицаЗначений - строки судов, находящихся у причалов.
Функция ПолучитьСудаИзEDS() Экспорт

	Попытка
		Возврат ВыполнитьЗапросСудаEDS(Истина);
	Исключение
		ОписаниеПервойОшибки = ОписаниеОшибки();
	КонецПопытки;

	Попытка
		Возврат ВыполнитьЗапросСудаEDS(Ложь);
	Исключение
		ВызватьИсключение СтрШаблон(
			"Не удалось получить суда из EDS: %1",
			ОписаниеПервойОшибки);
	КонецПопытки;

КонецФункции

Функция ВыполнитьЗапросСудаEDS(ВключатьРазмерыСудна2)

	Если ВключатьРазмерыСудна2 Тогда
		ТекстЗапроса =
			"ВЫБРАТЬ
			|	ЕДС_ЖурналШвартовыхОпераций.Дата КАК Дата,
			|	ПРЕДСТАВЛЕНИЕ(ЕДС_ЖурналШвартовыхОпераций.Судно) КАК Судно,
			|	ЕДС_ЖурналШвартовыхОпераций.Судно.сДлина КАК СудносДлина,
			|	ЕДС_ЖурналШвартовыхОпераций.Судно.сШирина КАК СудносШирина,
			|	ПРЕДСТАВЛЕНИЕ(ЕДС_ЖурналШвартовыхОпераций.Причал) КАК Причал,
			|	ПРЕДСТАВЛЕНИЕ(ЕДС_ЖурналШвартовыхОпераций.ВидГруза) КАК ВидГруза,
			|	ПРЕДСТАВЛЕНИЕ(ЕДС_ЖурналШвартовыхОпераций.СпособПостановки) КАК СпособПостановки,
			|	ЕДС_ЖурналШвартовыхОпераций.ДатаОтшвартовки КАК ДатаОтшвартовки,
			|	ЕДС_ЖурналШвартовыхОпераций.ВторойБорт КАК ВторойБорт,
			|	ПРЕДСТАВЛЕНИЕ(ЕДС_ЖурналШвартовыхОпераций.Судно2) КАК Судно2,
			|	ЕДС_ЖурналШвартовыхОпераций.Судно2.сДлина КАК Судно2сДлина,
			|	ЕДС_ЖурналШвартовыхОпераций.Судно2.сШирина КАК Судно2сШирина,
			|	ПРЕДСТАВЛЕНИЕ(ЕДС_ЖурналШвартовыхОпераций.ВидГруза2) КАК ВидГруза2,
			|	ЕДС_ЖурналШвартовыхОпераций.Дата2 КАК Дата2,
			|	ЕДС_ЖурналШвартовыхОпераций.ДатаОтшвартовки2 КАК ДатаОтшвартовки2
			|ИЗ
			|	Документ.ЕДС_ЖурналШвартовыхОпераций КАК ЕДС_ЖурналШвартовыхОпераций
			|ГДЕ
			|	ЕДС_ЖурналШвартовыхОпераций.ДатаОтшвартовки = ДАТАВРЕМЯ(1, 1, 1)
			|	И ЕДС_ЖурналШвартовыхОпераций.ПометкаУдаления = ЛОЖЬ";
	Иначе
		ТекстЗапроса =
			"ВЫБРАТЬ
			|	ЕДС_ЖурналШвартовыхОпераций.Дата КАК Дата,
			|	ПРЕДСТАВЛЕНИЕ(ЕДС_ЖурналШвартовыхОпераций.Судно) КАК Судно,
			|	ЕДС_ЖурналШвартовыхОпераций.Судно.сДлина КАК СудносДлина,
			|	ЕДС_ЖурналШвартовыхОпераций.Судно.сШирина КАК СудносШирина,
			|	ПРЕДСТАВЛЕНИЕ(ЕДС_ЖурналШвартовыхОпераций.Причал) КАК Причал,
			|	ПРЕДСТАВЛЕНИЕ(ЕДС_ЖурналШвартовыхОпераций.ВидГруза) КАК ВидГруза,
			|	ПРЕДСТАВЛЕНИЕ(ЕДС_ЖурналШвартовыхОпераций.СпособПостановки) КАК СпособПостановки,
			|	ЕДС_ЖурналШвартовыхОпераций.ДатаОтшвартовки КАК ДатаОтшвартовки,
			|	ЕДС_ЖурналШвартовыхОпераций.ВторойБорт КАК ВторойБорт,
			|	ПРЕДСТАВЛЕНИЕ(ЕДС_ЖурналШвартовыхОпераций.Судно2) КАК Судно2,
			|	ПРЕДСТАВЛЕНИЕ(ЕДС_ЖурналШвартовыхОпераций.ВидГруза2) КАК ВидГруза2,
			|	ЕДС_ЖурналШвартовыхОпераций.Дата2 КАК Дата2,
			|	ЕДС_ЖурналШвартовыхОпераций.ДатаОтшвартовки2 КАК ДатаОтшвартовки2
			|ИЗ
			|	Документ.ЕДС_ЖурналШвартовыхОпераций КАК ЕДС_ЖурналШвартовыхОпераций
			|ГДЕ
			|	ЕДС_ЖурналШвартовыхОпераций.ДатаОтшвартовки = ДАТАВРЕМЯ(1, 1, 1)
			|	И ЕДС_ЖурналШвартовыхОпераций.ПометкаУдаления = ЛОЖЬ";
	КонецЕсли;

	Возврат ВыполнитьЗапросEDS(ТекстЗапроса);

КонецФункции

Функция ВыполнитьЗапросEDS(ТекстЗапроса)

	ПараметрыСервиса = Обработки.d3_v4.ПолучитьWebСервисEDS();
	ПараметрыЗапроса = Новый Структура;
	ОбработкаРС = ПараметрыСервиса.Сервис.ВнешнийЗапрос(
		ТекстЗапроса,
		ЗначениеВСтрокуВнутр(ПараметрыЗапроса),
		ПараметрыСервиса.КодПроверки);
	ТаблицаСудов = ЗначениеИзСтрокиВнутр(ОбработкаРС);
	Если ТипЗнч(ТаблицаСудов) <> Тип("ТаблицаЗначений") Тогда
		ВызватьИсключение "EDS вернул данные, которые не удалось преобразовать в таблицу судов.";
	КонецЕсли;
	Возврат ТаблицаСудов;

КонецФункции

Функция ВыполнитьЗапросУПП(ТекстЗапроса, ПараметрыЗапроса)

	ПараметрыСервиса = Обработки.d3_v4.ПолучитьWebСервисУПП();
	ОбработкаРС = ПараметрыСервиса.Сервис.ВнешнийЗапрос(
		ТекстЗапроса,
		ЗначениеВСтрокуВнутр(ПараметрыЗапроса),
		ПараметрыСервиса.КодПроверки);
	ТаблицаВагонов = ЗначениеИзСтрокиВнутр(ОбработкаРС);
	Если ТипЗнч(ТаблицаВагонов) <> Тип("ТаблицаЗначений") Тогда
		ВызватьИсключение "УПП вернул данные, которые не удалось преобразовать в таблицу вагонов.";
	КонецЕсли;
	Возврат ТаблицаВагонов;

КонецФункции

Функция ВыполнитьЗапросУКТ(ТекстЗапроса, ПараметрыЗапроса)

	ПараметрыСервиса = Обработки.d3_v4.ПолучитьWebСервисУКТ();
	ОбработкаРС = ПараметрыСервиса.Сервис.ВнешнийЗапрос(
		ТекстЗапроса,
		ЗначениеВСтрокуВнутр(ПараметрыЗапроса),
		ПараметрыСервиса.КодПроверки);
	ТаблицаНаполнения = ЗначениеИзСтрокиВнутр(ОбработкаРС);
	Если ТипЗнч(ТаблицаНаполнения) <> Тип("ТаблицаЗначений") Тогда
		ВызватьИсключение "УКТ вернул данные, которые не удалось преобразовать в таблицу наполнения площадок.";
	КонецЕсли;
	Возврат ТаблицаНаполнения;

КонецФункции

// Получает из УКТ актуальную высоту стопки в каждой занятой ячейке.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Зона, Стек, Ряд, Ярусов.
Функция ПолучитьНаполнениеПлощадокИзУКТ() Экспорт

	ТекстЗапроса =
		"ВЫБРАТЬ
		|	ОстаткиКонтейнеров.ЯчейкаХранения КАК ЯчейкаХранения,
		|	КОЛИЧЕСТВО(ОстаткиКонтейнеров.Контейнер) КАК Ярусов
		|ПОМЕСТИТЬ ВТ_Ячейки
		|ИЗ
		|	РегистрСведений.ОстаткиКонтейнеров КАК ОстаткиКонтейнеров
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиКонтейнеров.ЯчейкаХранения
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ЯчейкаХранения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Ячейки.ЯчейкаХранения.Владелец.КраткоеНаименование КАК Зона,
		|	ВТ_Ячейки.ЯчейкаХранения.Стек КАК Стек,
		|	ВТ_Ячейки.ЯчейкаХранения.Ряд КАК Ряд,
		|	ВТ_Ячейки.Ярусов КАК Ярусов
		|ИЗ
		|	ВТ_Ячейки КАК ВТ_Ячейки";

	Возврат ВыполнитьЗапросУКТ(ТекстЗапроса, Новый Структура);

КонецФункции

// Получает из УПП таблицу вагонов на ЖД-путях терминала.
//
// Возвращаемое значение:
//  ТаблицаЗначений - строки вагонов на путях ОУВиСц.
Функция ПолучитьВагоныИзУПП() Экспорт

	ТекстЗапроса =
		"ВЫБРАТЬ
		|	Остатки.ЖДПуть КАК ЖДПуть,
		|	Остатки.Вагон КАК Вагон,
		|	Выбор
		|		Когда Остатки.Вагон.ДлинаВагона = 0 Тогда 20
		|		Иначе Остатки.Вагон.ДлинаВагона
		|	Конец ВагонДлина,
		|	Остатки.Вагон.Наименование КАК ВагонНаименование,
		|	Остатки.ПорядковыйНомер КАК ПорядковыйНомер
		|ПОМЕСТИТЬ ВТ_Остатки
		|ИЗ
		|	РегистрСведений.ОстаткиВагоновНаЖДПутях КАК Остатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.МестаЖД КАК МестаЖД
		|		ПО Остатки.ЖДПуть = МестаЖД.Ссылка
		|			И МестаЖД.ОУВиСц
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОперацияСВагоном.Вагон КАК Вагон,
		|	ОперацияСВагоном.Ссылка КАК Ссылка,
		|	ОперацияСВагоном.Операция КАК Операция,
		|	ОперацияСВагоном.Дата КАК Дата,
		|	ОперацияСВагоном.ОперацияЗавершена КАК ОперацияЗавершена,
		|	ОперацияСВагоном.ОткудаПоступил КАК ОткудаПоступил
		|ПОМЕСТИТЬ ВТ_Операции
		|ИЗ
		|	Документ.ОперацияСВагоном КАК ОперацияСВагоном
		|ГДЕ
		|	ОперацияСВагоном.Дата >= &НачальнаяДата
		|	И ОперацияСВагоном.Проведен
		|	И НЕ ОперацияСВагоном.ПометкаУдаления
		|	И ОперацияСВагоном.Вагон В
		|			(ВЫБРАТЬ
		|				ВТ_Остатки.ВагонНаименование
		|			ИЗ
		|				ВТ_Остатки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Последние.Вагон КАК Вагон,
		|	ВТ_Операции.Ссылка КАК Ссылка,
		|	ВТ_Операции.Операция КАК Операция,
		|	ВТ_Операции.ОперацияЗавершена КАК ОперацияЗавершена,
		|	ВТ_Операции.ОткудаПоступил КАК ОткудаПоступил
		|ПОМЕСТИТЬ ВТ_ПоследниеОперации
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВТ_Операции.Вагон КАК Вагон,
		|		МАКСИМУМ(ВТ_Операции.Дата) КАК Дата
		|	ИЗ
		|		ВТ_Операции КАК ВТ_Операции
		|
		|	СГРУППИРОВАТЬ ПО
		|		ВТ_Операции.Вагон) КАК Последние
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Операции КАК ВТ_Операции
		|		ПО Последние.Вагон = ВТ_Операции.Вагон
		|			И Последние.Дата = ВТ_Операции.Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МестаЖД.Код КАК Путь,
		|	ВТ_Остатки.ПорядковыйНомер КАК Порядок,
		|	ВТ_Остатки.ВагонДлина КАК ВагонДлина,
		|	ВТ_Остатки.ВагонНаименование КАК НомерВагона,
		|	Представление(ЕСТЬNULL(ВТ_ПоследниеОперации.Ссылка.ТипВагона, ВТ_Остатки.Вагон.ТипВагона)) КАК ТипВагона,
		|	ВЫБОР
		|		КОГДА ВТ_ПоследниеОперации.ОткудаПоступил = ЗНАЧЕНИЕ(Перечисление.ОткудаПоступилВагон.СоСтанции)
		|				И ВТ_ПоследниеОперации.Операция = ЗНАЧЕНИЕ(Справочник.ОперацииСВагонами.Выгрузка)
		|				И НЕ ВТ_ПоследниеОперации.ОперацияЗавершена
		|			ТОГДА Истина
		|		КОГДА ВТ_ПоследниеОперации.ОткудаПоступил = ЗНАЧЕНИЕ(Перечисление.ОткудаПоступилВагон.ИзПодВыгрузки)
		|				И ВТ_ПоследниеОперации.Операция = ЗНАЧЕНИЕ(Справочник.ОперацииСВагонами.Погрузка)
		|				И ВТ_ПоследниеОперации.ОперацияЗавершена
		|			ТОГДА Истина
		|		КОГДА ВТ_ПоследниеОперации.ОткудаПоступил = ЗНАЧЕНИЕ(Перечисление.ОткудаПоступилВагон.СоСтанции)
		|				И ВТ_ПоследниеОперации.Операция = ЗНАЧЕНИЕ(Справочник.ОперацииСВагонами.Погрузка)
		|				И ВТ_ПоследниеОперации.ОперацияЗавершена
		|			ТОГДА Истина
		|		ИНАЧЕ Ложь
		|	КОНЕЦ КАК Груженый
		|ИЗ
		|	ВТ_Остатки КАК ВТ_Остатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.МестаЖД КАК МестаЖД
		|		ПО ВТ_Остатки.ЖДПуть = МестаЖД.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПоследниеОперации КАК ВТ_ПоследниеОперации
		|		ПО ВТ_Остатки.ВагонНаименование = ВТ_ПоследниеОперации.Вагон
		|
		|УПОРЯДОЧИТЬ ПО
		|	Путь,
		|	Порядок УБЫВ";

	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("НачальнаяДата", ТекущаяДатаСеанса() - 180 * 86400);
	Возврат ВыполнитьЗапросУПП(ТекстЗапроса, ПараметрыЗапроса);

КонецФункции

// Получает из EDS таблицу судов, стоящих на рейде.
//
// Возвращаемое значение:
//  ТаблицаЗначений - строки рейсов без швартовки с постановкой на рейд.
Функция ПолучитьСудаРейдаИзEDS() Экспорт

	ТекстЗапроса =
		"ВЫБРАТЬ
		|	ЕДС_Рейс.Ссылка КАК Ссылка,
		|	ЕДС_Рейс.Судозаход КАК Судозаход,
		|	ЕДС_Рейс.Судно КАК Судно,
		|	ЕДС_Рейс.ВидГруза КАК ВидГруза,
		|	ЕДС_Рейс.Причал КАК Причал,
		|	ЕДС_Рейс.ДатаВремяПланПодходаКПричалу КАК ДатаВремяПланПодходаКПричалу,
		|	ЕДС_Рейс.КоличествоКонтейнеров10План КАК КоличествоКонтейнеров10План,
		|	ЕДС_Рейс.КоличествоКонтейнеров20План КАК КоличествоКонтейнеров20План,
		|	ЕДС_Рейс.КоличествоКонтейнеров40План КАК КоличествоКонтейнеров40План,
		|	ЕДС_Рейс.СтатусОбработкиСудна КАК СтатусОбработкиСудна
		|ПОМЕСТИТЬ ВТ_Погрузка
		|ИЗ
		|	Документ.ЕДС_Рейс КАК ЕДС_Рейс
		|ГДЕ
		|	ЕДС_Рейс.ДатаВремяШвартовки = ДАТАВРЕМЯ(1, 1, 1)
		|	И НЕ ЕДС_Рейс.СтатусОбработкиСудна В (ЗНАЧЕНИЕ(Перечисление.ЕДС_СтатусыОбработкиСудна.Отменен), ЗНАЧЕНИЕ(Перечисление.ЕДС_СтатусыОбработкиСудна.Планируемый))
		|	И ЕДС_Рейс.ДатаВремяПостановкиНаРейд <> ДАТАВРЕМЯ(1, 1, 1)
		|	И НЕ ЕДС_Рейс.ПометкаУдаления
		|	И ЕДС_Рейс.Погрузка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕДС_Рейс.Ссылка КАК Ссылка,
		|	ЕДС_Рейс.Судозаход КАК Судозаход,
		|	ЕДС_Рейс.Судно КАК Судно,
		|	ЕДС_Рейс.ВидГруза КАК ВидГруза,
		|	ЕДС_Рейс.Причал КАК Причал,
		|	ЕДС_Рейс.ДатаВремяПланПодходаКПричалу КАК ДатаВремяПланПодходаКПричалу,
		|	ЕДС_Рейс.КоличествоКонтейнеров10План КАК КоличествоКонтейнеров10План,
		|	ЕДС_Рейс.КоличествоКонтейнеров20План КАК КоличествоКонтейнеров20План,
		|	ЕДС_Рейс.КоличествоКонтейнеров40План КАК КоличествоКонтейнеров40План,
		|	ЕДС_Рейс.СтатусОбработкиСудна КАК СтатусОбработкиСудна
		|ПОМЕСТИТЬ ВТ_Выгрузка
		|ИЗ
		|	Документ.ЕДС_Рейс КАК ЕДС_Рейс
		|ГДЕ
		|	ЕДС_Рейс.ДатаВремяШвартовки = ДАТАВРЕМЯ(1, 1, 1)
		|	И НЕ ЕДС_Рейс.СтатусОбработкиСудна В (ЗНАЧЕНИЕ(Перечисление.ЕДС_СтатусыОбработкиСудна.Отменен), ЗНАЧЕНИЕ(Перечисление.ЕДС_СтатусыОбработкиСудна.Планируемый))
		|	И ЕДС_Рейс.ДатаВремяПостановкиНаРейд <> ДАТАВРЕМЯ(1, 1, 1)
		|	И НЕ ЕДС_Рейс.ПометкаУдаления
		|	И ЕДС_Рейс.Выгрузка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ВТ_Выгрузка.Судозаход, ВТ_Погрузка.Судозаход) КАК Судозаход,
		|	ЕСТЬNULL(ВТ_Выгрузка.Судно, ВТ_Погрузка.Судно) КАК Судно,
		|	ЕСТЬNULL(ВТ_Выгрузка.ВидГруза, ВТ_Погрузка.ВидГруза) КАК ВидГруза,
		|	ЕСТЬNULL(ВТ_Выгрузка.Причал, ВТ_Погрузка.Причал) КАК Причал,
		|	ЕСТЬNULL(ВТ_Выгрузка.ДатаВремяПланПодходаКПричалу, ВТ_Погрузка.ДатаВремяПланПодходаКПричалу) КАК ДатаВремяПланПодходаКПричалу,
		|	ЕСТЬNULL(ВТ_Выгрузка.КоличествоКонтейнеров10План, 0) КАК Выгрузка10,
		|	ЕСТЬNULL(ВТ_Выгрузка.КоличествоКонтейнеров20План, 0) КАК Выгрузка20,
		|	ЕСТЬNULL(ВТ_Выгрузка.КоличествоКонтейнеров40План, 0) КАК Выгрузка40,
		|	ЕСТЬNULL(ВТ_Погрузка.КоличествоКонтейнеров10План, 0) КАК Погрузка10,
		|	ЕСТЬNULL(ВТ_Погрузка.КоличествоКонтейнеров20План, 0) КАК Погрузка20,
		|	ЕСТЬNULL(ВТ_Погрузка.КоличествоКонтейнеров40План, 0) КАК Погрузка40
		|ПОМЕСТИТЬ ВТ_ВСЕ
		|ИЗ
		|	ВТ_Погрузка КАК ВТ_Погрузка
		|		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_Выгрузка КАК ВТ_Выгрузка
		|		ПО (ВТ_Выгрузка.Судозаход = ВТ_Погрузка.Судозаход)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ВСЕ.Судозаход КАК Судозаход,
		|	Представление(ВТ_ВСЕ.Судно) КАК Судно,
		|	Представление(ВТ_ВСЕ.ВидГруза) КАК ВидГруза,
		|	Представление(ВТ_ВСЕ.Причал) КАК Причал,
		|	ВТ_ВСЕ.ДатаВремяПланПодходаКПричалу КАК ДатаВремяПланПодходаКПричалу,
		|	ВТ_ВСЕ.Выгрузка10 КАК Выгрузка10,
		|	ВТ_ВСЕ.Выгрузка20 КАК Выгрузка20,
		|	ВТ_ВСЕ.Выгрузка40 КАК Выгрузка40,
		|	ВТ_ВСЕ.Погрузка10 КАК Погрузка10,
		|	ВТ_ВСЕ.Погрузка20 КАК Погрузка20,
		|	ВТ_ВСЕ.Погрузка40 КАК Погрузка40,
		|	ВТ_ВСЕ.Судно.сДлина КАК СудноДлина,
		|	ВТ_ВСЕ.Судно.сШирина КАК СудноШирина
		|ИЗ
		|	ВТ_ВСЕ КАК ВТ_ВСЕ
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаВремяПланПодходаКПричалу";
	Возврат ВыполнитьЗапросEDS(ТекстЗапроса);

КонецФункции

// Получает актуальные суда EDS и преобразует их в объекты сцены.
//
// Возвращаемое значение:
//  Структура:
//   * Объекты - Массив из Структура - суда для сцены;
//   * Предупреждения - Массив из Строка - пропущенные или исправленные данные EDS.
Функция СобратьСудаEDS() Экспорт

	Если Не Константы.ПолучениеРеальныхДанных.Получить() Тогда
		ВызватьИсключение "Режим реальных данных отключен константой ПолучениеРеальныхДанных.";
	КонецЕсли;

	Ошибки = Новый Массив;
	ТекстПричалов = ПолучитьТекстМакета("BerthsV4_json", Ошибки);
	ТекстПараметровСцены = ПолучитьТекстМакета("SceneOrigin_txt", Ошибки);
	ОписаниеПричалов = ПрочитатьJSONИзСтроки(ТекстПричалов, "BerthsV4_json", Ошибки);
	ПараметрыСцены = ПрочитатьПараметрыСцены(ТекстПараметровСцены, Ошибки);
	Если Ошибки.Количество() > 0 Тогда
		ВызватьИсключение "Ошибка данных причалов:" + Символы.ПС + СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;

	Предупреждения = Новый Массив;
	Объекты = СобратьСудаИзEDS(
		ОписаниеПричалов,
		ПолучитьСудаИзEDS(),
		ПараметрыСцены,
		Предупреждения);
	ДополнитьОбъектыСудамиРейда(Объекты, ОписаниеПричалов, ПараметрыСцены, Ошибки, Предупреждения);
	Если Ошибки.Количество() > 0 Тогда
		ВызватьИсключение "Ошибка данных рейда:" + Символы.ПС + СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Объекты", Объекты);
	Результат.Вставить("Предупреждения", Предупреждения);
	Возврат Результат;

КонецФункции

// Получает актуальные вагоны УПП и преобразует их в объекты сцены.
//
// Возвращаемое значение:
//  Структура:
//   * Объекты - Массив из Структура - вагоны для сцены;
//   * Предупреждения - Массив из Строка - пропущенные или исправленные данные УПП.
Функция СобратьВагоныУПП() Экспорт

	Если Не Константы.ПолучениеРеальныхДанных.Получить() Тогда
		ВызватьИсключение "Режим реальных данных отключен константой ПолучениеРеальныхДанных.";
	КонецЕсли;

	Ошибки = Новый Массив;
	ТекстЖелезныхДорог = ПолучитьТекстМакета("RailwaysV4_json", Ошибки);
	ТекстПараметровСцены = ПолучитьТекстМакета("SceneOrigin_txt", Ошибки);
	ОписаниеЖелезныхДорог = ПрочитатьJSONИзСтроки(ТекстЖелезныхДорог, "RailwaysV4_json", Ошибки);
	ПараметрыСцены = ПрочитатьПараметрыСцены(ТекстПараметровСцены, Ошибки);
	Если Ошибки.Количество() > 0 Тогда
		ВызватьИсключение "Ошибка данных железной дороги:" + Символы.ПС + СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;
	Если Не ОписаниеЖелезныхДорог.Свойство("schemaVersion")
		Или ОписаниеЖелезныхДорог.schemaVersion <> "4.0"
		Или Не ОписаниеЖелезныхДорог.Свойство("visualPaths")
		Или Не ОписаниеЖелезныхДорог.Свойство("branches") Тогда
		ВызватьИсключение "RailwaysV4_json: неверный формат";
	КонецЕсли;

	Предупреждения = Новый Массив;
	ОписаниеЖелезныхДорог.Вставить("trains", СобратьСоставыИзУПП(
		ПолучитьВагоныИзУПП(),
		ОписаниеЖелезныхДорог,
		Предупреждения));
	ЖелезнаяДорога = СобратьЖелезнуюДорогу(ОписаниеЖелезныхДорог, ПараметрыСцены, Ошибки, Предупреждения);
	Если Ошибки.Количество() > 0 Тогда
		ВызватьИсключение "Ошибка размещения вагонов УПП:" + Символы.ПС + СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Объекты", ЖелезнаяДорога.Вагоны);
	Результат.Вставить("Предупреждения", Предупреждения);
	Возврат Результат;

КонецФункции

// Получает актуальное наполнение УКТ и преобразует его в размещения сцены.
//
// Возвращаемое значение:
//  Структура:
//   * Объекты - Массив из Структура - условные 20-футовые размещения;
//   * Предупреждения - Массив из Строка - пропущенные строки УКТ.
Функция СобратьРазмещенияУКТ() Экспорт

	Если Не Константы.ПолучениеРеальныхДанных.Получить() Тогда
		ВызватьИсключение "Режим реальных данных отключен константой ПолучениеРеальныхДанных.";
	КонецЕсли;

	Ошибки = Новый Массив;
	Layout = ПрочитатьJSONИзСтроки(
		ПолучитьТекстМакета("TerminalLayoutV4_json", Ошибки),
		"TerminalLayoutV4_json",
		Ошибки);
	GeoПлощадки = ПрочитатьJSONИзСтроки(
		ПолучитьТекстМакета("ContainerSitesV4_geojson", Ошибки),
		"ContainerSitesV4_geojson",
		Ошибки);
	GeoОси = ПрочитатьJSONИзСтроки(
		ПолучитьТекстМакета("ContainerSiteBayAxesV4_geojson", Ошибки),
		"ContainerSiteBayAxesV4_geojson",
		Ошибки);
	ПараметрыСцены = ПрочитатьПараметрыСцены(
		ПолучитьТекстМакета("SceneOrigin_txt", Ошибки),
		Ошибки);
	Если Ошибки.Количество() > 0 Тогда
		ВызватьИсключение "Ошибка данных контейнерных площадок:" + Символы.ПС
			+ СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;

	ТопологияПлощадок = СобратьТопологиюКонтейнерныхПлощадок(
		Layout,
		GeoПлощадки,
		GeoОси,
		ПараметрыСцены,
		Ошибки);
	Если Ошибки.Количество() > 0 Тогда
		ВызватьИсключение "Ошибка топологии контейнерных площадок:" + Символы.ПС
			+ СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;

	Предупреждения = Новый Массив;
	Размещения = СобратьРазмещенияИзУКТ(
		ПолучитьНаполнениеПлощадокИзУКТ(),
		ТопологияПлощадок.Ячейки,
		Предупреждения);

	Результат = Новый Структура;
	Результат.Вставить("Объекты", Размещения);
	Результат.Вставить("Предупреждения", Предупреждения);
	Возврат Результат;

КонецФункции


// Формирует HTML и статический снимок сцены из макетов V4.
//
// Возвращаемое значение:
//  Структура - HTML, JSON сцены, идентификатор снимка и состояние загрузки.
Функция СобратьHTMLСцены() Экспорт

	HTMLДокумент = ПолучитьМакет("МакетHTML").ПолучитьТекст();
	КодJavaScript = ПолучитьМакет("МакетJS").ПолучитьТекст();
	Стили = ПолучитьМакет("МакетCSS").ПолучитьТекст();

	HTMLДокумент = СтрЗаменить(HTMLДокумент, "@CSS", Стили);
	HTMLДокумент = СтрЗаменить(HTMLДокумент, "@JS", КодJavaScript);

	Снимок = ПолучитьСнимок();
	JSONСцены = СериализоватьJSON(Снимок.ДанныеСцены);
	JSONСцены = СтрЗаменить(JSONСцены, "</", "<\/");
	HTMLДокумент = СтрЗаменить(HTMLДокумент, "@SceneData", JSONСцены);

	Результат = Новый Структура;
	Результат.Вставить("HTML", HTMLДокумент);
	Результат.Вставить("ДанныеСценыJSON", JSONСцены);
	Результат.Вставить("SnapshotId", Снимок.SnapshotId);
	Результат.Вставить("СостояниеОбмена", Снимок.СостояниеОбмена);
	Возврат Результат;

КонецФункции

// Читает, проверяет и собирает статический снимок из макетов данных V4.
//
// Возвращаемое значение:
//  Структура - снимок сцены.
Функция ПолучитьСнимок() Экспорт

	РезультатСборки = СобратьСценуИзМакетов();
	ДополнениеСостояния = "";
	Предупреждения = Новый Массив;
	Для Каждого ТекстПредупреждения Из РезультатСборки.ПредупрежденияСудов Цикл
		Предупреждения.Добавить(ТекстПредупреждения);
	КонецЦикла;
	Для Каждого ТекстПредупреждения Из РезультатСборки.ПредупрежденияВагонов Цикл
		Предупреждения.Добавить(ТекстПредупреждения);
	КонецЦикла;
	Для Каждого ТекстПредупреждения Из РезультатСборки.ПредупрежденияКонтейнеров Цикл
		Предупреждения.Добавить(ТекстПредупреждения);
	КонецЦикла;
	Если Предупреждения.Количество() > 0 Тогда
		ДополнениеСостояния = " · " + СтрСоединить(Предупреждения, "; ");
	КонецЕсли;
	Снимок = Новый Структура;
	Снимок.Вставить("SnapshotId", "v4-" + РезультатСборки.BuildId);
	Снимок.Вставить("ДанныеСцены", РезультатСборки.Сцена);
	Снимок.Вставить("СостояниеОбмена", СтрШаблон(
		"макеты V4 · суда: %1 (%2) · рейд %3 (%4) · вагоны: %5 (%6) · площадок %7 · ячеек %8 · ж/д веток %9",
		РезультатСборки.ИсточникСудов,
		РезультатСборки.КоличествоСудов,
		РезультатСборки.ИсточникСудовНаРейде,
		РезультатСборки.КоличествоСудовНаРейде,
		РезультатСборки.ИсточникВагонов,
		РезультатСборки.КоличествоВагонов,
		РезультатСборки.КоличествоПлощадок,
		РезультатСборки.КоличествоЯчеек,
		РезультатСборки.КоличествоЖДВеток)
		+ СтрШаблон(
			" · контейнеры: %1 (%2) · составов %3",
			РезультатСборки.ИсточникКонтейнеров,
			РезультатСборки.КоличествоРазмещений,
			РезультатСборки.КоличествоСоставов)
		+ ДополнениеСостояния);
	Возврат Снимок;

КонецФункции

// Читает актуальные положения техники из среза последних регистра Скаут.
// На сцену попадают только записи с Отображать = Истина.
//
// Возвращаемое значение:
//  Массив - объекты сцены вида scoutVehicle.
Функция СобратьТехникуСкаут() Экспорт

	Результат = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Положение.Идентификатор КАК Идентификатор,
	|	Положение.Наименование КАК Наименование,
	|	Положение.ТипТехники КАК ТипТехники,
	|	Положение.Широта КАК Широта,
	|	Положение.Долгота КАК Долгота,
	|	Положение.КоординатаX КАК КоординатаX,
	|	Положение.КоординатаY КАК КоординатаY
	|ИЗ
	|	РегистрСведений.ПоложениеТехникиСкаут.СрезПоследних КАК Положение
	|ГДЕ
	|	Положение.Отображать";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Выборка.Идентификатор) Тогда
			Продолжить;
		КонецЕсли;
		Если Выборка.Широта = 0 И Выборка.Долгота = 0 Тогда
			Продолжить;
		КонецЕсли;

		Техника = Новый Структура;
		Техника.Вставить("id", "scout-" + Формат(Выборка.Идентификатор, "ЧГ=0"));
		Техника.Вставить("kind", "scoutVehicle");
		Техника.Вставить("name", Строка(Выборка.Наименование));
		Техника.Вставить("equipmentType", Строка(Выборка.ТипТехники));
		Техника.Вставить("x", Выборка.КоординатаX);
		Техника.Вставить("y", Выборка.КоординатаY);
		Техника.Вставить("z", 0);
		Техника.Вставить("rotation", 0);
		Техника.Вставить("color", "#1769aa");
		Результат.Добавить(Техника);
	КонецЦикла;
	Возврат Результат;

КонецФункции

