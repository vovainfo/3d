Функция ПолучитьВершиныПолигона(Feature, ПараметрыСцены, Имя, Ошибки)

	Результат = Новый Массив;
	Если Feature.geometry.type <> "Polygon" Тогда
		ДобавитьОшибку(Ошибки, Имя + ": ожидается Polygon");
		Возврат Результат;
	КонецЕсли;
	Кольцо = Feature.geometry.coordinates[0];
	Для Индекс = 0 По Кольцо.ВГраница() Цикл
		Если Индекс = Кольцо.ВГраница()
			И Кольцо[Индекс][0] = Кольцо[0][0]
			И Кольцо[Индекс][1] = Кольцо[0][1] Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(ПреобразоватьКоординаты(Кольцо[Индекс], ПараметрыСцены));
	КонецЦикла;
	Если Результат.Количество() <> 4 Тогда
		ДобавитьОшибку(Ошибки, Имя + ": прямоугольник должен иметь четыре вершины");
	КонецЕсли;
	Возврат Результат;

