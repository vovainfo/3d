Функция ПолучитьТочкиЛинии(Feature, ПараметрыСцены, Имя, Ошибки)

	Результат = Новый Массив;
	Если Feature.geometry.type <> "LineString" Или Feature.geometry.coordinates.Количество() <> 2 Тогда
		ДобавитьОшибку(Ошибки, Имя + ": ожидается LineString из двух точек");
		Возврат Результат;
	КонецЕсли;
	Для Каждого Координаты Из Feature.geometry.coordinates Цикл
		Результат.Добавить(ПреобразоватьКоординаты(Координаты, ПараметрыСцены));
	КонецЦикла;
	Возврат Результат;

