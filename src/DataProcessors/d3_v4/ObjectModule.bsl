			Продолжить;
		КонецЕсли;
		Идентификатор = СокрЛП(Строка(Feature.properties.id));
		Имя = СокрЛП(Строка(Feature.properties.name));
		Цвет = Строка(Feature.properties.color);
		Если ПустаяСтрока(Идентификатор) Или ПустаяСтрока(Имя) Тогда
			ДобавитьОшибку(Ошибки, "Buildings_geojson: id и name не должны быть пустыми");
			Продолжить;
		КонецЕсли;
		Если СтрДлина(Цвет) <> 7 Или Лев(Цвет, 1) <> "#" Тогда
			ДобавитьОшибку(Ошибки, "Buildings_geojson: color должен иметь формат #RRGGBB");
			Продолжить;
		КонецЕсли;
		Если Идентификаторы.Получить(Идентификатор) <> Неопределено Тогда
			ДобавитьОшибку(Ошибки, "Buildings_geojson: повтор " + Идентификатор);
			Продолжить;
		КонецЕсли;
		Идентификаторы.Вставить(Идентификатор, Истина);

		Если Не Feature.Свойство("geometry")
			Или Feature.geometry.type <> "Polygon"
			Или Feature.geometry.coordinates.Количество() <> 1 Тогда
			ДобавитьОшибку(Ошибки, "Buildings_geojson: для " + Идентификатор + " ожидается Polygon без внутренних колец");
			Продолжить;
		КонецЕсли;
		КоординатыКольца = Feature.geometry.coordinates[0];
		Вершины = Новый Массив;
		Для Индекс = 0 По КоординатыКольца.ВГраница() Цикл
			Если Индекс = КоординатыКольца.ВГраница()
				И КоординатыКольца[Индекс][0] = КоординатыКольца[0][0]
				И КоординатыКольца[Индекс][1] = КоординатыКольца[0][1] Тогда
				Продолжить;
			КонецЕсли;
			Вершины.Добавить(ПреобразоватьКоординаты(КоординатыКольца[Индекс], ПараметрыСцены));
		КонецЦикла;
		Если Вершины.Количество() < 3 Тогда
			ДобавитьОшибку(Ошибки, "Buildings_geojson: полигон " + Идентификатор + " содержит менее трех вершин");
			Продолжить;
		КонецЕсли;

		Центр = СредняяТочка(Вершины);
		Здание = Новый Структура;
		Здание.Вставить("id", Идентификатор);
		Здание.Вставить("kind", "building");
		Здание.Вставить("name", Имя);
		Здание.Вставить("color", Цвет);
		Здание.Вставить("x", Центр.x);
		Здание.Вставить("y", Центр.y);
		Здание.Вставить("polygon", Вершины);
		Результат.Добавить(Здание);
	КонецЦикла;
	Возврат Результат;

