Функция СобратьСценуИзМакетов()

	Ошибки = Новый Массив;
	ТекстМакетов = Новый Структура;
	ТекстМакетов.Вставить("Layout", ПолучитьТекстМакета("TerminalLayoutV4_json", Ошибки));
	ТекстМакетов.Вставить("Origin", ПолучитьТекстМакета("SceneOrigin_txt", Ошибки));
	ТекстМакетов.Вставить("Shoreline", ПолучитьТекстМакета("Shoreline_geojson", Ошибки));
	ТекстМакетов.Вставить("Water", ПолучитьТекстМакета("Water_geojson", Ошибки));
	ТекстМакетов.Вставить("Buildings", ПолучитьТекстМакета("Buildings_geojson", Ошибки));
	ТекстМакетов.Вставить("Roads", ПолучитьТекстМакета("Roads_geojson", Ошибки));
	ТекстМакетов.Вставить("PortBoundary", ПолучитьТекстМакета("PortBoundary_geojson", Ошибки));
	ТекстМакетов.Вставить("Berths", ПолучитьТекстМакета("BerthsV4_json", Ошибки));
	ТекстМакетов.Вставить("Vessels", ПолучитьТекстМакета("VesselsV4_json", Ошибки));
	ТекстМакетов.Вставить("Cranes", ПолучитьТекстМакета("CranesV4_json", Ошибки));
	ТекстМакетов.Вставить("Railways", ПолучитьТекстМакета("RailwaysV4_json", Ошибки));
	ТекстМакетов.Вставить("Anchorage", ПолучитьТекстМакета("Anchorage_geojson", Ошибки));
	ТекстМакетов.Вставить("AnchorageVessels", ПолучитьТекстМакета("AnchorageVessels_json", Ошибки));
	ТекстМакетов.Вставить("Sites", ПолучитьТекстМакета("ContainerSitesV4_geojson", Ошибки));
	ТекстМакетов.Вставить("Axes", ПолучитьТекстМакета("ContainerSiteBayAxesV4_geojson", Ошибки));
	ТекстМакетов.Вставить("Manifest", ПолучитьТекстМакета("SceneManifestV4_json", Ошибки));

	Layout = ПрочитатьJSONИзСтроки(ТекстМакетов.Layout, "TerminalLayoutV4_json", Ошибки);
	GeoБерег = ПрочитатьJSONИзСтроки(ТекстМакетов.Shoreline, "Shoreline_geojson", Ошибки);
	GeoВода = ПрочитатьJSONИзСтроки(ТекстМакетов.Water, "Water_geojson", Ошибки);
	GeoЗдания = ПрочитатьJSONИзСтроки(ТекстМакетов.Buildings, "Buildings_geojson", Ошибки);
	GeoДороги = ПрочитатьJSONИзСтроки(ТекстМакетов.Roads, "Roads_geojson", Ошибки);
	GeoГраницаПорта = ПрочитатьJSONИзСтроки(ТекстМакетов.PortBoundary, "PortBoundary_geojson", Ошибки);
	ОписаниеПричалов = ПрочитатьJSONИзСтроки(ТекстМакетов.Berths, "BerthsV4_json", Ошибки);
	ОписаниеСудов = ПрочитатьJSONИзСтроки(ТекстМакетов.Vessels, "VesselsV4_json", Ошибки);
	ОписаниеКранов = ПрочитатьJSONИзСтроки(ТекстМакетов.Cranes, "CranesV4_json", Ошибки);
	ОписаниеЖелезныхДорог = ПрочитатьJSONИзСтроки(ТекстМакетов.Railways, "RailwaysV4_json", Ошибки);
	GeoРейд = ПрочитатьJSONИзСтроки(ТекстМакетов.Anchorage, "Anchorage_geojson", Ошибки);
	ОписаниеСудовРейда = ПрочитатьJSONИзСтроки(ТекстМакетов.AnchorageVessels, "AnchorageVessels_json", Ошибки);
	GeoПлощадки = ПрочитатьJSONИзСтроки(ТекстМакетов.Sites, "ContainerSitesV4_geojson", Ошибки);
	GeoОси = ПрочитатьJSONИзСтроки(ТекстМакетов.Axes, "ContainerSiteBayAxesV4_geojson", Ошибки);
	Манифест = ПрочитатьJSONИзСтроки(ТекстМакетов.Manifest, "SceneManifestV4_json", Ошибки);
	ПараметрыСцены = ПрочитатьПараметрыСцены(ТекстМакетов.Origin, Ошибки);

	ПроверитьКорневыеДанные(
		Layout,
		GeoБерег,
		GeoВода,
		GeoЗдания,
		GeoДороги,
		GeoГраницаПорта,
		ОписаниеПричалов,
		ОписаниеСудов,
		ОписаниеКранов,
		ОписаниеЖелезныхДорог,
		GeoРейд,
		ОписаниеСудовРейда,
		GeoПлощадки,
		GeoОси,
		Манифест,
		ПараметрыСцены,
		Ошибки);
	ПроверитьКомплектМакетов(Манифест, ТекстМакетов, Ошибки);
	Если Ошибки.Количество() > 0 Тогда
		ВызватьИсключение "Ошибка данных сцены V4:" + Символы.ПС + СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;

	Сцена = Новый Структура;
	Сцена.Вставить("version", 4);
	Сцена.Вставить("units", "m");
	Сцена.Вставить("view", "top");

	БереговаяЛиния = СобратьБереговуюЛинию(GeoБерег, ПараметрыСцены, Ошибки);
	КольцаВоды = СобратьКольцаВоды(GeoВода, ПараметрыСцены, Ошибки);
	ЗданияСцены = СобратьЗдания(GeoЗдания, ПараметрыСцены, Ошибки);
	ДорогиСцены = СобратьДороги(GeoДороги, ПараметрыСцены, Ошибки);
	ГраницаПортаСцены = СобратьГраницуПорта(GeoГраницаПорта, ПараметрыСцены, Ошибки);
	ТопологияПлощадок = СобратьТопологиюКонтейнерныхПлощадок(
		Layout,
		GeoПлощадки,
		GeoОси,
		ПараметрыСцены,
		Ошибки);
	Ячейки = ТопологияПлощадок.Ячейки;
	ПлощадкиСцены = ТопологияПлощадок.Площадки;
	ЗоныСцены = ТопологияПлощадок.Зоны;
	Инфраструктура = ТопологияПлощадок.Инфраструктура;
	ГеометрияПлощадок = ТопологияПлощадок.Геометрия;
	Если Ошибки.Количество() > 0 Тогда
		ВызватьИсключение "Ошибка топологии сцены V4:" + Символы.ПС + СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;

	Размещения = СгенерироватьСтатическиеРазмещения(Ячейки, Layout.demo);
	ПредупрежденияКонтейнеров = Новый Массив;
	ИсточникКонтейнеров = "макет";
	Если Константы.ПолучениеРеальныхДанных.Получить() Тогда
		Попытка
			Размещения = СобратьРазмещенияИзУКТ(
				ПолучитьНаполнениеПлощадокИзУКТ(),
				Ячейки,
				ПредупрежденияКонтейнеров);
			ИсточникКонтейнеров = "УКТ";
		Исключение
			ИсточникКонтейнеров = "УКТ, fallback макет";
			ПредупрежденияКонтейнеров.Добавить("УКТ недоступен: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	ПредупрежденияВагонов = Новый Массив;
	ИсточникВагонов = "макет";
	ПредупрежденияРазмещенияВагонов = Неопределено;
	Если Константы.ПолучениеРеальныхДанных.Получить() Тогда
		Попытка
			ОписаниеЖелезныхДорог.Вставить("trains", СобратьСоставыИзУПП(
				ПолучитьВагоныИзУПП(),
				ОписаниеЖелезныхДорог,
				ПредупрежденияВагонов));
			ИсточникВагонов = "УПП";
			ПредупрежденияРазмещенияВагонов = ПредупрежденияВагонов;
		Исключение
			ИсточникВагонов = "УПП, fallback макет";
			ПредупрежденияВагонов.Добавить("УПП недоступен: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	ЖелезнаяДорога = СобратьЖелезнуюДорогу(
		ОписаниеЖелезныхДорог,
		ПараметрыСцены,
		Ошибки,
		ПредупрежденияРазмещенияВагонов);
	ПредупрежденияСудов = Новый Массив;
	ИсточникСудов = "макет";
	Если Константы.ПолучениеРеальныхДанных.Получить() Тогда
		Попытка
			Объекты = СобратьСудаИзEDS(
				ОписаниеПричалов,
				ПолучитьСудаИзEDS(),
				ПараметрыСцены,
				ПредупрежденияСудов);
			ИсточникСудов = "EDS";
		Исключение
			ИсточникСудов = "EDS, fallback макет";
			ПредупрежденияСудов.Добавить("EDS недоступен: " + ОписаниеОшибки());
			Объекты = СобратьСуда(ОписаниеПричалов, ОписаниеСудов, ПараметрыСцены, Ошибки);
		КонецПопытки;
	Иначе
		Объекты = СобратьСуда(ОписаниеПричалов, ОписаниеСудов, ПараметрыСцены, Ошибки);
	КонецЕсли;
	КоличествоСудов = Объекты.Количество();
	НаправляющиеРейда = СобратьНаправляющуюРейда(GeoРейд, ПараметрыСцены, Ошибки);
	ИсточникСудовНаРейде = "макет";
	ОписаниеСудовРейдаДляРазмещения = ОписаниеСудовРейда;
	Если Константы.ПолучениеРеальныхДанных.Получить() Тогда
		Попытка
			ОписаниеСудовРейдаДляРазмещения = СобратьОписаниеСудовРейдаИзEDS(
				ПолучитьСудаРейдаИзEDS(),
				ОписаниеПричалов,
				ПараметрыСцены,
				ПредупрежденияСудов);
			ИсточникСудовНаРейде = "EDS";
		Исключение
			ИсточникСудовНаРейде = "EDS, fallback макет";
			ПредупрежденияСудов.Добавить("рейд EDS недоступен: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	СудаРейда = СобратьСудаНаРейде(НаправляющиеРейда, ОписаниеСудовРейдаДляРазмещения, Ошибки);
	КоличествоСудовНаРейде = СудаРейда.Количество();
	Для Каждого СудноРейда Из СудаРейда Цикл
		Объекты.Добавить(СудноРейда);
	КонецЦикла;
	Краны = СобратьКраны(ОписаниеКранов, ГеометрияПлощадок, ПараметрыСцены, Ошибки);
	Для Каждого Кран Из Краны Цикл
		Объекты.Добавить(Кран);
	КонецЦикла;
	Для Каждого Вагон Из ЖелезнаяДорога.Вагоны Цикл
		Объекты.Добавить(Вагон);
	КонецЦикла;
	Если Ошибки.Количество() > 0 Тогда
		ВызватьИсключение "Ошибка размещения объектов V4:" + Символы.ПС + СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;

	Границы = РассчитатьГраницыСцены(
		БереговаяЛиния,
		КольцаВоды,
		ЗданияСцены,
		ДорогиСцены,
		ГраницаПортаСцены,
		НаправляющиеРейда,
		ПлощадкиСцены,
		ЖелезнаяДорога.Топология,
		Объекты);
	ОписаниеТерритории = Новый Структура;
	ОписаниеТерритории.Вставить("minX", Границы.minX);
	ОписаниеТерритории.Вставить("minY", Границы.minY);
	ОписаниеТерритории.Вставить("maxX", Границы.maxX);
	ОписаниеТерритории.Вставить("maxY", Границы.maxY);
	ОписаниеТерритории.Вставить("width", Границы.maxX - Границы.minX);
	ОписаниеТерритории.Вставить("length", Границы.maxY - Границы.minY);
	ОписаниеТерритории.Вставить("shoreline", БереговаяЛиния);
	ОписаниеТерритории.Вставить("water", КольцаВоды);
	Сцена.Вставить("site", ОписаниеТерритории);

	Для Каждого Техника Из СобратьТехникуСкаут() Цикл
		Объекты.Добавить(Техника);
	КонецЦикла;

	Топология = Новый Структура;
	Топология.Вставить("sites", ПлощадкиСцены);
	Топология.Вставить("zones", ЗоныСцены);
	Топология.Вставить("infrastructure", Инфраструктура);
	Топология.Вставить("buildings", ЗданияСцены);
	Топология.Вставить("roads", ДорогиСцены);
	Топология.Вставить("portBoundary", ГраницаПортаСцены);
	Топология.Вставить("anchorage", НаправляющиеРейда);
	Топология.Вставить("railways", ЖелезнаяДорога.Топология);
	Сцена.Вставить("topology", Топология);
	Сцена.Вставить("cells", Ячейки);
	Сцена.Вставить("placements", Размещения);
	Сцена.Вставить("objects", Объекты);

	BuildId = ?(Манифест.Свойство("buildId"), Строка(Манифест.buildId), "unknown");
	Результат = Новый Структура;
	Результат.Вставить("BuildId", BuildId);
	Результат.Вставить("Сцена", Сцена);
	Результат.Вставить("КоличествоПлощадок", ПлощадкиСцены.Количество());
	Результат.Вставить("КоличествоЯчеек", Ячейки.Количество());
	Результат.Вставить("КоличествоРазмещений", Размещения.Количество());
	Результат.Вставить("КоличествоЖДВеток", ЖелезнаяДорога.Топология.branches.Количество());
	Результат.Вставить("КоличествоСоставов", ЖелезнаяДорога.КоличествоСоставов);
	Результат.Вставить("КоличествоВагонов", ЖелезнаяДорога.Вагоны.Количество());
	Результат.Вставить("ИсточникСудов", ИсточникСудов);
	Результат.Вставить("ИсточникСудовНаРейде", ИсточникСудовНаРейде);
	Результат.Вставить("ИсточникВагонов", ИсточникВагонов);
	Результат.Вставить("ИсточникКонтейнеров", ИсточникКонтейнеров);
	Результат.Вставить("КоличествоСудов", КоличествоСудов);
	Результат.Вставить("КоличествоСудовНаРейде", КоличествоСудовНаРейде);
	Результат.Вставить("ПредупрежденияСудов", ПредупрежденияСудов);
	Результат.Вставить("ПредупрежденияВагонов", ПредупрежденияВагонов);
	Результат.Вставить("ПредупрежденияКонтейнеров", ПредупрежденияКонтейнеров);
	Возврат Результат;

КонецФункции

Функция СобратьТопологиюКонтейнерныхПлощадок(
	Layout,
	GeoПлощадки,
	GeoОси,
	ПараметрыСцены,
	Ошибки)

	ПлощадкиПоИд = ИндексироватьОбъектыGeoJSON(GeoПлощадки, "site_id", "площадки", Ошибки);
	ОсиПоИд = ИндексироватьОбъектыGeoJSON(GeoОси, "site_id", "оси", Ошибки);

	Ячейки = Новый Массив;
	ПлощадкиСцены = Новый Массив;
	ЗоныСцены = Новый Массив;
	Инфраструктура = Новый Массив;
	ГеометрияПлощадок = Новый Соответствие;

	Для Каждого ОписаниеПлощадки Из Layout.sites Цикл
		ИдентификаторПлощадки = Строка(ОписаниеПлощадки.id);
		ПолигонGeo = ПлощадкиПоИд.Получить(ИдентификаторПлощадки);
		ОсьGeo = ОсиПоИд.Получить(ИдентификаторПлощадки);
		Если ПолигонGeo = Неопределено Тогда
			ДобавитьОшибку(Ошибки, "Нет полигона площадки " + ИдентификаторПлощадки);
			Продолжить;
		КонецЕсли;
		Если ОсьGeo = Неопределено Тогда
			ДобавитьОшибку(Ошибки, "Нет оси Bays площадки " + ИдентификаторПлощадки);
			Продолжить;
		КонецЕсли;

		СобратьПлощадку(
			ОписаниеПлощадки,
			ПолигонGeo,
			ОсьGeo,
			Layout.cell,
			ПараметрыСцены,
			ПлощадкиСцены,
			ЗоныСцены,
			Инфраструктура,
			ГеометрияПлощадок,
			Ячейки,
			Ошибки);
	КонецЦикла;

	ПроверитьСоответствиеИдентификаторов(Layout, ПлощадкиПоИд, ОсиПоИд, Ошибки);

	Результат = Новый Структура;
	Результат.Вставить("Ячейки", Ячейки);
	Результат.Вставить("Площадки", ПлощадкиСцены);
	Результат.Вставить("Зоны", ЗоныСцены);
	Результат.Вставить("Инфраструктура", Инфраструктура);
	Результат.Вставить("Геометрия", ГеометрияПлощадок);
	Возврат Результат;

КонецФункции

Процедура СобратьПлощадку(
	ОписаниеПлощадки,
	ПолигонGeo,
	ОсьGeo,
	РазмерыЯчейки,
	ПараметрыСцены,
	ПлощадкиСцены,
	ЗоныСцены,
	Инфраструктура,
	ГеометрияПлощадок,
	Ячейки,
	Ошибки)

	ИдентификаторПлощадки = Строка(ОписаниеПлощадки.id);
	Если Не ОписаниеПлощадки.Свойство("containerLabelRotationDeg")
		Или (ОписаниеПлощадки.containerLabelRotationDeg <> 0
			И ОписаниеПлощадки.containerLabelRotationDeg <> 180) Тогда
		ДобавитьОшибку(Ошибки, ИдентификаторПлощадки + ": containerLabelRotationDeg должен быть 0 или 180");
		Возврат;
	КонецЕсли;
	Вершины = ПолучитьВершиныПолигона(ПолигонGeo, ПараметрыСцены, ИдентификаторПлощадки, Ошибки);
	ТочкиОси = ПолучитьТочкиЛинии(ОсьGeo, ПараметрыСцены, "ось " + ИдентификаторПлощадки, Ошибки);
	Если Вершины.Количество() <> 4 Или ТочкиОси.Количество() <> 2 Тогда
		Возврат;
	КонецЕсли;

	НачалоОси = ТочкиОси[0];
	КонецОси = ТочкиОси[1];
	Для Каждого ТочкаОси Из ТочкиОси Цикл
		МинимальноеРасстояние = Неопределено;
		Для Каждого Вершина Из Вершины Цикл
			ТекущееРасстояние = Расстояние(ТочкаОси, Вершина);
			Если МинимальноеРасстояние = Неопределено Или ТекущееРасстояние < МинимальноеРасстояние Тогда
				МинимальноеРасстояние = ТекущееРасстояние;
			КонецЕсли;
		КонецЦикла;
		Если МинимальноеРасстояние = Неопределено Или МинимальноеРасстояние > 0.15 Тогда
			ДобавитьОшибку(Ошибки, ИдентификаторПлощадки + ": точка оси не совпадает с вершиной полигона");
		КонецЕсли;
	КонецЦикла;
	ДлинаОси = Расстояние(НачалоОси, КонецОси);
	Если ДлинаОси < 0.5 Тогда
		ДобавитьОшибку(Ошибки, ИдентификаторПлощадки + ": ось Bays слишком короткая");
		Возврат;
	КонецЕсли;
	ЕдиничныйBayX = (КонецОси.x - НачалоОси.x) / ДлинаОси;
	ЕдиничныйBayY = (КонецОси.y - НачалоОси.y) / ДлинаОси;

	ЦентрПолигона = СредняяТочка(Вершины);
	ЕдиничныйRowX = -ЕдиничныйBayY;
	ЕдиничныйRowY = ЕдиничныйBayX;
	Если (ЦентрПолигона.x - НачалоОси.x) * ЕдиничныйRowX
		+ (ЦентрПолигона.y - НачалоОси.y) * ЕдиничныйRowY < 0 Тогда
		ЕдиничныйRowX = -ЕдиничныйRowX;
		ЕдиничныйRowY = -ЕдиничныйRowY;
	КонецЕсли;
	Угол = Арктангенс2(ЕдиничныйBayY, ЕдиничныйBayX) * 180 / 3.141592653589793;

	Строки = РазвернутьСтроки(ОписаниеПлощадки.topology.rows, РазмерыЯчейки, Ошибки, ИдентификаторПлощадки);
	Бэи = РазвернутьБэи(ОписаниеПлощадки.topology.bays, РазмерыЯчейки, Ошибки, ИдентификаторПлощадки);
	ШиринаПоRows = Строки.ПолнаяШирина;
	ДлинаПоBays = Бэи.ПолнаяШирина;
	ДоступнаяШиринаRows = 0;
	Для Каждого Вершина Из Вершины Цикл
		Проекция = (Вершина.x - НачалоОси.x) * ЕдиничныйRowX
			+ (Вершина.y - НачалоОси.y) * ЕдиничныйRowY;
		ДоступнаяШиринаRows = Макс(ДоступнаяШиринаRows, Проекция);
	КонецЦикла;
	Если ДлинаОси + 0.05 < ДлинаПоBays Тогда
		ДобавитьОшибку(Ошибки, ИдентификаторПлощадки + ": топология Bays не помещается в полигон");
	КонецЕсли;
	Если ДоступнаяШиринаRows + 0.05 < ШиринаПоRows Тогда
		ДобавитьОшибку(Ошибки, ИдентификаторПлощадки + ": топология Rows не помещается в полигон");
	КонецЕсли;

	ОписаниеПолигона = Новый Массив;
	Для Каждого Вершина Из Вершины Цикл
		ОписаниеПолигона.Добавить(Вершина);
	КонецЦикла;
	ПлощадкаСцены = Новый Структура;
	ПлощадкаСцены.Вставить("id", ИдентификаторПлощадки);
	ПлощадкаСцены.Вставить("name", ОписаниеПлощадки.name);
	ПлощадкаСцены.Вставить("kind", "containerSite");
	ПлощадкаСцены.Вставить("polygon", ОписаниеПолигона);
	ПлощадкаСцены.Вставить("rotation", Угол);
	ПлощадкаСцены.Вставить("containerLabelRotationDeg", ОписаниеПлощадки.containerLabelRotationDeg);
	ПлощадкаСцены.Вставить("maxTier", ОписаниеПлощадки.maxTier);
	ПлощадкиСцены.Добавить(ПлощадкаСцены);

	ГеометрияПлощадки = Новый Структура;
	ГеометрияПлощадки.Вставить("origin", НачалоОси);
	ГеометрияПлощадки.Вставить("bayX", ЕдиничныйBayX);
	ГеометрияПлощадки.Вставить("bayY", ЕдиничныйBayY);
	ГеометрияПлощадки.Вставить("rowX", ЕдиничныйRowX);
	ГеометрияПлощадки.Вставить("rowY", ЕдиничныйRowY);
	ГеометрияПлощадки.Вставить("bayLength", ДлинаПоBays);
	ГеометрияПлощадки.Вставить("rowLength", ШиринаПоRows);
	ГеометрияПлощадки.Вставить("bayRotation", Угол);
	ГеометрияПлощадки.Вставить("rowRotation", Арктангенс2(ЕдиничныйRowY, ЕдиничныйRowX) * 180 / 3.141592653589793);
	ГеометрияПлощадок.Вставить(ИдентификаторПлощадки, ГеометрияПлощадки);

	ДобавитьИнфраструктуруПлощадки(
		ОписаниеПлощадки,
		РазмерыЯчейки,
		Строки,
		Бэи,
		НачалоОси,
		ЕдиничныйBayX,
		ЕдиничныйBayY,
		ЕдиничныйRowX,
		ЕдиничныйRowY,
		Угол,
		ДлинаПоBays,
		ШиринаПоRows,
		ЗоныСцены,
		Инфраструктура);

	Для Каждого ОписаниеБэя Из Бэи.Ячейки Цикл
		Для Каждого ОписаниеСтроки Из Строки.Ячейки Цикл
			СмещениеBay = ОписаниеБэя.Смещение + РазмерыЯчейки.container20Ft.lengthM / 2;
			СмещениеRow = ОписаниеСтроки.Смещение + РазмерыЯчейки.container20Ft.widthM / 2;
			КоординатаX = НачалоОси.x + СмещениеBay * ЕдиничныйBayX + СмещениеRow * ЕдиничныйRowX;
			КоординатаY = НачалоОси.y + СмещениеBay * ЕдиничныйBayY + СмещениеRow * ЕдиничныйRowY;
			ИдентификаторЯчейки = СтрШаблон(
				"%1:%2:%3:%4",
				ИдентификаторПлощадки,
				ОписаниеБэя.ZoneId,
				ОписаниеБэя.Номер,
				ОписаниеСтроки.Номер);

			Ячейка = Новый Структура;
			Ячейка.Вставить("id", ИдентификаторЯчейки);
			Ячейка.Вставить("kind", "cell");
			Ячейка.Вставить("siteId", ИдентификаторПлощадки);
			Ячейка.Вставить("blockId", ИдентификаторПлощадки);
			Ячейка.Вставить("zoneId", ОписаниеБэя.ZoneId);
			Ячейка.Вставить("zoneKind", ПолучитьВидЗоны(ОписаниеПлощадки, ОписаниеБэя.ZoneId));
			Ячейка.Вставить("zoneBay", ОписаниеБэя.Номер);
			Ячейка.Вставить("bay", ОписаниеБэя.Номер);
			Ячейка.Вставить("row", ОписаниеСтроки.Номер);
			Ячейка.Вставить("physicalBayIndex", ОписаниеБэя.ФизическийИндекс);
			Ячейка.Вставить("physicalRowIndex", ОписаниеСтроки.ФизическийИндекс);
			Ячейка.Вставить("baySegmentIndex", ОписаниеБэя.ИндексСегмента);
			Ячейка.Вставить("bayIndexInSegment", ОписаниеБэя.ИндексВСегменте);
			Ячейка.Вставить("x", КоординатаX);
			Ячейка.Вставить("y", КоординатаY);
			Ячейка.Вставить("rotation", Угол);
			Ячейка.Вставить("labelRotationDeg", ОписаниеПлощадки.containerLabelRotationDeg);
			Ячейка.Вставить("length", РазмерыЯчейки.container20Ft.lengthM);
			Ячейка.Вставить("width", РазмерыЯчейки.container20Ft.widthM);
			Ячейка.Вставить("maxTier", ОписаниеПлощадки.maxTier);
			Ячейка.Вставить("count", 0);
			Ячейки.Добавить(Ячейка);
		КонецЦикла;
	КонецЦикла;

	Если ОписаниеПлощадки.Свойство("expected") Тогда
		Если ОписаниеПлощадки.expected.rowCellCount <> Строки.Ячейки.Количество() Тогда
			ДобавитьОшибку(Ошибки, ИдентификаторПлощадки + ": expected.rowCellCount не совпадает");
		КонецЕсли;
		Если ОписаниеПлощадки.expected.bayCellCount <> Бэи.Ячейки.Количество() Тогда
			ДобавитьОшибку(Ошибки, ИдентификаторПлощадки + ": expected.bayCellCount не совпадает");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция РазвернутьСтроки(Сегменты, РазмерыЯчейки, Ошибки, ИдентификаторПлощадки)

	Ячейки = Новый Массив;
	Инфраструктура = Новый Массив;
	ЗанятыеНомера = Новый Соответствие;
	Смещение = 0;
	ФизическийИндекс = 0;
	ИндексСегмента = 0;
	Для Каждого Сегмент Из Сегменты Цикл
		ИндексСегмента = ИндексСегмента + 1;
		Если Сегмент.kind = "cells" Тогда
			Если Сегмент.numbers.from > Сегмент.numbers.to Тогда
				ДобавитьОшибку(Ошибки, ИдентификаторПлощадки + ": обратный диапазон Rows");
				Продолжить;
			КонецЕсли;
			Для Номер = Сегмент.numbers.from По Сегмент.numbers.to Цикл
				Если ЗанятыеНомера.Получить(Номер) <> Неопределено Тогда
					ДобавитьОшибку(Ошибки, ИдентификаторПлощадки + ": повтор Row " + Строка(Номер));
				КонецЕсли;
				ЗанятыеНомера.Вставить(Номер, Истина);
				ФизическийИндекс = ФизическийИндекс + 1;
				Описание = Новый Структура;
				Описание.Вставить("Номер", Номер);
				Описание.Вставить("Смещение", Смещение);
				Описание.Вставить("ФизическийИндекс", ФизическийИндекс);
				Описание.Вставить("ИндексСегмента", ИндексСегмента);
				Ячейки.Добавить(Описание);
				Смещение = Смещение + РазмерыЯчейки.rowPitchM;
			КонецЦикла;
		ИначеЕсли Сегмент.kind = "aisle" Или Сегмент.kind = "reeferRack" Или Сегмент.kind = "canopy" Тогда
			Если Сегмент.widthM <= 0 Или Сегмент.runsAlong <> "bays" Тогда
				ДобавитьОшибку(Ошибки, ИдентификаторПлощадки + ": неверный разрыв Rows");
			КонецЕсли;
			Описание = Новый Структура;
			Описание.Вставить("Сегмент", Сегмент);
			Описание.Вставить("Смещение", Смещение);
			Инфраструктура.Добавить(Описание);
			Смещение = Смещение + Сегмент.widthM;
		Иначе
			ДобавитьОшибку(Ошибки, ИдентификаторПлощадки + ": неизвестный вид сегмента Rows");
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("Ячейки,Инфраструктура,ПолнаяШирина", Ячейки, Инфраструктура, Смещение);

КонецФункции

Функция РазвернутьБэи(Сегменты, РазмерыЯчейки, Ошибки, ИдентификаторПлощадки)

	Ячейки = Новый Массив;
	Инфраструктура = Новый Массив;
	НомераЗон = Новый Соответствие;
	Смещение = 0;
	ФизическийИндекс = 0;
	ИндексСегмента = 0;
	Для Каждого Сегмент Из Сегменты Цикл
		ИндексСегмента = ИндексСегмента + 1;
		Если Сегмент.kind = "zone" Тогда
			Если Сегмент.numbers.from > Сегмент.numbers.to Тогда
				ДобавитьОшибку(Ошибки, ИдентификаторПлощадки + ": обратный диапазон Bays");
				Продолжить;
			КонецЕсли;
			ЗанятыеНомера = НомераЗон.Получить(Сегмент.zoneId);
			Если ЗанятыеНомера = Неопределено Тогда
				ЗанятыеНомера = Новый Соответствие;
				НомераЗон.Вставить(Сегмент.zoneId, ЗанятыеНомера);
			КонецЕсли;
			ИндексВСегменте = 0;
			Для Номер = Сегмент.numbers.from По Сегмент.numbers.to Цикл
				ИндексВСегменте = ИндексВСегменте + 1;
				Если ЗанятыеНомера.Получить(Номер) <> Неопределено Тогда
					ДобавитьОшибку(Ошибки, СтрШаблон("%1: повтор Bay %2 зоны %3", ИдентификаторПлощадки, Номер, Сегмент.zoneId));
				КонецЕсли;
				ЗанятыеНомера.Вставить(Номер, Истина);
				ФизическийИндекс = ФизическийИндекс + 1;
				Описание = Новый Структура;
				Описание.Вставить("ZoneId", Сегмент.zoneId);
				Описание.Вставить("Номер", Номер);
				Описание.Вставить("Смещение", Смещение);
				Описание.Вставить("ФизическийИндекс", ФизическийИндекс);
				Описание.Вставить("ИндексСегмента", ИндексСегмента);
				Описание.Вставить("ИндексВСегменте", ИндексВСегменте);
				Ячейки.Добавить(Описание);
				Смещение = Смещение + РазмерыЯчейки.bayPitchM;
			КонецЦикла;
		ИначеЕсли Сегмент.kind = "aisle" Или Сегмент.kind = "reeferRack" Или Сегмент.kind = "canopy" Тогда
			Если Сегмент.widthM <= 0 Или Сегмент.runsAlong <> "rows" Тогда
				ДобавитьОшибку(Ошибки, ИдентификаторПлощадки + ": неверный разрыв Bays");
			КонецЕсли;
			Описание = Новый Структура;
			Описание.Вставить("Сегмент", Сегмент);
			Описание.Вставить("Смещение", Смещение);
			Инфраструктура.Добавить(Описание);
			Смещение = Смещение + Сегмент.widthM;
		Иначе
			ДобавитьОшибку(Ошибки, ИдентификаторПлощадки + ": неизвестный вид сегмента Bays");
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("Ячейки,Инфраструктура,ПолнаяШирина", Ячейки, Инфраструктура, Смещение);

КонецФункции

Процедура ДобавитьИнфраструктуруПлощадки(
	ОписаниеПлощадки,
	РазмерыЯчейки,
	Строки,
	Бэи,
	НачалоОси,
	ЕдиничныйBayX,
	ЕдиничныйBayY,
	ЕдиничныйRowX,
	ЕдиничныйRowY,
	Угол,
	ДлинаПоBays,
	ШиринаПоRows,
	ЗоныСцены,
	Инфраструктура)

	ИдентификаторПлощадки = Строка(ОписаниеПлощадки.id);
	ИндексЗоны = 0;
	СмещениеBay = 0;
	Для Каждого Сегмент Из ОписаниеПлощадки.topology.bays Цикл
		Если Сегмент.kind = "zone" Тогда
			ИндексЗоны = ИндексЗоны + 1;
			Длина = (Сегмент.numbers.to - Сегмент.numbers.from + 1) * РазмерыЯчейки.bayPitchM;
		ИначеЕсли Сегмент.kind = "aisle" Или Сегмент.kind = "reeferRack" Или Сегмент.kind = "canopy" Тогда
			Длина = Сегмент.widthM;
		Иначе
			Длина = 0;
		КонецЕсли;
		Если Сегмент.kind = "zone" Тогда
			Центр = ЛокальнаяТочка(
				НачалоОси,
				СмещениеBay + Длина / 2,
				ШиринаПоRows / 2,
				ЕдиничныйBayX,
				ЕдиничныйBayY,
				ЕдиничныйRowX,
				ЕдиничныйRowY);
			Зона = Новый Структура;
			Зона.Вставить("id", СтрШаблон("%1:%2:%3", ИдентификаторПлощадки, Сегмент.zoneId, ИндексЗоны));
			Зона.Вставить("kind", "zone");
			Зона.Вставить("siteId", ИдентификаторПлощадки);
			Зона.Вставить("zoneId", Сегмент.zoneId);
			Зона.Вставить("zoneKind", ПолучитьВидЗоны(ОписаниеПлощадки, Сегмент.zoneId));
			Зона.Вставить("x", Центр.x);
			Зона.Вставить("y", Центр.y);
			Зона.Вставить("rotation", Угол);
			Зона.Вставить("length", Длина);
			Зона.Вставить("width", ШиринаПоRows);
			ЗоныСцены.Добавить(Зона);
		ИначеЕсли Длина > 0 Тогда
			Центр = ЛокальнаяТочка(
				НачалоОси,
				СмещениеBay + Длина / 2,
				ШиринаПоRows / 2,
				ЕдиничныйBayX,
				ЕдиничныйBayY,
				ЕдиничныйRowX,
				ЕдиничныйRowY);
			ДобавитьПолосуИнфраструктуры(
				Инфраструктура,
				Сегмент,
				ИдентификаторПлощадки,
				Центр,
				Угол + 90,
				ШиринаПоRows,
				Длина);
		КонецЕсли;
		СмещениеBay = СмещениеBay + Длина;
	КонецЦикла;

	СмещениеRow = 0;
	Для Каждого Сегмент Из ОписаниеПлощадки.topology.rows Цикл
		Если Сегмент.kind = "cells" Тогда
			Ширина = (Сегмент.numbers.to - Сегмент.numbers.from + 1) * РазмерыЯчейки.rowPitchM;
		ИначеЕсли Сегмент.kind = "aisle" Или Сегмент.kind = "reeferRack" Или Сегмент.kind = "canopy" Тогда
			Ширина = Сегмент.widthM;
		Иначе
			Ширина = 0;
		КонецЕсли;
		Если (Сегмент.kind = "aisle" Или Сегмент.kind = "reeferRack" Или Сегмент.kind = "canopy") И Ширина > 0 Тогда
			Центр = ЛокальнаяТочка(
				НачалоОси,
				ДлинаПоBays / 2,
				СмещениеRow + Ширина / 2,
				ЕдиничныйBayX,
				ЕдиничныйBayY,
				ЕдиничныйRowX,
				ЕдиничныйRowY);
			ДобавитьПолосуИнфраструктуры(
				Инфраструктура,
				Сегмент,
				ИдентификаторПлощадки,
				Центр,
				Угол,
				ДлинаПоBays,
				Ширина);
		КонецЕсли;
		СмещениеRow = СмещениеRow + Ширина;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПолосуИнфраструктуры(Инфраструктура, Сегмент, ИдентификаторПлощадки, Центр, Угол, Длина, Ширина)

	Полоса = Новый Структура;
	Полоса.Вставить("id", ИдентификаторПлощадки + ":" + Сегмент.id);
	Полоса.Вставить("kind", Сегмент.kind);
	Полоса.Вставить("siteId", ИдентификаторПлощадки);
	Полоса.Вставить("runsAlong", Сегмент.runsAlong);
	Полоса.Вставить("x", Центр.x);
	Полоса.Вставить("y", Центр.y);
	Полоса.Вставить("rotation", Угол);
	Полоса.Вставить("length", Длина);
	Полоса.Вставить("width", Ширина);
	Инфраструктура.Добавить(Полоса);

КонецПроцедуры

Функция ПолучитьВидЗоны(ОписаниеПлощадки, ИдентификаторЗоны)

	Для Каждого ОписаниеЗоны Из ОписаниеПлощадки.zones Цикл
		Если ОписаниеЗоны.id = ИдентификаторЗоны Тогда
			Возврат ОписаниеЗоны.kind;
		КонецЕсли;
	КонецЦикла;
	Возврат "unknown";

КонецФункции

Функция ЛокальнаяТочка(НачалоОси, Bay, Row, ЕдиничныйBayX, ЕдиничныйBayY, ЕдиничныйRowX, ЕдиничныйRowY)

	Возврат Новый Структура(
		"x,y",
		НачалоОси.x + Bay * ЕдиничныйBayX + Row * ЕдиничныйRowX,
		НачалоОси.y + Bay * ЕдиничныйBayY + Row * ЕдиничныйRowY);

КонецФункции

Функция СобратьРазмещенияИзУКТ(ТаблицаНаполнения, Ячейки, Предупреждения)

	Если ТаблицаНаполнения.Колонки.Найти("Зона") = Неопределено
		Или ТаблицаНаполнения.Колонки.Найти("Стек") = Неопределено
		Или ТаблицаНаполнения.Колонки.Найти("Ряд") = Неопределено
		Или ТаблицаНаполнения.Колонки.Найти("Ярусов") = Неопределено Тогда
		ВызватьИсключение "УКТ вернул таблицу без обязательных колонок Зона, Стек, Ряд, Ярусов.";
	КонецЕсли;

	ИндексЯчеек = Новый Соответствие;
	НеоднозначныеАдреса = Новый Соответствие;
	Для Каждого Ячейка Из Ячейки Цикл
		КлючАдреса = КлючАдресаЯчейкиУКТ(Ячейка.zoneId, Ячейка.row, Ячейка.zoneBay);
		Если НеоднозначныеАдреса.Получить(КлючАдреса) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ИндексЯчеек.Получить(КлючАдреса) <> Неопределено Тогда
			ИндексЯчеек.Удалить(КлючАдреса);
			НеоднозначныеАдреса.Вставить(КлючАдреса, Истина);
		Иначе
			ИндексЯчеек.Вставить(КлючАдреса, Ячейка);
		КонецЕсли;
	КонецЦикла;

	КонтекстПредупреждений = Новый Структура;
	КонтекстПредупреждений.Вставить("Предупреждения", Предупреждения);
	КонтекстПредупреждений.Вставить("Ключи", Новый Соответствие);
	КонтекстПредупреждений.Вставить("Пропущено", 0);
	КонтекстПредупреждений.Вставить("Максимум", 20);
	ОбработанныеАдреса = Новый Соответствие;
	Размещения = Новый Массив;
	НомерСтроки = 0;

	Для Каждого СтрокаНаполнения Из ТаблицаНаполнения Цикл
		НомерСтроки = НомерСтроки + 1;
		Зона = СокрЛП(Строка(СтрокаНаполнения.Зона));
		Стек = ЦелоеЧислоУКТ(СтрокаНаполнения.Стек);
		Ряд = ЦелоеЧислоУКТ(СтрокаНаполнения.Ряд);
		Ярусов = ЦелоеЧислоУКТ(СтрокаНаполнения.Ярусов);

		Если ПустаяСтрока(Зона)
			Или Стек = Неопределено
			Или Ряд = Неопределено
			Или Стек <= 0
			Или Ряд <= 0 Тогда
			ДобавитьПредупреждениеУКТ(
				КонтекстПредупреждений,
				"адрес|" + Строка(НомерСтроки),
				СтрШаблон(
					"УКТ: пропущена строка с некорректным адресом (Зона=%1, Стек=%2, Ряд=%3).",
					Зона,
					Строка(СтрокаНаполнения.Стек),
					Строка(СтрокаНаполнения.Ряд)));
			Продолжить;
		КонецЕсли;

		КлючАдреса = КлючАдресаЯчейкиУКТ(Зона, Стек, Ряд);
		Если ОбработанныеАдреса.Получить(КлючАдреса) <> Неопределено Тогда
			ДобавитьПредупреждениеУКТ(
				КонтекстПредупреждений,
				"повтор|" + КлючАдреса,
				СтрШаблон("УКТ: повтор адреса %1/%2/%3, использована первая строка.", Зона, Стек, Ряд));
			Продолжить;
		КонецЕсли;
		ОбработанныеАдреса.Вставить(КлючАдреса, Истина);

		Если Ярусов = Неопределено Или Ярусов < 0 Тогда
			ДобавитьПредупреждениеУКТ(
				КонтекстПредупреждений,
				"ярусы|" + КлючАдреса,
				СтрШаблон(
					"УКТ: ячейка %1/%2/%3 содержит некорректное число ярусов (%4).",
					Зона,
					Стек,
					Ряд,
					Строка(СтрокаНаполнения.Ярусов)));
			Продолжить;
		КонецЕсли;
		Если Ярусов = 0 Тогда
			Продолжить;
		КонецЕсли;

		Если НеоднозначныеАдреса.Получить(КлючАдреса) <> Неопределено Тогда
			ДобавитьПредупреждениеУКТ(
				КонтекстПредупреждений,
				"неоднозначно|" + КлючАдреса,
				СтрШаблон("УКТ: адрес %1/%2/%3 неоднозначен в топологии.", Зона, Стек, Ряд));
			Продолжить;
		КонецЕсли;

		Ячейка = ИндексЯчеек.Получить(КлючАдреса);
		Если Ячейка = Неопределено Тогда
			ДобавитьПредупреждениеУКТ(
				КонтекстПредупреждений,
				"не найдено|" + КлючАдреса,
				СтрШаблон("УКТ: ячейка %1/%2/%3 не найдена в макете.", Зона, Стек, Ряд));
			Продолжить;
		КонецЕсли;

		ИдентификаторыЯчеек = Новый Массив;
		ИдентификаторыЯчеек.Добавить(Ячейка.id);
		Для Ярус = 1 По Ярусов Цикл
			Размещение = Новый Структура;
			Размещение.Вставить("id", СтрШаблон("P-%1-T%2-20", Ячейка.id, Ярус));
			Размещение.Вставить("kind", "placement");
			Размещение.Вставить("siteId", Ячейка.siteId);
			Размещение.Вставить("blockId", Ячейка.siteId);
			Размещение.Вставить("zoneId", Ячейка.zoneId);
			Размещение.Вставить("zoneKind", Ячейка.zoneKind);
			Размещение.Вставить("row", Ячейка.row);
			Размещение.Вставить("bay", Ячейка.zoneBay);
			Размещение.Вставить("tier", Ярус);
			Размещение.Вставить("lengthFt", 20);
			Размещение.Вставить("spanCells", 1);
			Размещение.Вставить("cellIds", ИдентификаторыЯчеек);
			Размещение.Вставить("x", Ячейка.x);
			Размещение.Вставить("y", Ячейка.y);
			Размещение.Вставить("rotation", Ячейка.rotation);
			Размещение.Вставить("labelRotationDeg", Ячейка.labelRotationDeg);
			Размещения.Добавить(Размещение);
		КонецЦикла;
	КонецЦикла;

	Если КонтекстПредупреждений.Пропущено > 0 Тогда
		Предупреждения.Добавить(
			СтрШаблон("УКТ: не показано дополнительных предупреждений: %1.", КонтекстПредупреждений.Пропущено));
	КонецЕсли;
	Возврат Размещения;

КонецФункции

Функция КлючАдресаЯчейкиУКТ(Зона, Стек, Ряд)

	Возврат СтрШаблон(
		"%1|%2|%3",
		СокрЛП(Строка(Зона)),
		Формат(Стек, "ЧГ=0"),
		Формат(Ряд, "ЧГ=0"));

КонецФункции

Функция ЦелоеЧислоУКТ(Значение)

	Попытка
		Если ТипЗнч(Значение) = Тип("Число") Тогда
			ЧисловоеЗначение = Значение;
		Иначе
			ТекстЗначения = СокрЛП(Строка(Значение));
			Если ПустаяСтрока(ТекстЗначения) Тогда
				Возврат Неопределено;
			КонецЕсли;
			ЧисловоеЗначение = Число(ТекстЗначения);
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если ЧисловоеЗначение <> Цел(ЧисловоеЗначение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Цел(ЧисловоеЗначение);

КонецФункции

Процедура ДобавитьПредупреждениеУКТ(Контекст, Ключ, Текст)

	Если Контекст.Ключи.Получить(Ключ) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Контекст.Ключи.Вставить(Ключ, Истина);
	Если Контекст.Предупреждения.Количество() < Контекст.Максимум Тогда
		Контекст.Предупреждения.Добавить(Текст);
	Иначе
		Контекст.Пропущено = Контекст.Пропущено + 1;
	КонецЕсли;

КонецПроцедуры

Функция СгенерироватьСтатическиеРазмещения(Ячейки, НастройкиДемо)

	Размещения = Новый Массив;
	Если Не НастройкиДемо.enabled Тогда
		Возврат Размещения;
	КонецЕсли;

	ИндексЯчеек = Новый Соответствие;
	Для Каждого Ячейка Из Ячейки Цикл
		Ключ = СтрШаблон("%1|%2|%3", Ячейка.siteId, Ячейка.row, Ячейка.physicalBayIndex);
		ИндексЯчеек.Вставить(Ключ, Ячейка);
	КонецЦикла;

	Обработанные = Новый Соответствие;
	ГСЧ = Новый ГенераторСлучайныхЧисел(НастройкиДемо.seed);
	Для Каждого Ячейка Из Ячейки Цикл
		Если Обработанные.Получить(Ячейка.id) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ГСЧ.СлучайноеЧисло(1, 100) > НастройкиДемо.fillPercent Тогда
			Продолжить;
		КонецЕсли;

		СледующийКлюч = СтрШаблон("%1|%2|%3", Ячейка.siteId, Ячейка.row, Ячейка.physicalBayIndex + 1);
		СледующаяЯчейка = ИндексЯчеек.Получить(СледующийКлюч);
		Можно40 = СледующаяЯчейка <> Неопределено
			И СледующаяЯчейка.zoneId = Ячейка.zoneId
			И СледующаяЯчейка.baySegmentIndex = Ячейка.baySegmentIndex
			И СледующаяЯчейка.bayIndexInSegment = Ячейка.bayIndexInSegment + 1
			И Обработанные.Получить(СледующаяЯчейка.id) = Неопределено;
		СорокФутов = Можно40
			И ГСЧ.СлучайноеЧисло(1, 100) <= НастройкиДемо.container40FtPercent;
		ДлинаФуты = ?(СорокФутов, 40, 20);
		Высота = ГСЧ.СлучайноеЧисло(1, Мин(НастройкиДемо.maxTier, Ячейка.maxTier));
		ИдентификаторыЯчеек = Новый Массив;
		ИдентификаторыЯчеек.Добавить(Ячейка.id);
		Если СорокФутов Тогда
			ИдентификаторыЯчеек.Добавить(СледующаяЯчейка.id);
			Обработанные.Вставить(СледующаяЯчейка.id, Истина);
		КонецЕсли;
		Обработанные.Вставить(Ячейка.id, Истина);

		Для Ярус = 1 По Высота Цикл
			Размещение = Новый Структура;
			Размещение.Вставить("id", СтрШаблон("P-%1-T%2-%3", Ячейка.id, Ярус, ДлинаФуты));
			Размещение.Вставить("kind", "placement");
			Размещение.Вставить("siteId", Ячейка.siteId);
			Размещение.Вставить("blockId", Ячейка.siteId);
			Размещение.Вставить("zoneId", Ячейка.zoneId);
			Размещение.Вставить("zoneKind", Ячейка.zoneKind);
			Размещение.Вставить("row", Ячейка.row);
			Размещение.Вставить("bay", Ячейка.zoneBay);
			Размещение.Вставить("tier", Ярус);
			Размещение.Вставить("lengthFt", ДлинаФуты);
			Размещение.Вставить("spanCells", ?(СорокФутов, 2, 1));
			Размещение.Вставить("cellIds", ИдентификаторыЯчеек);
			Размещение.Вставить("x", Ячейка.x);
			Размещение.Вставить("y", Ячейка.y);
			Размещение.Вставить("rotation", Ячейка.rotation);
			Размещение.Вставить("labelRotationDeg", Ячейка.labelRotationDeg);
			Размещения.Добавить(Размещение);
		КонецЦикла;
	КонецЦикла;

	Возврат Размещения;

КонецФункции

#КонецОбласти

#Область ЧтениеИВалидация

Функция ПолучитьТекстМакета(ИмяМакета, Ошибки)

	Попытка
		Текст = ПолучитьМакет(ИмяМакета).ПолучитьТекст();
	Исключение
		ДобавитьОшибку(Ошибки, ИмяМакета + ": макет недоступен или имеет неверный тип");
		Возврат "";
	КонецПопытки;
	Если ПустаяСтрока(СокрЛП(Текст)) Тогда
		ДобавитьОшибку(Ошибки, ИмяМакета + ": макет пуст");
	КонецЕсли;
	Возврат Текст;

КонецФункции

Функция ПрочитатьJSONИзСтроки(Текст, ИмяИсточника, Ошибки)

	Если ПустаяСтрока(СокрЛП(Текст)) Тогда
		Возврат Новый Структура;
	КонецЕсли;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Возврат ПреобразоватьJSONЗначение(ПрочитатьJSON(Чтение, Истина));
	Исключение
		ДобавитьОшибку(Ошибки, ИмяИсточника + ": некорректный JSON: " + ОписаниеОшибки());
		Возврат Новый Структура;
	КонецПопытки;

КонецФункции

Функция ПреобразоватьJSONЗначение(Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ПреобразоватьJSONЗначение(Элемент));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Значение) <> Тип("Соответствие") Тогда
		Возврат Значение;
	КонецЕсли;

	ВсеКлючиДопустимы = Истина;
	Для Каждого Элемент Из Значение Цикл
		Если Не ИмяСвойстваСтруктурыДопустимо(Строка(Элемент.Ключ)) Тогда
			ВсеКлючиДопустимы = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ВсеКлючиДопустимы Тогда
		Результат = Новый Структура;
		Для Каждого Элемент Из Значение Цикл
			Результат.Вставить(Строка(Элемент.Ключ), ПреобразоватьJSONЗначение(Элемент.Значение));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Результат = Новый Соответствие;
	Для Каждого Элемент Из Значение Цикл
		Результат.Вставить(Элемент.Ключ, ПреобразоватьJSONЗначение(Элемент.Значение));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ИмяСвойстваСтруктурыДопустимо(Имя)

	Если ПустаяСтрока(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		ПроверкаИмени = Новый Структура(Имя);
		Возврат ТипЗнч(ПроверкаИмени) = Тип("Структура");
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция ПрочитатьПараметрыСцены(Текст, Ошибки)

	Результат = Новый Структура;
	Для Каждого СтрокаТекста Из СтрРазделить(Текст, Символы.ПС) Цикл
		СтрокаТекста = СокрЛП(СтрЗаменить(СтрокаТекста, Символы.ВК, ""));
		Если ПустаяСтрока(СтрокаТекста) Или Лев(СтрокаТекста, 1) = "#" Тогда
			Продолжить;
		КонецЕсли;
		ПозицияРавно = СтрНайти(СтрокаТекста, "=");
		Если ПозицияРавно = 0 Тогда
			ДобавитьОшибку(Ошибки, "SceneOrigin_txt: ожидалось key=value");
			Продолжить;
		КонецЕсли;
		Ключ = СокрЛП(Лев(СтрокаТекста, ПозицияРавно - 1));
		Значение = СокрЛП(Сред(СтрокаТекста, ПозицияРавно + 1));
		Результат.Вставить(Ключ, Значение);
	КонецЦикла;
	Попытка
		Результат.originEasting = Число(Результат.originEasting);
		Результат.originNorthing = Число(Результат.originNorthing);
		Результат.rotationDeg = Число(Результат.rotationDeg);
	Исключение
		ДобавитьОшибку(Ошибки, "SceneOrigin_txt: originEasting, originNorthing и rotationDeg обязательны");
	КонецПопытки;
	Возврат Результат;

КонецФункции

Процедура ПроверитьКорневыеДанные(
	Layout,
	GeoБерег,
	GeoВода,
	GeoЗдания,
	GeoДороги,
	GeoГраницаПорта,
	ОписаниеПричалов,
	ОписаниеСудов,
	ОписаниеКранов,
	ОписаниеЖелезныхДорог,
	GeoРейд,
	ОписаниеСудовРейда,
	GeoПлощадки,
	GeoОси,
	Манифест,
	ПараметрыСцены,
	Ошибки)

	Если Не Layout.Свойство("schemaVersion") Или Layout.schemaVersion <> "4.0" Тогда
		ДобавитьОшибку(Ошибки, "TerminalLayoutV4_json: schemaVersion должен быть 4.0");
	КонецЕсли;
	Если Не Layout.Свойство("terminal") Или Layout.terminal.units <> "m" Тогда
		ДобавитьОшибку(Ошибки, "TerminalLayoutV4_json: units должен быть m");
	КонецЕсли;
	Если Не Layout.Свойство("sites") Или Layout.sites.Количество() = 0 Тогда
		ДобавитьОшибку(Ошибки, "TerminalLayoutV4_json: sites пуст");
	КонецЕсли;
	Если Не Layout.Свойство("cell") Или Layout.cell.layoutMode <> "fixed_pitch" Тогда
		ДобавитьОшибку(Ошибки, "TerminalLayoutV4_json: требуется fixed_pitch");
	КонецЕсли;
	Если Не Layout.Свойство("demo") Тогда
		ДобавитьОшибку(Ошибки, "TerminalLayoutV4_json: отсутствуют настройки demo");
	КонецЕсли;
	ПроверитьFeatureCollection(GeoБерег, "Shoreline_geojson", Ошибки);
	ПроверитьFeatureCollection(GeoВода, "Water_geojson", Ошибки);
	ПроверитьFeatureCollection(GeoЗдания, "Buildings_geojson", Ошибки);
	ПроверитьFeatureCollection(GeoДороги, "Roads_geojson", Ошибки);
	ПроверитьFeatureCollection(GeoГраницаПорта, "PortBoundary_geojson", Ошибки);
	ПроверитьFeatureCollection(GeoПлощадки, "ContainerSitesV4_geojson", Ошибки);
	ПроверитьFeatureCollection(GeoОси, "ContainerSiteBayAxesV4_geojson", Ошибки);
	Если Не ОписаниеПричалов.Свойство("schemaVersion")
		Или ОписаниеПричалов.schemaVersion <> "4.0"
		Или Не ОписаниеПричалов.Свойство("berths") Тогда
		ДобавитьОшибку(Ошибки, "BerthsV4_json: неверный формат");
	КонецЕсли;
	Если Не ОписаниеСудов.Свойство("schemaVersion")
		Или ОписаниеСудов.schemaVersion <> "4.0"
		Или Не ОписаниеСудов.Свойство("vessels") Тогда
		ДобавитьОшибку(Ошибки, "VesselsV4_json: неверный формат");
	КонецЕсли;
	Если Не ОписаниеКранов.Свойство("schemaVersion")
		Или ОписаниеКранов.schemaVersion <> "4.0"
		Или Не ОписаниеКранов.Свойство("cranes") Тогда
		ДобавитьОшибку(Ошибки, "CranesV4_json: неверный формат");
	КонецЕсли;
	Если Не ОписаниеЖелезныхДорог.Свойство("schemaVersion")
		Или ОписаниеЖелезныхДорог.schemaVersion <> "4.0"
		Или Не ОписаниеЖелезныхДорог.Свойство("visualPaths")
		Или Не ОписаниеЖелезныхДорог.Свойство("branches")
		Или Не ОписаниеЖелезныхДорог.Свойство("trains") Тогда
		ДобавитьОшибку(Ошибки, "RailwaysV4_json: неверный формат");
	КонецЕсли;
	ПроверитьFeatureCollection(GeoРейд, "Anchorage_geojson", Ошибки);
	Если Не ОписаниеСудовРейда.Свойство("schemaVersion")
		Или ОписаниеСудовРейда.schemaVersion <> "4.0"
		Или Не ОписаниеСудовРейда.Свойство("vessels") Тогда
		ДобавитьОшибку(Ошибки, "AnchorageVessels_json: неверный формат");
	КонецЕсли;
	Если Не Манифест.Свойство("schemaVersion") Или Манифест.schemaVersion <> "4.0"
		Или Не Манифест.Свойство("buildId") Тогда
		ДобавитьОшибку(Ошибки, "SceneManifestV4_json: неверный манифест");
	КонецЕсли;
	Если Layout.Свойство("terminal") И ПараметрыСцены.Свойство("crs")
		И Layout.terminal.crs <> ПараметрыСцены.crs Тогда
		ДобавитьОшибку(Ошибки, "SceneOrigin_txt: CRS не совпадает с layout");
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьFeatureCollection(Документ, Имя, Ошибки)

	Если Не Документ.Свойство("type") Или Документ.type <> "FeatureCollection"
		Или Не Документ.Свойство("features") Тогда
		ДобавитьОшибку(Ошибки, Имя + ": ожидается FeatureCollection");
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьКомплектМакетов(Манифест, ТекстМакетов, Ошибки)

	Если Не Манифест.Свойство("sources") Тогда
		ДобавитьОшибку(Ошибки, "SceneManifestV4_json: отсутствует sources");
		Возврат;
	КонецЕсли;
	ПроверитьРазмерМакета(Манифест.sources, "terminalLayout", ТекстМакетов.Layout, Ошибки);
	ПроверитьРазмерМакета(Манифест.sources, "sceneOrigin", ТекстМакетов.Origin, Ошибки);
	ПроверитьРазмерМакета(Манифест.sources, "shoreline", ТекстМакетов.Shoreline, Ошибки);
	ПроверитьРазмерМакета(Манифест.sources, "water", ТекстМакетов.Water, Ошибки);
	ПроверитьРазмерМакета(Манифест.sources, "buildings", ТекстМакетов.Buildings, Ошибки);
	ПроверитьРазмерМакета(Манифест.sources, "roads", ТекстМакетов.Roads, Ошибки);
	ПроверитьРазмерМакета(Манифест.sources, "portBoundary", ТекстМакетов.PortBoundary, Ошибки);
	ПроверитьРазмерМакета(Манифест.sources, "berths", ТекстМакетов.Berths, Ошибки);
	ПроверитьРазмерМакета(Манифест.sources, "vessels", ТекстМакетов.Vessels, Ошибки);
	ПроверитьРазмерМакета(Манифест.sources, "cranes", ТекстМакетов.Cranes, Ошибки);
	ПроверитьРазмерМакета(Манифест.sources, "railways", ТекстМакетов.Railways, Ошибки);
	ПроверитьРазмерМакета(Манифест.sources, "anchorage", ТекстМакетов.Anchorage, Ошибки);
	ПроверитьРазмерМакета(Манифест.sources, "anchorageVessels", ТекстМакетов.AnchorageVessels, Ошибки);
	ПроверитьРазмерМакета(Манифест.sources, "containerSites", ТекстМакетов.Sites, Ошибки);
	ПроверитьРазмерМакета(Манифест.sources, "bayAxes", ТекстМакетов.Axes, Ошибки);

КонецПроцедуры

Процедура ПроверитьРазмерМакета(Источники, ИмяИсточника, Текст, Ошибки)

	ОписаниеИсточника = Неопределено;
	Если Не Источники.Свойство(ИмяИсточника, ОписаниеИсточника)
		Или Не ОписаниеИсточника.Свойство("characters") Тогда
		ДобавитьОшибку(Ошибки, "SceneManifestV4_json: нет описания " + ИмяИсточника);
		Возврат;
	КонецЕсли;
	Если СтрДлина(Текст) <> ОписаниеИсточника.characters Тогда
		ДобавитьОшибку(Ошибки, ИмяИсточника + ": размер не совпадает с манифестом");
	КонецЕсли;

КонецПроцедуры

Функция ИндексироватьОбъектыGeoJSON(Документ, ИмяПоля, ИмяИсточника, Ошибки)

	Индекс = Новый Соответствие;
	Для Каждого Feature Из Документ.features Цикл
		Если Не Feature.Свойство("properties") Или Не Feature.properties.Свойство(ИмяПоля) Тогда
			ДобавитьОшибку(Ошибки, ИмяИсточника + ": отсутствует " + ИмяПоля);
			Продолжить;
		КонецЕсли;
		Идентификатор = Строка(Feature.properties[ИмяПоля]);
		Если Индекс.Получить(Идентификатор) <> Неопределено Тогда
			ДобавитьОшибку(Ошибки, ИмяИсточника + ": повтор " + Идентификатор);
		Иначе
			Индекс.Вставить(Идентификатор, Feature);
		КонецЕсли;
	КонецЦикла;
	Возврат Индекс;

КонецФункции

Процедура ПроверитьСоответствиеИдентификаторов(Layout, ПлощадкиПоИд, ОсиПоИд, Ошибки)

	ИдентификаторыLayout = Новый Соответствие;
	Для Каждого Площадка Из Layout.sites Цикл
		Идентификатор = Строка(Площадка.id);
		Если ИдентификаторыLayout.Получить(Идентификатор) <> Неопределено Тогда
			ДобавитьОшибку(Ошибки, "Повтор площадки " + Идентификатор);
		КонецЕсли;
		ИдентификаторыLayout.Вставить(Идентификатор, Истина);
		Если ПлощадкиПоИд.Получить(Идентификатор) = Неопределено Тогда
			ДобавитьОшибку(Ошибки, "Нет полигона " + Идентификатор);
		КонецЕсли;
		Если ОсиПоИд.Получить(Идентификатор) = Неопределено Тогда
			ДобавитьОшибку(Ошибки, "Нет оси " + Идентификатор);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Элемент Из ПлощадкиПоИд Цикл
		Если ИдентификаторыLayout.Получить(Элемент.Ключ) = Неопределено Тогда
			ДобавитьОшибку(Ошибки, "Лишний полигон " + Строка(Элемент.Ключ));
		КонецЕсли;
	КонецЦикла;
	Для Каждого Элемент Из ОсиПоИд Цикл
		Если ИдентификаторыLayout.Получить(Элемент.Ключ) = Неопределено Тогда
			ДобавитьОшибку(Ошибки, "Лишняя ось " + Строка(Элемент.Ключ));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция СобратьСуда(ОписаниеПричалов, ОписаниеСудов, ПараметрыСцены, Ошибки)

	Причалы = Новый Соответствие;
	Для Каждого ОписаниеПричала Из ОписаниеПричалов.berths Цикл
		ИдентификаторПричала = Строка(ОписаниеПричала.id);
		Если Причалы.Получить(ИдентификаторПричала) <> Неопределено Тогда
			ДобавитьОшибку(Ошибки, "BerthsV4_json: повтор " + ИдентификаторПричала);
			Продолжить;
		КонецЕсли;
		ЦентрПричала = ПреобразоватьКоординаты(ОписаниеПричала.center, ПараметрыСцены);
		ТочкаНаправления = ПреобразоватьКоординаты(ОписаниеПричала.headingPoint, ПараметрыСцены);
		ДлинаНаправления = Расстояние(ЦентрПричала, ТочкаНаправления);
		Если ДлинаНаправления < 0.5 Тогда
			ДобавитьОшибку(Ошибки, "BerthsV4_json: короткая ось причала " + ИдентификаторПричала);
			Продолжить;
		КонецЕсли;
		ЕдиничныйX = (ТочкаНаправления.x - ЦентрПричала.x) / ДлинаНаправления;
		ЕдиничныйY = (ТочкаНаправления.y - ЦентрПричала.y) / ДлинаНаправления;
		Угол = Арктангенс2(ЕдиничныйY, ЕдиничныйX) * 180 / 3.141592653589793;
		Причал = Новый Структура;
		Причал.Вставить("id", ИдентификаторПричала);
		Причал.Вставить("name", Строка(ОписаниеПричала.name));
		Причал.Вставить("center", ЦентрПричала);
		Причал.Вставить("headingX", ЕдиничныйX);
		Причал.Вставить("headingY", ЕдиничныйY);
		Причал.Вставить("rotation", Угол);
		Причалы.Вставить(ИдентификаторПричала, Причал);
	КонецЦикла;

	Результат = Новый Массив;
	ИдентификаторыСудов = Новый Соответствие;
	ЗанятыеПричалы = Новый Соответствие;
	Для Каждого ОписаниеСудна Из ОписаниеСудов.vessels Цикл
		ИдентификаторСудна = Строка(ОписаниеСудна.id);
		ИдентификаторПричала = Строка(ОписаниеСудна.berthId);
		Если ИдентификаторыСудов.Получить(ИдентификаторСудна) <> Неопределено Тогда
			ДобавитьОшибку(Ошибки, "VesselsV4_json: повтор " + ИдентификаторСудна);
			Продолжить;
		КонецЕсли;
		ИдентификаторыСудов.Вставить(ИдентификаторСудна, Истина);
		Если ЗанятыеПричалы.Получить(ИдентификаторПричала) <> Неопределено Тогда
			ДобавитьОшибку(Ошибки, "VesselsV4_json: причал уже занят " + ИдентификаторПричала);
			Продолжить;
		КонецЕсли;
		Причал = Причалы.Получить(ИдентификаторПричала);
		Если Причал = Неопределено Тогда
			ДобавитьОшибку(Ошибки, "VesselsV4_json: неизвестный причал " + ИдентификаторПричала);
			Продолжить;
		КонецЕсли;
		ЗанятыеПричалы.Вставить(ИдентификаторПричала, Истина);
		Если ОписаниеСудна.lengthM <= 0 Или ОписаниеСудна.beamM <= 0 Тогда
			ДобавитьОшибку(Ошибки, "VesselsV4_json: неверные размеры судна " + ИдентификаторСудна);
			Продолжить;
		КонецЕсли;
		Если ОписаниеСудна.mooringSide <> "right"
			И ОписаниеСудна.mooringSide <> "left"
			И ОписаниеСудна.mooringSide <> "bow"
			И ОписаниеСудна.mooringSide <> "stern" Тогда
			ДобавитьОшибку(Ошибки, "VesselsV4_json: неверная ориентация судна " + ИдентификаторСудна);
			Продолжить;
		КонецЕсли;
		Если Не ОписаниеСудна.Свойство("vesselType")
			Или (ОписаниеСудна.vesselType <> "container"
				И ОписаниеСудна.vesselType <> "carCarrier"
				И ОписаниеСудна.vesselType <> "coal"
				И ОписаниеСудна.vesselType <> "fish"
				И ОписаниеСудна.vesselType <> "general"
				И ОписаниеСудна.vesselType <> "bunker"
				И ОписаниеСудна.vesselType <> "empty") Тогда
			ДобавитьОшибку(Ошибки, "VesselsV4_json: неверный вид судна " + ИдентификаторСудна);
			Продолжить;
		КонецЕсли;

		Зазор = 1;
		Если ОписаниеСудна.Свойство("clearanceM") Тогда
			Зазор = ОписаниеСудна.clearanceM;
		КонецЕсли;
		Если ОписаниеСудна.mooringSide = "bow" Или ОписаниеСудна.mooringSide = "stern" Тогда
			Смещение = ОписаниеСудна.lengthM / 2 + Зазор;
		Иначе
			Смещение = ОписаниеСудна.beamM / 2 + Зазор;
		КонецЕсли;
		НормальПравогоБортаX = Причал.headingY;
		НормальПравогоБортаY = -Причал.headingX;
		X = Причал.center.x - НормальПравогоБортаX * Смещение;
		Y = Причал.center.y - НормальПравогоБортаY * Смещение;
		Угол = Причал.rotation;
		Если ОписаниеСудна.mooringSide = "left" Тогда
			Угол = Угол + 180;
		ИначеЕсли ОписаниеСудна.mooringSide = "bow" Тогда
			Угол = Угол - 90;
		ИначеЕсли ОписаниеСудна.mooringSide = "stern" Тогда
			Угол = Угол + 90;
		КонецЕсли;
		Цвет = "#d7dee8";
		Если ОписаниеСудна.Свойство("color") Тогда
			Цвет = Строка(ОписаниеСудна.color);
		КонецЕсли;

		Размер = Новый Структура;
		Размер.Вставить("length", ОписаниеСудна.lengthM);
		Размер.Вставить("beam", ОписаниеСудна.beamM);
		Судно = Новый Структура;
		Судно.Вставить("id", ИдентификаторСудна);
		Судно.Вставить("kind", "vessel");
		Судно.Вставить("name", Строка(ОписаниеСудна.name));
		Судно.Вставить("x", X);
		Судно.Вставить("y", Y);
		Судно.Вставить("z", 0);
		Судно.Вставить("rotation", Угол);
		Судно.Вставить("color", Цвет);
		Судно.Вставить("length", ОписаниеСудна.lengthM);
		Судно.Вставить("size", Размер);
		Судно.Вставить("berthId", ИдентификаторПричала);
		Судно.Вставить("mooringSide", ОписаниеСудна.mooringSide);
		Судно.Вставить("vesselType", Строка(ОписаниеСудна.vesselType));
		Заправка = Ложь;
		Если ОписаниеСудна.Свойство("refueling") Тогда
			Заправка = ОписаниеСудна.refueling = Истина;
		КонецЕсли;
		Судно.Вставить("refueling", Заправка);
		Результат.Добавить(Судно);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ДополнитьОбъектыСудамиРейда(Объекты, ОписаниеПричалов, ПараметрыСцены, Ошибки, Предупреждения)

	ТекстНаправляющей = ПолучитьТекстМакета("Anchorage_geojson", Ошибки);
	GeoРейд = ПрочитатьJSONИзСтроки(ТекстНаправляющей, "Anchorage_geojson", Ошибки);
	Если Не GeoРейд.Свойство("type") Или GeoРейд.type <> "FeatureCollection"
		Или Не GeoРейд.Свойство("features") Тогда
		ДобавитьОшибку(Ошибки, "Anchorage_geojson: ожидается FeatureCollection");
	КонецЕсли;

	ОписаниеСудовРейда = Неопределено;
	Если Константы.ПолучениеРеальныхДанных.Получить() Тогда
		Попытка
			ОписаниеСудовРейда = СобратьОписаниеСудовРейдаИзEDS(
				ПолучитьСудаРейдаИзEDS(),
				ОписаниеПричалов,
				ПараметрыСцены,
				Предупреждения);
		Исключение
			Предупреждения.Добавить("рейд EDS недоступен: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	Если ОписаниеСудовРейда = Неопределено Тогда
		ТекстСудовРейда = ПолучитьТекстМакета("AnchorageVessels_json", Ошибки);
		ОписаниеСудовРейда = ПрочитатьJSONИзСтроки(ТекстСудовРейда, "AnchorageVessels_json", Ошибки);
		Если Не ОписаниеСудовРейда.Свойство("schemaVersion")
			Или ОписаниеСудовРейда.schemaVersion <> "4.0"
			Или Не ОписаниеСудовРейда.Свойство("vessels") Тогда
			ДобавитьОшибку(Ошибки, "AnchorageVessels_json: неверный формат");
		КонецЕсли;
	КонецЕсли;
	Если Ошибки.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;

	НаправляющиеРейда = СобратьНаправляющуюРейда(GeoРейд, ПараметрыСцены, Ошибки);
	СудаРейда = СобратьСудаНаРейде(НаправляющиеРейда, ОписаниеСудовРейда, Ошибки);
	Для Каждого СудноРейда Из СудаРейда Цикл
		Объекты.Добавить(СудноРейда);
	КонецЦикла;

КонецПроцедуры

Функция СобратьОписаниеСудовРейдаИзEDS(ТаблицаСудов, ОписаниеПричалов, ПараметрыСцены, Предупреждения)

	Если ТаблицаСудов = Неопределено Тогда
		ВызватьИсключение "EDS вернул неопределённое значение вместо таблицы судов рейда.";
	КонецЕсли;

	ИндексПричалов = ПостроитьИндексПричаловEDS(ОписаниеПричалов, ПараметрыСцены, Новый Массив);
	ИдентификаторыСудов = Новый Соответствие;
	Суда = Новый Массив;

	Для Каждого СтрокаEDS Из ТаблицаСудов Цикл
		Судозаход = ОчиститьПредставлениеEDS(СтрокаEDS.Судозаход);
		БазовыйИдентификатор = СформироватьИдентификаторСуднаРейдаEDS(Судозаход);
		Если ПустаяСтрока(БазовыйИдентификатор) Тогда
			Продолжить;
		КонецЕсли;

		ДатаШвартовки = НормализоватьДатуШвартовки(СтрокаEDS.ДатаВремяПланПодходаКПричалу);
		Если Не ЗначениеЗаполнено(СтрокаEDS.ДатаВремяПланПодходаКПричалу) Или ПустаяСтрока(ДатаШвартовки) Тогда
			Продолжить;
		КонецЕсли;

		ПредставлениеПричала = ОчиститьПредставлениеEDS(СтрокаEDS.Причал);
		Если ПустаяСтрока(ПредставлениеПричала) Тогда
			Продолжить;
		КонецЕсли;
		Причал = НайтиПричалEDS(ПредставлениеПричала, ИндексПричалов);
		Если Причал = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ИмяСудна = ОчиститьПредставлениеEDS(СтрокаEDS.Судно);
		Если ПустаяСтрока(ИмяСудна) Тогда
			Продолжить;
		КонецЕсли;

		ДлинаСудна = ЧислоEDS(СтрокаEDS.СудноДлина, 0);
		ШиринаСудна = ЧислоEDS(СтрокаEDS.СудноШирина, 0);
		Если ДлинаСудна <= 0 Или ШиринаСудна <= 0 Тогда
			Продолжить;
		КонецЕсли;

		ПланПогрузки = ПланКонтейнеровEDS(СтрокаEDS.Погрузка10, СтрокаEDS.Погрузка20, СтрокаEDS.Погрузка40);
		ПланРазгрузки = ПланКонтейнеровEDS(СтрокаEDS.Выгрузка10, СтрокаEDS.Выгрузка20, СтрокаEDS.Выгрузка40);
		Если ПланПогрузки = Неопределено Или ПланРазгрузки = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ОписаниеСудна = Новый Структура;
		ОписаниеСудна.Вставить("id", ПолучитьУникальныйИдентификаторСуднаEDS(БазовыйИдентификатор, ИдентификаторыСудов));
		ОписаниеСудна.Вставить("name", ИмяСудна);
		ОписаниеСудна.Вставить("plannedBerthingAt", ДатаШвартовки);
		ОписаниеСудна.Вставить("plannedBerthId", Причал.id);
		ОписаниеСудна.Вставить("plannedLoad", ПланПогрузки);
		ОписаниеСудна.Вставить("plannedUnload", ПланРазгрузки);
		ОписаниеСудна.Вставить("lengthM", ДлинаСудна);
		ОписаниеСудна.Вставить("beamM", ШиринаСудна);
		ОписаниеСудна.Вставить("vesselType", НормализоватьВидГрузаEDS(СтрокаEDS.ВидГруза));
		Суда.Добавить(ОписаниеСудна);
	КонецЦикла;

	Описание = Новый Структура;
	Описание.Вставить("schemaVersion", "4.0");
	Описание.Вставить("vessels", Суда);
	Возврат Описание;

КонецФункции

Функция СформироватьИдентификаторСуднаРейдаEDS(Судозаход)

	ЧастьСудозахода = СанироватьТекстИдентификатораEDS(Судозаход);
	Если ПустаяСтрока(ЧастьСудозахода) Тогда
		Возврат "";
	КонецЕсли;
	Возврат "eds-anchorage-" + ЧастьСудозахода;

КонецФункции

Функция ПланКонтейнеровEDS(Количество10, Количество20, Количество40)

	Число10 = НеотрицательноеЦелоеEDS(Количество10);
	Число20 = НеотрицательноеЦелоеEDS(Количество20);
	Число40 = НеотрицательноеЦелоеEDS(Количество40);
	Если Число10 = Неопределено Или Число20 = Неопределено Или Число40 = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	План = Новый Структура;
	План.Вставить("ft10", Число10);
	План.Вставить("ft20", Число20);
	План.Вставить("ft40", Число40);
	Возврат План;

КонецФункции

Функция НеотрицательноеЦелоеEDS(Значение)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	КонецЕсли;
	Количество = ЧислоEDS(Значение, Неопределено);
	Если Количество = Неопределено Или Количество < 0 Или Количество <> Цел(Количество) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Количество;

КонецФункции

Функция СобратьСудаНаРейде(Направляющие, ОписаниеСудов, Ошибки)

	Если Направляющие.Количество() = 0 Тогда
		ДобавитьОшибку(Ошибки, "Anchorage_geojson: нет направляющей для размещения судов");
		Возврат Новый Массив;
	КонецЕсли;

	Направляющая = Направляющие[0];
	ДлинаОси = Расстояние(Направляющая.points[0], Направляющая.points[1]);
	Если ДлинаОси < 0.5 Тогда
		ДобавитьОшибку(Ошибки, "Anchorage_geojson: короткая ось fid " + Направляющая.fid);
		Возврат Новый Массив;
	КонецЕсли;
	ЕдиничныйX = (Направляющая.points[1].x - Направляющая.points[0].x) / ДлинаОси;
	ЕдиничныйY = (Направляющая.points[1].y - Направляющая.points[0].y) / ДлинаОси;
	Угол = Арктангенс2(ЕдиничныйY, ЕдиничныйX) * 180 / 3.141592653589793 + 90;

	Описания = Новый Массив;
	ИдентификаторыСудов = Новый Соответствие;
	Для Каждого ОписаниеСудна Из ОписаниеСудов.vessels Цикл
		ИдентификаторСудна = Строка(ОписаниеСудна.id);
		Если ИдентификаторыСудов.Получить(ИдентификаторСудна) <> Неопределено Тогда
			ДобавитьОшибку(Ошибки, "AnchorageVessels_json: повтор " + ИдентификаторСудна);
			Продолжить;
		КонецЕсли;
		ИдентификаторыСудов.Вставить(ИдентификаторСудна, Истина);
		Если ОписаниеСудна.lengthM <= 0 Или ОписаниеСудна.beamM <= 0 Тогда
			ДобавитьОшибку(Ошибки, "AnchorageVessels_json: неверные размеры судна " + ИдентификаторСудна);
			Продолжить;
		КонецЕсли;
		Если Не ОписаниеСудна.Свойство("vesselType")
			Или (ОписаниеСудна.vesselType <> "container"
				И ОписаниеСудна.vesselType <> "carCarrier"
				И ОписаниеСудна.vesselType <> "coal"
				И ОписаниеСудна.vesselType <> "fish"
				И ОписаниеСудна.vesselType <> "general"
				И ОписаниеСудна.vesselType <> "bunker"
				И ОписаниеСудна.vesselType <> "empty") Тогда
			ДобавитьОшибку(Ошибки, "AnchorageVessels_json: неверный вид судна " + ИдентификаторСудна);
			Продолжить;
		КонецЕсли;
		Если Не ОписаниеСудна.Свойство("plannedBerthingAt") Тогда
			ДобавитьОшибку(Ошибки, "AnchorageVessels_json: неверная дата швартовки " + ИдентификаторСудна);
			Продолжить;
		КонецЕсли;
		ДатаШвартовки = НормализоватьДатуШвартовки(ОписаниеСудна.plannedBerthingAt);
		Если ПустаяСтрока(ДатаШвартовки) Тогда
			ДобавитьОшибку(Ошибки, "AnchorageVessels_json: неверная дата швартовки " + ИдентификаторСудна);
			Продолжить;
		КонецЕсли;
		ПлановыйПричал = "";
		Если ОписаниеСудна.Свойство("plannedBerthId") Тогда
			ПлановыйПричал = СокрЛП(Строка(ОписаниеСудна.plannedBerthId));
		КонецЕсли;
		Если ПустаяСтрока(ПлановыйПричал) Тогда
			ДобавитьОшибку(Ошибки, "AnchorageVessels_json: неверный плановый причал " + ИдентификаторСудна);
			Продолжить;
		КонецЕсли;
		ПланПогрузки = ПрочитатьПланКонтейнеров(ОписаниеСудна, "plannedLoad");
		ПланРазгрузки = ПрочитатьПланКонтейнеров(ОписаниеСудна, "plannedUnload");
		Если ПланПогрузки = Неопределено Или ПланРазгрузки = Неопределено Тогда
			ДобавитьОшибку(Ошибки, "AnchorageVessels_json: неверный план контейнеров " + ИдентификаторСудна);
			Продолжить;
		КонецЕсли;
		Если Не ОписаниеСудна.Свойство("name") Или ПустаяСтрока(СокрЛП(Строка(ОписаниеСудна.name))) Тогда
			ДобавитьОшибку(Ошибки, "AnchorageVessels_json: пустое имя судна " + ИдентификаторСудна);
			Продолжить;
		КонецЕсли;
		Нормализованное = Новый Структура;
		Нормализованное.Вставить("id", ИдентификаторСудна);
		Нормализованное.Вставить("name", СокрЛП(Строка(ОписаниеСудна.name)));
		Нормализованное.Вставить("plannedBerthingAt", ДатаШвартовки);
		Нормализованное.Вставить("plannedBerthId", ПлановыйПричал);
		Нормализованное.Вставить("plannedLoad", ПланПогрузки);
		Нормализованное.Вставить("plannedUnload", ПланРазгрузки);
		Нормализованное.Вставить("lengthM", ОписаниеСудна.lengthM);
		Нормализованное.Вставить("beamM", ОписаниеСудна.beamM);
		Нормализованное.Вставить("vesselType", Строка(ОписаниеСудна.vesselType));
		Если ОписаниеСудна.Свойство("color") Тогда
			Нормализованное.Вставить("color", Строка(ОписаниеСудна.color));
		КонецЕсли;
		Описания.Добавить(Нормализованное);
	КонецЦикла;

	Описания = ОтсортироватьСудаРейда(Описания);

	Результат = Новый Массив;
	СмещениеЦентра = 0;
	НомерВОчереди = 0;
	Для Каждого ОписаниеСудна Из Описания Цикл
		Если НомерВОчереди > 0 Тогда
			Предыдущее = Описания[НомерВОчереди - 1];
			СмещениеЦентра = СмещениеЦентра + Предыдущее.beamM / 2 + Направляющая.gapM + ОписаниеСудна.beamM / 2;
		КонецЕсли;
		НомерВОчереди = НомерВОчереди + 1;
		X = Направляющая.points[0].x + ЕдиничныйX * СмещениеЦентра;
		Y = Направляющая.points[0].y + ЕдиничныйY * СмещениеЦентра;
		Цвет = "#d7dee8";
		Если ОписаниеСудна.Свойство("color") Тогда
			Цвет = Строка(ОписаниеСудна.color);
		КонецЕсли;
		Размер = Новый Структура;
		Размер.Вставить("length", ОписаниеСудна.lengthM);
		Размер.Вставить("beam", ОписаниеСудна.beamM);
		Судно = Новый Структура;
		Судно.Вставить("id", Строка(ОписаниеСудна.id));
		Судно.Вставить("kind", "vessel");
		Судно.Вставить("name", Строка(ОписаниеСудна.name));
		Судно.Вставить("x", X);
		Судно.Вставить("y", Y);
		Судно.Вставить("z", 0);
		Судно.Вставить("rotation", Угол);
		Судно.Вставить("color", Цвет);
		Судно.Вставить("length", ОписаниеСудна.lengthM);
		Судно.Вставить("size", Размер);
		Судно.Вставить("berthId", "");
		Судно.Вставить("mooringSide", "");
		Судно.Вставить("vesselType", Строка(ОписаниеСудна.vesselType));
		Судно.Вставить("refueling", Ложь);
		Судно.Вставить("locationType", "anchorage");
		Судно.Вставить("plannedBerthingAt", Строка(ОписаниеСудна.plannedBerthingAt));
		Судно.Вставить("plannedBerthId", Строка(ОписаниеСудна.plannedBerthId));
		Судно.Вставить("plannedLoad", ОписаниеСудна.plannedLoad);
		Судно.Вставить("plannedUnload", ОписаниеСудна.plannedUnload);
		Судно.Вставить("queuePosition", НомерВОчереди);
		Результат.Добавить(Судно);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ОтсортироватьСудаРейда(Описания)

	Результат = Новый Массив;
	Для Каждого ОписаниеСудна Из Описания Цикл
		Вставлено = Ложь;
		Для Индекс = 0 По Результат.ВГраница() Цикл
			Текущее = Результат[Индекс];
			Если Строка(ОписаниеСудна.plannedBerthingAt) < Строка(Текущее.plannedBerthingAt)
				Или (Строка(ОписаниеСудна.plannedBerthingAt) = Строка(Текущее.plannedBerthingAt)
					И Строка(ОписаниеСудна.id) < Строка(Текущее.id)) Тогда
				Результат.Вставить(Индекс, ОписаниеСудна);
				Вставлено = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не Вставлено Тогда
			Результат.Добавить(ОписаниеСудна);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПрочитатьПланКонтейнеров(Описание, ИмяСвойства)

	Если Не Описание.Свойство(ИмяСвойства) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Источник = Описание[ИмяСвойства];
	Если ТипЗнч(Источник) = Тип("Соответствие") Тогда
		СтруктураИсточника = Новый Структура;
		СтруктураИсточника.Вставить("ft10", Источник.Получить("ft10"));
		СтруктураИсточника.Вставить("ft20", Источник.Получить("ft20"));
		СтруктураИсточника.Вставить("ft40", Источник.Получить("ft40"));
		Источник = СтруктураИсточника;
	КонецЕсли;
	Если ТипЗнч(Источник) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Не НеотрицательноеЦелое(Источник, "ft10")
		Или Не НеотрицательноеЦелое(Источник, "ft20")
		Или Не НеотрицательноеЦелое(Источник, "ft40") Тогда
		Возврат Неопределено;
	КонецЕсли;
	План = Новый Структура;
	План.Вставить("ft10", Источник.ft10);
	План.Вставить("ft20", Источник.ft20);
	План.Вставить("ft40", Источник.ft40);
	Возврат План;

КонецФункции

Функция НеотрицательноеЦелое(Описание, ИмяСвойства)

	Если Не Описание.Свойство(ИмяСвойства) Тогда
		Возврат Ложь;
	КонецЕсли;
	Значение = Описание[ИмяСвойства];
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Значение >= 0 И Значение = Цел(Значение);

КонецФункции

Функция НормализоватьДатуШвартовки(Значение)

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ=yyyy-MM-dd") + "T" + Формат(Значение, "ДФ=HH:mm:ss");
	КонецЕсли;
	Текст = СокрЛП(Строка(Значение));
	Если Не ДатаШвартовкиКорректна(Текст) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Текст;

КонецФункции

Функция ДатаШвартовкиКорректна(Значение)

	Текст = СокрЛП(Значение);
	Если СтрДлина(Текст) <> 19 Или Сред(Текст, 11, 1) <> "T" Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		XMLЗначение(Тип("Дата"), Текст);
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;

КонецФункции

Функция СобратьСудаИзEDS(ОписаниеПричалов, ТаблицаСудов, ПараметрыСцены, Предупреждения)

	Если ТаблицаСудов = Неопределено Тогда
		ВызватьИсключение "EDS вернул неопределённое значение вместо таблицы судов.";
	КонецЕсли;

	ИндексПричалов = ПостроитьИндексПричаловEDS(ОписаниеПричалов, ПараметрыСцены, Предупреждения);
	ГруппыСудов = Новый Соответствие;
	ИдентификаторыСудов = Новый Соответствие;
	ЕстьДлинаСудна2 = ТаблицаСудов.Колонки.Найти("Судно2сДлина") <> Неопределено;
	ЕстьШиринаСудна2 = ТаблицаСудов.Колонки.Найти("Судно2сШирина") <> Неопределено;

	Для Каждого СтрокаEDS Из ТаблицаСудов Цикл
		ИмяСудна = ОчиститьПредставлениеEDS(СтрокаEDS.Судно);
		Если ПустаяСтрока(ИмяСудна) Тогда
			Предупреждения.Добавить("EDS: пропущена строка без судна.");
			Продолжить;
		КонецЕсли;

		Причал = НайтиПричалEDS(СтрокаEDS.Причал, ИндексПричалов);
		Если Причал = Неопределено Тогда
			Предупреждения.Добавить(
				СтрШаблон("EDS: судно %1 пропущено, причал %2 не найден в макете.", ИмяСудна, Строка(СтрокаEDS.Причал)));
			Продолжить;
		КонецЕсли;

		ДлинаСудна = ЧислоEDS(СтрокаEDS.СудносДлина, 0);
		ШиринаСудна = ЧислоEDS(СтрокаEDS.СудносШирина, 0);
		Если ДлинаСудна <= 0 Или ШиринаСудна <= 0 Тогда
			Предупреждения.Добавить(
				СтрШаблон("EDS: судно %1 пропущено, не заполнены длина или ширина.", ИмяСудна));
			Продолжить;
		КонецЕсли;

		СпособПостановки = НормализоватьСпособПостановкиEDS(СтрокаEDS.СпособПостановки);
		Идентификатор = ПолучитьУникальныйИдентификаторСуднаEDS(
			СформироватьИдентификаторСуднаEDS(Причал.id, ИмяСудна, СтрокаEDS.Дата),
			ИдентификаторыСудов);
		ИмяСудна2 = ОчиститьПредставлениеEDS(СтрокаEDS.Судно2);
		ВидГруза2 = ОчиститьПредставлениеEDS(СтрокаEDS.ВидГруза2);
		ЕстьВтороеСудно = СтрокаEDS.ВторойБорт = Истина
			И ЗначениеЗаполнено(СтрокаEDS.Дата2)
			И Не ЗначениеЗаполнено(СтрокаEDS.ДатаОтшвартовки2);
		ЕстьБункеровщик = СтрокаEDS.ВторойБорт = Истина
			И Не ЕстьВтороеСудно
			И Не ЗначениеЗаполнено(СтрокаEDS.ДатаОтшвартовки2)
			И ЭтоБункеровкаEDS(ВидГруза2);

		ОписаниеСудна = Новый Структура;
		ОписаниеСудна.Вставить("id", Идентификатор);
		ОписаниеСудна.Вставить("name", ИмяСудна);
		ОписаниеСудна.Вставить("lengthM", ДлинаСудна);
		ОписаниеСудна.Вставить("beamM", ШиринаСудна);
		ОписаниеСудна.Вставить("berthId", Причал.id);
		ОписаниеСудна.Вставить("mooringSide", СпособПостановки);
		ОписаниеСудна.Вставить("vesselType", НормализоватьВидГрузаEDS(СтрокаEDS.ВидГруза));
		ОписаниеСудна.Вставить("refueling", ЕстьБункеровщик);
		ОписаниеСудна.Вставить("secondVessel", Неопределено);

		Если ЕстьВтороеСудно Тогда
			ДлинаСудна2 = 28;
			ШиринаСудна2 = 8;
			Если ЕстьДлинаСудна2 Тогда
				ДлинаСудна2 = ЧислоEDS(СтрокаEDS["Судно2сДлина"], ДлинаСудна2);
			КонецЕсли;
			Если ЕстьШиринаСудна2 Тогда
				ШиринаСудна2 = ЧислоEDS(СтрокаEDS["Судно2сШирина"], ШиринаСудна2);
			КонецЕсли;
			Если ДлинаСудна2 <= 0 Тогда
				ДлинаСудна2 = 28;
			КонецЕсли;
			Если ШиринаСудна2 <= 0 Тогда
				ШиринаСудна2 = 8;
			КонецЕсли;

			Если ПустаяСтрока(ИмяСудна2) Тогда
				ИмяСудна2 = "2-й борт";
			КонецЕсли;
			ОписаниеСудна2 = Новый Структура;
			ОписаниеСудна2.Вставить("id", ПолучитьУникальныйИдентификаторСуднаEDS(
				СформироватьИдентификаторСуднаEDS(Причал.id, ИмяСудна2, СтрокаEDS.Дата2) + "-2",
				ИдентификаторыСудов));
			ОписаниеСудна2.Вставить("name", ИмяСудна2);
			ОписаниеСудна2.Вставить("lengthM", ДлинаСудна2);
			ОписаниеСудна2.Вставить("beamM", ШиринаСудна2);
			ОписаниеСудна2.Вставить("berthId", Причал.id);
			ОписаниеСудна2.Вставить("mooringSide", СпособПостановки);
			ОписаниеСудна2.Вставить("vesselType", НормализоватьВидГрузаEDS(ВидГруза2));
			ОписаниеСудна2.Вставить("refueling", Ложь);
			ОписаниеСудна.secondVessel = ОписаниеСудна2;
		КонецЕсли;

		ГруппаСудов = ГруппыСудов.Получить(Причал.id);
		Если ГруппаСудов = Неопределено Тогда
			ГруппаСудов = Новый Массив;
			ГруппыСудов.Вставить(Причал.id, ГруппаСудов);
		КонецЕсли;
		ГруппаСудов.Добавить(ОписаниеСудна);
	КонецЦикла;

	Результат = Новый Массив;
	Для Каждого ЭлементГруппы Из ГруппыСудов Цикл
		Причал = ИндексПричалов.ПоИдентификатору.Получить(ЭлементГруппы.Ключ);
		РазместитьГруппуСудовEDS(Причал, ЭлементГруппы.Значение, Результат);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПостроитьИндексПричаловEDS(ОписаниеПричалов, ПараметрыСцены, Предупреждения)

	ПоИдентификатору = Новый Соответствие;
	ПоИмени = Новый Соответствие;
	ДочерниеПричалы = Новый Соответствие;

	Для Каждого ОписаниеПричала Из ОписаниеПричалов.berths Цикл
		ИдентификаторПричала = СокрЛП(Строка(ОписаниеПричала.id));
		ЦентрПричала = ПреобразоватьКоординаты(ОписаниеПричала.center, ПараметрыСцены);
		ТочкаНаправления = ПреобразоватьКоординаты(ОписаниеПричала.headingPoint, ПараметрыСцены);
		ДлинаНаправления = Расстояние(ЦентрПричала, ТочкаНаправления);
		Если ДлинаНаправления < 0.5 Тогда
			Предупреждения.Добавить("EDS: пропущена короткая ось причала " + ИдентификаторПричала + ".");
			Продолжить;
		КонецЕсли;

		Причал = Новый Структура;
		Причал.Вставить("id", ИдентификаторПричала);
		Причал.Вставить("name", Строка(ОписаниеПричала.name));
		Причал.Вставить("center", ЦентрПричала);
		Причал.Вставить("headingX", (ТочкаНаправления.x - ЦентрПричала.x) / ДлинаНаправления);
		Причал.Вставить("headingY", (ТочкаНаправления.y - ЦентрПричала.y) / ДлинаНаправления);
		Причал.Вставить("rotation", Арктангенс2(Причал.headingY, Причал.headingX) * 180 / 3.141592653589793);
		ПоИдентификатору.Вставить(ИдентификаторПричала, Причал);
		ПоИмени.Вставить(НРег(СокрЛП(Причал.name)), Причал);

		ПозицияДефиса = СтрНайти(ИдентификаторПричала, "-");
		Если ПозицияДефиса > 1 Тогда
			ИдентификаторГруппы = Лев(ИдентификаторПричала, ПозицияДефиса - 1);
			ГруппаПричалов = ДочерниеПричалы.Получить(ИдентификаторГруппы);
			Если ГруппаПричалов = Неопределено Тогда
				ГруппаПричалов = Новый Массив;
				ДочерниеПричалы.Вставить(ИдентификаторГруппы, ГруппаПричалов);
			КонецЕсли;
			ГруппаПричалов.Добавить(Причал);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ЭлементГруппы Из ДочерниеПричалы Цикл
		Если ПоИдентификатору.Получить(ЭлементГруппы.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СуммаX = 0;
		СуммаY = 0;
		СуммаНаправленияX = 0;
		СуммаНаправленияY = 0;
		Для Каждого ДочернийПричал Из ЭлементГруппы.Значение Цикл
			СуммаX = СуммаX + ДочернийПричал.center.x;
			СуммаY = СуммаY + ДочернийПричал.center.y;
			СуммаНаправленияX = СуммаНаправленияX + ДочернийПричал.headingX;
			СуммаНаправленияY = СуммаНаправленияY + ДочернийПричал.headingY;
		КонецЦикла;
		КоличествоПричалов = ЭлементГруппы.Значение.Количество();
		ДлинаНаправления = Sqrt(
			СуммаНаправленияX * СуммаНаправленияX + СуммаНаправленияY * СуммаНаправленияY);
		Если КоличествоПричалов = 0 Или ДлинаНаправления < 0.001 Тогда
			Продолжить;
		КонецЕсли;
		ЦентрГруппы = Новый Структура;
		ЦентрГруппы.Вставить("x", СуммаX / КоличествоПричалов);
		ЦентрГруппы.Вставить("y", СуммаY / КоличествоПричалов);
		ПричалГруппы = Новый Структура;
		ПричалГруппы.Вставить("id", Строка(ЭлементГруппы.Ключ));
		ПричалГруппы.Вставить("name", "Причал " + Строка(ЭлементГруппы.Ключ));
		ПричалГруппы.Вставить("center", ЦентрГруппы);
		ПричалГруппы.Вставить("headingX", СуммаНаправленияX / ДлинаНаправления);
		ПричалГруппы.Вставить("headingY", СуммаНаправленияY / ДлинаНаправления);
		ПричалГруппы.Вставить(
			"rotation",
			Арктангенс2(ПричалГруппы.headingY, ПричалГруппы.headingX) * 180 / 3.141592653589793);
		ПоИдентификатору.Вставить(ЭлементГруппы.Ключ, ПричалГруппы);
		ПоИмени.Вставить(НРег(ПричалГруппы.name), ПричалГруппы);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("ПоИдентификатору", ПоИдентификатору);
	Результат.Вставить("ПоИмени", ПоИмени);
	Возврат Результат;

КонецФункции

Функция НайтиПричалEDS(ПредставлениеПричала, ИндексПричалов)

	ТекстПричала = СокрЛП(Строка(ПредставлениеПричала));
	ИдентификаторПричала = ТекстПричала;
	Если СтрНайти(НРег(ТекстПричала), "причал ") = 1 Тогда
		ИдентификаторПричала = СокрЛП(Сред(ТекстПричала, 8));
	КонецЕсли;
	Причал = ИндексПричалов.ПоИдентификатору.Получить(ИдентификаторПричала);
	Если Причал = Неопределено Тогда
		Причал = ИндексПричалов.ПоИмени.Получить(НРег(ТекстПричала));
	КонецЕсли;
	Возврат Причал;

КонецФункции

Процедура РазместитьГруппуСудовEDS(Причал, ГруппаСудов, Результат)

	ЗазорМеждуСудами = 3;
	ОбщаяДлина = 0;
	Для Каждого ОписаниеСудна Из ГруппаСудов Цикл
		ОбщаяДлина = ОбщаяДлина + РазмерСуднаВДольПричалаEDS(ОписаниеСудна);
	КонецЦикла;
	Если ГруппаСудов.Количество() > 1 Тогда
		ОбщаяДлина = ОбщаяДлина + ЗазорМеждуСудами * (ГруппаСудов.Количество() - 1);
	КонецЕсли;

	ТекущаяПозиция = -ОбщаяДлина / 2;
	Для Каждого ОписаниеСудна Из ГруппаСудов Цикл
		РазмерВДоль = РазмерСуднаВДольПричалаEDS(ОписаниеСудна);
		СмещениеВДоль = ТекущаяПозиция + РазмерВДоль / 2;
		Судно = СоздатьОбъектСуднаEDS(ОписаниеСудна, Причал, СмещениеВДоль);
		Результат.Добавить(Судно);
		Если ОписаниеСудна.secondVessel <> Неопределено Тогда
			Результат.Добавить(СоздатьСудноВторогоБортаEDS(
				ОписаниеСудна.secondVessel,
				Судно,
				Причал));
		КонецЕсли;
		ТекущаяПозиция = ТекущаяПозиция + РазмерВДоль + ЗазорМеждуСудами;
	КонецЦикла;

КонецПроцедуры

Функция РазмерСуднаВДольПричалаEDS(ОписаниеСудна)

	Если ОписаниеСудна.mooringSide = "bow" Или ОписаниеСудна.mooringSide = "stern" Тогда
		Возврат ОписаниеСудна.beamM;
	КонецЕсли;
	Возврат ОписаниеСудна.lengthM;

КонецФункции

Функция СоздатьОбъектСуднаEDS(ОписаниеСудна, Причал, СмещениеВДоль)

	ЗазорОтПричала = 1;
	Если ОписаниеСудна.mooringSide = "bow" Или ОписаниеСудна.mooringSide = "stern" Тогда
		СмещениеОтПричала = ОписаниеСудна.lengthM / 2 + ЗазорОтПричала;
	Иначе
		СмещениеОтПричала = ОписаниеСудна.beamM / 2 + ЗазорОтПричала;
	КонецЕсли;
	НормальПравогоБортаX = Причал.headingY;
	НормальПравогоБортаY = -Причал.headingX;
	КоординатаX = Причал.center.x + Причал.headingX * СмещениеВДоль - НормальПравогоБортаX * СмещениеОтПричала;
	КоординатаY = Причал.center.y + Причал.headingY * СмещениеВДоль - НормальПравогоБортаY * СмещениеОтПричала;
	Угол = Причал.rotation;
	Если ОписаниеСудна.mooringSide = "left" Тогда
		Угол = Угол + 180;
	ИначеЕсли ОписаниеСудна.mooringSide = "bow" Тогда
		Угол = Угол - 90;
	ИначеЕсли ОписаниеСудна.mooringSide = "stern" Тогда
		Угол = Угол + 90;
	КонецЕсли;

	Возврат СоздатьСтруктуруСуднаEDS(ОписаниеСудна, КоординатаX, КоординатаY, Угол);

КонецФункции

Функция СоздатьСудноВторогоБортаEDS(ОписаниеСудна, ОсновноеСудно, Причал)

	НаправлениеX = -Причал.headingY;
	НаправлениеY = Причал.headingX;
	Если ОсновноеСудно.mooringSide = "bow" Или ОсновноеСудно.mooringSide = "stern" Тогда
		Смещение = ОсновноеСудно.size.length / 2 + ОписаниеСудна.lengthM / 2 + 2;
	Иначе
		Смещение = ОсновноеСудно.size.beam / 2 + ОписаниеСудна.beamM / 2 + 2;
	КонецЕсли;
	КоординатаX = ОсновноеСудно.x + НаправлениеX * Смещение;
	КоординатаY = ОсновноеСудно.y + НаправлениеY * Смещение;
	Возврат СоздатьСтруктуруСуднаEDS(
		ОписаниеСудна,
		КоординатаX,
		КоординатаY,
		ОсновноеСудно.rotation);

КонецФункции

Функция СоздатьСтруктуруСуднаEDS(ОписаниеСудна, КоординатаX, КоординатаY, Угол)

	Размер = Новый Структура;
	Размер.Вставить("length", ОписаниеСудна.lengthM);
	Размер.Вставить("beam", ОписаниеСудна.beamM);
	Судно = Новый Структура;
	Судно.Вставить("id", ОписаниеСудна.id);
	Судно.Вставить("kind", "vessel");
	Судно.Вставить("name", ОписаниеСудна.name);
	Судно.Вставить("x", КоординатаX);
	Судно.Вставить("y", КоординатаY);
	Судно.Вставить("z", 0);
	Судно.Вставить("rotation", Угол);
	Судно.Вставить("color", ?(ОписаниеСудна.vesselType = "bunker", "#fef3c7", "#d7dee8"));
	Судно.Вставить("length", ОписаниеСудна.lengthM);
	Судно.Вставить("size", Размер);
	Судно.Вставить("berthId", ОписаниеСудна.berthId);
	Судно.Вставить("mooringSide", ОписаниеСудна.mooringSide);
	Судно.Вставить("vesselType", ОписаниеСудна.vesselType);
	Судно.Вставить("refueling", ОписаниеСудна.refueling);
	Возврат Судно;

КонецФункции

Функция НормализоватьСпособПостановкиEDS(Значение)

	Текст = НРег(СокрЛП(Строка(Значение)));
	Текст = СокрЛП(СтрЗаменить(Текст, "(большие кранцы)", ""));
	Текст = СокрЛП(СтрЗаменить(Текст, "(малые кранцы)", ""));
	Если Текст = "правый борт" Тогда
		Возврат "right";
	ИначеЕсли Текст = "левый борт" Тогда
		Возврат "left";
	ИначеЕсли Текст = "корма" Тогда
		Возврат "stern";
	ИначеЕсли Текст = "второй борт" Тогда
		Возврат "right";
	КонецЕсли;
	Возврат "right";

КонецФункции

Функция НормализоватьВидГрузаEDS(Значение)

	Текст = НРег(СокрЛП(Строка(Значение)));
	Если Текст = "контейнеры" Тогда
		Возврат "container";
	ИначеЕсли Текст = "рыбопродукция" Тогда
		Возврат "fish";
	ИначеЕсли Текст = "перестой" Тогда
		Возврат "empty";
	ИначеЕсли Текст = "уголь" Тогда
		Возврат "coal";
	ИначеЕсли Текст = "автотехника" Тогда
		Возврат "carCarrier";
	ИначеЕсли Текст = "бункеровка" Тогда
		Возврат "bunker";
	КонецЕсли;
	Возврат "general";

КонецФункции

Функция ЭтоБункеровкаEDS(Значение)

	Возврат НРег(СокрЛП(Строка(Значение))) = "бункеровка";

КонецФункции

Функция ОчиститьПредставлениеEDS(Значение)

	Текст = СокрЛП(Строка(Значение));
	Если Текст = "-" Или Текст = "—" Тогда
		Возврат "";
	КонецЕсли;
	Возврат Текст;

КонецФункции

Функция ЧислоEDS(Значение, ЗначениеПоУмолчанию)

	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат ЗначениеПоУмолчанию;
	КонецПопытки;

КонецФункции

Функция СанироватьТекстИдентификатораEDS(Значение)

	Текст = НРег(СокрЛП(Строка(Значение)));
	Текст = СтрЗаменить(Текст, " ", "-");
	Текст = СтрЗаменить(Текст, "/", "-");
	Текст = СтрЗаменить(Текст, "\", "-");
	Текст = СтрЗаменить(Текст, ".", "-");
	Текст = СтрЗаменить(Текст, ":", "-");
	Текст = СтрЗаменить(Текст, "(", "");
	Текст = СтрЗаменить(Текст, ")", "");
	Пока СтрНайти(Текст, "--") > 0 Цикл
		Текст = СтрЗаменить(Текст, "--", "-");
	КонецЦикла;
	Возврат Текст;

КонецФункции

Функция СформироватьИдентификаторСуднаEDS(ИдентификаторПричала, ИмяСудна, ДатаОперации)

	ЧастьИмени = СанироватьТекстИдентификатораEDS(ИмяСудна);
	ЧастьДаты = "без-даты";
	Если ЗначениеЗаполнено(ДатаОперации) Тогда
		ЧастьДаты = Формат(ДатаОперации, "ДФ=yyyyMMddHHmmss");
	КонецЕсли;
	Возврат "eds-" + ИдентификаторПричала + "-" + ЧастьИмени + "-" + ЧастьДаты;

КонецФункции

Функция ПолучитьУникальныйИдентификаторСуднаEDS(БазовыйИдентификатор, Идентификаторы)

	Идентификатор = БазовыйИдентификатор;
	Номер = 2;
	Пока Идентификаторы.Получить(Идентификатор) <> Неопределено Цикл
		Идентификатор = БазовыйИдентификатор + "-" + Формат(Номер, "ЧГ=0");
		Номер = Номер + 1;
	КонецЦикла;
	Идентификаторы.Вставить(Идентификатор, Истина);
	Возврат Идентификатор;

КонецФункции

Функция СобратьКраны(ОписаниеКранов, ГеометрияПлощадок, ПараметрыСцены, Ошибки)

	Результат = Новый Массив;
	Идентификаторы = Новый Соответствие;
	Для Каждого ОписаниеКрана Из ОписаниеКранов.cranes Цикл
		Идентификатор = Строка(ОписаниеКрана.id);
		Если Идентификаторы.Получить(Идентификатор) <> Неопределено Тогда
			ДобавитьОшибку(Ошибки, "CranesV4_json: повтор " + Идентификатор);
			Продолжить;
		КонецЕсли;
		Идентификаторы.Вставить(Идентификатор, Истина);

		Кран = Новый Структура;
		Кран.Вставить("id", Идентификатор);
		Кран.Вставить("name", Строка(ОписаниеКрана.name));
		Кран.Вставить("z", 0);
		Кран.Вставить("color", Строка(ОписаниеКрана.color));
		Кран.Вставить("craneType", Строка(ОписаниеКрана.type));

		Если ОписаниеКрана.type = "portal" Тогда
			Точка = ПреобразоватьКоординаты(ОписаниеКрана.position, ПараметрыСцены);
			// Стрела иконки направлена по локальной оси -Y. Геодезический азимут
			// (0° — север) переводится в угол сцены с учётом поворота origin.
			Угол = -ОписаниеКрана.azimuthDeg - ПараметрыСцены.rotationDeg;
			Размер = Новый Структура("gauge,outreach,length", 9, 21, 7);
			Кран.Вставить("kind", "cranePortal");
			Кран.Вставить("x", Точка.x);
			Кран.Вставить("y", Точка.y);
			Кран.Вставить("rotation", Угол);
			Кран.Вставить("model", Строка(ОписаниеКрана.model));
			Кран.Вставить("scale", ОписаниеКрана.scale);
			Кран.Вставить("azimuthDeg", ОписаниеКрана.azimuthDeg);
			Кран.Вставить("size", Размер);
			Результат.Добавить(Кран);
			Продолжить;
		КонецЕсли;

		ИдентификаторПлощадки = Строка(ОписаниеКрана.siteId);
		Геометрия = ГеометрияПлощадок.Получить(ИдентификаторПлощадки);
		Если Геометрия = Неопределено Тогда
			ДобавитьОшибку(Ошибки, "CranesV4_json: неизвестная площадка " + ИдентификаторПлощадки);
			Продолжить;
		КонецЕсли;
		ВдольBays = ОписаниеКрана.movementAxis = "bays";
		Если ВдольBays Тогда
			НаправлениеX = Геометрия.bayX;
			НаправлениеY = Геометрия.bayY;
			ПоперечныйX = Геометрия.rowX;
			ПоперечныйY = Геометрия.rowY;
			ПоперечныйРазмер = Геометрия.rowLength;
			ДлинаПути = Геометрия.bayLength;
			Угол = Геометрия.bayRotation + 90;
		Иначе
			НаправлениеX = Геометрия.rowX;
			НаправлениеY = Геометрия.rowY;
			ПоперечныйX = Геометрия.bayX;
			ПоперечныйY = Геометрия.bayY;
			ПоперечныйРазмер = Геометрия.bayLength;
			ДлинаПути = Геометрия.rowLength;
			Угол = Геометрия.rowRotation + 90;
		КонецЕсли;

		X = Геометрия.origin.x
			+ НаправлениеX * ОписаниеКрана.positionM
			+ ПоперечныйX * ПоперечныйРазмер / 2;
		Y = Геометрия.origin.y
			+ НаправлениеY * ОписаниеКрана.positionM
			+ ПоперечныйY * ПоперечныйРазмер / 2;
		// После поворота +90° локальная ось X иконки идёт поперёк площадки:
		// пролёт (расстояние между опорами) должен быть шире площадки.
		ВыносОпор = 2;
		Если ОписаниеКрана.type = "rmg" Тогда
			ВыносОпор = ОписаниеКрана.railInsetM;
		КонецЕсли;
		Пролет = ПоперечныйРазмер + 2 * ВыносОпор;
		Рельсы = Новый Массив;
		Если ОписаниеКрана.type = "rmg" Тогда
			// Рельсы снаружи площадки; опоры RMG стоят точно на них.
			Для ИндексРельса = 0 По 1 Цикл
				ПоперечноеСмещение = ?(
					ИндексРельса = 0,
					-ОписаниеКрана.railInsetM,
					ПоперечныйРазмер + ОписаниеКрана.railInsetM);
				НачалоРельсаX = Геометрия.origin.x + ПоперечныйX * ПоперечноеСмещение;
				НачалоРельсаY = Геометрия.origin.y + ПоперечныйY * ПоперечноеСмещение;
				Рельс = Новый Структура;
				Рельс.Вставить("x1", НачалоРельсаX);
				Рельс.Вставить("y1", НачалоРельсаY);
				Рельс.Вставить("x2", НачалоРельсаX + НаправлениеX * ДлинаПути);
				Рельс.Вставить("y2", НачалоРельсаY + НаправлениеY * ДлинаПути);
				Рельсы.Добавить(Рельс);
			КонецЦикла;
		КонецЕсли;

		Размер = Новый Структура("span,length", Пролет, 22);
		Кран.Вставить("kind", ?(ОписаниеКрана.type = "rmg", "craneRmg", "craneRtg"));
		Кран.Вставить("x", X);
		Кран.Вставить("y", Y);
		Кран.Вставить("rotation", Угол);
		Кран.Вставить("siteId", ИдентификаторПлощадки);
		Кран.Вставить("movementAxis", Строка(ОписаниеКрана.movementAxis));
		Кран.Вставить("positionM", ОписаниеКрана.positionM);
		Кран.Вставить("size", Размер);
		Если ОписаниеКрана.type = "rmg" Тогда
			Кран.Вставить("railInsetM", ОписаниеКрана.railInsetM);
			Кран.Вставить("leftWingM", ОписаниеКрана.leftWingM);
			Кран.Вставить("rightWingM", ОписаниеКрана.rightWingM);
			Кран.Вставить("rails", Рельсы);
		КонецЕсли;
		Результат.Добавить(Кран);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СобратьСоставыИзУПП(ТаблицаВагонов, ОписаниеЖелезныхДорог, Предупреждения)

	Если ТаблицаВагонов = Неопределено Тогда
		ВызватьИсключение "УПП вернул неопределённое значение вместо таблицы вагонов.";
	КонецЕсли;

	ВеткиПоИд = Новый Соответствие;
	Для Каждого ОписаниеВетки Из ОписаниеЖелезныхДорог.branches Цикл
		ИдентификаторВетки = СокрЛП(Строка(ОписаниеВетки.id));
		Если ПустаяСтрока(ИдентификаторВетки) Тогда
			Продолжить;
		КонецЕсли;
		ВеткиПоИд.Вставить(ИдентификаторВетки, ОписаниеВетки);
	КонецЦикла;

	Составы = Новый Массив;
	СоставыПоПути = Новый Соответствие;
	ИспользованныеИдентификаторы = Новый Соответствие;
	НеизвестныеПути = Новый Соответствие;

	Для Каждого СтрокаУПП Из ТаблицаВагонов Цикл
		Путь = СокрЛП(Строка(СтрокаУПП.Путь));
		Если ПустаяСтрока(Путь) Тогда
			Предупреждения.Добавить("УПП: пропущена строка без пути.");
			Продолжить;
		КонецЕсли;
		Если СтрНайти(Путь, " ") > 0 Тогда
			Предупреждения.Добавить(СтрШаблон("УПП: путь %1 пропущен, в коде есть пробел.", Путь));
			Продолжить;
		КонецЕсли;

		ОписаниеВетки = ВеткиПоИд.Получить(Путь);
		Если ОписаниеВетки = Неопределено Тогда
			Если НеизвестныеПути.Получить(Путь) = Неопределено Тогда
				НеизвестныеПути.Вставить(Путь, Истина);
				Предупреждения.Добавить(СтрШаблон("УПП: путь %1 не найден в макете веток.", Путь));
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		НомерВагона = СокрЛП(Строка(СтрокаУПП.НомерВагона));
		Если ПустаяСтрока(НомерВагона) Тогда
			Предупреждения.Добавить(СтрШаблон("УПП: на пути %1 пропущен вагон без номера.", Путь));
			Продолжить;
		КонецЕсли;

		ДлинаВагона = ЧислоEDS(СтрокаУПП.ВагонДлина, 0);
		Если ДлинаВагона <= 0 Тогда
			Предупреждения.Добавить(СтрШаблон("УПП: вагон %1 пропущен, не заполнена длина.", НомерВагона));
			Продолжить;
		КонецЕсли;

		ОписаниеСостава = СоставыПоПути.Получить(Путь);
		Если ОписаниеСостава = Неопределено Тогда
			ИдентификаторВетки = Строка(ОписаниеВетки.id);
			ОписаниеСостава = Новый Структура;
			ОписаниеСостава.Вставить("id", "TRAIN-" + ИдентификаторВетки);
			ОписаниеСостава.Вставить("name", СокрЛП(Строка(ОписаниеВетки.name)));
			ОписаниеСостава.Вставить("branchId", ИдентификаторВетки);
			ОписаниеСостава.Вставить("offsetM", 0);
			ОписаниеСостава.Вставить("direction", "forward");
			ОписаниеСостава.Вставить("gapM", 1);
			ОписаниеСостава.Вставить("wagons", Новый Массив);
			Составы.Добавить(ОписаниеСостава);
			СоставыПоПути.Вставить(Путь, ОписаниеСостава);
		КонецЕсли;

		ИдентификаторВагона = НомерВагона;
		Если ИспользованныеИдентификаторы.Получить(ИдентификаторВагона) <> Неопределено Тогда
			ИдентификаторВагона = СтрШаблон("%1-%2", НомерВагона, ОписаниеСостава.wagons.Количество() + 1);
			Предупреждения.Добавить(СтрШаблон(
				"УПП: повтор номера вагона %1, использован идентификатор %2.",
				НомерВагона,
				ИдентификаторВагона));
		КонецЕсли;
		ИспользованныеИдентификаторы.Вставить(ИдентификаторВагона, Истина);

		ОписаниеВагона = Новый Структура;
		ОписаниеВагона.Вставить("id", ИдентификаторВагона);
		ОписаниеВагона.Вставить("type", СокрЛП(Строка(СтрокаУПП.ТипВагона)));
		ОписаниеВагона.Вставить("lengthM", ДлинаВагона);
		ОписаниеВагона.Вставить("loaded", СтрокаУПП.Груженый = Истина);
		ОписаниеСостава.wagons.Добавить(ОписаниеВагона);
	КонецЦикла;

	Возврат Составы;

КонецФункции

Функция СобратьЖелезнуюДорогу(ОписаниеЖелезныхДорог, ПараметрыСцены, Ошибки, ПредупрежденияРазмещения = Неопределено)

	ВизуальныеЛинии = Новый Массив;
	Ветки = Новый Массив;
	ВеткиПоИд = Новый Соответствие;

	Для Каждого ОписаниеЛинии Из ОписаниеЖелезныхДорог.visualPaths Цикл
		Линия = СобратьЛиниюЖД(ОписаниеЛинии, ПараметрыСцены, "визуальная линия", Ошибки);
		Если Линия <> Неопределено Тогда
			ВизуальныеЛинии.Добавить(Линия);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ОписаниеВетки Из ОписаниеЖелезныхДорог.branches Цикл
		Линия = СобратьЛиниюЖД(ОписаниеВетки, ПараметрыСцены, "ветка", Ошибки);
		Если Линия = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Не Линия.Свойство("id") Или ПустаяСтрока(Линия.id) Тогда
			ДобавитьОшибку(Ошибки, "RailwaysV4_json: у ветки отсутствует id");
			Продолжить;
		КонецЕсли;
		Если ВеткиПоИд.Получить(Линия.id) <> Неопределено Тогда
			ДобавитьОшибку(Ошибки, "RailwaysV4_json: повтор ветки " + Линия.id);
			Продолжить;
		КонецЕсли;
		Ветки.Добавить(Линия);
		ВеткиПоИд.Вставить(Линия.id, Линия);
	КонецЦикла;

	Вагоны = Новый Массив;
	КоличествоСоставов = 0;
	Для Каждого ОписаниеСостава Из ОписаниеЖелезныхДорог.trains Цикл
		ИдентификаторСостава = Строка(ОписаниеСостава.id);
		ИдентификаторВетки = Строка(ОписаниеСостава.branchId);
		Ветка = ВеткиПоИд.Получить(ИдентификаторВетки);
		Если Ветка = Неопределено Тогда
			ТекстНеизвестнойВетки = "RailwaysV4_json: неизвестная ветка " + ИдентификаторВетки;
			Если ПредупрежденияРазмещения = Неопределено Тогда
				ДобавитьОшибку(Ошибки, ТекстНеизвестнойВетки);
			Иначе
				ПредупрежденияРазмещения.Добавить(ТекстНеизвестнойВетки);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		КоличествоСоставов = КоличествоСоставов + 1;
		Направление = ?(ОписаниеСостава.direction = "reverse", -1, 1);
		Зазор = 1;
		Если ОписаниеСостава.Свойство("gapM") Тогда
			Зазор = ОписаниеСостава.gapM;
		КонецЕсли;
		Позиция = ОписаниеСостава.offsetM;
		ПредыдущаяДлина = 0;
		ИндексВагона = 0;

		Для Каждого ОписаниеВагона Из ОписаниеСостава.wagons Цикл
			ДлинаВагона = ПолучитьРазмерВагона(ОписаниеВагона, "length", 14);
			ШиринаВагона = ПолучитьРазмерВагона(ОписаниеВагона, "width", 3.1);
			Если ИндексВагона = 0 Тогда
				Позиция = Позиция + ДлинаВагона / 2;
			Иначе
				Позиция = Позиция
					+ ПредыдущаяДлина / 2 + Зазор + ДлинаВагона / 2;
			КонецЕсли;
			Если ПредупрежденияРазмещения <> Неопределено
				И Позиция + ДлинаВагона / 2 > Ветка.lengthM Тогда
				ОсталосьВагонов = ОписаниеСостава.wagons.Количество() - ИндексВагона;
				ПредупрежденияРазмещения.Добавить(СтрШаблон(
					"УПП: на ветке %1 размещены %2 вагонов, не влезло %3.",
					ИдентификаторВетки,
					ИндексВагона,
					ОсталосьВагонов));
				Прервать;
			КонецЕсли;
			Положение = ПолучитьПоложениеНаЛинии(
				Ветка,
				Позиция,
				Ошибки,
				ПредупрежденияРазмещения <> Неопределено);
			Если Положение = Неопределено Тогда
				Если ПредупрежденияРазмещения <> Неопределено Тогда
					ОсталосьВагонов = ОписаниеСостава.wagons.Количество() - ИндексВагона;
					ПредупрежденияРазмещения.Добавить(СтрШаблон(
						"УПП: на ветке %1 размещены %2 вагонов, не влезло %3.",
						ИдентификаторВетки,
						ИндексВагона,
						ОсталосьВагонов));
					Прервать;
				КонецЕсли;
				Продолжить;
			КонецЕсли;

			ИдентификаторВагона = Строка(ОписаниеВагона.id);
			ТипВагона = Строка(ОписаниеВагона.type);
			ЦветВагона = "#6b7280";
			Если ОписаниеВагона.Свойство("color") Тогда
				ЦветВагона = Строка(ОписаниеВагона.color);
			КонецЕсли;
			Загружен = Ложь;
			Если ОписаниеВагона.Свойство("loaded") И ОписаниеВагона.loaded = Истина Тогда
				Загружен = Истина;
			КонецЕсли;

			Вагон = Новый Структура;
			Вагон.Вставить("id", ИдентификаторВагона);
			Вагон.Вставить("kind", "railWagon");
			Вагон.Вставить("name", ИдентификаторВагона);
			Вагон.Вставить("x", Положение.x);
			Вагон.Вставить("y", Положение.y);
			Вагон.Вставить("z", 0);
			Вагон.Вставить("rotation", Положение.rotation + ?(Направление < 0, 180, 0));
			Вагон.Вставить("color", ЦветВагона);
			Вагон.Вставить("size", Новый Структура("length,width", ДлинаВагона, ШиринаВагона));
			Вагон.Вставить("wagonType", ТипВагона);
			Вагон.Вставить("trainId", ИдентификаторСостава);
			Вагон.Вставить("branchId", ИдентификаторВетки);
			Вагон.Вставить("positionM", Позиция);
			Вагон.Вставить("loaded", Загружен);
			Вагоны.Добавить(Вагон);

			ПредыдущаяДлина = ДлинаВагона;
			ИндексВагона = ИндексВагона + 1;
		КонецЦикла;
	КонецЦикла;

	Топология = Новый Структура;
	Топология.Вставить("visual", ВизуальныеЛинии);
	Топология.Вставить("branches", Ветки);
	Результат = Новый Структура;
	Результат.Вставить("Топология", Топология);
	Результат.Вставить("Вагоны", Вагоны);
	Результат.Вставить("КоличествоСоставов", КоличествоСоставов);
	Возврат Результат;

КонецФункции

Функция СобратьЛиниюЖД(ОписаниеЛинии, ПараметрыСцены, Представление, Ошибки)

	КоординатыЛинии = Неопределено;
	Если Не ОписаниеЛинии.Свойство("coordinates", КоординатыЛинии)
		Или КоординатыЛинии.Количество() < 2 Тогда
		ДобавитьОшибку(Ошибки, "RailwaysV4_json: " + Представление + " содержит менее двух точек");
		Возврат Неопределено;
	КонецЕсли;
	Точки = Новый Массив;
	Длина = 0;
	ПредыдущаяТочка = Неопределено;
	Для Каждого Координаты Из КоординатыЛинии Цикл
		Точка = ПреобразоватьКоординаты(Координаты, ПараметрыСцены);
		Точки.Добавить(Точка);
		Если ПредыдущаяТочка <> Неопределено Тогда
			Длина = Длина + Расстояние(ПредыдущаяТочка, Точка);
		КонецЕсли;
		ПредыдущаяТочка = Точка;
	КонецЦикла;
	Если Длина <= 0 Тогда
		ДобавитьОшибку(Ошибки, "RailwaysV4_json: нулевая длина линии");
		Возврат Неопределено;
	КонецЕсли;

	Линия = Новый Структура;
	Если ОписаниеЛинии.Свойство("id") Тогда
		Линия.Вставить("id", Строка(ОписаниеЛинии.id));
	КонецЕсли;
	Если ОписаниеЛинии.Свойство("name") Тогда
		Линия.Вставить("name", Строка(ОписаниеЛинии.name));
	КонецЕсли;
	ШиринаКолеи = 1.52;
	Если ОписаниеЛинии.Свойство("gaugeM") Тогда
		ШиринаКолеи = ОписаниеЛинии.gaugeM;
	КонецЕсли;
	ЦветЛинии = "#6b7280";
	Если ОписаниеЛинии.Свойство("color") Тогда
		ЦветЛинии = Строка(ОписаниеЛинии.color);
	КонецЕсли;
	Линия.Вставить("gaugeM", ШиринаКолеи);
	Линия.Вставить("color", ЦветЛинии);
	Линия.Вставить("points", Точки);
	Линия.Вставить("lengthM", Длина);
	Возврат Линия;

КонецФункции

Функция ПолучитьРазмерВагона(ОписаниеВагона, ИмяРазмера, ЗначениеПоУмолчанию)

	Размеры = Неопределено;
	Если ОписаниеВагона.Свойство("size", Размеры) И Размеры.Свойство(ИмяРазмера) Тогда
		Возврат Размеры[ИмяРазмера];
	КонецЕсли;
	ИмяПоля = ИмяРазмера + "M";
	Если Размеры <> Неопределено И Размеры.Свойство(ИмяПоля) Тогда
		Возврат Размеры[ИмяПоля];
	КонецЕсли;
	Если ОписаниеВагона.Свойство(ИмяПоля) Тогда
		Возврат ОписаниеВагона[ИмяПоля];
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;

КонецФункции

Функция ПолучитьПоложениеНаЛинии(Линия, ПозицияM, Ошибки, МягкийРежим = Ложь)

	Если ПозицияM < 0 Или ПозицияM > Линия.lengthM Тогда
		Если Не МягкийРежим Тогда
			ДобавитьОшибку(Ошибки, СтрШаблон(
				"RailwaysV4_json: позиция %1 м выходит за ветку %2 длиной %3 м",
				ПозицияM, Линия.id, Линия.lengthM));
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	Пройдено = 0;
	Для Индекс = 1 По Линия.points.ВГраница() Цикл
		Начало = Линия.points[Индекс - 1];
		Конец = Линия.points[Индекс];
		ДлинаСегмента = Расстояние(Начало, Конец);
		Если ДлинаСегмента <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Пройдено + ДлинаСегмента >= ПозицияM
			Или Индекс = Линия.points.ВГраница() Тогда
			Доля = (ПозицияM - Пройдено) / ДлинаСегмента;
			Доля = Макс(0, Мин(1, Доля));
			X = Начало.x + (Конец.x - Начало.x) * Доля;
			Y = Начало.y + (Конец.y - Начало.y) * Доля;
			Угол = Арктангенс2(Конец.y - Начало.y, Конец.x - Начало.x) * 180 / 3.141592653589793;
			Возврат Новый Структура("x,y,rotation", X, Y, Угол);
		КонецЕсли;
		Пройдено = Пройдено + ДлинаСегмента;
	КонецЦикла;
