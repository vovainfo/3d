КонецФункции

Процедура СгенерироватьРазмещенияБлока(Блок, Размещения, ГСЧ)

	ЧислоРядов = Блок.rows;
	ЧислоБэев = Блок.bays;
	МаксЯрус = Блок.maxTier;

	// Занятость: ключ "row:bay:tier" → id размещения.
	Занято = Новый Соответствие;

	// Разреженная демо-загрузка: иначе JSON/рендер ~10–30k placements убивают WebKit 1С.
	// Нумерация ячеек с 1: row ∈ [1..rows], bay ∈ [1..bays].
	Для НомерРяда = 1 По ЧислоРядов Цикл
		НомерБэя = 1;
		Пока НомерБэя <= ЧислоБэев Цикл
			// ~10% слотов без штабеля (было ~55% → занятость примерно x2).
			Если ГСЧ.СлучайноеЧисло(1, 100) <= 10 Тогда
				НомерБэя = НомерБэя + 1;
				Продолжить;
			КонецЕсли;

			Высота = ГСЧ.СлучайноеЧисло(1, Мин(4, МаксЯрус));
			Ярус = 1;
			Пока Ярус <= Высота Цикл
				Ключ = КлючСлота(НомерРяда, НомерБэя, Ярус);
				Если Занято.Получить(Ключ) <> Неопределено Тогда
					Прервать;
				КонецЕсли;

				Можно40 = (НомерБэя + 1 <= ЧислоБэев)
					И (Занято.Получить(КлючСлота(НомерРяда, НомерБэя + 1, Ярус)) = Неопределено)
					И (Ярус = 1
						Или Занято.Получить(КлючСлота(НомерРяда, НомерБэя + 1, Ярус - 1)) <> Неопределено);

				Бросок = ГСЧ.СлучайноеЧисло(1, 100);
				Если Можно40 И Бросок <= 45 Тогда
					Размещение = СоздатьРазмещение(Блок, НомерРяда, НомерБэя, Ярус, 40);
					Размещения.Добавить(Размещение);
					Занято.Вставить(КлючСлота(НомерРяда, НомерБэя, Ярус), Размещение.id);
					Занято.Вставить(КлючСлота(НомерРяда, НомерБэя + 1, Ярус), Размещение.id);
				Иначе
					Размещение = СоздатьРазмещение(Блок, НомерРяда, НомерБэя, Ярус, 20);
					Размещения.Добавить(Размещение);
					Занято.Вставить(КлючСлота(НомерРяда, НомерБэя, Ярус), Размещение.id);
				КонецЕсли;
				Ярус = Ярус + 1;
			КонецЦикла;

			// Если поставили 40 ft на нижнем ярусе, сдвигаем на 2 bay.
			Если Занято.Получить(КлючСлота(НомерРяда, НомерБэя, 1)) <> Неопределено
				И НомерБэя + 1 <= ЧислоБэев
				И Занято.Получить(КлючСлота(НомерРяда, НомерБэя + 1, 1))
					= Занято.Получить(КлючСлота(НомерРяда, НомерБэя, 1)) Тогда
				НомерБэя = НомерБэя + 2;
			Иначе
				НомерБэя = НомерБэя + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция КлючСлота(Row, Bay, Tier)

	Возврат СтрШаблон("%1:%2:%3", Row, Bay, Tier);

КонецФункции

Функция СоздатьРазмещение(Блок, Row, Bay, Tier, LengthFt)

	Span = ?(LengthFt = 40, 2, 1);
	ИдЯчеек = Новый Массив;
	ИдЯчеек.Добавить(СтрШаблон("%1:%2:%3", Блок.id, Row, Bay));
	Если Span = 2 Тогда
		ИдЯчеек.Добавить(СтрШаблон("%1:%2:%3", Блок.id, Row, Bay + 1));
	КонецЕсли;

	Возврат Новый Структура(
		"id,kind,blockId,row,bay,tier,lengthFt,spanCells,cellIds",
		СтрШаблон("P-%1-%2-%3-T%4-%5", Блок.id, Row, Bay, Tier, LengthFt),
		"placement",
		Блок.id,
		Row,
		Bay,
		Tier,
		LengthFt,
		Span,
		ИдЯчеек);

КонецФункции

Функция ОписаниеБлока(Идентификатор, OriginX, OriginY, RotationDeg, RowPitch, BayPitch, TierPitch, Rows, Bays, MaxTier,
	RowSize = Неопределено, BaySize = Неопределено)

	Возврат Новый Структура(
		"id,originX,originY,rotationDeg,rowPitch,bayPitch,rowSize,baySize,tierPitch,rows,bays,maxTier",
		Идентификатор, OriginX, OriginY, RotationDeg, RowPitch, BayPitch,
		?(RowSize = Неопределено, RowPitch * 0.88, RowSize),
		?(BaySize = Неопределено, BayPitch * 0.94, BaySize),
		TierPitch, Rows, Bays, MaxTier);

