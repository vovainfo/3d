Функция РассчитатьГраницыСцены(БереговаяЛиния, КольцаВоды, Здания, Дороги, ГраницаПорта, Площадки, ЖелезныеДороги, Объекты)

	ВсеТочки = Новый Массив;
	Для Каждого Точка Из БереговаяЛиния Цикл
		ВсеТочки.Добавить(Точка);
	КонецЦикла;
	Для Каждого Кольцо Из КольцаВоды Цикл
		Для Каждого Точка Из Кольцо Цикл
			ВсеТочки.Добавить(Точка);
		КонецЦикла;
	КонецЦикла;
	Для Каждого Здание Из Здания Цикл
		Для Каждого Точка Из Здание.polygon Цикл
			ВсеТочки.Добавить(Точка);
		КонецЦикла;
	КонецЦикла;
	Для Каждого Дорога Из Дороги Цикл
		Для Каждого Точка Из Дорога.points Цикл
			ВсеТочки.Добавить(Точка);
		КонецЦикла;
	КонецЦикла;
	Для Каждого ЛинияГраницы Из ГраницаПорта Цикл
		Для Каждого Точка Из ЛинияГраницы.points Цикл
			ВсеТочки.Добавить(Точка);
		КонецЦикла;
	КонецЦикла;
	Для Каждого Площадка Из Площадки Цикл
		Для Каждого Точка Из Площадка.polygon Цикл
			ВсеТочки.Добавить(Точка);
		КонецЦикла;
	КонецЦикла;
	Для Каждого Линия Из ЖелезныеДороги.visual Цикл
		Для Каждого Точка Из Линия.points Цикл
			ВсеТочки.Добавить(Точка);
		КонецЦикла;
	КонецЦикла;
	Для Каждого Линия Из ЖелезныеДороги.branches Цикл
		Для Каждого Точка Из Линия.points Цикл
			ВсеТочки.Добавить(Точка);
		КонецЦикла;
	КонецЦикла;
	Для Каждого ОбъектСцены Из Объекты Цикл
		Если ОбъектСцены.kind = "vessel" Тогда
			Радиус = Sqrt(Pow(ОбъектСцены.size.length / 2, 2) + Pow(ОбъектСцены.size.beam / 2, 2));
			ВсеТочки.Добавить(Новый Структура("x,y", ОбъектСцены.x - Радиус, ОбъектСцены.y - Радиус));
			ВсеТочки.Добавить(Новый Структура("x,y", ОбъектСцены.x + Радиус, ОбъектСцены.y + Радиус));
		ИначеЕсли ОбъектСцены.kind = "cranePortal" Тогда
			Радиус = (ОбъектСцены.size.outreach + ОбъектСцены.size.gauge + ОбъектСцены.size.length)
				* ОбъектСцены.scale;
			ВсеТочки.Добавить(Новый Структура("x,y", ОбъектСцены.x - Радиус, ОбъектСцены.y - Радиус));
			ВсеТочки.Добавить(Новый Структура("x,y", ОбъектСцены.x + Радиус, ОбъектСцены.y + Радиус));
		ИначеЕсли ОбъектСцены.kind = "craneRtg" Или ОбъектСцены.kind = "craneRmg" Тогда
			Полупролет = ОбъектСцены.size.span / 2;
			Если ОбъектСцены.kind = "craneRmg" Тогда
				Полупролет = Полупролет + Макс(ОбъектСцены.leftWingM, ОбъектСцены.rightWingM);
			КонецЕсли;
			Радиус = Sqrt(Pow(ОбъектСцены.size.length / 2, 2) + Pow(Полупролет, 2));
			ВсеТочки.Добавить(Новый Структура("x,y", ОбъектСцены.x - Радиус, ОбъектСцены.y - Радиус));
			ВсеТочки.Добавить(Новый Структура("x,y", ОбъектСцены.x + Радиус, ОбъектСцены.y + Радиус));
			Если ОбъектСцены.Свойство("rails") Тогда
				Для Каждого Рельс Из ОбъектСцены.rails Цикл
					ВсеТочки.Добавить(Новый Структура("x,y", Рельс.x1, Рельс.y1));
					ВсеТочки.Добавить(Новый Структура("x,y", Рельс.x2, Рельс.y2));
				КонецЦикла;
			КонецЕсли;
		ИначеЕсли ОбъектСцены.kind = "railWagon" Тогда
			Радиус = Sqrt(Pow(ОбъектСцены.size.length / 2, 2) + Pow(ОбъектСцены.size.width / 2, 2));
			ВсеТочки.Добавить(Новый Структура("x,y", ОбъектСцены.x - Радиус, ОбъектСцены.y - Радиус));
			ВсеТочки.Добавить(Новый Структура("x,y", ОбъектСцены.x + Радиус, ОбъектСцены.y + Радиус));
		КонецЕсли;
	КонецЦикла;
	Если ВсеТочки.Количество() = 0 Тогда
		Возврат Новый Структура("minX,minY,maxX,maxY", 0, 0, 1, 1);
	КонецЕсли;
	МинимумX = ВсеТочки[0].x;
	МинимумY = ВсеТочки[0].y;
	МаксимумX = ВсеТочки[0].x;
	МаксимумY = ВсеТочки[0].y;
	Для Каждого Точка Из ВсеТочки Цикл
		МинимумX = Мин(МинимумX, Точка.x);
		МинимумY = Мин(МинимумY, Точка.y);
		МаксимумX = Макс(МаксимумX, Точка.x);
		МаксимумY = Макс(МаксимумY, Точка.y);
	КонецЦикла;
	Возврат Новый Структура("minX,minY,maxX,maxY", МинимумX, МинимумY, МаксимумX, МаксимумY);

КонецФункции

