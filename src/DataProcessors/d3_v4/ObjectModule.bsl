#Область Геометрия

Функция СобратьБереговуюЛинию(GeoJSON, ПараметрыСцены, Ошибки)

	Результат = Новый Массив;
	Для Каждого Feature Из GeoJSON.features Цикл
		Если Feature.geometry.type <> "LineString" Тогда
			ДобавитьОшибку(Ошибки, "Shoreline_geojson: допустим только LineString");
			Продолжить;
		КонецЕсли;
		Для Каждого Координаты Из Feature.geometry.coordinates Цикл
			Результат.Добавить(ПреобразоватьКоординаты(Координаты, ПараметрыСцены));
		КонецЦикла;
	КонецЦикла;
	Если Результат.Количество() < 2 Тогда
		ДобавитьОшибку(Ошибки, "Shoreline_geojson: менее двух точек");
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция СобратьКольцаВоды(GeoJSON, ПараметрыСцены, Ошибки)

	Результат = Новый Массив;
	Для Каждого Feature Из GeoJSON.features Цикл
		Если Feature.geometry.type = "Polygon" Тогда
			ДобавитьКольцаПолигона(Feature.geometry.coordinates, ПараметрыСцены, Результат, Ошибки);
		ИначеЕсли Feature.geometry.type = "MultiPolygon" Тогда
			Для Каждого Полигон Из Feature.geometry.coordinates Цикл
				ДобавитьКольцаПолигона(Полигон, ПараметрыСцены, Результат, Ошибки);
			КонецЦикла;
		Иначе
			ДобавитьОшибку(Ошибки, "Water_geojson: допустимы Polygon и MultiPolygon");
		КонецЕсли;
	КонецЦикла;
	Если Результат.Количество() = 0 Тогда
		ДобавитьОшибку(Ошибки, "Water_geojson: нет колец воды");
	КонецЕсли;
	Возврат Результат;

КонецФункции

Процедура ДобавитьКольцаПолигона(Кольца, ПараметрыСцены, Результат, Ошибки)

	Для Каждого КоординатыКольца Из Кольца Цикл
		Кольцо = Новый Массив;
		Для Каждого Координаты Из КоординатыКольца Цикл
			Кольцо.Добавить(ПреобразоватьКоординаты(Координаты, ПараметрыСцены));
		КонецЦикла;
		Если Кольцо.Количество() < 4 Тогда
			ДобавитьОшибку(Ошибки, "Water_geojson: кольцо содержит менее четырех точек");
		Иначе
			Результат.Добавить(Кольцо);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьВершиныПолигона(Feature, ПараметрыСцены, Имя, Ошибки)

	Результат = Новый Массив;
	Если Feature.geometry.type <> "Polygon" Тогда
		ДобавитьОшибку(Ошибки, Имя + ": ожидается Polygon");
		Возврат Результат;
	КонецЕсли;
	Кольцо = Feature.geometry.coordinates[0];
	Для Индекс = 0 По Кольцо.ВГраница() Цикл
		Если Индекс = Кольцо.ВГраница()
			И Кольцо[Индекс][0] = Кольцо[0][0]
			И Кольцо[Индекс][1] = Кольцо[0][1] Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(ПреобразоватьКоординаты(Кольцо[Индекс], ПараметрыСцены));
	КонецЦикла;
	Если Результат.Количество() <> 4 Тогда
		ДобавитьОшибку(Ошибки, Имя + ": прямоугольник должен иметь четыре вершины");
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ПолучитьТочкиЛинии(Feature, ПараметрыСцены, Имя, Ошибки)

	Результат = Новый Массив;
	Если Feature.geometry.type <> "LineString" Или Feature.geometry.coordinates.Количество() <> 2 Тогда
		ДобавитьОшибку(Ошибки, Имя + ": ожидается LineString из двух точек");
		Возврат Результат;
	КонецЕсли;
	Для Каждого Координаты Из Feature.geometry.coordinates Цикл
		Результат.Добавить(ПреобразоватьКоординаты(Координаты, ПараметрыСцены));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПреобразоватьКоординаты(Координаты, ПараметрыСцены)

	ЛокальнаяX = Координаты[0] - ПараметрыСцены.originEasting;
	ЛокальнаяY = Координаты[1] - ПараметрыСцены.originNorthing;
	Радианы = -ПараметрыСцены.rotationDeg * 3.141592653589793 / 180;
	КоординатаX = ЛокальнаяX * Cos(Радианы) - ЛокальнаяY * Sin(Радианы);
	КоординатаY = ЛокальнаяX * Sin(Радианы) + ЛокальнаяY * Cos(Радианы);
	Возврат Новый Структура("x,y", КоординатаX, КоординатаY);

КонецФункции

Функция СредняяТочка(Точки)

	СуммаX = 0;
	СуммаY = 0;
	Для Каждого Точка Из Точки Цикл
		СуммаX = СуммаX + Точка.x;
		СуммаY = СуммаY + Точка.y;
	КонецЦикла;
	Возврат Новый Структура("x,y", СуммаX / Точки.Количество(), СуммаY / Точки.Количество());

КонецФункции

Функция Расстояние(ПерваяТочка, ВтораяТочка)

	Возврат Sqrt(Pow(ВтораяТочка.x - ПерваяТочка.x, 2) + Pow(ВтораяТочка.y - ПерваяТочка.y, 2));

КонецФункции

Функция Арктангенс2(КоординатаY, КоординатаX)

	Если КоординатаX > 0 Тогда
		Возврат ATan(КоординатаY / КоординатаX);
	ИначеЕсли КоординатаX < 0 И КоординатаY >= 0 Тогда
		Возврат ATan(КоординатаY / КоординатаX) + 3.141592653589793;
	ИначеЕсли КоординатаX < 0 И КоординатаY < 0 Тогда
		Возврат ATan(КоординатаY / КоординатаX) - 3.141592653589793;
	ИначеЕсли КоординатаY > 0 Тогда
		Возврат 3.141592653589793 / 2;
	ИначеЕсли КоординатаY < 0 Тогда
		Возврат -3.141592653589793 / 2;
	КонецЕсли;
	Возврат 0;

КонецФункции

Функция РассчитатьГраницыСцены(БереговаяЛиния, КольцаВоды, Площадки)

	ВсеТочки = Новый Массив;
	Для Каждого Точка Из БереговаяЛиния Цикл
		ВсеТочки.Добавить(Точка);
	КонецЦикла;
	Для Каждого Кольцо Из КольцаВоды Цикл
		Для Каждого Точка Из Кольцо Цикл
			ВсеТочки.Добавить(Точка);
		КонецЦикла;
	КонецЦикла;
	Для Каждого Площадка Из Площадки Цикл
		Для Каждого Точка Из Площадка.polygon Цикл
			ВсеТочки.Добавить(Точка);
		КонецЦикла;
	КонецЦикла;
	Если ВсеТочки.Количество() = 0 Тогда
		Возврат Новый Структура("minX,minY,maxX,maxY", 0, 0, 1, 1);
	КонецЕсли;
	МинимумX = ВсеТочки[0].x;
	МинимумY = ВсеТочки[0].y;
	МаксимумX = ВсеТочки[0].x;
	МаксимумY = ВсеТочки[0].y;
	Для Каждого Точка Из ВсеТочки Цикл
		МинимумX = Мин(МинимумX, Точка.x);
		МинимумY = Мин(МинимумY, Точка.y);
		МаксимумX = Макс(МаксимумX, Точка.x);
		МаксимумY = Макс(МаксимумY, Точка.y);
	КонецЦикла;
	Возврат Новый Структура("minX,minY,maxX,maxY", МинимумX, МинимумY, МаксимумX, МаксимумY);

