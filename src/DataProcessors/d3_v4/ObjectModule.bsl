// Возвращает HTML-документ плана с CSS/JS и JSON данных (без Three.js).
//
Функция СобратьHTMLСцены() Экспорт

	HTML = ПолучитьМакет("МакетHTML").ПолучитьТекст();
	JS = ПолучитьМакет("МакетJS").ПолучитьТекст();
	CSS = ПолучитьМакет("МакетCSS").ПолучитьТекст();

	HTML = СтрЗаменить(HTML, "@CSS", CSS);
	HTML = СтрЗаменить(HTML, "@JS", JS);

	Снимок = ПолучитьСнимок();
	JSONСцены = СериализоватьJSON(Снимок.ДанныеСцены);
	JSONСцены = СтрЗаменить(JSONСцены, "</", "<\/");
	HTML = СтрЗаменить(HTML, "@SceneData", JSONСцены);

	Результат = Новый Структура;
	Результат.Вставить("HTML", HTML);
	Результат.Вставить("ДанныеСценыJSON", JSONСцены);
	Результат.Вставить("SnapshotId", Снимок.SnapshotId);
	Результат.Вставить("СостояниеОбмена", Снимок.СостояниеОбмена);
	Возврат Результат;

КонецФункции

Функция ПолучитьСнимок() Экспорт

	ДанныеСцены = СгенерироватьДемоСцену();
	SnapshotId = "stub-" + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0");

	Результат = Новый Структура;
	Результат.Вставить("SnapshotId", SnapshotId);
	Результат.Вставить("ДанныеСцены", ДанныеСцены);
	Результат.Вставить("СостояниеОбмена", "stub · 2D plan · polling выключен");
	Возврат Результат;

КонецФункции

Функция ПолучитьЧанкСнимка(SnapshotId, ChunkIndex) Экспорт

	Снимок = ПолучитьСнимок();
	Чанк = Новый Структура;
	Чанк.Вставить("snapshotId", SnapshotId);
	Чанк.Вставить("chunkIndex", ChunkIndex);
	Чанк.Вставить("blockId", "*");
	Чанк.Вставить("placements", Снимок.ДанныеСцены.placements);
	Чанк.Вставить("objects", Снимок.ДанныеСцены.objects);
	Возврат Чанк;

КонецФункции

Функция ПолучитьИзменения(ПослеВерсии) Экспорт

	Delta = Новый Структура;
	Delta.Вставить("baseSnapshotId", "");
	Delta.Вставить("version", ПослеВерсии);
	Delta.Вставить("moves", Новый Массив);
	Delta.Вставить("placementUpserts", Новый Массив);
	Delta.Вставить("placementRemoved", Новый Массив);
	Delta.Вставить("cellUpserts", Новый Массив);
	Delta.Вставить("upserts", Новый Массив);
	Delta.Вставить("removed", Новый Массив);
	Delta.Вставить("quality", Новый Массив);
