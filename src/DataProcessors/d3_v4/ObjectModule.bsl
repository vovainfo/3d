Процедура ДобавитьСудаИСтс(Объекты)

	// Причал: y=105 на участке [0..280], y=72 на участке [400..720].
	// Суда вплотную к стенке: южный борт ≈ y_причала − 1 м.
	Зазор = 1;

	// Судно 1 — западный прямолинейный участок (y = 105)
	Длина1 = 152;
	Ширина1 = 28;
	YПричала1 = 105;
	YСудна1 = YПричала1 - Ширина1 / 2 - Зазор;
	Объекты.Добавить(Новый Структура(
		"id,kind,name,x,y,z,rotation,color,length,size",
		"SHIP-001", "vessel", "MV Aurora",
		155, YСудна1, 0, 0, "#d7dee8",
		Длина1,
		Новый Структура("length,beam", Длина1, Ширина1)));
	Объекты.Добавить(Новый Структура(
		"id,kind,name,x,y,z,rotation,color,vesselId,size",
		"CR-STS-1A", "craneSts", "STS 1A",
		110, YПричала1, 0, 0, "#f0c000", "SHIP-001",
		Новый Структура("gauge,outreach,length", 16, Ширина1 + 8, 14)));
	Объекты.Добавить(Новый Структура(
		"id,kind,name,x,y,z,rotation,color,vesselId,size",
		"CR-STS-1B", "craneSts", "STS 1B",
		200, YПричала1, 0, 0, "#e8b400", "SHIP-001",
		Новый Структура("gauge,outreach,length", 16, Ширина1 + 8, 14)));

	// Судно 2 — восточный прямолинейный участок (y = 72)
	Длина2 = 186;
	Ширина2 = 32;
	YПричала2 = 72;
	YСудна2 = YПричала2 - Ширина2 / 2 - Зазор;
	Объекты.Добавить(Новый Структура(
		"id,kind,name,x,y,z,rotation,color,length,size",
		"SHIP-002", "vessel", "MV Pacific Star",
		560, YСудна2, 0, 0, "#cfd6e0",
		Длина2,
		Новый Структура("length,beam", Длина2, Ширина2)));
	Объекты.Добавить(Новый Структура(
		"id,kind,name,x,y,z,rotation,color,vesselId,size",
		"CR-STS-2A", "craneSts", "STS 2A",
		490, YПричала2, 0, 0, "#f0c000", "SHIP-002",
		Новый Структура("gauge,outreach,length", 18, Ширина2 + 10, 15)));
	Объекты.Добавить(Новый Структура(
		"id,kind,name,x,y,z,rotation,color,vesselId,size",
		"CR-STS-2B", "craneSts", "STS 2B",
		630, YПричала2, 0, 0, "#e8b400", "SHIP-002",
		Новый Структура("gauge,outreach,length", 18, Ширина2 + 10, 15)));

