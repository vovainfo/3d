#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьWebСервисПоБазе(База)

	ПараметрыПодключения = Справочники.ИнформационныеБазыПорта.ПараметрыПодключения(База);
	ПроверитьПараметрыWebСервиса(ПараметрыПодключения, База);

	ПараметрыСервиса = Новый Структура;
	ПараметрыСервиса.Вставить("Сервис", Неопределено);
	ПараметрыСервиса.Вставить("КодПроверки", ПараметрыПодключения.КодПроверки);

	Таймаут = ПараметрыПодключения.ТаймаутЗапроса;
	Определение = Новый WSОпределения(
		ПараметрыПодключения.АдресWSDL,
		ПараметрыПодключения.ПользовательСервиса,
		ПараметрыПодключения.ПарольСервиса,
		Неопределено,
		Таймаут);
	Сервис = Новый WSПрокси(
		Определение,
		ПараметрыПодключения.URIПространстваИмен,
		ПараметрыПодключения.ИмяСервиса,
		ПараметрыПодключения.ИмяТочкиПодключения,
		Неопределено,
		Таймаут);
	Сервис.Пользователь = ПараметрыПодключения.ПользовательСервиса;
	Сервис.Пароль = ПараметрыПодключения.ПарольСервиса;

	ПараметрыСервиса.Сервис = Сервис;

	Возврат ПараметрыСервиса;

КонецФункции

Процедура ПроверитьПараметрыWebСервиса(ПараметрыПодключения, База)

	ОбязательныеПоля = СтрРазделить(
		"АдресWSDL,ПользовательСервиса,ПарольСервиса,URIПространстваИмен,ИмяСервиса,ИмяТочкиПодключения",
		",",
		Ложь);
	Для Каждого ИмяПоля Из ОбязательныеПоля Цикл
		Если Не ПустаяСтрока(СокрЛП(Строка(ПараметрыПодключения[ИмяПоля]))) Тогда
			Продолжить;
		КонецЕсли;
		ВызватьИсключение СтрШаблон(
			"Не заполнен реквизит ""%1"" элемента справочника ""Информационные базы порта"" (%2).",
			ИмяПоля,
			База);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
