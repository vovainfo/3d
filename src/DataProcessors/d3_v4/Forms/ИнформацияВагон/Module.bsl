
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Номер = Параметры.Номер;
	ТипКод = Параметры.ТипКод;
	Тип = ПредставлениеТипаВагона(ТипКод);
	Если Параметры.Груженый Тогда
		Груженый = "да";
	Иначе
		Груженый = "нет";
	КонецЕсли;
	Ветка = Параметры.Ветка;
	Если Параметры.ДлинаУказана Тогда
		Длина = Формат(Параметры.ДлинаМ, "ЧДЦ=2");
		Элементы.Длина.Заголовок = "Длина, м";
	Иначе
		Длина = "не указана";
		Элементы.Длина.Заголовок = "Длина";
	КонецЕсли;
	Позиция = Параметры.Позиция;
	Заголовок = СтрШаблон("Информация о вагоне: %1", Номер);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗакрытьФорму(Команда)

	Закрыть();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПредставлениеТипаВагона(КодТипа)

	Если КодТипа = "кр" Тогда
		Возврат "крытый вагон";
	ИначеЕсли КодТипа = "пв" Тогда
		Возврат "полувагон";
	ИначеЕсли КодТипа = "реф" Тогда
		Возврат "рефрижераторный";
	ИначеЕсли КодТипа = "сетка а/м" Тогда
		Возврат "сетка для автомобилей";
	ИначеЕсли КодТипа = "тер" Тогда
		Возврат "термос";
	ИначеЕсли КодТипа = "фит.пл." Тогда
		Возврат "фитинговая платформа";
	ИначеЕсли КодТипа = "цистерна" Тогда
		Возврат "цистерна";
	ИначеЕсли ПустаяСтрока(КодТипа) Тогда
		Возврат "неизвестный тип";
	Иначе
		Возврат СтрШаблон("неизвестный тип (%1)", КодТипа);
	КонецЕсли;

КонецФункции

#КонецОбласти
