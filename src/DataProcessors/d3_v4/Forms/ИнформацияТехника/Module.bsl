
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Наименование = Параметры.Наименование;
	ТипТехники = Параметры.ТипТехники;
	Заголовок = СтрШаблон("Информация о технике: %1", Наименование);
	ЗаполнитьКонтейнерНаТехнике();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьКонтейнерНаТехнике()

	Если Не Константы.ПолучениеРеальныхДанных.Получить() Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Реальные данные отключены. Сведения о контейнере не загружены.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;

	ДанныеКонтейнера = Неопределено;
	Если Параметры.ИдентификаторСкаут <> 0 Тогда
		ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
		Попытка
			ДанныеКонтейнера = ОбработкаОбъект.ПолучитьКонтейнерНаТехникеИзУКТ(Параметры.ИдентификаторСкаут);
		Исключение
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не удалось получить контейнер на технике из УКТ: " + ОписаниеОшибки();
			Сообщение.Сообщить();
		КонецПопытки;
	КонецЕсли;

	Если ДанныеКонтейнера <> Неопределено Тогда
		Контейнер = ДанныеКонтейнера.НомерКонтейнера;
		Откуда = ДанныеКонтейнера.АдресОткуда;
		Куда = ДанныеКонтейнера.АдресКуда;
		Если ДанныеКонтейнера.ДатаОперации <> Null И ДанныеКонтейнера.ДатаОперации <> Неопределено Тогда
			Дата = ДанныеКонтейнера.ДатаОперации;
		КонецЕсли;
	КонецЕсли;

	// Если Откуда не заполнено из УКТ (или запрос ничего не вернул), пробуем разобрать строку из регистра Скаут
	СтрокаИнфо = "";
	// @skip-check optional-form-parameter-access
	Если ПустаяСтрока(Откуда) И Параметры.Свойство("Информация", СтрокаИнфо) И ЗначениеЗаполнено(СтрокаИнфо) Тогда
		РазобратьСтрокуИнформации(СтрокаИнфо);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура РазобратьСтрокуИнформации(СтрокаИнфо)

	// Формат в регистре Скаут: "%1: %2->%3 %4" (Контейнер: Откуда->Куда Время)
	Текст = СокрЛП(Строка(СтрокаИнфо));
	ПозицияТчкЗпт = СтрНайти(Текст, ";", НаправлениеПоиска.СКонца);
	Если ПозицияТчкЗпт > 0 Тогда
		Текст = СокрЛП(Сред(Текст, ПозицияТчкЗпт + 1));
	КонецЕсли;

	ПозицияДвоеточия = СтрНайти(Текст, ":");
	Если ПозицияДвоеточия = 0 Тогда
		Возврат;
	КонецЕсли;

	НомерКт = СокрЛП(Лев(Текст, ПозицияДвоеточия - 1));
	Остаток = СокрЛП(Сред(Текст, ПозицияДвоеточия + 1));

	ПозицияСтрелки = СтрНайти(Остаток, "->");
	Если ПозицияСтрелки = 0 Тогда
		Возврат;
	КонецЕсли;

	АдрОткуда = СокрЛП(Лев(Остаток, ПозицияСтрелки - 1));
	Хвост = СокрЛП(Сред(Остаток, ПозицияСтрелки + 2));

	ПозицияПробела = СтрНайти(Хвост, " ", НаправлениеПоиска.СКонца);
	АдрКуда = Хвост;
	Если ПозицияПробела > 0 Тогда
		КандидатВремя = СокрЛП(Сред(Хвост, ПозицияПробела + 1));
		Если СтрДлина(КандидатВремя) = 8 И СтрНайти(КандидатВремя, ":") = 3 Тогда
			АдрКуда = СокрЛП(Лев(Хвост, ПозицияПробела - 1));
		КонецЕсли;
	КонецЕсли;

	Если ПустаяСтрока(Контейнер) И Не ПустаяСтрока(НомерКт) Тогда
		Контейнер = НомерКт;
	КонецЕсли;
	Если ПустаяСтрока(Откуда) И Не ПустаяСтрока(АдрОткуда) Тогда
		Откуда = АдрОткуда;
	КонецЕсли;
	Если ПустаяСтрока(Куда) И Не ПустаяСтрока(АдрКуда) Тогда
		Куда = АдрКуда;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
