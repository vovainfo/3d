
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Наименование = Параметры.Наименование;
	ВидСудна = Параметры.ВидСудна;
	Длина = Параметры.Длина;
	Причал = Параметры.Причал;
	Борт = Параметры.Борт;
	Заправка = Параметры.Заправка;
	ПлановыйПричал = Параметры.ПлановыйПричал;
	ДатаШвартовки = Параметры.ДатаШвартовки;
	Погрузка = Параметры.Погрузка;
	Разгрузка = Параметры.Разгрузка;
	Заголовок = СтрШаблон("Информация о судне: %1", Наименование);
	Если Параметры.ЭтоРейд Тогда
		Элементы.ГруппаПричал.Видимость = Ложь;
		Элементы.ГруппаРейд.Видимость = Истина;
	Иначе
		Элементы.ГруппаПричал.Видимость = Истина;
		Элементы.ГруппаРейд.Видимость = Ложь;
		ЗаполнитьДанныеСуднаУПричалаИзEDS();
	КонецЕсли;
	ЗаполнитьГрузСуднаИзEDS();
	Элементы.ГруппаВсеРейсыEDS.Заголовок = СтрШаблон(
		"Все записи рейсов ЕДС (%1)",
		Формат(ВсеРейсыEDS.Количество(), "ЧН=0; ЧГ=0"));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗакрытьФорму(Команда)

	Закрыть();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьДанныеСуднаУПричалаИзEDS()

	Если Не Константы.ПолучениеРеальныхДанных.Получить() Тогда
		ВывестиСообщениеПользователю("Реальные данные отключены. Сведения о швартовке не загружены из ЕДС.");
		Возврат;
	КонецЕсли;

	ДанныеСудна = Неопределено;
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Попытка
		ДанныеСудна = ОбработкаОбъект.ПолучитьКарточкуСуднаУПричалаИзEDS(Параметры.Наименование);
	Исключение
		ВывестиСообщениеПользователю(
			"Не удалось получить сведения о швартовке из ЕДС: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Если ДанныеСудна = Неопределено Тогда
		ВывестиСообщениеПользователю("Актуальная швартовая операция в ЕДС не найдена.");
		Возврат;
	КонецЕсли;

	Наименование = ДанныеСудна.Судно;
	Длина = ДанныеСудна.СудносДлина;
	Ширина = ДанныеСудна.СудносШирина;
	Причал = ДанныеСудна.Причал;
	ВидСудна = ДанныеСудна.ВидГруза;
	СпособПостановки = ДанныеСудна.СпособПостановки;
	IMO = ДанныеСудна.СудноIMO;
	Линейное = ДанныеСудна.СудноЛинейное;
	DWT = ДанныеСудна.СудноDWT;
	Дата = ДанныеСудна.Дата;
	Заголовок = СтрШаблон("Информация о судне: %1", Наименование);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьГрузСуднаИзEDS()

	Если Не Константы.ПолучениеРеальныхДанных.Получить() Тогда
		Элементы.ГруппаГруз.Видимость = Ложь;
		ВывестиСообщениеПользователю("Реальные данные отключены. Сведения о грузе не загружены из ЕДС.");
		Возврат;
	КонецЕсли;

	ДанныеРейсов = Неопределено;
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Попытка
		ДанныеРейсов = ОбработкаОбъект.ПолучитьРейсыСуднаИзEDS(Параметры.Наименование);
	Исключение
		Элементы.ГруппаГруз.Видимость = Ложь;
		ВывестиСообщениеПользователю(
			"Не удалось получить сведения о грузе из ЕДС: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Если ДанныеРейсов = Неопределено Тогда
		Элементы.ГруппаГруз.Видимость = Ложь;
		ВывестиСообщениеПользователю("Актуальные рейсы в ЕДС не найдены.");
		Возврат;
	КонецЕсли;

	СтраницаГруза = СтраницаГрузаПоВиду(ВидСудна);
	ПоказатьСтраницуГруза(СтраницаГруза);
	ЗаполнитьТаблицуВсехРейсов(ДанныеРейсов.ВсеРейсы);
	Если СтраницаГруза <> Элементы.СтраницаКонтейнеры Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьБлокКонтейнеров(
		ДанныеРейсов.РейсВыгрузки,
		"ГруппаВыгрузкаКонтейнеры",
		"Выгрузка",
		"Выгрузка: %1");
	ЗаполнитьБлокКонтейнеров(
		ДанныеРейсов.РейсПогрузки,
		"ГруппаПогрузкаКонтейнеры",
		"Погрузка",
		"Погрузка: %1");

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуВсехРейсов(ВсеРейсы)

	ВсеРейсыEDS.Очистить();
	Если ВсеРейсы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаРейса Из ВсеРейсы Цикл
		НоваяСтрока = ВсеРейсыEDS.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРейса);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьБлокКонтейнеров(ДанныеРейса, ИмяГруппы, Префикс, ШаблонЗаголовка)

	Если ДанныеРейса = Неопределено Тогда
		Элементы[ИмяГруппы].Видимость = Ложь;
		Возврат;
	КонецЕсли;

	Элементы[ИмяГруппы].Видимость = Истина;
	Элементы[ИмяГруппы].Заголовок = СтрШаблон(ШаблонЗаголовка, ДанныеРейса.СтатусОбработкиСудна);

	ЭтотОбъект[Префикс + "10План"] = ДанныеРейса.КоличествоКонтейнеров10План;
	ЭтотОбъект[Префикс + "20План"] = ДанныеРейса.КоличествоКонтейнеров20План;
	ЭтотОбъект[Префикс + "40План"] = ДанныеРейса.КоличествоКонтейнеров40План;
	ЭтотОбъект[Префикс + "10Манифест"] = ДанныеРейса.КоличествоКонтейнеров10Манифест;
	ЭтотОбъект[Префикс + "20Манифест"] = ДанныеРейса.КоличествоКонтейнеров20Манифест;
	ЭтотОбъект[Префикс + "40Манифест"] = ДанныеРейса.КоличествоКонтейнеров40Манифест;
	ЭтотОбъект[Префикс + "10Факт"] = ДанныеРейса.КоличествоКонтейнеров10Факт;
	ЭтотОбъект[Префикс + "20Факт"] = ДанныеРейса.КоличествоКонтейнеров20Факт;
	ЭтотОбъект[Префикс + "40Факт"] = ДанныеРейса.КоличествоКонтейнеров40Факт;

	ЭтотОбъект[Префикс + "АвтоПлан"] = ДанныеРейса.КоличествоАвтоПлан;
	ЭтотОбъект[Префикс + "АвтоМанифест"] = ДанныеРейса.КоличествоАвтоМанифест;
	ЭтотОбъект[Префикс + "АвтоФакт"] = ДанныеРейса.КоличествоАвтоФакт;
	ЭтотОбъект[Префикс + "ГГПлан"] = ДанныеРейса.КоличествоГГПлан;
	ЭтотОбъект[Префикс + "ГГМанифест"] = ДанныеРейса.КоличествоГГМанифест;
	ЭтотОбъект[Префикс + "ГГФакт"] = ДанныеРейса.КоличествоГГФакт;

	ЭтотОбъект[Префикс + "TEUПлан"] = КоличествоTEUКонтейнеров(
		ДанныеРейса.КоличествоКонтейнеров10План,
		ДанныеРейса.КоличествоКонтейнеров20План,
		ДанныеРейса.КоличествоКонтейнеров40План);
	ЭтотОбъект[Префикс + "TEUМанифест"] = КоличествоTEUКонтейнеров(
		ДанныеРейса.КоличествоКонтейнеров10Манифест,
		ДанныеРейса.КоличествоКонтейнеров20Манифест,
		ДанныеРейса.КоличествоКонтейнеров40Манифест);
	ЭтотОбъект[Префикс + "TEUФакт"] = КоличествоTEUКонтейнеров(
		ДанныеРейса.КоличествоКонтейнеров10Факт,
		ДанныеРейса.КоличествоКонтейнеров20Факт,
		ДанныеРейса.КоличествоКонтейнеров40Факт);

	ЭтотОбъект[Префикс + "10Остаток"] = ЭтотОбъект[Префикс + "10План"] - ЭтотОбъект[Префикс + "10Факт"];
	ЭтотОбъект[Префикс + "20Остаток"] = ЭтотОбъект[Префикс + "20План"] - ЭтотОбъект[Префикс + "20Факт"];
	ЭтотОбъект[Префикс + "40Остаток"] = ЭтотОбъект[Префикс + "40План"] - ЭтотОбъект[Префикс + "40Факт"];
	ЭтотОбъект[Префикс + "TEUОстаток"] = ЭтотОбъект[Префикс + "TEUПлан"] - ЭтотОбъект[Префикс + "TEUФакт"];
	ЭтотОбъект[Префикс + "АвтоОстаток"] = ЭтотОбъект[Префикс + "АвтоПлан"] - ЭтотОбъект[Префикс + "АвтоФакт"];
	ЭтотОбъект[Префикс + "ГГОстаток"] = ЭтотОбъект[Префикс + "ГГПлан"] - ЭтотОбъект[Префикс + "ГГФакт"];

КонецПроцедуры

&НаСервере
Функция КоличествоTEUКонтейнеров(Количество10, Количество20, Количество40)

	Возврат Количество10 * 0.5 + Количество20 + Количество40 * 2;

КонецФункции

&НаСервере
Функция СтраницаГрузаПоВиду(ВидГруза)

	Текст = НРег(СокрЛП(Строка(ВидГруза)));
	Если Текст = "контейнеры" Или Текст = "container" Тогда
		Возврат Элементы.СтраницаКонтейнеры;
	ИначеЕсли Текст = "автотехника" Или Текст = "автомобили" Или Текст = "carcarrier" Тогда
		Возврат Элементы.СтраницаАвтотехника;
	ИначеЕсли Текст = "генеральный груз" Или Текст = "general" Тогда
		Возврат Элементы.СтраницаГенеральныйГруз;
	ИначеЕсли Текст = "рыбопродукция" Или Текст = "рыба" Или Текст = "fish" Тогда
		Возврат Элементы.СтраницаРыбопродукция;
	ИначеЕсли Текст = "уголь" Или Текст = "coal" Тогда
		Возврат Элементы.СтраницаУголь;
	КонецЕсли;
	Возврат Элементы.СтраницаПрочие;

КонецФункции

&НаСервере
Процедура ПоказатьСтраницуГруза(ВыбраннаяСтраница)

	Страницы = Новый Массив;
	Страницы.Добавить(Элементы.СтраницаКонтейнеры);
	Страницы.Добавить(Элементы.СтраницаАвтотехника);
	Страницы.Добавить(Элементы.СтраницаГенеральныйГруз);
	Страницы.Добавить(Элементы.СтраницаРыбопродукция);
	Страницы.Добавить(Элементы.СтраницаУголь);
	Страницы.Добавить(Элементы.СтраницаПрочие);
	Для Каждого Страница Из Страницы Цикл
		Страница.Видимость = Страница = ВыбраннаяСтраница;
	КонецЦикла;
	Элементы.ГруппаГруз.ТекущаяСтраница = ВыбраннаяСтраница;
	Элементы.ГруппаГруз.Видимость = Истина;

КонецПроцедуры

&НаСервере
Процедура ВывестиСообщениеПользователю(ТекстСообщения)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти
