
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПометкаОтключения = "";
	Параметры.Свойство("ПометкаОтключения", ПометкаОтключения);
	Заголовок = СтрШаблон(
		"Информация о ячейке %1%2",
		Параметры.КодЯчейки,
		?(ПустаяСтрока(ПометкаОтключения), "", " (" + ПометкаОтключения + ")"));

	Если Не Константы.ПолучениеРеальныхДанных.Получить() Тогда
		Элементы.ГруппаПараметрыЯчейки.Видимость = Ложь;
		ВывестиСообщениеПользователю("Реальные данные отключены. Сведения о ячейке не загружены из УКТ.");
		Возврат;
	КонецЕсли;

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ЗаполнитьПараметрыЯчейки(ОбработкаОбъект);
	ЗаполнитьТаблицуКонтейнеров(ОбработкаОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗакрытьФорму(Команда)

	Закрыть();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьПараметрыЯчейки(ОбработкаОбъект)

	Попытка
		ПараметрыЯчейки = ОбработкаОбъект.ПолучитьПараметрыЯчейкиИзУКТ(Параметры.КодЯчейки);
	Исключение
		Элементы.ГруппаПараметрыЯчейки.Видимость = Ложь;
		ВывестиСообщениеПользователю(
			"Не удалось получить параметры ячейки из УКТ: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Если ПараметрыЯчейки = Неопределено Тогда
		Элементы.ГруппаПараметрыЯчейки.Видимость = Ложь;
		Возврат;
	КонецЕсли;

	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ПараметрыЯчейки);
	ВыделитьЗаголовкиАктивныхПризнаков();

КонецПроцедуры

&НаСервере
Процедура ВыделитьЗаголовкиАктивныхПризнаков()

	ИменаПризнаков = СтрРазделить(
		"ЗонаШаттла,Дорога,Тупик,Активность,Отключена,ОграничениеВыдачи,НаличиеРозетки",
		",",
		Ложь);
	Для Каждого ИмяПризнака Из ИменаПризнаков Цикл
		Если ЭтотОбъект[ИмяПризнака] <> Истина Тогда
			Продолжить;
		КонецЕсли;
		Поле = Элементы[ИмяПризнака];
		Поле.ШрифтЗаголовка = Новый Шрифт(Поле.ШрифтЗаголовка, , , Истина);
		Поле.Шрифт = Новый Шрифт(Поле.Шрифт, , , Истина);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуКонтейнеров(ОбработкаОбъект)

	Контейнеры.Очистить();

	Попытка
		ТаблицаКонтейнеров = ОбработкаОбъект.ПолучитьКонтейнерыЯчейкиИзУКТ(Параметры.КодЯчейки);
	Исключение
		ВывестиСообщениеПользователю("Не удалось получить контейнеры ячейки из УКТ: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	ИндексПрихода = Новый Соответствие;
	МассивКонтейнеров = Новый Массив;
	Для Каждого СтрокаТаблицы Из ТаблицаКонтейнеров Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.Код) Тогда
			МассивКонтейнеров.Добавить(СтрокаТаблицы.Код);
		КонецЕсли;
	КонецЦикла;

	Если МассивКонтейнеров.Количество() > 0 Тогда
		Попытка
			ТаблицаПрихода = ОбработкаОбъект.ПолучитьДанныеПриходаИзВМКТ(МассивКонтейнеров);
			Для Каждого СтрокаПрихода Из ТаблицаПрихода Цикл
				ДанныеПрихода = Новый Структура;
				ДанныеПрихода.Вставить("ДатаПрихода", СтрокаПрихода.ДатаПрихода);
				ДанныеПрихода.Вставить("Транспорт", СтрокаПрихода.Транспорт);
				ИндексПрихода.Вставить(КлючКонтейнераДляСклейки(СтрокаПрихода.Контейнер), ДанныеПрихода);
			КонецЦикла;
		Исключение
			ВывестиСообщениеПользователю(
				"Не удалось получить дату прихода и транспорт из ВМКТ: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	Для Каждого СтрокаТаблицы Из ТаблицаКонтейнеров Цикл
		НоваяСтрока = Контейнеры.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		ДанныеПрихода = ИндексПрихода.Получить(КлючКонтейнераДляСклейки(СтрокаТаблицы.Код));
		Если ДанныеПрихода = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ДанныеПрихода.ДатаПрихода <> Null И ДанныеПрихода.ДатаПрихода <> Неопределено Тогда
			НоваяСтрока.ДатаПрихода = ДанныеПрихода.ДатаПрихода;
		КонецЕсли;
		Если ДанныеПрихода.Транспорт <> Null И ДанныеПрихода.Транспорт <> Неопределено Тогда
			НоваяСтрока.Транспорт = ДанныеПрихода.Транспорт;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция КлючКонтейнераДляСклейки(ЗначениеКонтейнера)

	Возврат ВРег(СокрЛП(Строка(ЗначениеКонтейнера)));

КонецФункции

&НаСервере
Процедура ВывестиСообщениеПользователю(ТекстСообщения)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти
