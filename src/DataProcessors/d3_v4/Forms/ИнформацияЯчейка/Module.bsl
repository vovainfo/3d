
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Заголовок = СтрШаблон("Информация о ячейке %1", Параметры.КодЯчейки);
	ЗаполнитьТаблицуКонтейнеров();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьТаблицуКонтейнеров()

	Контейнеры.Очистить();

	Если Не Константы.ПолучениеРеальныхДанных.Получить() Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Реальные данные отключены. Список контейнеров не загружен.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");

	Попытка
		ТаблицаКонтейнеров = ОбработкаОбъект.ПолучитьКонтейнерыЯчейкиИзУКТ(Параметры.КодЯчейки);
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось получить контейнеры ячейки из УКТ: " + ОписаниеОшибки();
		Сообщение.Сообщить();
		Возврат;
	КонецПопытки;

	Для Каждого СтрокаТаблицы Из ТаблицаКонтейнеров Цикл
		НоваяСтрока = Контейнеры.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
