&НаКлиенте
Процедура СинхронизироватьИндексРазмещений(МассивРазмещений)

	Если ИндексЯчеек = Неопределено Или ИндексРазмещений = Неопределено Тогда
		ПостроитьИндексы();
	КонецЕсли;

	Для Каждого ЭлементИндекса Из ИндексЯчеек Цикл
		ЭлементИндекса.Значение.count = 0;
	КонецЦикла;
	ИндексРазмещений = Новый Соответствие;
	Для Каждого Размещение Из МассивРазмещений Цикл
		ИндексРазмещений.Вставить(Размещение.id, Размещение);
		ОбновитьВысотуЯчеекРазмещения(Размещение);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПостроитьИндексы()

	НачалоПостроения = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ИндексОбъектов = Новый Соответствие;
	ИндексЯчеек = Новый Соответствие;
	ИндексРазмещений = Новый Соответствие;
	//@skip-check bsl-legacy-check-type-environments
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ДанныеСценыJSON);
	//@skip-check undefined-function
	Сцена = ПрочитатьJSON(Чтение);
	Если Сцена = Неопределено Тогда
		ДобавитьЗамерИндексовВСостояние(ДлительностьКлиентМс(НачалоПостроения));
		Возврат;
	КонецЕсли;

	Если Сцена.Свойство("objects") Тогда
		Для Каждого ОбъектСцены Из Сцена.objects Цикл
			ИндексОбъектов.Вставить(ОбъектСцены.id, ОбъектСцены);
		КонецЦикла;
	КонецЕсли;

	Если Сцена.Свойство("topology") И Сцена.topology.Свойство("buildings") Тогда
		Для Каждого ЗданиеСцены Из Сцена.topology.buildings Цикл
			ИндексОбъектов.Вставить(ЗданиеСцены.id, ЗданиеСцены);
		КонецЦикла;
	КонецЕсли;

	Если Сцена.Свойство("cells") Тогда
		Для Каждого ЯчейкаСцены Из Сцена.cells Цикл
			ЯчейкаСцены.count = 0;
			ИндексЯчеек.Вставить(ЯчейкаСцены.id, ЯчейкаСцены);
		КонецЦикла;
	КонецЕсли;

	Если Сцена.Свойство("placements") Тогда
		Для Каждого Размещение Из Сцена.placements Цикл
			ИндексРазмещений.Вставить(Размещение.id, Размещение);
			ОбновитьВысотуЯчеекРазмещения(Размещение);
		КонецЦикла;
	КонецЕсли;
	ДобавитьЗамерИндексовВСостояние(ДлительностьКлиентМс(НачалоПостроения));

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВысотуЯчеекРазмещения(Размещение)

	Если Не Размещение.Свойство("cellIds") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ИдЯчейки Из Размещение.cellIds Цикл
		Ячейка = ИндексЯчеек.Получить(ИдЯчейки);
		Если Ячейка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Размещение.tier > Ячейка.count Тогда
			Ячейка.count = Размещение.tier;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораОбъектаПоиска(РезультатВыбора, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(РезультатВыбора) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Если Не РезультатВыбора.Свойство("Идентификатор") Или Не ЗначениеЗаполнено(РезультатВыбора.Идентификатор) Тогда
		Возврат;
	КонецЕсли;
	Если РезультатВыбора.Свойство("ВидОбъекта") И РезультатВыбора.ВидОбъекта = "cell" Тогда
		СфокусироватьЯчейкуСцены(РезультатВыбора.Идентификатор);
		Возврат;
	КонецЕсли;
	СфокусироватьОбъектСцены(РезультатВыбора.Идентификатор);

КонецПроцедуры

&НаКлиенте
Процедура СфокусироватьОбъектСцены(Идентификатор)

	Цель = НайтиОбъектВИндексе(Идентификатор);
	Если Цель = Неопределено Тогда
		ОбновитьТехнику(Неопределено);
		Цель = НайтиОбъектВИндексе(Идентификатор);
	КонецЕсли;
	Если Цель = Неопределено Тогда
		СостояниеОбмена = СтрШаблон("объект поиска не найден: %1", Идентификатор);
		Возврат;
	КонецЕсли;

	Попытка
		КомандаСцены = Новый Структура;
		КомандаСцены.Вставить("op", "focus");
		КомандаСцены.Вставить("id", Цель.id);
		КомандаСцены.Вставить("notify", Ложь);
		КомандаСцены.Вставить("minScale", 2.5);
		ОтправитьКомандуСцене(КомандаСцены);
	Исключение
		СостояниеОбмена = "не удалось сфокусировать план: " + ОписаниеОшибки();
	КонецПопытки;

	КоординатаX = 0;
	КоординатаY = 0;
	Если Цель.Свойство("x") Тогда
		КоординатаX = Цель.x;
	КонецЕсли;
	Если Цель.Свойство("y") Тогда
		КоординатаY = Цель.y;
	КонецЕсли;
	ВидОбъекта = "";
	Если Цель.Свойство("kind") Тогда
		ВидОбъекта = Цель.kind;
	КонецЕсли;
	ОбработатьВыборОбъекта(Цель.id, ВидОбъекта, КоординатаX, КоординатаY, 0);

КонецПроцедуры

