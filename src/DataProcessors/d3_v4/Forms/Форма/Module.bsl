&НаКлиенте
Процедура ПрочитатьМетрикиСцены(УзелКоманд, Метрики)

	Текст = ПолучитьАтрибутHTML(УзелКоманд, "data-metrics");
	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		//@skip-check bsl-legacy-check-type-environments
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		//@skip-check undefined-function
		Данные = ПрочитатьJSON(Чтение);
	Исключение
		Возврат;
	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Метрики.JsParseМс = ЧислоИзМетрикиСцены(Данные, "jsParse");
	Метрики.NormalizeМс = ЧислоИзМетрикиСцены(Данные, "normalize");
	Метрики.RecomputeМс = ЧислоИзМетрикиСцены(Данные, "recompute");
	Метрики.DrawМс = ЧислоИзМетрикиСцены(Данные, "draw");

КонецПроцедуры

&НаКлиенте
Функция ЧислоИзМетрикиСцены(Данные, ИмяСвойства)

	Если Не Данные.Свойство(ИмяСвойства) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Данные[ИмяСвойства]);
	Исключение
		Возврат 0;
	КонецПопытки;

