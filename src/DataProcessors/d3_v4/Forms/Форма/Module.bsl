#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьИЗаписатьТехникуСкаутНаСервере()

	ОбработкаСкаут = Обработки.Скаут.Создать();
	ТаблицаКоординат = ОбработкаСкаут.ПолучитьКоординатыТехники();
	ОбработкаСкаут.ЗаписатьПоложениеТехники(ТаблицаКоординат);
	Возврат ТаблицаКоординат.Количество();

КонецФункции

&НаСервере
Функция ПолучитьТехникуСкаутНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Возврат ОбъектОбработки.СобратьТехникуСкаут();

КонецФункции

&НаКлиенте
Процедура СинхронизироватьИндексТехники(МассивТехники)

	УдаляемыеИдентификаторы = Новый Массив;
	Для Каждого ЭлементИндекса Из ИндексОбъектов Цикл
		ОбъектСцены = ЭлементИндекса.Значение;
		Если ОбъектСцены.Свойство("kind") И ОбъектСцены.kind = "scoutVehicle" Тогда
			УдаляемыеИдентификаторы.Добавить(ЭлементИндекса.Ключ);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Идентификатор Из УдаляемыеИдентификаторы Цикл
		ИндексОбъектов.Удалить(Идентификатор);
	КонецЦикла;
	Для Каждого ОбъектТехники Из МассивТехники Цикл
		ИндексОбъектов.Вставить(ОбъектТехники.id, ОбъектТехники);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СинхронизироватьИндексСудов(МассивСудов)

	УдаляемыеИдентификаторы = Новый Массив;
	Для Каждого ЭлементИндекса Из ИндексОбъектов Цикл
		ОбъектСцены = ЭлементИндекса.Значение;
		Если ОбъектСцены.Свойство("kind") И ОбъектСцены.kind = "vessel" Тогда
			УдаляемыеИдентификаторы.Добавить(ЭлементИндекса.Ключ);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Идентификатор Из УдаляемыеИдентификаторы Цикл
		ИндексОбъектов.Удалить(Идентификатор);
	КонецЦикла;
	Для Каждого Судно Из МассивСудов Цикл
		ИндексОбъектов.Вставить(Судно.id, Судно);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СинхронизироватьИндексВагонов(МассивВагонов)

	УдаляемыеИдентификаторы = Новый Массив;
	Для Каждого ЭлементИндекса Из ИндексОбъектов Цикл
		ОбъектСцены = ЭлементИндекса.Значение;
		Если ОбъектСцены.Свойство("kind") И ОбъектСцены.kind = "railWagon" Тогда
			УдаляемыеИдентификаторы.Добавить(ЭлементИндекса.Ключ);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Идентификатор Из УдаляемыеИдентификаторы Цикл
		ИндексОбъектов.Удалить(Идентификатор);
	КонецЦикла;
	Для Каждого Вагон Из МассивВагонов Цикл
		ИндексОбъектов.Вставить(Вагон.id, Вагон);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СинхронизироватьИндексРазмещений(МассивРазмещений)

	Если ИндексЯчеек = Неопределено Или ИндексРазмещений = Неопределено Тогда
		ПостроитьИндексы();
	КонецЕсли;

	Для Каждого ЭлементИндекса Из ИндексЯчеек Цикл
		ЭлементИндекса.Значение.count = 0;
	КонецЦикла;
	ИндексРазмещений = Новый Соответствие;
	Для Каждого Размещение Из МассивРазмещений Цикл
		ИндексРазмещений.Вставить(Размещение.id, Размещение);
		ОбновитьВысотуЯчеекРазмещения(Размещение);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПостроитьИндексы()

	ИндексОбъектов = Новый Соответствие;
	ИндексЯчеек = Новый Соответствие;
	ИндексРазмещений = Новый Соответствие;
	//@skip-check bsl-legacy-check-type-environments
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ДанныеСценыJSON);
	//@skip-check undefined-function
	Сцена = ПрочитатьJSON(Чтение);
	Если Сцена = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Сцена.Свойство("objects") Тогда
		Для Каждого ОбъектСцены Из Сцена.objects Цикл
			ИндексОбъектов.Вставить(ОбъектСцены.id, ОбъектСцены);
		КонецЦикла;
	КонецЕсли;

	Если Сцена.Свойство("topology") И Сцена.topology.Свойство("buildings") Тогда
		Для Каждого ЗданиеСцены Из Сцена.topology.buildings Цикл
			ИндексОбъектов.Вставить(ЗданиеСцены.id, ЗданиеСцены);
		КонецЦикла;
	КонецЕсли;

	Если Сцена.Свойство("cells") Тогда
		Для Каждого ЯчейкаСцены Из Сцена.cells Цикл
			ЯчейкаСцены.count = 0;
			ИндексЯчеек.Вставить(ЯчейкаСцены.id, ЯчейкаСцены);
		КонецЦикла;
	КонецЕсли;

	Если Сцена.Свойство("placements") Тогда
		Для Каждого Размещение Из Сцена.placements Цикл
			ИндексРазмещений.Вставить(Размещение.id, Размещение);
			ОбновитьВысотуЯчеекРазмещения(Размещение);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВысотуЯчеекРазмещения(Размещение)

	Если Не Размещение.Свойство("cellIds") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ИдЯчейки Из Размещение.cellIds Цикл
		Ячейка = ИндексЯчеек.Получить(ИдЯчейки);
		Если Ячейка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Размещение.tier > Ячейка.count Тогда
			Ячейка.count = Размещение.tier;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция НайтиОбъектВИндексе(Идентификатор)

	Если ИндексОбъектов = Неопределено Тогда
		ПостроитьИндексы();
	КонецЕсли;
	Возврат ИндексОбъектов.Получить(Идентификатор);

КонецФункции

&НаКлиенте
Функция НайтиЯчейкуВИндексе(Идентификатор)

	Если ИндексЯчеек = Неопределено Тогда
		ПостроитьИндексы();
	КонецЕсли;
	Возврат ИндексЯчеек.Получить(Идентификатор);

КонецФункции

&НаКлиенте
Функция НайтиРазмещениеВИндексе(Идентификатор)

	Если ИндексРазмещений = Неопределено Тогда
		ПостроитьИндексы();
	КонецЕсли;
	Возврат ИндексРазмещений.Получить(Идентификатор);

КонецФункции

&НаКлиенте
Функция ВерхнееРазмещениеЯчейки(ИдЯчейки)

	Ячейка = НайтиЯчейкуВИндексе(ИдЯчейки);
	Если Ячейка = Неопределено Или Ячейка.count <= 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Лучшее = Неопределено;
	Для Каждого КлючИЗначение Из ИндексРазмещений Цикл
		Размещение = КлючИЗначение.Значение;
		Если Не Размещение.Свойство("cellIds") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Ид Из Размещение.cellIds Цикл
			Если Ид = ИдЯчейки Тогда
				Если Лучшее = Неопределено Или Размещение.tier > Лучшее.tier Тогда
					Лучшее = Размещение;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Лучшее;

КонецФункции

&НаКлиенте
Функция ЧислоИзАтрибута(Узел, ИмяАтрибута)

	Текст = ПолучитьАтрибутHTML(Узел, ИмяАтрибута);
	Если ПустаяСтрока(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Текст);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

&НаКлиенте
Процедура ОтправитьКомандуСцене(Команда)

	Попытка
		ДокументHTML = Элементы.HTML.Документ;
		УзелКоманд = ДокументHTML.getElementById("scene-command-bridge");
	Исключение
		ВызватьИсключение "Не удалось получить доступ к документу плана.";
	КонецПопытки;

	Если УзелКоманд = Неопределено Тогда
		ВызватьИсключение "План ещё не готов принимать команды.";
	КонецЕсли;
	Если ПолучитьАтрибутHTML(УзелКоманд, "data-ready") <> "true" Тогда
		ВызватьИсключение "План ещё не завершил инициализацию.";
	КонецЕсли;

	НомерКоманды = 0;
	ПредыдущийНомерКоманды = ПолучитьАтрибутHTML(УзелКоманд, "data-seq");
	Если Не ПустаяСтрока(ПредыдущийНомерКоманды) Тогда
		Попытка
			НомерКоманды = Число(ПредыдущийНомерКоманды);
		Исключение
			НомерКоманды = 0;
		КонецПопытки;
	КонецЕсли;
	НомерКоманды = НомерКоманды + 1;
	СтрокаНомераКоманды = Строка(НомерКоманды);

	УзелКоманд.setAttribute("data-error", "");
	УзелКоманд.setAttribute("data-ack", "");
	УзелКоманд.setAttribute("data-payload", СериализоватьJSON(Команда));
	УзелКоманд.setAttribute("data-seq", СтрокаНомераКоманды);
	Попытка
		УзелКоманд.click();
	Исключение
		Попытка
			УзелКоманд.fireEvent("onclick");
		Исключение
			ВызватьИсключение "HTML-движок не поддерживает отправку команд на план.";
		КонецПопытки;
	КонецПопытки;

	Если ПолучитьАтрибутHTML(УзелКоманд, "data-ack") <> СтрокаНомераКоманды Тогда
		ВызватьИсключение "План не подтвердил применение команды.";
	КонецЕсли;
	ТекстОшибки = ПолучитьАтрибутHTML(УзелКоманд, "data-error");
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ВызватьИсключение "Ошибка изменения плана: " + ТекстОшибки;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция СериализоватьJSON(Значение)

	//@skip-check bsl-legacy-check-type-environments
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	//@skip-check undefined-function-or-procedure
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

&НаКлиенте
Функция ПолучитьАтрибутHTML(Узел, ИмяАтрибута)

	Попытка
		Значение = Узел.getAttribute(ИмяАтрибута);
		Если Значение = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Возврат Строка(Значение);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

&НаКлиенте
Процедура ОбработатьВыборОбъекта(Идентификатор, ВидОбъекта, X, Y, Z) Экспорт

	Если ВидОбъекта = "placement" Тогда
		Размещение = НайтиРазмещениеВИндексе(Идентификатор);
		Если Размещение = Неопределено Тогда
			КарточкаОбъекта = СтрШаблон("Размещение %1", Идентификатор);
			Возврат;
		КонецЕсли;
		ЯчейкиТекст = "";
		Если Размещение.Свойство("cellIds") Тогда
			ЯчейкиТекст = СтрСоединить(Размещение.cellIds, ", ");
		КонецЕсли;
		КарточкаОбъекта = СтрШаблон(
			"Контейнер %1%2%3 ft · ярус %4%2Блок %5 · row %6 · bay %7%2Ячейки: %8",
			Размещение.id, Символы.ПС,
			Размещение.lengthFt, Размещение.tier,
			Размещение.blockId, Размещение.row, Размещение.bay,
			ЯчейкиТекст);
		Возврат;
	КонецЕсли;

	Если ВидОбъекта = "cell" Тогда
		Ячейка = НайтиЯчейкуВИндексе(Идентификатор);
		Если Ячейка = Неопределено Тогда
			КарточкаОбъекта = СтрШаблон("Ячейка %1", Идентификатор);
			Возврат;
		КонецЕсли;
		Верх = ВерхнееРазмещениеЯчейки(Идентификатор);
		Доп = "";
		Если Верх <> Неопределено Тогда
			Доп = СтрШаблон("%1Верх: %2 (%3 ft, tier %4)",
				Символы.ПС, Верх.id, Верх.lengthFt, Верх.tier);
		КонецЕсли;
		КарточкаОбъекта = СтрШаблон(
			"Ячейка %1 (20 ft)%2Блок %3 · row %4 · bay %5%2Высота: %6 / max %7%2Координаты: %8, %9 м%10",
			Ячейка.id, Символы.ПС,
			Ячейка.blockId, Ячейка.row, Ячейка.bay,
			Ячейка.count, Ячейка.maxTier,
			Формат(Ячейка.x, "ЧДЦ=2"), Формат(Ячейка.y, "ЧДЦ=2"),
			Доп);
		Возврат;
	КонецЕсли;

	ОбъектСцены = НайтиОбъектВИндексе(Идентификатор);
	Если ОбъектСцены = Неопределено Тогда
		КарточкаОбъекта = СтрШаблон("%1 (%2) · X=%3 Y=%4", Идентификатор, ВидОбъекта, X, Y);
		Возврат;
	КонецЕсли;

	Если ОбъектСцены.kind = "vessel" Тогда
		ДлинаСудна = 0;
		Если ОбъектСцены.Свойство("length") Тогда
			ДлинаСудна = ОбъектСцены.length;
		ИначеЕсли ОбъектСцены.Свойство("size") И ОбъектСцены.size.Свойство("length") Тогда
			ДлинаСудна = ОбъектСцены.size.length;
		КонецЕсли;
		ВидСудна = "";
		Если ОбъектСцены.Свойство("vesselType") Тогда
			Если ОбъектСцены.vesselType = "container" Тогда
				ВидСудна = "контейнеры";
			ИначеЕсли ОбъектСцены.vesselType = "carCarrier" Тогда
				ВидСудна = "автомобили";
			ИначеЕсли ОбъектСцены.vesselType = "coal" Тогда
				ВидСудна = "уголь";
			ИначеЕсли ОбъектСцены.vesselType = "fish" Тогда
				ВидСудна = "рыба";
			ИначеЕсли ОбъектСцены.vesselType = "general" Тогда
				ВидСудна = "генеральный груз";
			ИначеЕсли ОбъектСцены.vesselType = "bunker" Тогда
				ВидСудна = "бункеровка";
			ИначеЕсли ОбъектСцены.vesselType = "empty" Тогда
				ВидСудна = "без груза";
			Иначе
				ВидСудна = Строка(ОбъектСцены.vesselType);
			КонецЕсли;
		КонецЕсли;
		Если ОбъектСцены.Свойство("locationType") И ОбъектСцены.locationType = "anchorage" Тогда
			ДатаШвартовки = ?(ОбъектСцены.Свойство("plannedBerthingAt"), Строка(ОбъектСцены.plannedBerthingAt), "");
			ДатаШвартовки = СтрЗаменить(ДатаШвартовки, "T", " ");
			ПланПогрузки = Неопределено;
			Если ОбъектСцены.Свойство("plannedLoad") Тогда
				ПланПогрузки = ОбъектСцены.plannedLoad;
			КонецЕсли;
			ПланРазгрузки = Неопределено;
			Если ОбъектСцены.Свойство("plannedUnload") Тогда
				ПланРазгрузки = ОбъектСцены.plannedUnload;
			КонецЕсли;
			ПлановыйПричал = ?(ОбъектСцены.Свойство("plannedBerthId"), Строка(ОбъектСцены.plannedBerthId), "");
			ПричалИШвартовка = СтрШаблон(
				"Причал: %1 · швартовка: %2",
				ПлановыйПричал,
				ДатаШвартовки);
			Координаты = СтрШаблон(
				"%1, %2 м",
				Формат(ОбъектСцены.x, "ЧДЦ=2"),
				Формат(ОбъектСцены.y, "ЧДЦ=2"));
			КарточкаОбъекта = СтрШаблон(
				"%1 · судно на рейде%2%3Вид: %4%2Длина: %5 м%2%6%2Погрузка: %7%2Разгрузка: %8%2Координаты: %9",
				ОбъектСцены.name, Символы.ПС, ОбъектСцены.id + Символы.ПС,
				ВидСудна,
				Формат(ДлинаСудна, "ЧДЦ=0"),
				ПричалИШвартовка,
				ТекстПланаКонтейнеров(ПланПогрузки),
				ТекстПланаКонтейнеров(ПланРазгрузки),
				Координаты);
			Возврат;
		КонецЕсли;
		Причал = ?(ОбъектСцены.Свойство("berthId"), Строка(ОбъектСцены.berthId), "");
		Борт = "";
		Если ОбъектСцены.Свойство("mooringSide") Тогда
			Если ОбъектСцены.mooringSide = "right" Тогда
				Борт = "правый борт";
			ИначеЕсли ОбъектСцены.mooringSide = "left" Тогда
				Борт = "левый борт";
			ИначеЕсли ОбъектСцены.mooringSide = "bow" Тогда
				Борт = "носом";
			ИначеЕсли ОбъектСцены.mooringSide = "stern" Тогда
				Борт = "кормой";
			Иначе
				Борт = Строка(ОбъектСцены.mooringSide);
			КонецЕсли;
		КонецЕсли;
		Заправка = "";
		Если ОбъектСцены.Свойство("refueling") И ОбъектСцены.refueling = Истина Тогда
			Заправка = Символы.ПС + "Заправка: да";
		КонецЕсли;
		КарточкаОбъекта = СтрШаблон(
			"%1 · судно%2%3Вид: %4%2Длина: %5 м%2Причал: %6 · борт: %7%8%2Координаты: %9, %10 м",
			ОбъектСцены.name, Символы.ПС, ОбъектСцены.id + Символы.ПС,
			ВидСудна,
			Формат(ДлинаСудна, "ЧДЦ=0"),
			Причал, Борт, Заправка,
			Формат(ОбъектСцены.x, "ЧДЦ=2"), Формат(ОбъектСцены.y, "ЧДЦ=2"));
		Возврат;
	КонецЕсли;

	Если ОбъектСцены.kind = "railWagon" Тогда
		Если ОбъектСцены.wagonType = "кр" Тогда
			ТипВагона = "крытый вагон";
		ИначеЕсли ОбъектСцены.wagonType = "пв" Тогда
			ТипВагона = "полувагон";
		ИначеЕсли ОбъектСцены.wagonType = "реф" Тогда
			ТипВагона = "рефрижераторный";
		ИначеЕсли ОбъектСцены.wagonType = "сетка а/м" Тогда
			ТипВагона = "сетка для автомобилей";
		ИначеЕсли ОбъектСцены.wagonType = "тер" Тогда
			ТипВагона = "термос";
		ИначеЕсли ОбъектСцены.wagonType = "фит.пл." Тогда
			ТипВагона = "фитинговая платформа";
		ИначеЕсли ОбъектСцены.wagonType = "цистерна" Тогда
			ТипВагона = "цистерна";
		Иначе
			ТипВагона = СтрШаблон("неизвестный тип (%1)", ОбъектСцены.wagonType);
		КонецЕсли;

		ДлинаВагона = 0;
		Если ОбъектСцены.Свойство("size") И ОбъектСцены.size.Свойство("length") Тогда
			ДлинаВагона = ОбъектСцены.size.length;
		КонецЕсли;
		ТекстЗагрузки = "нет";
		Если ОбъектСцены.Свойство("loaded") И ОбъектСцены.loaded = Истина Тогда
			ТекстЗагрузки = "да";
		КонецЕсли;
		КарточкаОбъекта = СтрШаблон(
			"%1 · %2%3Состав: %4 · ветка: %5%3Длина: %6 м%3Гружёный: %7%3Позиция: %8 м%3Координаты: %9, %10 м",
			ОбъектСцены.id, ТипВагона, Символы.ПС,
			ОбъектСцены.trainId, ОбъектСцены.branchId,
			Формат(ДлинаВагона, "ЧДЦ=2"),
			ТекстЗагрузки,
			Формат(ОбъектСцены.positionM, "ЧДЦ=2"),
			Формат(ОбъектСцены.x, "ЧДЦ=2"), Формат(ОбъектСцены.y, "ЧДЦ=2"));
		Возврат;
	КонецЕсли;

	Если ОбъектСцены.kind = "scoutVehicle" Тогда
		ИмяТехники = ?(ОбъектСцены.Свойство("name") И ЗначениеЗаполнено(ОбъектСцены.name),
			Строка(ОбъектСцены.name),
			ОбъектСцены.id);
		ТипТехники = "";
		Если ОбъектСцены.Свойство("equipmentType") И ЗначениеЗаполнено(ОбъектСцены.equipmentType) Тогда
			ТипТехники = Строка(ОбъектСцены.equipmentType);
		КонецЕсли;
		Если ПустаяСтрока(ТипТехники) Тогда
			КарточкаОбъекта = СтрШаблон(
				"%1%2Координаты: %3, %4 м",
				ИмяТехники, Символы.ПС,
				Формат(ОбъектСцены.x, "ЧДЦ=2"), Формат(ОбъектСцены.y, "ЧДЦ=2"));
		Иначе
			КарточкаОбъекта = СтрШаблон(
				"%1%2Тип: %3%2Координаты: %4, %5 м",
				ИмяТехники, Символы.ПС, ТипТехники,
				Формат(ОбъектСцены.x, "ЧДЦ=2"), Формат(ОбъектСцены.y, "ЧДЦ=2"));
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если ОбъектСцены.kind = "building" Тогда
		ЦветЗдания = ?(ОбъектСцены.Свойство("color"), Строка(ОбъектСцены.color), "");
		КарточкаОбъекта = СтрШаблон(
			"%1 · здание%2%3Цвет: %4%2Координаты: %5, %6 м",
			ОбъектСцены.name, Символы.ПС, ОбъектСцены.id + Символы.ПС,
			ЦветЗдания,
			Формат(ОбъектСцены.x, "ЧДЦ=2"), Формат(ОбъектСцены.y, "ЧДЦ=2"));
		Возврат;
	КонецЕсли;

	Если ОбъектСцены.kind = "cranePortal" Тогда
		КарточкаОбъекта = СтрШаблон(
			"%1 · портальный кран%2%3Марка: %4 · масштаб: %5%2Азимут стрелы: %6° · цвет: %7%2Координаты: %8, %9 м",
			ОбъектСцены.name, Символы.ПС, ОбъектСцены.id + Символы.ПС,
			ОбъектСцены.model, Формат(ОбъектСцены.scale, "ЧДЦ=2"),
			Формат(ОбъектСцены.azimuthDeg, "ЧДЦ=1"), ОбъектСцены.color,
			Формат(ОбъектСцены.x, "ЧДЦ=2"), Формат(ОбъектСцены.y, "ЧДЦ=2"));
		Возврат;
	КонецЕсли;

	Если ОбъектСцены.kind = "craneRtg" Или ОбъектСцены.kind = "craneRmg" Тогда
		ТипКрана = ?(ОбъектСцены.kind = "craneRmg", "RMG", "RTG");
		ДополнениеРельсов = "";
		Если ОбъектСцены.kind = "craneRmg" Тогда
			ДополнениеРельсов = СтрШаблон(
				"%1Отступ рельсов: %2 м%1Крылья: слева %3 м · справа %4 м",
				Символы.ПС,
				Формат(ОбъектСцены.railInsetM, "ЧДЦ=2"),
				Формат(ОбъектСцены.leftWingM, "ЧДЦ=2"),
				Формат(ОбъектСцены.rightWingM, "ЧДЦ=2"));
		КонецЕсли;
		Координаты = СтрШаблон(
			"%1, %2 м",
			Формат(ОбъектСцены.x, "ЧДЦ=2"),
			Формат(ОбъектСцены.y, "ЧДЦ=2"));
		КарточкаОбъекта = СтрШаблон(
			"%1 · %2%3%4Площадка: %5 · ось: %6%3Позиция: %7 м · цвет: %8%9%3Координаты: %10",
			ОбъектСцены.name, ТипКрана, Символы.ПС, ОбъектСцены.id + Символы.ПС,
			ОбъектСцены.siteId, ОбъектСцены.movementAxis,
			Формат(ОбъектСцены.positionM, "ЧДЦ=2"), ОбъектСцены.color,
			ДополнениеРельсов,
			Координаты);
		Возврат;
	КонецЕсли;

	КарточкаОбъекта = СтрШаблон(
		"%1 · %2%3Координаты: %4, %5 м",
		ОбъектСцены.id, ОбъектСцены.kind, Символы.ПС,
		Формат(ОбъектСцены.x, "ЧДЦ=2"), Формат(ОбъектСцены.y, "ЧДЦ=2"));

КонецПроцедуры

&НаКлиенте
Функция ТекстПланаКонтейнеров(План)

	Число10 = 0;
	Число20 = 0;
	Число40 = 0;
	Если ТипЗнч(План) = Тип("Структура") Тогда
		Если План.Свойство("ft10") Тогда
			Число10 = План.ft10;
		КонецЕсли;
		Если План.Свойство("ft20") Тогда
			Число20 = План.ft20;
		КонецЕсли;
		Если План.Свойство("ft40") Тогда
			Число40 = План.ft40;
		КонецЕсли;
	ИначеЕсли ТипЗнч(План) = Тип("Соответствие") Тогда
		Если План.Получить("ft10") <> Неопределено Тогда
			Число10 = План.Получить("ft10");
		КонецЕсли;
		Если План.Получить("ft20") <> Неопределено Тогда
			Число20 = План.Получить("ft20");
		КонецЕсли;
		Если План.Получить("ft40") <> Неопределено Тогда
			Число40 = План.Получить("ft40");
		КонецЕсли;
	КонецЕсли;
	Возврат СтрШаблон(
		"10ft/20ft/40ft -  %1/%2/%3",
		Формат(Число10, "ЧДЦ=0; ЧН=0"),
		Формат(Число20, "ЧДЦ=0; ЧН=0"),
		Формат(Число40, "ЧДЦ=0; ЧН=0"));

КонецФункции


&НаСервере
Функция ПолучитьСудаНаСервере()

	Если Не Константы.ПолучениеРеальныхДанных.Получить() Тогда
		Результат = Новый Структура;
		Результат.Вставить("РежимEDS", Ложь);
		Результат.Вставить("Объекты", Новый Массив);
		Результат.Вставить("Предупреждения", Новый Массив);
		Возврат Результат;
	КонецЕсли;

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Результат = ОбъектОбработки.СобратьСудаEDS();
	Результат.Вставить("РежимEDS", Истина);
	Возврат Результат;

КонецФункции

