Функция ТекстОбъемаJSON(ДлинаJSON)

	Если ДлинаJSON >= 1048576 Тогда
		Возврат СтрШаблон("%1 МБ", Формат(ДлинаJSON / 1048576, "ЧДЦ=1; ЧН=0; ЧГ=0"));
	КонецЕсли;
	Возврат СтрШаблон("%1 КБ", Формат(ДлинаJSON / 1024, "ЧДЦ=0; ЧН=0; ЧГ=0"));

