&НаКлиенте
Процедура ОтправитьКомандуСцене(Команда)

	ОтправитьПолезнуюНагрузкуСцене(СериализоватьJSON(Команда));

КонецПроцедуры

&НаКлиенте
Функция ОтправитьПолезнуюНагрузкуСцене(ТекстJSON)

	Метрики = ПустыеМетрикиМоста();

	Попытка
		ДокументHTML = Элементы.HTML.Документ;
		УзелКоманд = ДокументHTML.getElementById("scene-command-bridge");
	Исключение
		ВызватьИсключение "Не удалось получить доступ к документу плана.";
	КонецПопытки;

	Если УзелКоманд = Неопределено Тогда
		ВызватьИсключение "План ещё не готов принимать команды.";
	КонецЕсли;
	Если ПолучитьАтрибутHTML(УзелКоманд, "data-ready") <> "true" Тогда
		ВызватьИсключение "План ещё не завершил инициализацию.";
	КонецЕсли;

	НомерКоманды = 0;
	ПредыдущийНомерКоманды = ПолучитьАтрибутHTML(УзелКоманд, "data-seq");
	Если Не ПустаяСтрока(ПредыдущийНомерКоманды) Тогда
		Попытка
			НомерКоманды = Число(ПредыдущийНомерКоманды);
		Исключение
			НомерКоманды = 0;
		КонецПопытки;
	КонецЕсли;
	НомерКоманды = НомерКоманды + 1;
	СтрокаНомераКоманды = Строка(НомерКоманды);

	УзелКоманд.setAttribute("data-error", "");
	УзелКоманд.setAttribute("data-ack", "");
	УзелКоманд.setAttribute("data-metrics", "");

	НачалоЗаписи = ТекущаяУниверсальнаяДатаВМиллисекундах();
	УзелКоманд.setAttribute("data-payload", ТекстJSON);
	Метрики.SetAttributeМс = ДлительностьКлиентМс(НачалоЗаписи);

	НачалоClick = ТекущаяУниверсальнаяДатаВМиллисекундах();
	УзелКоманд.setAttribute("data-seq", СтрокаНомераКоманды);
	Попытка
		УзелКоманд.click();
	Исключение
		Попытка
			УзелКоманд.fireEvent("onclick");
		Исключение
			ВызватьИсключение "HTML-движок не поддерживает отправку команд на план.";
		КонецПопытки;
	КонецПопытки;

	Если ПолучитьАтрибутHTML(УзелКоманд, "data-ack") <> СтрокаНомераКоманды Тогда
		ВызватьИсключение "План не подтвердил применение команды.";
	КонецЕсли;
	ТекстОшибки = ПолучитьАтрибутHTML(УзелКоманд, "data-error");
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ВызватьИсключение "Ошибка изменения плана: " + ТекстОшибки;
	КонецЕсли;
	Метрики.ClickМс = ДлительностьКлиентМс(НачалоClick);
	ПрочитатьМетрикиСцены(УзелКоманд, Метрики);
	Возврат Метрики;

КонецФункции

&НаКлиенте
Функция СериализоватьJSON(Значение)

	//@skip-check bsl-legacy-check-type-environments
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	//@skip-check undefined-function-or-procedure
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

&НаКлиенте
Функция ТекстКомандыСцены(ИмяКоманды, Секция)

	ЕстьМассивОбъектов = Секция.Свойство("Объекты") И ТипЗнч(Секция.Объекты) = Тип("Массив");
	Если Не ЕстьМассивОбъектов
		И Секция.Свойство("ДанныеJSON")
		И ЗначениеЗаполнено(Секция.ДанныеJSON) Тогда
		Возврат "{""op"":""" + ИмяКоманды + """,""objects"":" + Секция.ДанныеJSON + "}";
	КонецЕсли;
	КомандаСцены = Новый Структура;
	КомандаСцены.Вставить("op", ИмяКоманды);
	КомандаСцены.Вставить("objects", Секция.Объекты);
	Возврат СериализоватьJSON(КомандаСцены);

КонецФункции

&НаКлиенте
Функция ПолучитьАтрибутHTML(Узел, ИмяАтрибута)

	Попытка
		Значение = Узел.getAttribute(ИмяАтрибута);
		Если Значение = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Возврат Строка(Значение);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

&НаКлиенте
Процедура ОбработатьВыборОбъекта(Идентификатор, ВидОбъекта, X, Y, Z, УзелВыбора = Неопределено) Экспорт

	Если ВидОбъекта = "placement" Тогда
		Размещение = НайтиРазмещениеВИндексе(Идентификатор);
		Если Размещение = Неопределено Тогда
			Размещение = РазмещениеИзУзлаВыбора(УзелВыбора, Идентификатор);
		КонецЕсли;
		Если Размещение = Неопределено Тогда
			КарточкаОбъекта = СтрШаблон("Размещение %1", Идентификатор);
			Возврат;
		КонецЕсли;
		ЯчейкиТекст = "";
		Если Размещение.Свойство("cellIds") Тогда
			ЯчейкиТекст = СтрСоединить(Размещение.cellIds, ", ");
		КонецЕсли;
		ПометкаОтключения = "";
		Если Размещение.Свойство("cellIds") И Размещение.cellIds.Количество() > 0 Тогда
			ПометкаОтключения = ПометкаОтключенияЯчейки(НайтиЯчейкуВИндексе(Размещение.cellIds[0]));
		КонецЕсли;
		ТекстОтключения = ТекстОтключенияДляКарточки(ПометкаОтключения);
		КарточкаОбъекта = СтрШаблон(
			"Контейнер %1%2%3 ft · ярус %4%2Блок %5 · row %6 · bay %7%2Ячейки: %8%9",
			Размещение.id, Символы.ПС,
			Размещение.lengthFt, Размещение.tier,
			Размещение.blockId, Размещение.row, Размещение.bay,
			ЯчейкиТекст,
			?(ПустаяСтрока(ТекстОтключения), "", Символы.ПС + ТекстОтключения));
		ОткрытьФормуИнформацииЯчейки(Размещение.zoneId, Размещение.bay, Размещение.row, ПометкаОтключения);
		Возврат;
	КонецЕсли;

	Если ВидОбъекта = "cell" Тогда
		Ячейка = НайтиЯчейкуВИндексе(Идентификатор);
		Если Ячейка = Неопределено Тогда
			КарточкаОбъекта = СтрШаблон("Ячейка %1", Идентификатор);
			Возврат;
		КонецЕсли;
		ВысотаЯчейки = Ячейка.count;
		Если УзелВыбора <> Неопределено Тогда
			ВысотаИзМоста = ЧислоИзАтрибута(УзелВыбора, "data-count");
			Если ВысотаИзМоста > 0 Или ПолучитьАтрибутHTML(УзелВыбора, "data-count") = "0" Тогда
				ВысотаЯчейки = ВысотаИзМоста;
			КонецЕсли;
		КонецЕсли;
		Верх = ВерхнееРазмещениеЯчейки(Идентификатор);
		Если Верх = Неопределено Тогда
			Верх = ВерхнееРазмещениеИзУзлаВыбора(УзелВыбора);
		КонецЕсли;
		Доп = "";
		Если Верх <> Неопределено Тогда
			Доп = СтрШаблон("%1Верх: %2 (%3 ft, tier %4)",
				Символы.ПС, Верх.id, Верх.lengthFt, Верх.tier);
		КонецЕсли;
		ПометкаОтключения = ПометкаОтключенияЯчейки(Ячейка);
		ТекстОтключения = ТекстОтключенияДляКарточки(ПометкаОтключения);
		Если Не ПустаяСтрока(ТекстОтключения) Тогда
			Доп = Доп + Символы.ПС + ТекстОтключения;
		КонецЕсли;
		КарточкаОбъекта = СтрШаблон(
			"Ячейка %1 (20 ft)%2Блок %3 · row %4 · bay %5%2Высота: %6 / max %7%2Координаты: %8, %9 м%10",
			Ячейка.id, Символы.ПС,
			Ячейка.blockId, Ячейка.row, Ячейка.bay,
			ВысотаЯчейки, Ячейка.maxTier,
			Формат(Ячейка.x, "ЧДЦ=2"), Формат(Ячейка.y, "ЧДЦ=2"),
			Доп);
		ОткрытьФормуИнформацииЯчейки(Ячейка.zoneId, Ячейка.bay, Ячейка.row, ПометкаОтключения);
		Возврат;
	КонецЕсли;

	ОбъектСцены = НайтиОбъектВИндексе(Идентификатор);
	Если ОбъектСцены = Неопределено Тогда
		КарточкаОбъекта = СтрШаблон("%1 (%2) · X=%3 Y=%4", Идентификатор, ВидОбъекта, X, Y);
		Возврат;
	КонецЕсли;

	Если ОбъектСцены.kind = "vessel" Тогда
		ОткрытьФормуИнформацииСудна(ОбъектСцены);
		Возврат;
	КонецЕсли;

	Если ОбъектСцены.kind = "railWagon" Тогда
		ОткрытьФормуИнформацииВагона(ОбъектСцены);
		Возврат;
	КонецЕсли;

	Если ОбъектСцены.kind = "scoutVehicle" Тогда
		ОткрытьФормуИнформацииТехники(ОбъектСцены);
		Возврат;
	КонецЕсли;

	Если ОбъектСцены.kind = "building" Тогда
		ЦветЗдания = ?(ОбъектСцены.Свойство("color"), Строка(ОбъектСцены.color), "");
		КарточкаОбъекта = СтрШаблон(
			"%1 · здание%2%3Цвет: %4%2Координаты: %5, %6 м",
			ОбъектСцены.name, Символы.ПС, ОбъектСцены.id + Символы.ПС,
			ЦветЗдания,
			Формат(ОбъектСцены.x, "ЧДЦ=2"), Формат(ОбъектСцены.y, "ЧДЦ=2"));
		Возврат;
	КонецЕсли;

	Если ОбъектСцены.kind = "cranePortal" Тогда
		КарточкаОбъекта = СтрШаблон(
			"%1 · портальный кран%2%3Марка: %4 · масштаб: %5%2Азимут стрелы: %6° · цвет: %7%2Координаты: %8, %9 м",
			ОбъектСцены.name, Символы.ПС, ОбъектСцены.id + Символы.ПС,
			ОбъектСцены.model, Формат(ОбъектСцены.scale, "ЧДЦ=2"),
			Формат(ОбъектСцены.azimuthDeg, "ЧДЦ=1"), ОбъектСцены.color,
			Формат(ОбъектСцены.x, "ЧДЦ=2"), Формат(ОбъектСцены.y, "ЧДЦ=2"));
		Возврат;
	КонецЕсли;

	Если ОбъектСцены.kind = "craneRtg" Или ОбъектСцены.kind = "craneRmg" Тогда
		ТипКрана = ?(ОбъектСцены.kind = "craneRmg", "RMG", "RTG");
		ДополнениеРельсов = "";
		Если ОбъектСцены.kind = "craneRmg" Тогда
			ДополнениеРельсов = СтрШаблон(
				"%1Отступ рельсов: %2 м%1Крылья: слева %3 м · справа %4 м",
				Символы.ПС,
				Формат(ОбъектСцены.railInsetM, "ЧДЦ=2"),
				Формат(ОбъектСцены.leftWingM, "ЧДЦ=2"),
				Формат(ОбъектСцены.rightWingM, "ЧДЦ=2"));
		КонецЕсли;
		Координаты = СтрШаблон(
			"%1, %2 м",
			Формат(ОбъектСцены.x, "ЧДЦ=2"),
			Формат(ОбъектСцены.y, "ЧДЦ=2"));
		КарточкаОбъекта = СтрШаблон(
			"%1 · %2%3%4Площадка: %5 · ось: %6%3Позиция: %7 м · цвет: %8%9%3Координаты: %10",
			ОбъектСцены.name, ТипКрана, Символы.ПС, ОбъектСцены.id + Символы.ПС,
			ОбъектСцены.siteId, ОбъектСцены.movementAxis,
			Формат(ОбъектСцены.positionM, "ЧДЦ=2"), ОбъектСцены.color,
			ДополнениеРельсов,
			Координаты);
		Возврат;
	КонецЕсли;

	КарточкаОбъекта = СтрШаблон(
		"%1 · %2%3Координаты: %4, %5 м",
		ОбъектСцены.id, ОбъектСцены.kind, Символы.ПС,
		Формат(ОбъектСцены.x, "ЧДЦ=2"), Формат(ОбъектСцены.y, "ЧДЦ=2"));

КонецПроцедуры

&НаКлиенте
Функция РазмещениеИзУзлаВыбора(УзелВыбора, Идентификатор)

	Если УзелВыбора = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ПустаяСтрока(ПолучитьАтрибутHTML(УзелВыбора, "data-kind")) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Размещение = Новый Структура;
	Размещение.Вставить("id", Идентификатор);
	Размещение.Вставить("lengthFt", ЧислоИзАтрибута(УзелВыбора, "data-lengthft"));
	Размещение.Вставить("tier", ЧислоИзАтрибута(УзелВыбора, "data-tier"));
	Размещение.Вставить("blockId", ПолучитьАтрибутHTML(УзелВыбора, "data-block"));
	Размещение.Вставить("row", ЧислоИзАтрибута(УзелВыбора, "data-row"));
	Размещение.Вставить("bay", ЧислоИзАтрибута(УзелВыбора, "data-bay"));
	Размещение.Вставить("zoneId", ПолучитьАтрибутHTML(УзелВыбора, "data-zone"));
	ИдентификаторыЯчеек = Новый Массив;
	ТекстЯчеек = ПолучитьАтрибутHTML(УзелВыбора, "data-cells");
	Если Не ПустаяСтрока(ТекстЯчеек) Тогда
		Для Каждого ИдЯчейки Из СтрРазделить(ТекстЯчеек, ",", Ложь) Цикл
			ИдентификаторыЯчеек.Добавить(СокрЛП(ИдЯчейки));
		КонецЦикла;
	КонецЕсли;
	Размещение.Вставить("cellIds", ИдентификаторыЯчеек);
	Возврат Размещение;

КонецФункции

&НаКлиенте
Функция ВерхнееРазмещениеИзУзлаВыбора(УзелВыбора)

	Если УзелВыбора = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Идентификатор = ПолучитьАтрибутHTML(УзелВыбора, "data-top-id");
	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Верх = Новый Структура;
	Верх.Вставить("id", Идентификатор);
	Верх.Вставить("lengthFt", ЧислоИзАтрибута(УзелВыбора, "data-top-lengthft"));
	Верх.Вставить("tier", ЧислоИзАтрибута(УзелВыбора, "data-top-tier"));
	Возврат Верх;

КонецФункции

&НаКлиенте
Функция ПометкаОтключенияЯчейки(Ячейка)

	Если Ячейка = Неопределено Или Не Ячейка.Свойство("disabledReason") Тогда
		Возврат "";
	КонецЕсли;
	Если Ячейка.disabledReason = "disabled" Тогда
		Возврат "отключена в УКТ";
	КонецЕсли;
	Если Ячейка.disabledReason = "missing" Тогда
		Возврат "нет в УКТ";
	КонецЕсли;
	Если Ячейка.disabledReason = "shuttle" Тогда
		Возврат "зона шаттла";
	КонецЕсли;
	Возврат "";

КонецФункции

&НаКлиенте
Функция ТекстОтключенияДляКарточки(ПометкаОтключения)

	Если ПометкаОтключения = "отключена в УКТ" Тогда
		Возврат "Ячейка отключена в УКТ";
	КонецЕсли;
	Если ПометкаОтключения = "нет в УКТ" Тогда
		Возврат "Ячейки нет в УКТ";
	КонецЕсли;
	Если ПометкаОтключения = "зона шаттла" Тогда
		Возврат "Ячейка в зоне шаттла";
	КонецЕсли;
	Возврат "";

КонецФункции

&НаКлиенте
Процедура ОткрытьФормуИнформацииЯчейки(Зона, Бэй, Ряд, ПометкаОтключения = "")

	КодЯчейки = СтрШаблон(
		"%1-%2-%3",
		СокрЛП(Строка(Зона)),
		Формат(Бэй, "ЧГ=0"),
		Формат(Ряд, "ЧГ=0"));
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("КодЯчейки", КодЯчейки);
	ПараметрыФормы.Вставить("ПометкаОтключения", ПометкаОтключения);
	ОткрытьФорму(
		"Обработка.d3_v4.Форма.ИнформацияЯчейка",
		ПараметрыФормы,
		ЭтотОбъект,
		КодЯчейки,
		,
		,
		,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуИнформацииТехники(ОбъектСцены)

	ИмяТехники = ?(ОбъектСцены.Свойство("name") И ЗначениеЗаполнено(ОбъектСцены.name),
		Строка(ОбъектСцены.name),
		ОбъектСцены.id);
	ТипТехники = "";
	Если ОбъектСцены.Свойство("equipmentType") И ЗначениеЗаполнено(ОбъектСцены.equipmentType) Тогда
		ТипТехники = Строка(ОбъектСцены.equipmentType);
	КонецЕсли;
	ИдентификаторСкаут = 0;
	Если ОбъектСцены.Свойство("scoutId") И ЗначениеЗаполнено(ОбъектСцены.scoutId) Тогда
		ИдентификаторСкаут = ОбъектСцены.scoutId;
	КонецЕсли;
	ИнформацияТехники = "";
	Если ОбъектСцены.Свойство("information") И ЗначениеЗаполнено(ОбъектСцены.information) Тогда
		ИнформацияТехники = Строка(ОбъектСцены.information);
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Наименование", ИмяТехники);
	ПараметрыФормы.Вставить("ТипТехники", ТипТехники);
	ПараметрыФормы.Вставить("ИдентификаторСкаут", ИдентификаторСкаут);
	ПараметрыФормы.Вставить("Информация", ИнформацияТехники);
	ОткрытьФорму(
		"Обработка.d3_v4.Форма.ИнформацияТехника",
		ПараметрыФормы,
		ЭтотОбъект,
		ОбъектСцены.id,
		,
		,
		,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуИнформацииВагона(ОбъектСцены)

	ТипКод = "";
	Если ОбъектСцены.Свойство("wagonType") Тогда
		ТипКод = Строка(ОбъектСцены.wagonType);
	КонецЕсли;
	Груженый = Ложь;
	Если ОбъектСцены.Свойство("loaded") И ОбъектСцены.loaded = Истина Тогда
		Груженый = Истина;
	КонецЕсли;
	Ветка = "";
	Если ОбъектСцены.Свойство("branchId") Тогда
		Ветка = Строка(ОбъектСцены.branchId);
	КонецЕсли;
	ДлинаВагона = 0;
	Если ОбъектСцены.Свойство("size") И ОбъектСцены.size.Свойство("length") Тогда
		ДлинаВагона = ОбъектСцены.size.length;
	КонецЕсли;
	ПозицияМ = 0;
	Если ОбъектСцены.Свойство("positionM") Тогда
		ПозицияМ = ОбъектСцены.positionM;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Номер", Строка(ОбъектСцены.id));
	ПараметрыФормы.Вставить("ТипКод", ТипКод);
	ПараметрыФормы.Вставить("Груженый", Груженый);
	ПараметрыФормы.Вставить("Ветка", Ветка);
	ПараметрыФормы.Вставить("Длина", ДлинаВагона);
	ПараметрыФормы.Вставить("Позиция", ПозицияМ);
	ОткрытьФорму(
		"Обработка.d3_v4.Форма.ИнформацияВагон",
		ПараметрыФормы,
		ЭтотОбъект,
		ОбъектСцены.id,
		,
		,
		,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуИнформацииСудна(ОбъектСцены)

	ИмяСудна = ?(ОбъектСцены.Свойство("name") И ЗначениеЗаполнено(ОбъектСцены.name),
		Строка(ОбъектСцены.name),
		ОбъектСцены.id);
	ДлинаСудна = 0;
	Если ОбъектСцены.Свойство("length") Тогда
		ДлинаСудна = ОбъектСцены.length;
	ИначеЕсли ОбъектСцены.Свойство("size") И ОбъектСцены.size.Свойство("length") Тогда
		ДлинаСудна = ОбъектСцены.size.length;
	КонецЕсли;
	ВидСудна = "";
	Если ОбъектСцены.Свойство("vesselType") Тогда
		Если ОбъектСцены.vesselType = "container" Тогда
			ВидСудна = "контейнеры";
		ИначеЕсли ОбъектСцены.vesselType = "carCarrier" Тогда
			ВидСудна = "автомобили";
		ИначеЕсли ОбъектСцены.vesselType = "coal" Тогда
			ВидСудна = "уголь";
		ИначеЕсли ОбъектСцены.vesselType = "fish" Тогда
			ВидСудна = "рыба";
		ИначеЕсли ОбъектСцены.vesselType = "general" Тогда
			ВидСудна = "генеральный груз";
		ИначеЕсли ОбъектСцены.vesselType = "bunker" Тогда
			ВидСудна = "бункеровка";
		ИначеЕсли ОбъектСцены.vesselType = "empty" Тогда
			ВидСудна = "без груза";
		Иначе
			ВидСудна = Строка(ОбъектСцены.vesselType);
		КонецЕсли;
	КонецЕсли;
	ЭтоРейд = ОбъектСцены.Свойство("locationType") И ОбъектСцены.locationType = "anchorage";
	Причал = "";
	Борт = "";
	Заправка = "нет";
	ПлановыйПричал = "";
	ДатаШвартовки = "";
	Погрузка = "";
	Разгрузка = "";
	Если ЭтоРейд Тогда
		ДатаШвартовки = ?(ОбъектСцены.Свойство("plannedBerthingAt"), Строка(ОбъектСцены.plannedBerthingAt), "");
		ДатаШвартовки = СтрЗаменить(ДатаШвартовки, "T", " ");
		ПланПогрузки = Неопределено;
		Если ОбъектСцены.Свойство("plannedLoad") Тогда
			ПланПогрузки = ОбъектСцены.plannedLoad;
		КонецЕсли;
		ПланРазгрузки = Неопределено;
		Если ОбъектСцены.Свойство("plannedUnload") Тогда
			ПланРазгрузки = ОбъектСцены.plannedUnload;
		КонецЕсли;
		ПлановыйПричал = ?(ОбъектСцены.Свойство("plannedBerthId"), Строка(ОбъектСцены.plannedBerthId), "");
		Погрузка = ТекстПланаКонтейнеров(ПланПогрузки);
		Разгрузка = ТекстПланаКонтейнеров(ПланРазгрузки);
	Иначе
		Причал = ?(ОбъектСцены.Свойство("berthId"), Строка(ОбъектСцены.berthId), "");
		Если ОбъектСцены.Свойство("mooringSide") Тогда
			Если ОбъектСцены.mooringSide = "right" Тогда
				Борт = "правый борт";
			ИначеЕсли ОбъектСцены.mooringSide = "left" Тогда
				Борт = "левый борт";
			ИначеЕсли ОбъектСцены.mooringSide = "bow" Тогда
				Борт = "носом";
			ИначеЕсли ОбъектСцены.mooringSide = "stern" Тогда
				Борт = "кормой";
			Иначе
				Борт = Строка(ОбъектСцены.mooringSide);
			КонецЕсли;
		КонецЕсли;
		Если ОбъектСцены.Свойство("refueling") И ОбъектСцены.refueling = Истина Тогда
			Заправка = "да";
		КонецЕсли;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Наименование", ИмяСудна);
	ПараметрыФормы.Вставить("ВидСудна", ВидСудна);
	ПараметрыФормы.Вставить("Длина", ДлинаСудна);
	ПараметрыФормы.Вставить("ЭтоРейд", ЭтоРейд);
	ПараметрыФормы.Вставить("Причал", Причал);
	ПараметрыФормы.Вставить("Борт", Борт);
	ПараметрыФормы.Вставить("Заправка", Заправка);
	ПараметрыФормы.Вставить("ПлановыйПричал", ПлановыйПричал);
	ПараметрыФормы.Вставить("ДатаШвартовки", ДатаШвартовки);
	ПараметрыФормы.Вставить("Погрузка", Погрузка);
	ПараметрыФормы.Вставить("Разгрузка", Разгрузка);
	ОткрытьФорму(
		"Обработка.d3_v4.Форма.ИнформацияСудно",
		ПараметрыФормы,
		ЭтотОбъект,
		ОбъектСцены.id,
		,
		,
		,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Функция ТекстПланаКонтейнеров(План)

	Число10 = 0;
	Число20 = 0;
	Число40 = 0;
	Если ТипЗнч(План) = Тип("Структура") Тогда
		Если План.Свойство("ft10") Тогда
			Число10 = План.ft10;
		КонецЕсли;
		Если План.Свойство("ft20") Тогда
			Число20 = План.ft20;
		КонецЕсли;
		Если План.Свойство("ft40") Тогда
			Число40 = План.ft40;
		КонецЕсли;
	ИначеЕсли ТипЗнч(План) = Тип("Соответствие") Тогда
		Если План.Получить("ft10") <> Неопределено Тогда
			Число10 = План.Получить("ft10");
		КонецЕсли;
		Если План.Получить("ft20") <> Неопределено Тогда
			Число20 = План.Получить("ft20");
		КонецЕсли;
		Если План.Получить("ft40") <> Неопределено Тогда
			Число40 = План.Получить("ft40");
		КонецЕсли;
	КонецЕсли;
	Возврат СтрШаблон(
		"10ft/20ft/40ft -  %1/%2/%3",
		Формат(Число10, "ЧДЦ=0; ЧН=0"),
		Формат(Число20, "ЧДЦ=0; ЧН=0"),
		Формат(Число40, "ЧДЦ=0; ЧН=0"));

КонецФункции


