	Если Количество > 0 Тогда
		Возврат Количество;
	КонецЕсли;
	Если Секция.Свойство("Объекты") И ТипЗнч(Секция.Объекты) = Тип("Массив") Тогда
		Возврат Секция.Объекты.Количество();
	КонецЕсли;
	Возврат 0;

