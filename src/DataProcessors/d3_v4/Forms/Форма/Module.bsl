&НаКлиенте
Функция СобратьТекстЗамераСекции(Секция, ИмяСлоя, ВызовСервераМс, СериализацияМс, МетрикиМоста, ИндексМс)

	ДлинаJSON = ЧислоСвойстваСекции(Секция, "ДлинаJSON");
	ДополнениеСостояния = "";
	Если Секция.Свойство("Предупреждения")
		И ТипЗнч(Секция.Предупреждения) = Тип("Массив")
		И Секция.Предупреждения.Количество() > 0 Тогда
		ДополнениеСостояния = " · " + СтрСоединить(Секция.Предупреждения, "; ");
	КонецЕсли;

	ЗаголовокЗамера = СтрШаблон(
		"%1 обновлены · объектов %2 · JSON %3",
		ИмяСлоя,
		ФорматМс(КоличествоОбъектовСекции(Секция)),
		ТекстОбъемаJSON(ДлинаJSON));
	ФазыСервера = СтрШаблон(
		"запрос %1 / разбор %2 / вызов %3 / сериализация %4",
		ФорматМс(ЧислоСвойстваСекции(Секция, "ДлительностьЗапросаМс")),
		ФорматМс(ЧислоСвойстваСекции(Секция, "ДлительностьРазбораМс")),
		ФорматМс(ВызовСервераМс),
		ФорматМс(СериализацияМс));
	ФазыМоста = СтрШаблон(
		"setAttribute %1 / click %2 / jsParse %3 / normalize %4 / recompute %5 / draw %6",
		ФорматМс(МетрикиМоста.SetAttributeМс),
		ФорматМс(МетрикиМоста.ClickМс),
		ФорматМс(МетрикиМоста.JsParseМс),
		ФорматМс(МетрикиМоста.NormalizeМс),
		ФорматМс(МетрикиМоста.RecomputeМс),
		ФорматМс(МетрикиМоста.DrawМс));
	ФазыКлиента = СтрШаблон(
		"индекс %1 мс · %2%3",
		ФорматМс(ИндексМс),
		Формат(ТекущаяДата(), "ДФ=HH:mm:ss"),
		ДополнениеСостояния);
	Возврат ЗаголовокЗамера + " · " + ФазыСервера + " / " + ФазыМоста + " / " + ФазыКлиента;

КонецФункции

&НаКлиенте
Функция ЕстьДолгаяФазаЗамера(Секция, ВызовСервераМс, СериализацияМс, МетрикиМоста, ИндексМс)

	Порог = 1000;
	Если ЧислоСвойстваСекции(Секция, "ДлительностьЗапросаМс") >= Порог Тогда
		Возврат Истина;
	КонецЕсли;
	Если ЧислоСвойстваСекции(Секция, "ДлительностьРазбораМс") >= Порог Тогда
		Возврат Истина;
	КонецЕсли;
	Если ВызовСервераМс >= Порог Тогда
		Возврат Истина;
	КонецЕсли;
	Если СериализацияМс >= Порог Тогда
		Возврат Истина;
	КонецЕсли;
	Если МетрикиМоста.SetAttributeМс >= Порог Тогда
		Возврат Истина;
	КонецЕсли;
	Если МетрикиМоста.ClickМс >= Порог Тогда
		Возврат Истина;
	КонецЕсли;
	Если МетрикиМоста.JsParseМс >= Порог Тогда
		Возврат Истина;
	КонецЕсли;
	Если МетрикиМоста.NormalizeМс >= Порог Тогда
		Возврат Истина;
	КонецЕсли;
	Если МетрикиМоста.RecomputeМс >= Порог Тогда
		Возврат Истина;
	КонецЕсли;
	Если МетрикиМоста.DrawМс >= Порог Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ИндексМс >= Порог;

КонецФункции

