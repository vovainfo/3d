
#Область ОписаниеПеременных

&НаКлиенте
Перем ИндексОбъектов;

&НаКлиенте
Перем ИндексЯчеек;

&НаКлиенте
Перем ИндексРазмещений;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Сборка = ОбъектОбработки.СобратьHTMLСцены();

	HTML = Сборка.HTML;
	ДанныеСценыJSON = Сборка.ДанныеСценыJSON;
	СостояниеОбмена = Сборка.СостояниеОбмена;
	КарточкаОбъекта = "Кликните ячейку, здание или технику на плане";
	ПоискОбъекта = "";

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПостроитьИндексы();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура HTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Href = "";
	Попытка
		Если ДанныеСобытия.Href <> Неопределено Тогда
			Href = Строка(ДанныеСобытия.Href);
		КонецЕсли;
	Исключение
	КонецПопытки;

	Если СтрНайти(Href, "#pick:") = 0 Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;

	Узел = Неопределено;
	Попытка
		Узел = ДанныеСобытия.Anchor;
	Исключение
		Попытка
			Узел = ДанныеСобытия.Element;
		Исключение
			Узел = Неопределено;
		КонецПопытки;
	КонецПопытки;

	Если Узел = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Идентификатор = ПолучитьАтрибутHTML(Узел, "data-id");
	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	ВидОбъекта = ПолучитьАтрибутHTML(Узел, "data-kind");
	X = ЧислоИзАтрибута(Узел, "data-x");
	Y = ЧислоИзАтрибута(Узел, "data-y");

	ОбработатьВыборОбъекта(Идентификатор, ВидОбъекта, X, Y, 0);

КонецПроцедуры

&НаКлиенте
Процедура ПоискОбъектаПриИзменении(Элемент)
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НайтиОбъект(Команда)

	Идентификатор = СокрЛП(ПоискОбъекта);
	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	Цель = НайтиРазмещениеВИндексе(Идентификатор);
	Вид = "placement";
	Если Цель = Неопределено Тогда
		Цель = НайтиЯчейкуВИндексе(Идентификатор);
		Вид = "cell";
	КонецЕсли;
	Если Цель = Неопределено Тогда
		Цель = НайтиОбъектВИндексе(Идентификатор);
		Вид = ?(Цель = Неопределено, "", Цель.kind);
	КонецЕсли;
	Если Цель = Неопределено Тогда
		КарточкаОбъекта = СтрШаблон("Объект %1 не найден", Идентификатор);
		Возврат;
	КонецЕсли;

	ОтправитьКомандуСцене(Новый Структура("op,id", "focus", Идентификатор));
	X = 0;
	Y = 0;
	Если Цель.Свойство("x") Тогда
		X = Цель.x;
	КонецЕсли;
	Если Цель.Свойство("y") Тогда
		Y = Цель.y;
	КонецЕсли;
	ОбработатьВыборОбъекта(Цель.id, Вид, X, Y, 0);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТехнику(Команда)

	Попытка
		МассивТехники = ПолучитьТехникуСкаутНаСервере();
		КомандаСцены = Новый Структура;
		КомандаСцены.Вставить("op", "updateScoutVehicles");
		КомандаСцены.Вставить("objects", МассивТехники);
		ОтправитьКомандуСцене(КомандаСцены);
		СинхронизироватьИндексТехники(МассивТехники);
		СостояниеОбмена = СтрШаблон(
			"техника обновлена · объектов %1 · %2",
			МассивТехники.Количество(),
			Формат(ТекущаяДата(), "ДФ=HH:mm:ss"));
	Исключение
		СостояниеОбмена = "ошибка обновления техники: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПолучитьТехникуИзСкаут(Команда)

	Попытка
		КоличествоТехники = ПолучитьИЗаписатьТехникуСкаутНаСервере();
		СостояниеОбмена = СтрШаблон(
			"из Скаут получено и записано объектов %1 · %2",
			КоличествоТехники,
			Формат(ТекущаяДата(), "ДФ=HH:mm:ss"));
	Исключение
		СостояниеОбмена = "ошибка получения техники из Скаут: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры


&НаКлиенте
Процедура ПолучитьСуда(Команда)

	Попытка
		Результат = ПолучитьСудаНаСервере();
		Если Не Результат.РежимEDS Тогда
			СостояниеОбмена = "суда не обновлены · включён демонстрационный режим";
			Возврат;
		КонецЕсли;
		КомандаСцены = Новый Структура;
		КомандаСцены.Вставить("op", "updateVessels");
		КомандаСцены.Вставить("objects", Результат.Объекты);
		ОтправитьКомандуСцене(КомандаСцены);
		СинхронизироватьИндексСудов(Результат.Объекты);
		ДополнениеСостояния = "";
		Если Результат.Предупреждения.Количество() > 0 Тогда
			ДополнениеСостояния = " · " + СтрСоединить(Результат.Предупреждения, "; ");
		КонецЕсли;
		СостояниеОбмена = СтрШаблон(
			"суда EDS обновлены · объектов %1 · %2%3",
			Результат.Объекты.Количество(),
			Формат(ТекущаяДата(), "ДФ=HH:mm:ss"),
			ДополнениеСостояния);
	Исключение
		СостояниеОбмена = "ошибка обновления судов EDS: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

