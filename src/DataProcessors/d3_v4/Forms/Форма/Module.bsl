
#Область ОписаниеПеременных

&НаКлиенте
Перем ИндексОбъектов;

&НаКлиенте
Перем ИндексЯчеек;

&НаКлиенте
Перем ИндексРазмещений;

&НаКлиенте
Перем ПериодСнимкаТехники;

&НаКлиенте
Перем ОбновлениеТехникиВыполняется;

&НаКлиенте
Перем ОшибокПодрядОбновленияТехники;

&НаКлиенте
Перем ПопытокСинхронизацииВместимости;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПолучениеРеальныхДанных = Константы.ПолучениеРеальныхДанных.Получить();
	ОтрисовкаПутейДляВагонов = Константы.ОтрисовкаПутейДляВагонов.Получить();
	ПоказыватьВместимостьЯчейки = Истина;
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Сборка = ОбъектОбработки.СобратьHTMLСцены();

	HTML = Сборка.HTML;
	ДанныеСценыJSON = Сборка.ДанныеСценыJSON;
	СостояниеОбмена = Сборка.СостояниеОбмена;
	ЗаполнитьДатыАктуализации(Сборка);
	КарточкаОбъекта = "Кликните ячейку, здание или технику на плане";

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПостроитьИндексы();
	ПериодСнимкаТехники = ДатаТехникаСкаут;
	НастроитьАвтообновлениеТехники();

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	ОтключитьОбработчикОжидания("ОбработчикОжиданияТехника");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПолучениеРеальныхДанныхПриИзменении(Элемент)

	ПересобратьСценуНаСервере();
	ПостроитьИндексы();
	ПериодСнимкаТехники = ДатаТехникаСкаут;
	КарточкаОбъекта = "Кликните ячейку, здание или технику на плане";
	НастроитьАвтообновлениеТехники();
	ЗапланироватьСинхронизациюВместимостиЯчейки();

КонецПроцедуры

&НаКлиенте
Процедура ОтрисовкаПутейДляВагоновПриИзменении(Элемент)

	ОтрисовкаПутейДляВагоновПриИзмененииНаСервере();
	Команда = Новый Структура;
	Команда.Вставить("op", "setDrawRailwayBranches");
	Команда.Вставить("visible", ОтрисовкаПутейДляВагонов);
	Попытка
		ОтправитьКомандуСцене(Команда);
	Исключение
		ПерерисоватьСценуБезОбменаНаСервере();
		ПостроитьИндексы();
		ЗапланироватьСинхронизациюВместимостиЯчейки();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьВместимостьЯчейкиПриИзменении(Элемент)

	ОтправитьПоказВместимостиЯчейки();

КонецПроцедуры

&НаКлиенте
Процедура HTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Href = "";
	Попытка
		Если ДанныеСобытия.Href <> Неопределено Тогда
			Href = Строка(ДанныеСобытия.Href);
		КонецЕсли;
	Исключение
	КонецПопытки;

	Если СтрНайти(Href, "#pick:") = 0 Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;

	Узел = Неопределено;
	Попытка
		Узел = ДанныеСобытия.Anchor;
	Исключение
		Попытка
			Узел = ДанныеСобытия.Element;
		Исключение
			Узел = Неопределено;
		КонецПопытки;
	КонецПопытки;

	Если Узел = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Идентификатор = ПолучитьАтрибутHTML(Узел, "data-id");
	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	ВидОбъекта = ПолучитьАтрибутHTML(Узел, "data-kind");
	X = ЧислоИзАтрибута(Узел, "data-x");
	Y = ЧислоИзАтрибута(Узел, "data-y");

	ОбработатьВыборОбъекта(Идентификатор, ВидОбъекта, X, Y, 0, Узел);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьПоискОбъектов(Команда)

	Оповещение = Новый ОписаниеОповещения("ПослеВыбораОбъектаПоиска", ЭтотОбъект);
	ОткрытьФорму(
		"Обработка.d3_v4.Форма.ПоискОбъектов",
		,
		ЭтотОбъект,
		"ПоискОбъектов",
		,
		,
		Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТехнику(Команда)

	Попытка
		МассивТехники = ПолучитьТехникуСкаутНаСервере();
		КомандаСцены = Новый Структура;
		КомандаСцены.Вставить("op", "updateScoutVehicles");
		КомандаСцены.Вставить("objects", МассивТехники);
		ОтправитьКомандуСцене(КомандаСцены);
		СинхронизироватьИндексТехники(МассивТехники);
		СостояниеОбмена = СтрШаблон(
			"техника обновлена · объектов %1 · %2",
			МассивТехники.Количество(),
			Формат(ТекущаяДата(), "ДФ=HH:mm:ss"));
	Исключение
		СостояниеОбмена = "ошибка обновления техники: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПолучитьТехникуИзСкаут(Команда)

	ОбновитьТехнику(Команда);

КонецПроцедуры


&НаКлиенте
Процедура ПолучитьСуда(Команда)

	ЗапуститьОбновлениеСудовНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПолучитьВагоны(Команда)

	ЗапуститьОбновлениеВагоновНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПолучитьКонтейнеры(Команда)

	ЗапуститьОбновлениеКонтейнеровНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПереключитьМаксимизациюКарты(Команда)

	КартаМаксимизирована = Не КартаМаксимизирована;
	ПрименитьРежимМаксимизацииКарты();

КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПрименитьРежимМаксимизацииКарты()

	ВидимостьЭлементов = Не КартаМаксимизирована;
	Элементы.Чекбоксы.Видимость = ВидимостьЭлементов;
	Элементы.КарточкаОбъекта.Видимость = ВидимостьЭлементов;
	Элементы.Кнопки.Видимость = ВидимостьЭлементов;

	КнопкаМаксимизации = Элементы.ФормаПереключитьМаксимизациюКарты;
	КнопкаМаксимизации.Пометка = КартаМаксимизирована;
	Если КартаМаксимизирована Тогда
		КнопкаМаксимизации.Заголовок = "Восстановить панели";
	Иначе
		КнопкаМаксимизации.Заголовок = "Развернуть карту";
	КонецЕсли;

	ПодключитьОбработчикОжидания("ОбновитьРазмерСценыПослеСменыРежима", 0.1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРазмерСценыПослеСменыРежима()

	Попытка
		ОтправитьКомандуСцене(Новый Структура("op", "resize"));
	Исключение
		Возврат;
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ЗапланироватьСинхронизациюВместимостиЯчейки()

	ПопытокСинхронизацииВместимости = 0;
	ПодключитьОбработчикОжидания("ОтправитьПоказВместимостиЯчейки", 0.1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьПоказВместимостиЯчейки()

	Команда = Новый Структура;
	Команда.Вставить("op", "setShowCellCapacity");
	Команда.Вставить("visible", ПоказыватьВместимостьЯчейки);
	Попытка
		ОтправитьКомандуСцене(Команда);
		ПопытокСинхронизацииВместимости = 0;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Если ЭтоОжиданиеГотовностиПлана(ТекстОшибки) Тогда
			Если ПопытокСинхронизацииВместимости = Неопределено Тогда
				ПопытокСинхронизацииВместимости = 0;
			КонецЕсли;
			ПопытокСинхронизацииВместимости = ПопытокСинхронизацииВместимости + 1;
			Если ПопытокСинхронизацииВместимости <= 2 Тогда
				ПодключитьОбработчикОжидания("ОтправитьПоказВместимостиЯчейки", 0.1, Истина);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		СостояниеОбмена = "не удалось применить показ вместимости ячейки: " + ТекстОшибки;
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура НастроитьАвтообновлениеТехники()

	ОтключитьОбработчикОжидания("ОбработчикОжиданияТехника");
	ОшибокПодрядОбновленияТехники = 0;
	ОбновлениеТехникиВыполняется = Ложь;
	Если ПолучениеРеальныхДанных Тогда
		ПодключитьОбработчикОжидания("ОбработчикОжиданияТехника", 20);
	Иначе
		ОчиститьДатыАктуализации();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикОжиданияТехника()

	Если ОбновлениеТехникиВыполняется = Истина Тогда
		Возврат;
	КонецЕсли;

	ОбновлениеТехникиВыполняется = Истина;
	Попытка
		Версии = Новый Структура;
		Версии.Вставить("ПериодТехники", ПериодСнимкаТехники);
		Версии.Вставить("ДатаEDS", ДатаСудаEDS);
		Версии.Вставить("ДатаУПП", ДатаВагоныУПП);
		Версии.Вставить("ДатаУКТ", ДатаКонтейнерыУКТ);
		НачалоВызова = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Результат = ПолучитьОбновленияСнимковНаСервере(Версии);
		ВызовСервераМс = ДлительностьКлиентМс(НачалоВызова);
		Если Результат.РежимРеальныхДанных <> ПолучениеРеальныхДанных Тогда
			СостояниеОбмена = "константа ПолучениеРеальныхДанных изменена в другом сеансе";
			НастроитьАвтообновлениеТехники();
			ОбновлениеТехникиВыполняется = Ложь;
			Возврат;
		КонецЕсли;
		ПрименитьСекциюСнимка(Результат.Техника, "updateScoutVehicles", "техника", ВызовСервераМс);
		ПрименитьСекциюСнимка(Результат.EDS, "updateVessels", "суда", ВызовСервераМс);
		ПрименитьСекциюСнимка(Результат.УПП, "updateRailWagons", "вагоны", ВызовСервераМс);
		ПрименитьСекциюСнимка(Результат.УКТ, "updatePlacements", "контейнеры", ВызовСервераМс);
		ОшибокПодрядОбновленияТехники = 0;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Если Не ЭтоОжиданиеГотовностиПлана(ТекстОшибки) Тогда
			СостояниеОбмена = "ошибка опроса снимков: " + ТекстОшибки;
		КонецЕсли;
	КонецПопытки;
	ОбновлениеТехникиВыполняется = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьСекциюСнимка(Секция, ИмяКоманды, ИмяСлоя, ВызовСервераМс)

	Если Секция = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Секция.Свойство("Ошибка") И Секция.Ошибка Тогда
		СостояниеОбмена = СтрШаблон("ошибка слоя %1: %2", ИмяСлоя, Секция.ТекстОшибки);
		Возврат;
	КонецЕсли;
	Если Не Секция.ЕстьИзменения Тогда
		Возврат;
	КонецЕсли;

	Попытка
		НачалоСериализации = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ТекстКоманды = ТекстКомандыСцены(ИмяКоманды, Секция);
		СериализацияМс = ДлительностьКлиентМс(НачалоСериализации);
		МетрикиМоста = ОтправитьПолезнуюНагрузкуСцене(ТекстКоманды);
		НачалоИндекса = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Если ИмяКоманды = "updateScoutVehicles" Тогда
			СинхронизироватьИндексТехники(Секция.Объекты);
			ПериодСнимкаТехники = Секция.ПериодСнимка;
			ДатаТехникаСкаут = Секция.ПериодСнимка;
		ИначеЕсли ИмяКоманды = "updateVessels" Тогда
			СинхронизироватьИндексСудов(Секция.Объекты);
			ДатаСудаEDS = Секция.ДатаСнимка;
		ИначеЕсли ИмяКоманды = "updateRailWagons" Тогда
			СинхронизироватьИндексВагонов(Секция.Объекты);
			ДатаВагоныУПП = Секция.ДатаСнимка;
		ИначеЕсли ИмяКоманды = "updatePlacements" Тогда
			Если ТипЗнч(Секция.Объекты) = Тип("Массив") Тогда
				СинхронизироватьИндексРазмещений(Секция.Объекты);
			КонецЕсли;
			ДатаКонтейнерыУКТ = Секция.ДатаСнимка;
		КонецЕсли;
		ИндексМс = ДлительностьКлиентМс(НачалоИндекса);
		ТекстЗамера = СобратьТекстЗамераСекции(
			Секция,
			ИмяСлоя,
			ВызовСервераМс,
			СериализацияМс,
			МетрикиМоста,
			ИндексМс);
		СостояниеОбмена = ТекстЗамера;
		Если ИмяКоманды = "updatePlacements"
			И ЕстьДолгаяФазаЗамера(Секция, ВызовСервераМс, СериализацияМс, МетрикиМоста, ИндексМс) Тогда
			ЗаписатьЗамерОбновленияКонтейнеровНаСервере(ТекстЗамера);
		КонецЕсли;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Если Не ЭтоОжиданиеГотовностиПлана(ТекстОшибки) Тогда
			СостояниеОбмена = СтрШаблон("не удалось применить слой %1: %2", ИмяСлоя, ТекстОшибки);
		КонецЕсли;
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Функция ЭтоОжиданиеГотовностиПлана(ТекстОшибки)

	Возврат СтрНайти(ТекстОшибки, "ещё не") > 0
		Или СтрНайти(ТекстОшибки, "Не удалось получить доступ к документу") > 0;

КонецФункции

&НаСервере
Процедура ПересобратьСценуНаСервере()

	Константы.ПолучениеРеальныхДанных.Установить(ПолучениеРеальныхДанных);
	Константы.ОтрисовкаПутейДляВагонов.Установить(ОтрисовкаПутейДляВагонов);

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Сборка = ОбъектОбработки.СобратьHTMLСцены();
	HTML = Сборка.HTML;
	ДанныеСценыJSON = Сборка.ДанныеСценыJSON;
	СостояниеОбмена = Сборка.СостояниеОбмена;
	ЗаполнитьДатыАктуализации(Сборка);

КонецПроцедуры

&НаСервере
Процедура ОтрисовкаПутейДляВагоновПриИзмененииНаСервере()

	Константы.ОтрисовкаПутейДляВагонов.Установить(ОтрисовкаПутейДляВагонов);

КонецПроцедуры

&НаСервере
Процедура ПерерисоватьСценуБезОбменаНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Сборка = ОбъектОбработки.СобратьHTMLСцены();
	HTML = Сборка.HTML;
	ДанныеСценыJSON = Сборка.ДанныеСценыJSON;
	СостояниеОбмена = Сборка.СостояниеОбмена;
	ЗаполнитьДатыАктуализации(Сборка);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТехникуСкаутНаСервере()

	ОбработкаОбъект = Обработки.d3_v4.Создать();
	Возврат ОбработкаОбъект.СобратьТехникуСкаут();

КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьТехникуСкаутНаСервере(ПериодСнимка)

	Результат = Новый Структура;
	Результат.Вставить("ЕстьИзменения", Ложь);
	Результат.Вставить("ПериодСнимка", ПериодСнимка);
	Результат.Вставить("Объекты", Новый Массив);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(Положение.Период) КАК Период
	|ИЗ
	|	РегистрСведений.ПоложениеТехникиСкаут КАК Положение";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Или Не ЗначениеЗаполнено(Выборка.Период) Тогда
		Возврат Результат;
	КонецЕсли;

	Если Выборка.Период = ПериодСнимка Тогда
		Возврат Результат;
	КонецЕсли;

	ОбработкаОбъект = Обработки.d3_v4.Создать();
	Результат.ЕстьИзменения = Истина;
	Результат.ПериодСнимка = Выборка.Период;
	Результат.Объекты = ОбработкаОбъект.СобратьТехникуСкаут();
	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура СинхронизироватьИндексТехники(МассивТехники)

	УдаляемыеИдентификаторы = Новый Массив;
	Для Каждого ЭлементИндекса Из ИндексОбъектов Цикл
		ОбъектСцены = ЭлементИндекса.Значение;
		Если ОбъектСцены.Свойство("kind") И ОбъектСцены.kind = "scoutVehicle" Тогда
			УдаляемыеИдентификаторы.Добавить(ЭлементИндекса.Ключ);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Идентификатор Из УдаляемыеИдентификаторы Цикл
		ИндексОбъектов.Удалить(Идентификатор);
	КонецЦикла;
	Для Каждого ОбъектТехники Из МассивТехники Цикл
		ИндексОбъектов.Вставить(ОбъектТехники.id, ОбъектТехники);
	КонецЦикла;

КонецПроцедуры

