
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьТехникуНаСервере();
	ЗаполнитьКонтейнерыНаСервере();
	ЗаполнитьВагоныНаСервере();
	ЗаполнитьПлощадкиНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыНайденныеОбъекты

&НаКлиенте
Процедура НайденныеОбъектыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ВернутьВыбранныйОбъект();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыНайденныеКонтейнеры

&НаКлиенте
Процедура НайденныеКонтейнерыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ВернутьВыбранныйКонтейнер();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыНайденныеВагоны

&НаКлиенте
Процедура НайденныеВагоныВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ВернутьВыбранныйВагон();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыНайденныеПлощадки

&НаКлиенте
Процедура НайденныеПлощадкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ВернутьВыбраннуюПлощадку();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьОбъект(Команда)

	ВернутьВыбранныйОбъект();

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКонтейнер(Команда)

	ВернутьВыбранныйКонтейнер();

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВагон(Команда)

	ВернутьВыбранныйВагон();

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПлощадку(Команда)

	ВернутьВыбраннуюПлощадку();

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФорму(Команда)

	Закрыть();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВернутьВыбранныйОбъект()

	ТекущиеДанные = Элементы.НайденныеОбъекты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекущиеДанные.Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	РезультатВыбора = Новый Структура;
	РезультатВыбора.Вставить("ВидОбъекта", ТекущиеДанные.ВидОбъекта);
	РезультатВыбора.Вставить("Идентификатор", ТекущиеДанные.Идентификатор);
	Закрыть(РезультатВыбора);

КонецПроцедуры

&НаКлиенте
Процедура ВернутьВыбранныйКонтейнер()

	ТекущиеДанные = Элементы.НайденныеКонтейнеры.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ТекущиеДанные.НаПлане Тогда
		ПоказатьПредупреждение(
			Неопределено,
			СтрШаблон("Ячейка %1 не описана на плане, показать её нельзя.", ТекущиеДанные.КодЯчейки));
		Возврат;
	КонецЕсли;

	РезультатВыбора = Новый Структура;
	РезультатВыбора.Вставить("ВидОбъекта", "cell");
	РезультатВыбора.Вставить("Идентификатор", ТекущиеДанные.ИдЯчейкиСцены);
	Закрыть(РезультатВыбора);

КонецПроцедуры

&НаКлиенте
Процедура ВернутьВыбранныйВагон()

	ТекущиеДанные = Элементы.НайденныеВагоны.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ТекущиеДанные.НаПлане Тогда
		ПоказатьПредупреждение(
			Неопределено,
			СтрШаблон("Вагон %1 ещё не перенесён на план, показать его нельзя.", ТекущиеДанные.Номер));
		Возврат;
	КонецЕсли;

	РезультатВыбора = Новый Структура;
	РезультатВыбора.Вставить("ВидОбъекта", "railWagon");
	РезультатВыбора.Вставить("Идентификатор", ТекущиеДанные.ИдВагонаСцены);
	Закрыть(РезультатВыбора);

КонецПроцедуры

&НаКлиенте
Процедура ВернутьВыбраннуюПлощадку()

	ТекущиеДанные = Элементы.НайденныеПлощадки.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекущиеДанные.Подпись) Тогда
		Возврат;
	КонецЕсли;

	РезультатВыбора = Новый Структура;
	РезультатВыбора.Вставить("ВидОбъекта", "containerSite");
	РезультатВыбора.Вставить("Идентификатор", ТекущиеДанные.Подпись);
	Закрыть(РезультатВыбора);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТехникуНаСервере()

	НайденныеОбъекты.Очистить();

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	МассивТехники = ОбработкаОбъект.СобратьТехникуСкаут();

	Для Каждого Техника Из МассивТехники Цикл
		ИмяТехники = "";
		Если Техника.Свойство("name") Тогда
			ИмяТехники = СокрЛП(Строка(Техника.name));
		КонецЕсли;

		СтрокаРезультата = НайденныеОбъекты.Добавить();
		СтрокаРезультата.ВидОбъекта = "scoutVehicle";
		Если Техника.Свойство("id") Тогда
			СтрокаРезультата.Идентификатор = Строка(Техника.id);
		КонецЕсли;
		СтрокаРезультата.Наименование = ИмяТехники;
		Если Техника.Свойство("equipmentType") Тогда
			СтрокаРезультата.ТипТехники = Строка(Техника.equipmentType);
		КонецЕсли;
		Если Техника.Свойство("information") Тогда
			СтрокаРезультата.Информация = Строка(Техника.information);
		КонецЕсли;
	КонецЦикла;

	НайденныеОбъекты.Сортировать("Наименование");

	КоличествоНайденных = НайденныеОбъекты.Количество();
	Если КоличествоНайденных = 0 Тогда
		СостояниеПоиска = "Ничего не найдено";
	Иначе
		СостояниеПоиска = СтрШаблон("Найдено: %1", КоличествоНайденных);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКонтейнерыНаСервере()

	НайденныеКонтейнеры.Очистить();

	Если Не Константы.ПолучениеРеальныхДанных.Получить() Тогда
		СостояниеПоискаКонтейнеров = "Реальные данные отключены";
		Возврат;
	КонецЕсли;

	Попытка
		ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
		ТаблицаКонтейнеров = ОбработкаОбъект.ПолучитьКонтейнерыПлощадокСоСценой();
	Исключение
		СостояниеПоискаКонтейнеров = "Не удалось получить контейнеры из УКТ: " + ОписаниеОшибки();
		Возврат;
	КонецПопытки;

	КоличествоВнеМакета = 0;
	Для Каждого СтрокаКонтейнера Из ТаблицаКонтейнеров Цикл
		КодКонтейнера = СокрЛП(Строка(СтрокаКонтейнера.Код));
		Если ПустаяСтрока(КодКонтейнера) Тогда
			Продолжить;
		КонецЕсли;

		СтрокаРезультата = НайденныеКонтейнеры.Добавить();
		СтрокаРезультата.Код = КодКонтейнера;
		СтрокаРезультата.КодЯчейки = СокрЛП(Строка(СтрокаКонтейнера.КодЯчейки));
		СтрокаРезультата.ТипЗоны = СокрЛП(Строка(СтрокаКонтейнера.ТипЗоны));
		СтрокаРезультата.ИдЯчейкиСцены = СокрЛП(Строка(СтрокаКонтейнера.ИдЯчейкиСцены));
		СтрокаРезультата.НаПлане = ЗначениеЗаполнено(СтрокаРезультата.ИдЯчейкиСцены);
		Если Не СтрокаРезультата.НаПлане Тогда
			КоличествоВнеМакета = КоличествоВнеМакета + 1;
		КонецЕсли;
	КонецЦикла;

	КоличествоНайденных = НайденныеКонтейнеры.Количество();
	Если КоличествоНайденных = 0 Тогда
		СостояниеПоискаКонтейнеров = "Ничего не найдено";
	ИначеЕсли КоличествоВнеМакета > 0 Тогда
		СостояниеПоискаКонтейнеров = СтрШаблон(
			"Найдено: %1, вне макета плана: %2",
			КоличествоНайденных,
			КоличествоВнеМакета);
	Иначе
		СостояниеПоискаКонтейнеров = СтрШаблон("Найдено: %1", КоличествоНайденных);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВагоныНаСервере()

	НайденныеВагоны.Очистить();

	Попытка
		ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
		ТаблицаВагонов = ОбработкаОбъект.ПолучитьВагоныСоСценой();
	Исключение
		СостояниеПоискаВагонов = "Не удалось получить вагоны из УПП: " + ОписаниеОшибки();
		Возврат;
	КонецПопытки;

	КоличествоВнеПлана = 0;
	Для Каждого СтрокаВагона Из ТаблицаВагонов Цикл
		НомерВагона = СокрЛП(Строка(СтрокаВагона.Номер));
		Если ПустаяСтрока(НомерВагона) Тогда
			Продолжить;
		КонецЕсли;

		СтрокаРезультата = НайденныеВагоны.Добавить();
		СтрокаРезультата.Номер = НомерВагона;
		СтрокаРезультата.ТипВагона = СокрЛП(Строка(СтрокаВагона.ТипВагона));
		СтрокаРезультата.Ветка = СокрЛП(Строка(СтрокаВагона.Ветка));
		СтрокаРезультата.Позиция = СтрокаВагона.Позиция;
		СтрокаРезультата.Груженый = СтрокаВагона.Груженый = Истина;
		СтрокаРезультата.ДлинаМ = СтрокаВагона.ДлинаМ;
		СтрокаРезультата.ИдВагонаСцены = СокрЛП(Строка(СтрокаВагона.ИдВагонаСцены));
		СтрокаРезультата.НаПлане = СтрокаВагона.НаПлане = Истина
			И ЗначениеЗаполнено(СтрокаРезультата.ИдВагонаСцены);
		Если Не СтрокаРезультата.НаПлане Тогда
			КоличествоВнеПлана = КоличествоВнеПлана + 1;
		КонецЕсли;
	КонецЦикла;

	КоличествоНайденных = НайденныеВагоны.Количество();
	Если КоличествоНайденных = 0 Тогда
		СостояниеПоискаВагонов = "Ничего не найдено";
	ИначеЕсли КоличествоВнеПлана > 0 Тогда
		СостояниеПоискаВагонов = СтрШаблон(
			"Найдено: %1, ещё нет на плане: %2",
			КоличествоНайденных,
			КоличествоВнеПлана);
	Иначе
		СостояниеПоискаВагонов = СтрШаблон("Найдено: %1", КоличествоНайденных);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПлощадкиНаСервере()

	НайденныеПлощадки.Очистить();

	Попытка
		ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
		ТаблицаПодписей = ОбработкаОбъект.ПолучитьПодписиКонтейнерныхПлощадок();
	Исключение
		СостояниеПоискаПлощадок = "Не удалось получить площадки: " + ОписаниеОшибки();
		Возврат;
	КонецПопытки;

	Для Каждого СтрокаПодписи Из ТаблицаПодписей Цикл
		Подпись = СокрЛП(Строка(СтрокаПодписи.Подпись));
		Если ПустаяСтрока(Подпись) Тогда
			Продолжить;
		КонецЕсли;

		СтрокаРезультата = НайденныеПлощадки.Добавить();
		СтрокаРезультата.Подпись = Подпись;
		СтрокаРезультата.КоличествоПлощадок = СтрокаПодписи.КоличествоПлощадок;
	КонецЦикла;

	НайденныеПлощадки.Сортировать("Подпись");

	КоличествоНайденных = НайденныеПлощадки.Количество();
	Если КоличествоНайденных = 0 Тогда
		СостояниеПоискаПлощадок = "Ничего не найдено";
	Иначе
		СостояниеПоискаПлощадок = СтрШаблон("Найдено: %1", КоличествоНайденных);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
